EXTRA_JS_MODULES += [
    "DesktopAddressInput.sys.mjs",
    "DesktopCleanLinks.sys.mjs",
    "DesktopDownloadPreferences.sys.mjs",
    "DesktopEngine.sys.mjs",
    "DesktopExtensionMenus.sys.mjs",
    "DesktopExtensionTabs.sys.mjs",
    "DesktopInternalPages.sys.mjs",
    "DesktopLocale.sys.mjs",
    "DesktopProcessIsolation.sys.mjs",
    "DesktopProductPages.sys.mjs",
    "DesktopProfileManagement.sys.mjs",
    "DesktopProfileStore.sys.mjs",
    "DesktopTabMetrics.sys.mjs",
    "NavisSearchPolicy.sys.mjs",
    "NavisSearchService.sys.mjs",
    "NavisSettingsPolicy.sys.mjs",
    "NavisSuggestionPolicy.sys.mjs",
]

if CONFIG["MOZ_WEBEXTENSIONS_RUNTIME"]:
    EXTRA_JS_MODULES += [
        "DesktopExtensionActions.sys.mjs",
        "DesktopExtensionManager.sys.mjs",
        "DesktopExtensionOmnibox.sys.mjs",
        "DesktopExtensionPermissionPrompts.sys.mjs",
        "DesktopExtensionPopupHost.sys.mjs",
    ]

if CONFIG["MOZ_DESKTOP_EMBEDDER_DEVTOOLS"]:
    EXTRA_JS_MODULES += ["DesktopDevTools.sys.mjs"]

FINAL_TARGET_FILES.modules += [
    "AboutNewTab.sys.mjs",
    "BrowserWindowTracker.sys.mjs",
    "ExtensionBrowsingData.sys.mjs",
]

FINAL_TARGET_FILES.modules["navis-licenses"] += ["licenses/source-code.txt"]
