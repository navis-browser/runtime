# Reusable executable, child-process, and platform-security integration for a
# product that provides MOZ_APP_NAME and includes this file from its app dir.
GeckoProgram(CONFIG["MOZ_APP_NAME"])

USE_LIBS += ["mozglue"]

SOURCES += ["/desktop-embedder/app/nsDesktopEmbedderApp.cpp"]

LOCAL_INCLUDES += [
    "!/build",
    "/toolkit/xre",
    "/xpcom/base",
    "/xpcom/build",
]

if CONFIG["CC_TYPE"] == "clang-cl":
    WIN32_EXE_LDFLAGS += ["-ENTRY:wmainCRTStartup"]

if CONFIG["OS_ARCH"] == "WINNT":
    # This is Gecko's in-process launch/security support. Do not traverse
    # browser/app/desktop-launcher: an embedder product must never install a
    # Firefox.exe sidecar.
    DIRS += ["/browser/app/winlauncher"]

    USE_LIBS += ["winlauncher"]

    LOCAL_INCLUDES += ["/browser/app/winlauncher"]

    OS_LIBS += [
        "advapi32",
        "shell32",
        "uuid",
    ]

    DELAYLOAD_DLLS += [
        "advapi32.dll",
        "oleaut32.dll",
        "ole32.dll",
        "rpcrt4.dll",
        "shell32.dll",
        "version.dll",
    ]

    if CONFIG["CC_TYPE"] == "clang-cl":
        libpath_flag = "-LIBPATH:"
    else:
        libpath_flag = "-L"

    WIN32_EXE_LDFLAGS += [
        libpath_flag + TOPOBJDIR + "/browser/app/winlauncher/freestanding",
    ]

    # The launcher selects CET compatibility per child process because xul.dll
    # contains JIT code.
    LINK_FLAGS["CETCOMPAT"] = []

if CONFIG["MOZ_SANDBOX"] and CONFIG["OS_ARCH"] == "WINNT":
    LOCAL_INCLUDES += [
        "/security/sandbox/chromium",
        "/security/sandbox/chromium-shim",
    ]

    USE_LIBS += ["sandbox_s"]

    # sandbox_s uses the same Win32 APIs as Gecko's child-process launcher.
    OS_LIBS += [
        "ntdll",
        "user32",
        "version",
        "winmm",
    ]

    DELAYLOAD_DLLS += [
        "user32.dll",
        "userenv.dll",
        "usp10.dll",
        "winmm.dll",
    ]

if CONFIG["MOZ_WEBRTC"]:
    DEFINES["MOZ_WEBRTC"] = True

DisableStlWrapping()

# WINCONSOLE moved from the legacy Make backend into moz.build after ESR 140.
# Keep the shared source consumable by both ESR generations; the current 140
# compatibility run is Linux-only, where the Windows subsystem choice is inert.
if int(CONFIG["GRE_MILESTONE"].split(".")[0]) >= 153:
    if CONFIG["MOZ_ASAN"] or CONFIG["MOZ_DEBUG"]:
        WINCONSOLE = True
    else:
        WINCONSOLE = False

if CONFIG["HAVE_CLOCK_MONOTONIC"]:
    OS_LIBS += CONFIG["REALTIME_LIBS"]
