+    }
+  }
+
+  private void dispatchOrQueue(final String event, final GeckoBundle data) {
+    ThreadUtils.assertOnUiThread();
+    ensureOpenRequested();
+    if (mHostReady) {
+      mDispatcher.dispatch(event, data);
+      return;
+    }
+    if (mPendingCommands.size() == MAX_PENDING_COMMANDS) {
+      throw new IllegalStateException("Too many commands queued before the engine host is ready");
+    }
+    mPendingCommands.addLast(new PendingCommand(event, data));
+  }
+
+  private void onNativeWindowReady() {
+    ThreadUtils.runOnUiThread(
+        () -> {
+          if (!mClosed && !mNativeWindowReady) {
+            mNativeWindowReady = true;
+            completeNewWindowOpen(true);
+            mDelegate.onNativeWindowReady(mSessionId);
+          }
+        });
+  }
+
+  private void onNativeWindowError(final String message) {
+    ThreadUtils.runOnUiThread(
+        () -> {
+          if (!mClosed) {
+            failNewWindowOpen(message);
+            transitionToClosed();
+            mDelegate.onSessionError(mSessionId, message);
+            releaseDispatcher();
+            notifySessionClosed();
+          }
+        });
+  }
+
+  private void onNativeWindowClosed() {
