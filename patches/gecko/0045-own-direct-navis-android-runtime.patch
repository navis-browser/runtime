+          final PendingCommand command = mPendingCommands.removeFirst();
+          mDispatcher.dispatch(command.event, command.data);
+        }
+        break;
+      case EVENT_LOCATION:
+        mDelegate.onLocationChanged(mSessionId, message.getString("uri", ""));
+        break;
+      case EVENT_TITLE:
+        mDelegate.onTitleChanged(mSessionId, message.getString("title", ""));
+        break;
+      case EVENT_LOADING:
+        mDelegate.onLoadingChanged(mSessionId, message.getBoolean("loading", false));
+        break;
+      case EVENT_LOAD_COMPLETE:
+        mDelegate.onLoadCompleted(mSessionId, message.getBoolean("succeeded", false));
+        break;
+      case EVENT_SESSION_STATE:
+        final String serializedState = message.getString("state", "");
+        if (!serializedState.isEmpty()
+            && serializedState.length() <= MAX_RESTORED_STATE_CHARS) {
+          mDelegate.onSessionStateChanged(mSessionId, serializedState);
+        }
+        break;
+      case EVENT_HISTORY:
