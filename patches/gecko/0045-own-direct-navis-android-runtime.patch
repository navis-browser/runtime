diff --git a/widget/android/NavisAndroidSupport.cpp b/widget/android/NavisAndroidSupport.cpp
new file mode 100644
index 000000000000..52c956e23b2d
--- /dev/null
+++ b/widget/android/NavisAndroidSupport.cpp
@@ -0,0 +1,308 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "NavisAndroidSupport.h"
+
+#include "AndroidBridge.h"
+#include "AndroidUiThread.h"
+#include "AndroidView.h"
+#include "JavaBuiltins.h"
+#include "gfxPlatform.h"
+#include "mozilla/java/EventDispatcherWrappers.h"
+#include "mozilla/java/NavisAndroidSessionWrappers.h"
+#include "mozilla/layers/UiCompositorControllerChild.h"
+#include "mozilla/net/AsyncUrlChannelClassifier.h"
+#include "nsIAppWindow.h"
+#include "nsIWidgetListener.h"
+#include "nsIWindowWatcher.h"
+#include "nsPIDOMWindow.h"
+#include "nsServiceManagerUtils.h"
+#include "nsThreadUtils.h"
+#include "nsWindow.h"
+
+using mozilla::layers::UiCompositorControllerChild;
+
+namespace mozilla::widget {
+
+namespace {
+
+template <typename Lambda>
+bool DispatchToAndroidUiThread(const char* aName, Lambda&& aLambda) {
+  if (RefPtr<nsThread> thread = GetAndroidUiThread()) {
+    thread->Dispatch(
+        NS_NewRunnableFunction(aName, std::forward<Lambda>(aLambda)));
+    return true;
+  }
+  return false;
+}
+
+}  // namespace
+
+NavisAndroidCompositorSupport::NavisAndroidCompositorSupport(
+    NavisAndroidWindowPtr aWindow,
+    const java::NavisAndroidSession::Compositor::LocalRef& aInstance)
+    : mWindow(aWindow), mCompositor(aInstance) {}
+
+void NavisAndroidCompositorSupport::OnWeakNonIntrusiveDetach(
+    already_AddRefed<Runnable> aDisposer) {
+  RefPtr<Runnable> disposer(aDisposer);
+  auto compositor =
+      java::NavisAndroidSession::Compositor::GlobalRef(mCompositor);
+  if (!compositor) {
+    disposer->Run();
+    return;
+  }
+
+  if (!DispatchToAndroidUiThread("NavisAndroidCompositorSupport::Detach",
+                                 [compositor, disposer]() mutable {
+                                   compositor->OnCompositorDetached();
+                                   disposer->Run();
+                                 })) {
+    disposer->Run();
+  }
+}
+
+void NavisAndroidCompositorSupport::NotifyCompositorCreated(
+    RefPtr<UiCompositorControllerChild> aController) {
+  MOZ_ASSERT(AndroidBridge::IsJavaUiThread());
+  mController = std::move(aController);
+  if (mCompositorPaused || !mController) {
+    return;
+  }
+
+  if (auto window = mWindow.Access()) {
+    if (nsWindow* widget = window->GetNsWindow()) {
+      mController->OnCompositorSurfaceChanged(widget->mWidgetId, mSurface);
+    }
+  }
+  if (!mController->ResumeAndResize(mX, mY, mWidth, mHeight)) {
+    RequestNewSurface();
+  }
+}
+
+void NavisAndroidCompositorSupport::NotifyCompositorSessionLost() {
+  MOZ_ASSERT(AndroidBridge::IsJavaUiThread());
+  mController = nullptr;
+  mSurface = nullptr;
+}
+
+void NavisAndroidCompositorSupport::OnBoundsChanged(int32_t aLeft, int32_t aTop,
+                                                    int32_t aWidth,
+                                                    int32_t aHeight) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (auto window = mWindow.Access()) {
+    if (nsWindow* widget = window->GetNsWindow()) {
+      widget->DoResize(aLeft, aTop, aWidth, aHeight, false);
+    }
+  }
+}
+
+void NavisAndroidCompositorSupport::SyncPauseCompositor() {
+  MOZ_ASSERT(AndroidBridge::IsJavaUiThread());
+  mCompositorPaused = true;
+  if (!mController) {
+    mSurface = nullptr;
+    return;
+  }
+
+  mController->Pause();
+  mSurface = nullptr;
+  if (auto window = mWindow.Access()) {
+    if (nsWindow* widget = window->GetNsWindow()) {
+      mController->OnCompositorSurfaceChanged(widget->mWidgetId, nullptr);
+    }
+  }
+}
+
+void NavisAndroidCompositorSupport::SyncResumeResizeCompositor(
+    int32_t aX, int32_t aY, int32_t aWidth, int32_t aHeight,
+    jni::Object::Param aSurface) {
+  MOZ_ASSERT(AndroidBridge::IsJavaUiThread());
+  mCompositorPaused = false;
+  mX = aX;
+  mY = aY;
+  mWidth = aWidth;
+  mHeight = aHeight;
+  mSurface = java::sdk::Surface::GlobalRef::From(aSurface);
+
+  if (mController) {
+    if (auto window = mWindow.Access()) {
+      if (nsWindow* widget = window->GetNsWindow()) {
+        mController->OnCompositorSurfaceChanged(widget->mWidgetId, mSurface);
+      }
+    }
+    if (!mController->ResumeAndResize(aX, aY, aWidth, aHeight)) {
+      RequestNewSurface();
+      return;
+    }
+  }
+
+  mRequestedNewSurface = false;
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "NavisAndroidCompositorSupport::Redraw", [window = mWindow] {
+        if (auto access = window.Access()) {
+          if (nsWindow* widget = access->GetNsWindow()) {
+            widget->RedrawAll();
+          }
+        }
+      }));
+}
+
+void NavisAndroidCompositorSupport::RequestNewSurface() {
+  if (mRequestedNewSurface) {
+    return;
+  }
+  auto compositor =
+      java::NavisAndroidSession::Compositor::LocalRef(mCompositor);
+  if (compositor) {
+    mRequestedNewSurface = true;
+    compositor->RequestNewSurface();
+  }
+}
+
+NavisAndroidWindowSupport::NavisAndroidWindowSupport(
+    nsWindow* aWindow,
+    const java::NavisAndroidSession::NativeWindow::LocalRef& aInstance,
+    nsPIDOMWindowOuter* aDOMWindow)
+    : mWindow(aWindow), mPeer(aInstance), mDOMWindow(aDOMWindow) {}
+
+NavisAndroidWindowSupport::~NavisAndroidWindowSupport() {
+  if (mWindow) {
+    mWindow->DetachNatives();
+  }
+}
+
+/* static */
+void NavisAndroidWindowSupport::Open(
+    const jni::Class::LocalRef& aCls,
+    java::NavisAndroidSession::NativeWindow::Param aWindow,
+    jni::Object::Param aCompositor, jni::Object::Param aInputProvider,
+    jni::Object::Param aEditableParent,
+    jni::Object::Param aAccessibilityProvider, jni::Object::Param aDispatcher,
+    int64_t aSessionId, bool aPrivateMode, jni::String::Param aWindowToken) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  auto peer =
+      java::NavisAndroidSession::NativeWindow::LocalRef(aCls.Env(), aWindow);
+  auto fail = [&peer](const char* aMessage) {
+    peer->OnNativeWindowError(jni::StringParam(aMessage));
+  };
+
+  if (aSessionId <= 0 || !aCompositor || !aInputProvider || !aEditableParent ||
+      !aAccessibilityProvider || !aDispatcher) {
+    fail("Invalid direct Android session arguments");
+    return;
+  }
+
+  // Prime the same engine facilities as the selected ESR's Android window
+  // path, while keeping lifecycle ownership in this Navis peer.
+  gfxPlatform::GetPlatform();
+  net::AsyncUrlChannelClassifier::WarmUp();
+
+  nsCOMPtr<nsIWindowWatcher> watcher =
+      do_GetService(NS_WINDOWWATCHER_CONTRACTID);
+  if (!watcher) {
+    fail("Android window watcher is unavailable");
+    return;
+  }
+
+  auto androidView = MakeRefPtr<AndroidView>();
+  androidView->mEventDispatcher->Attach(
+      java::EventDispatcher::Ref::From(aDispatcher));
+
+  nsAutoCString name;
+  if (aWindowToken) {
+    name = aWindowToken->ToCString();
+  } else {
+    name.AssignLiteral("navis-android-session-");
+    name.AppendInt(aSessionId);
+  }
+  nsAutoCString flags("chrome,dialog=0,remote,resizable,scrollbars");
+  if (aPrivateMode) {
+    flags += ",private";
+  }
+
+  nsCOMPtr<mozIDOMWindowProxy> domWindow;
+  nsresult rv = watcher->OpenWindow(
+      nullptr, "chrome://navis-android/content/host.xhtml"_ns, name, flags,
+      androidView, getter_AddRefs(domWindow));
+  if (NS_FAILED(rv) || !domWindow) {
+    androidView->mEventDispatcher->Detach();
+    fail("Failed to create the direct Android engine window");
+    return;
+  }
+
+  nsCOMPtr<nsPIDOMWindowOuter> outer = nsPIDOMWindowOuter::From(domWindow);
+  RefPtr<nsWindow> window = nsWindow::From(outer);
+  if (!window) {
+    outer->ForceClose();
+    androidView->mEventDispatcher->Detach();
+    fail("Direct Android engine window has no Android widget");
+    return;
+  }
+
+  MOZ_RELEASE_ASSERT(!window->mNavisAndroidWindowSupport.IsAttached());
+
+  auto weakWindow = jni::NativeWeakPtrHolder<NavisAndroidWindowSupport>::Attach(
+      peer, window, peer, outer);
+  window->mNavisAndroidWindowSupport = weakWindow;
+  window->mAndroidView = androidView;
+
+  auto compositor = java::NavisAndroidSession::Compositor::LocalRef(
+      aCls.Env(),
+      java::NavisAndroidSession::Compositor::Ref::From(aCompositor));
+  window->mNavisAndroidCompositorSupport =
+      jni::NativeWeakPtrHolder<NavisAndroidCompositorSupport>::Attach(
+          compositor, weakWindow, compositor);
+  window->AttachNavisInput(aInputProvider);
+  window->AttachNavisEditable(aEditableParent);
+  window->AttachNavisAccessibility(aAccessibilityProvider);
+
+  if (window->mWidgetListener) {
+    nsCOMPtr<nsIAppWindow> appWindow(window->mWidgetListener->GetAppWindow());
+    if (appWindow) {
+      appWindow->SetIntrinsicallySized(false);
+    }
+  }
+
+  DispatchToAndroidUiThread(
+      "NavisAndroidCompositorSupport::Attached",
+      [compositor = java::NavisAndroidSession::Compositor::GlobalRef(
+           compositor)] { compositor->OnCompositorAttached(); });
+
+  if (RefPtr<UiCompositorControllerChild> controller =
+          window->GetUiCompositorControllerChild()) {
+    DispatchToAndroidUiThread(
+        "NavisAndroidCompositorSupport::CompositorCreated",
+        [support = window->mNavisAndroidCompositorSupport, controller] {
+          if (auto access = support.Access()) {
+            access->NotifyCompositorCreated(controller);
+          }
+        });
+  }
+
+  peer->OnNativeWindowReady();
+}
+
+void NavisAndroidWindowSupport::Close() {
+  MOZ_ASSERT(NS_IsMainThread());
+  auto peer = java::NavisAndroidSession::NativeWindow::LocalRef(mPeer);
+
+  if (mWindow) {
+    if (mWindow->mAndroidView) {
+      mWindow->mAndroidView->mEventDispatcher->Detach();
+    }
+    mWindow = nullptr;
+  }
+  if (mDOMWindow) {
+    mDOMWindow->ForceClose();
+    mDOMWindow = nullptr;
+  }
+  if (peer) {
+    peer->OnNativeWindowClosed();
+  }
+  mPeer = nullptr;
+}
+
+}  // namespace mozilla::widget
