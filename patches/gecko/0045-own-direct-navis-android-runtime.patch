+          }
+        });
+  }
+
+  private void onCompositorDetached() {
+    ThreadUtils.runOnUiThread(
+        () -> {
+          if (!mClosed) {
+            mDelegate.onCompositorDetached(mSessionId);
+          }
+        });
+  }
+
+  private void onNewSurfaceRequired() {
+    ThreadUtils.runOnUiThread(
+        () -> {
+          if (!mClosed) {
+            mDelegate.onNewSurfaceRequired(mSessionId);
+          }
+        });
+  }
+
+  private void handleNewWindowRequest(
+      final GeckoBundle message, final EventCallback callback) {
+    if (callback == null) {
+      return;
+    }
+    final String uri = message.getString("uri", "");
+    final String windowToken = message.getString("windowToken", "");
+    if (uri.length() > MAX_NEW_WINDOW_URI_CHARS || !isValidWindowToken(windowToken)) {
+      callback.sendError("Invalid new-window request");
+      return;
+    }
+    if (mPendingNewWindows.containsKey(windowToken)) {
+      callback.sendError("Duplicate new-window engine token");
+      return;
+    }
+
+    final PendingNewWindowRequest request = new PendingNewWindowRequest(callback);
+    request.timeout =
+        () -> completeNewWindowRequest(windowToken, request, false, null);
+    mPendingNewWindows.put(windowToken, request);
+    mUiHandler.postDelayed(request.timeout, NEW_WINDOW_TIMEOUT_MS);
+
+    final CompletionStage<Boolean> response;
+    try {
+      response =
+          mDelegate.onNewWindowRequested(
+              mSessionId,
+              uri,
+              windowToken,
+              message.getBoolean("privateMode", false));
+    } catch (final Throwable error) {
+      completeNewWindowRequest(windowToken, request, false, error);
+      return;
+    }
+    if (response == null) {
+      completeNewWindowRequest(windowToken, request, false, null);
+      return;
+    }
+    response.whenComplete(
+        (accepted, error) ->
+            ThreadUtils.runOnUiThread(
+                () ->
+                    completeNewWindowRequest(
+                        windowToken, request, Boolean.TRUE.equals(accepted), error)));
+  }
+
+  private void completeNewWindowRequest(
+      final String windowToken,
+      final PendingNewWindowRequest request,
+      final boolean accepted,
+      final Throwable error) {
+    ThreadUtils.assertOnUiThread();
+    if (mPendingNewWindows.get(windowToken) != request) {
+      return;
+    }
+    mPendingNewWindows.remove(windowToken);
+    mUiHandler.removeCallbacks(request.timeout);
+    if (error == null) {
+      request.callback.sendSuccess(accepted);
+    } else {
+      final String message = error.getMessage();
+      request.callback.sendError(
+          message == null || message.isEmpty() ? "New-window request failed" : message);
+    }
+  }
+
+  private void transitionToClosed() {
+    if (mClosed) {
+      return;
+    }
+    mClosed = true;
+    mHostReady = false;
+    clearInputView();
+    mSurfaceBounds.setEmpty();
+    mPendingCommands.clear();
+    completeNewWindowOpen(false);
+    final ArrayList<PendingNewWindowRequest> pending =
+        new ArrayList<>(mPendingNewWindows.values());
+    mPendingNewWindows.clear();
+    for (final PendingNewWindowRequest request : pending) {
+      mUiHandler.removeCallbacks(request.timeout);
+      request.callback.sendSuccess(false);
+    }
+    if (mFullscreen) {
+      mFullscreen = false;
+      mDelegate.onFullscreenChanged(mSessionId, false);
+    }
+  }
+
+  private void clearInputView() {
+    mInputView = null;
+    mTextInput.setView(null);
+    mAccessibility.setView(null);
+  }
+
+  private void notifySessionClosed() {
+    if (mSessionClosedNotified) {
+      return;
+    }
+    mSessionClosedNotified = true;
+    mDelegate.onSessionClosed(mSessionId);
+  }
+
+  private void completeNewWindowOpen(final boolean opened) {
+    if (mNewWindowOpenResult == null) {
+      return;
+    }
+    final CompletableFuture<Boolean> result = mNewWindowOpenResult;
+    mNewWindowOpenResult = null;
+    result.complete(opened);
+  }
+
+  private void failNewWindowOpen(final String message) {
+    if (mNewWindowOpenResult == null) {
+      return;
+    }
+    final CompletableFuture<Boolean> result = mNewWindowOpenResult;
+    mNewWindowOpenResult = null;
+    result.completeExceptionally(new IllegalStateException(message));
+  }
+
+  private static boolean isValidWindowToken(final String token) {
+    if (token == null || token.length() != 32) {
+      return false;
+    }
+    for (int index = 0; index < token.length(); index++) {
+      final char value = token.charAt(index);
+      if (!((value >= '0' && value <= '9') || (value >= 'a' && value <= 'f'))) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  private void releaseDispatcher() {
+    if (mDispatcherReleased) {
+      return;
+    }
+    mDispatcherReleased = true;
+    mDispatcher.unregisterUiThreadListener(
+        mEventListener,
+        EVENT_HOST_READY,
+        EVENT_LOCATION,
+        EVENT_TITLE,
+        EVENT_LOADING,
+        EVENT_LOAD_COMPLETE,
+        EVENT_SESSION_STATE,
+        EVENT_HISTORY,
+        EVENT_SECURITY,
+        EVENT_FULLSCREEN,
+        EVENT_CONTENT_PROCESS_GONE,
+        EVENT_NEW_WINDOW);
+    mDispatcher.shutdown();
+  }
+
+  private void ensureNotClosed() {
+    if (mClosed) {
+      throw new IllegalStateException("Navis Android session is closed");
+    }
+  }
+
+  private void ensureOpenRequested() {
+    ensureNotClosed();
+    if (!mOpenRequested) {
+      throw new IllegalStateException("Navis Android session is not open");
+    }
+  }
+
+  private static final class NativeWindow extends JNIObject {
+    @SuppressWarnings("unused")
+    private final NavisAndroidSession mOwner;
+
+    NativeWindow(final NavisAndroidSession owner) {
+      mOwner = owner;
+    }
+
+    @WrapForJNI(dispatchTo = "proxy", stubName = "Open")
+    private static native void open(
+        NativeWindow instance,
+        Compositor compositor,
+        NavisAndroidInput.NativeProvider input,
+        NavisAndroidTextInput editable,
+        Object accessibility,
+        EventDispatcher dispatcher,
+        long sessionId,
+        boolean privateMode,
+        String engineWindowToken);
+
+    @WrapForJNI(dispatchTo = "proxy", stubName = "Close")
+    private native void close();
+
+    @WrapForJNI(calledFrom = "gecko")
+    private void onNativeWindowReady() {
+      mOwner.onNativeWindowReady();
+    }
+
+    @WrapForJNI(calledFrom = "gecko")
+    private void onNativeWindowError(final String message) {
+      mOwner.onNativeWindowError(message);
+    }
+
+    @WrapForJNI(calledFrom = "gecko")
+    private void onNativeWindowClosed() {
+      mOwner.onNativeWindowClosed();
+    }
+
+    @Override
+    protected void disposeNative() {
+      throw new UnsupportedOperationException("The native window owns this weak JNI binding");
+    }
+  }
+
+  private static final class Compositor extends JNIObject {
+    @SuppressWarnings("unused")
+    private final NavisAndroidSession mOwner;
+
+    Compositor(final NavisAndroidSession owner) {
+      mOwner = owner;
+    }
+
+    @WrapForJNI(calledFrom = "ui", dispatchTo = "proxy")
+    private native void onBoundsChanged(int left, int top, int width, int height);
+
+    @WrapForJNI(calledFrom = "ui", dispatchTo = "current")
+    private native void syncPauseCompositor();
+
+    @WrapForJNI(calledFrom = "ui", dispatchTo = "current")
+    private native void syncResumeResizeCompositor(
+        int x, int y, int width, int height, Object surface);
+
+    @WrapForJNI(calledFrom = "ui")
+    private void onCompositorAttached() {
+      mOwner.onCompositorAttached();
+    }
+
+    @WrapForJNI(calledFrom = "ui")
+    private void onCompositorDetached() {
+      mOwner.onCompositorDetached();
+    }
+
+    @WrapForJNI(calledFrom = "ui")
+    private void requestNewSurface() {
+      mOwner.onNewSurfaceRequired();
+    }
+
+    @Override
+    protected void disposeNative() {
+      throw new UnsupportedOperationException("The native window owns this weak JNI binding");
+    }
+  }
+}
