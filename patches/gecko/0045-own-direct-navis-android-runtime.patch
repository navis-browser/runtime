+class nsPIDOMWindowOuter;
+class nsWindow;
+
+namespace mozilla::widget {
+
+class NavisAndroidWindowSupport;
+
+using NavisAndroidWindowPtr = jni::NativeWeakPtr<NavisAndroidWindowSupport>;
+
+/** Owns the compositor Surface for a direct Navis Android session. */
+class NavisAndroidCompositorSupport final
+    : public java::NavisAndroidSession::Compositor::Natives<
+          NavisAndroidCompositorSupport> {
+ public:
+  using Base = java::NavisAndroidSession::Compositor::Natives<
+      NavisAndroidCompositorSupport>;
+
+  NavisAndroidCompositorSupport(
+      NavisAndroidWindowPtr aWindow,
+      const java::NavisAndroidSession::Compositor::LocalRef& aInstance);
+  ~NavisAndroidCompositorSupport() = default;
+
+  using Base::AttachNative;
+  using Base::DisposeNative;
+
+  template <typename Functor>
+  static void OnNativeCall(Functor&& aCall) {
+    NS_DispatchToMainThread(new WindowEvent<Functor>(std::move(aCall)));
+  }
+
+  void OnWeakNonIntrusiveDetach(already_AddRefed<Runnable> aDisposer);
+
+  void NotifyCompositorCreated(
+      RefPtr<layers::UiCompositorControllerChild> aController);
+  void NotifyCompositorSessionLost();
+
+  bool CompositorPaused() const { return mCompositorPaused; }
+  const java::sdk::Surface::Ref& GetSurface() const { return mSurface; }
+
+  void OnBoundsChanged(int32_t aLeft, int32_t aTop, int32_t aWidth,
+                       int32_t aHeight);
+  void SyncPauseCompositor();
+  void SyncResumeResizeCompositor(int32_t aX, int32_t aY, int32_t aWidth,
+                                  int32_t aHeight, jni::Object::Param aSurface);
+
+ private:
+  void RequestNewSurface();
+
+  NavisAndroidWindowPtr mWindow;
+  java::NavisAndroidSession::Compositor::WeakRef mCompositor;
+  Atomic<bool, ReleaseAcquire> mCompositorPaused{true};
+  java::sdk::Surface::GlobalRef mSurface;
+  int32_t mX{0};
+  int32_t mY{0};
+  int32_t mWidth{0};
+  int32_t mHeight{0};
+  RefPtr<layers::UiCompositorControllerChild> mController;
+  bool mRequestedNewSurface{false};
+};
+
+/** Owns one Gecko top-level window without constructing a GeckoSession. */
+class NavisAndroidWindowSupport final
+    : public java::NavisAndroidSession::NativeWindow::Natives<
+          NavisAndroidWindowSupport> {
+ public:
+  using Base = java::NavisAndroidSession::NativeWindow::Natives<
+      NavisAndroidWindowSupport>;
+
+  NavisAndroidWindowSupport(
+      nsWindow* aWindow,
+      const java::NavisAndroidSession::NativeWindow::LocalRef& aInstance,
+      nsPIDOMWindowOuter* aDOMWindow);
+  ~NavisAndroidWindowSupport();
+
+  template <typename Functor>
+  static void OnNativeCall(Functor&& aCall) {
+    NS_DispatchToMainThread(new WindowEvent<Functor>(std::move(aCall)));
+  }
+
+  using Base::DisposeNative;
+
+  void OnWeakNonIntrusiveDetach(already_AddRefed<Runnable> aDisposer) {
+    RefPtr<Runnable> disposer(aDisposer);
+    disposer->Run();
+  }
+
+  static void Open(const jni::Class::LocalRef& aCls,
+                   java::NavisAndroidSession::NativeWindow::Param aWindow,
+                   jni::Object::Param aCompositor,
+                   jni::Object::Param aInputProvider,
+                   jni::Object::Param aEditableParent,
+                   jni::Object::Param aAccessibilityProvider,
+                   jni::Object::Param aDispatcher, int64_t aSessionId,
+                   bool aPrivateMode, jni::String::Param aWindowToken);
+  void Close();
+
+  nsWindow* GetNsWindow() const { return mWindow; }
+
+ private:
+  RefPtr<nsWindow> mWindow;
+  java::NavisAndroidSession::NativeWindow::WeakRef mPeer;
+  nsCOMPtr<nsPIDOMWindowOuter> mDOMWindow;
+};
+
+}  // namespace mozilla::widget
+
+#endif  // mozilla_widget_NavisAndroidSupport_h
