+  if (enabled) {
+    GeckoViewRemoteDebugger.onEnable();
+  } else {
+    GeckoViewRemoteDebugger.onDisable();
+  }
+}
+
+const commandListener = {
+  onEvent(event, data) {
+    switch (event) {
+      case "NavisAndroid:Load": {
+        const uri = data?.uri;
+        if (typeof uri !== "string" || !uri) {
+          throw new TypeError("NavisAndroid:Load requires a non-empty URI");
+        }
+        browser.loadURI(Services.io.newURI(uri), {
+          triggeringPrincipal:
+            Services.scriptSecurityManager.getSystemPrincipal(),
+        });
+        break;
+      }
+      case "NavisAndroid:Reload":
+        browser.reload();
+        break;
+      case "NavisAndroid:Stop":
+        browser.stop();
+        break;
+      case "NavisAndroid:Back":
+        if (browser.canGoBack) {
+          browser.goBack();
+        }
+        break;
+      case "NavisAndroid:Forward":
+        if (browser.canGoForward) {
+          browser.goForward();
+        }
+        break;
+      case "NavisAndroid:RestoreState":
+        restoreSessionState(data?.state);
+        break;
+      case "NavisAndroid:FlushSessionState":
+        dispatchSessionState();
+        break;
+      case "NavisAndroid:ExitFullscreen":
+        document.exitFullscreen();
+        break;
+    }
+  },
+};
+
+const contentProcessObserver = {
+  observe(subject, topic) {
+    if (!browser || !dispatcher || shuttingDown) {
+      return;
+    }
+
+    if (topic === "oop-frameloader-crashed") {
+      const crashedBrowser = subject?.ownerElement;
+      if (crashedBrowser !== browser) {
+        return;
+      }
+      const pending = {
+        childId: browser.frameLoader?.childID,
+        crashed: false,
+      };
+      contentCrashPending = pending;
+      pending.timer = window.setTimeout(() => {
+        if (contentCrashPending !== pending || !dispatcher || shuttingDown) {
+          return;
+        }
+        contentCrashPending = null;
+        dispatcher.dispatch("NavisAndroid:ContentProcessGone", {
+          crashed: pending.crashed,
+        });
+      }, 250);
+      return;
+    }
+
+    if (topic !== "ipc:content-shutdown" || !contentCrashPending) {
+      return;
+    }
+    subject.QueryInterface(Ci.nsIPropertyBag2);
+    if (
+      subject.get("dumpID") &&
+      contentCrashPending.childId !== undefined &&
+      subject.get("childID") === contentCrashPending.childId
+    ) {
+      contentCrashPending.crashed = true;
+    }
+  },
+};
+
+function registerFullscreenActors() {
+  GeckoViewActorManager.addJSWindowActors({
+    GeckoViewContent: {
+      parent: {
+        esModuleURI: "resource:///actors/GeckoViewContentParent.sys.mjs",
+      },
+      child: {
+        esModuleURI: "resource:///actors/GeckoViewContentChild.sys.mjs",
+      },
+      allFrames: true,
+      messageManagerGroups: ["browsers"],
+    },
+    ContentDelegate: {
+      parent: {
+        esModuleURI: "resource:///actors/ContentDelegateParent.sys.mjs",
+      },
+      child: {
+        esModuleURI: "resource:///actors/ContentDelegateChild.sys.mjs",
+        events: {
+          "MozDOMFullscreen:Entered": {},
+          "MozDOMFullscreen:Exit": {},
+          "MozDOMFullscreen:Exited": {},
+          "MozDOMFullscreen:Request": {},
+        },
+      },
+      allFrames: true,
+      messageManagerGroups: ["browsers"],
+    },
+  });
+}
+
+function dispatchFullscreenState(enabled) {
+  if (fullscreenActive === enabled || !dispatcher || shuttingDown) {
+    return;
+  }
+  fullscreenActive = enabled;
+  dispatcher.dispatch("NavisAndroid:Fullscreen", { enabled });
+}
+
+function sendEnterDOMFullscreenEvent(requestOrigin) {
+  const actors = [];
+  let currentContext = requestOrigin.browsingContext;
+  let currentPid = currentContext.currentWindowGlobal.osPid;
+  let parentContext = currentContext.parent;
+
+  while (parentContext?.currentWindowGlobal) {
+    const parentPid = parentContext.currentWindowGlobal.osPid;
+    if (currentPid !== parentPid) {
+      const actor =
+        parentContext.currentWindowGlobal.getActor("GeckoViewContent");
+      actor.sendAsyncMessage("GeckoView:DOMFullscreenEntered", {
+        remoteFrameBC: currentContext,
+      });
+      actors.push(actor);
+      currentPid = parentPid;
+    }
+    currentContext = parentContext;
+    parentContext = parentContext.parent;
+  }
+
+  const actor =
+    requestOrigin.browsingContext.currentWindowGlobal.getActor(
+      "GeckoViewContent"
+    );
+  actor.sendAsyncMessage("GeckoView:DOMFullscreenEntered", {});
+  actors.push(actor);
+  fullscreenRequest = { actors };
+}
+
+function sendExitDOMFullscreenEvent() {
+  if (!fullscreenRequest) {
+    return;
+  }
+  for (const actor of fullscreenRequest.actors) {
+    if (
+      !actor.hasBeenDestroyed() &&
+      actor.windowContext &&
+      !actor.windowContext.isInBFCache
+    ) {
+      actor.sendAsyncMessage("GeckoView:DOMFullscreenExited", {});
+    }
+  }
+  fullscreenRequest = null;
+}
+
+const fullscreenListener = {
+  handleEvent(event) {
+    if (event.type === "MozDOMFullscreen:Exited") {
+      sendExitDOMFullscreenEvent();
+      dispatchFullscreenState(false);
+      return;
+    }
+    if (event.type !== "MozDOMFullscreen:Entered" || event.target !== browser) {
+      return;
+    }
+    const requestOrigin =
+      browser.documentGlobal.browsingContext?.fullscreenRequestOrigin?.get();
+    if (!requestOrigin) {
+      document.exitFullscreen();
+      return;
+    }
+    try {
+      sendEnterDOMFullscreenEvent(requestOrigin);
+      dispatchFullscreenState(true);
+    } catch (error) {
+      console.error("Navis Android failed to enter DOM fullscreen", error);
+      sendExitDOMFullscreenEvent();
+      document.exitFullscreen();
+    }
+  },
+};
+
+function cancelOpenWindowInfo(openWindowInfo) {
+  try {
+    openWindowInfo?.cancel();
+  } catch (error) {
+    console.error("Navis Android failed to cancel a new content window", error);
+  }
+}
+
+function waitAndSetupWindow(windowToken, openWindowInfo, name) {
+  let settled = false;
+  let timeout;
+  let resolveSetup;
+  let rejectSetup;
+  const promise = new Promise((resolve, reject) => {
+    resolveSetup = resolve;
+    rejectSetup = reject;
+  });
+  promise.catch(() => {});
+
+  const finish = (error, targetBrowser = null) => {
+    if (settled) {
+      return;
+    }
+    settled = true;
+    Services.obs.removeObserver(observer, "navis-android-window-created");
+    window.clearTimeout(timeout);
+    pendingWindowSetups.delete(waiter);
+    if (error) {
+      rejectSetup(error);
+    } else {
+      resolveSetup(targetBrowser);
+    }
+  };
+  const observer = {
+    observe(subject, topic) {
+      if (
+        topic !== "navis-android-window-created" ||
+        subject?.name !== windowToken ||
+        !subject.browser
+      ) {
+        return;
+      }
+      const targetBrowser = subject.browser;
+      if (openWindowInfo) {
+        targetBrowser.openWindowInfo = openWindowInfo;
+        if (!openWindowInfo.isRemote && targetBrowser.hasAttribute("remote")) {
+          targetBrowser.removeAttribute("remote");
+          targetBrowser.removeAttribute("remoteType");
+        }
+      }
+      if (name) {
+        targetBrowser.setAttribute("name", name);
+      }
+      finish(null, targetBrowser);
+    },
+  };
+  const waiter = {
+    promise,
+    cancel(error) {
+      finish(error ?? new Error("New content window request cancelled"));
+    },
+  };
+  pendingWindowSetups.add(waiter);
+  Services.obs.addObserver(observer, "navis-android-window-created");
+  timeout = window.setTimeout(
+    () => waiter.cancel(new Error("Timed out creating a new content window")),
+    NEW_WINDOW_TIMEOUT_MS
+  );
+  return waiter;
+}
+
+async function requestNewSession(uri, openWindowInfo, name) {
+  const windowToken = Services.uuid
+    .generateUUID()
+    .toString()
+    .slice(1, -1)
+    .replace(/-/g, "");
+  const waiter = waitAndSetupWindow(windowToken, openWindowInfo, name);
+  try {
+    const accepted = await dispatcher.sendRequestForResult(
+      "NavisAndroid:NewWindow",
+      {
+        uri: uri?.displaySpec ?? "",
+        windowToken,
+        privateMode:
+          browser.browsingContext.originAttributes.privateBrowsingId > 0,
+      }
+    );
+    if (!accepted) {
+      throw new Error("New content window request rejected");
+    }
+    return await waiter.promise;
+  } catch (error) {
+    waiter.cancel(error);
+    cancelOpenWindowInfo(openWindowInfo);
+    throw error;
+  }
+}
+
+function waitSynchronously(label, promise) {
+  let result;
+  promise.then(
+    value => {
+      result = value;
+    },
+    () => {
+      result = null;
+    }
+  );
+  Services.tm.spinEventLoopUntil(
+    `Navis Android ${label}`,
+    () => window.closed || result !== undefined
+  );
+  return result || null;
+}
+
+const browserDOMWindow = {
+  QueryInterface: ChromeUtils.generateQI(["nsIBrowserDOMWindow"]),
+
+  get tabCount() {
+    return 1;
+  },
+
+  createContentWindow(uri, openWindowInfo, where) {
+    const promise = requestNewSession(uri, openWindowInfo, null);
+    const isNewTab = [
+      Ci.nsIBrowserDOMWindow.OPEN_NEWTAB,
+      Ci.nsIBrowserDOMWindow.OPEN_NEWTAB_BACKGROUND,
+    ].includes(where);
+    if (openWindowInfo && !isNewTab) {
+      promise.catch(() => {});
+      return null;
+    }
+    const targetBrowser = waitSynchronously("createContentWindow", promise);
+    if (!targetBrowser) {
+      Components.returnCode = Cr.NS_ERROR_ABORT;
+      return null;
+    }
+    return targetBrowser.browsingContext;
+  },
+
+  createContentWindowInFrame(uri, params, where, _flags, name) {
+    if (where === Ci.nsIBrowserDOMWindow.OPEN_PRINT_BROWSER) {
+      cancelOpenWindowInfo(params.openWindowInfo);
+      Components.returnCode = Cr.NS_ERROR_ABORT;
+      return null;
+    }
+    const targetBrowser = waitSynchronously(
+      "createContentWindowInFrame",
+      requestNewSession(uri, params.openWindowInfo, name)
+    );
+    if (!targetBrowser) {
+      Components.returnCode = Cr.NS_ERROR_ABORT;
+    }
+    return targetBrowser;
+  },
+
+  async openURIAsync(
+    uri,
+    openWindowInfo,
+    where,
+    triggeringPrincipal,
+    policyContainer,
+    referrerInfo = null,
+    name = null
+  ) {
+    const opensNewSession = [
+      Ci.nsIBrowserDOMWindow.OPEN_NEWWINDOW,
+      Ci.nsIBrowserDOMWindow.OPEN_NEWTAB,
+      Ci.nsIBrowserDOMWindow.OPEN_NEWTAB_BACKGROUND,
+      Ci.nsIBrowserDOMWindow.OPEN_NEWTAB_FOREGROUND,
+    ].includes(where);
+    const targetBrowser = opensNewSession
+      ? await requestNewSession(uri, openWindowInfo, name)
+      : browser;
+    targetBrowser.loadURI(uri, {
+      triggeringPrincipal,
+      policyContainer,
+      referrerInfo,
+      hasValidUserGestureActivation:
+        !!openWindowInfo?.hasValidUserGestureActivation,
+      textDirectiveUserActivation:
+        !!openWindowInfo?.textDirectiveUserActivation,
+    });
+    return targetBrowser;
+  },
+
+  openURI(
+    uri,
+    openWindowInfo,
+    where,
+    _flags,
+    triggeringPrincipal,
+    policyContainer
+  ) {
+    const targetBrowser = waitSynchronously(
+      "openURI",
+      this.openURIAsync(
+        uri,
+        openWindowInfo,
+        where,
+        triggeringPrincipal,
+        policyContainer
+      )
+    );
+    if (!targetBrowser) {
+      Components.returnCode = Cr.NS_ERROR_ABORT;
+      return null;
+    }
+    return targetBrowser.browsingContext;
+  },
+
+  openURIInFrame(uri, params, where, _flags, name) {
+    const targetBrowser = waitSynchronously(
+      "openURIInFrame",
+      this.openURIAsync(
+        uri,
+        params.openWindowInfo,
+        where,
+        params.triggeringPrincipal,
+        params.policyContainer,
+        params.referrerInfo,
+        name
+      )
+    );
+    if (!targetBrowser) {
+      Components.returnCode = Cr.NS_ERROR_ABORT;
+    }
+    return targetBrowser;
+  },
+
+  canClose() {
+    return true;
+  },
+};
+
+const progressListener = {
+  QueryInterface: ChromeUtils.generateQI([
+    "nsIWebProgressListener",
+    "nsISupportsWeakReference",
+  ]),
+
+  onStateChange(webProgress, request, flags) {
+    if (
+      !webProgress.isTopLevel ||
+      !(flags & Ci.nsIWebProgressListener.STATE_IS_NETWORK)
+    ) {
+      return;
+    }
+    if (flags & Ci.nsIWebProgressListener.STATE_START) {
+      dispatcher.dispatch("NavisAndroid:Loading", { loading: true });
+    } else if (flags & Ci.nsIWebProgressListener.STATE_STOP) {
+      dispatcher.dispatch("NavisAndroid:Loading", { loading: false });
+      dispatcher.dispatch("NavisAndroid:LoadComplete", {
+        succeeded: Boolean(request && Components.isSuccessCode(request.status)),
+      });
+      dispatchHistoryState();
+      dispatchSessionState();
+    }
+  },
+
+  onLocationChange(webProgress, request, location) {
+    if (!webProgress.isTopLevel) {
+      return;
+    }
+    dispatcher.dispatch("NavisAndroid:Location", {
+      uri: location?.spec ?? "",
+    });
+    dispatchHistoryState();
+  },
+
+  onSecurityChange(webProgress, request, state) {
+    if (!webProgress.isTopLevel) {
+      return;
+    }
+    let securityState = 0;
+    if (state & Ci.nsIWebProgressListener.STATE_IS_SECURE) {
+      securityState = 3;
+    } else if (state & Ci.nsIWebProgressListener.STATE_IS_BROKEN) {
+      securityState = 2;
+    } else if (state & Ci.nsIWebProgressListener.STATE_IS_INSECURE) {
+      securityState = 1;
+    }
+    dispatcher.dispatch("NavisAndroid:Security", { state: securityState });
+  },
+
+  onProgressChange() {},
+  onStatusChange() {},
+  onContentBlockingEvent() {},
+};
+
+function dispatchHistoryState() {
+  dispatcher.dispatch("NavisAndroid:History", {
+    canGoBack: browser.canGoBack,
+    canGoForward: browser.canGoForward,
+  });
+}
+
+function collectSessionState() {
+  const browsingContext = browser?.browsingContext;
+  const uri = browsingContext?.currentURI?.spec;
+  const history = browsingContext?.sessionHistory;
+  if (!uri || !history) {
+    return null;
+  }
+  const serialized = JSON.stringify({
+    version: 1,
+    history: SessionHistory.collectFromParent(uri, true, history),
+  });
+  return serialized.length <= MAX_SESSION_STATE_CHARS ? serialized : null;
+}
+
+function dispatchSessionState() {
+  const state = collectSessionState();
+  if (state) {
+    dispatcher.dispatch("NavisAndroid:SessionState", { state });
+  }
+}
+
+function restoreSessionState(serialized) {
+  if (
+    typeof serialized !== "string" ||
+    !serialized ||
+    serialized.length > MAX_SESSION_STATE_CHARS
+  ) {
+    throw new TypeError("Navis Android restore state is empty or too large");
+  }
+  const state = JSON.parse(serialized);
+  const entries = state?.history?.entries;
+  const index = state?.history?.index;
+  if (
+    state?.version !== 1 ||
+    !Array.isArray(entries) ||
+    entries.length > MAX_SESSION_HISTORY_ENTRIES ||
+    (entries.length &&
+      (!Number.isInteger(index) || index < 1 || index > entries.length)) ||
+    entries.some(entry => typeof entry?.url !== "string" || !entry.url)
+  ) {
+    throw new TypeError("Invalid Navis Android session state");
+  }
+  if (!entries.length) {
+    return;
+  }
+  browser.stop();
+  SessionHistory.restoreFromParent(
+    browser.browsingContext.sessionHistory,
+    state.history
+  );
+  const url = entries[index - 1].url;
+  SessionStoreUtils.restoreDocShellState(
+    browser.browsingContext,
+    url,
+    state.history.disallow
+  );
+}
+
+function createRemoteBrowser() {
+  const element = document.createXULElement("browser");
+  element.permanentKey = new (Cu.getGlobalForObject(Services).Object)();
+  element.id = "navis-content";
+  element.setAttribute("nodefaultsrc", "true");
+  element.setAttribute("type", "content");
+  element.setAttribute("primary", "true");
+  element.setAttribute("flex", "1");
+  element.setAttribute("maychangeremoteness", "true");
+  element.setAttribute("remote", "true");
+  element.setAttribute(
+    "remoteType",
+    ChromeUtils.predictRemoteTypeForURI(null, { window })
+  );
+  element.setAttribute("messagemanagergroup", "browsers");
+  element.setAttribute("manualactiveness", "true");
+  return element;
+}
+
+function startup() {
+  dispatcher = EventDispatcher.for(window);
+  registerFullscreenActors();
+  browser = createRemoteBrowser();
+  window.browser = browser;
+  window.browserDOMWindow = browserDOMWindow;
+  Services.obs.notifyObservers(window, "navis-android-window-created");
+  document.documentElement.appendChild(browser);
+  browser.preserveLayers(true);
+  browser.docShellIsActive = true;
+
+  dispatcher.registerListener(commandListener, COMMANDS);
+  Services.obs.addObserver(
+    developerModeObserver,
+    "navis-android-developer-mode"
+  );
+  Services.obs.addObserver(contentProcessObserver, "oop-frameloader-crashed");
+  Services.obs.addObserver(contentProcessObserver, "ipc:content-shutdown");
+  window.addEventListener("MozDOMFullscreen:Entered", fullscreenListener, true);
+  window.addEventListener("MozDOMFullscreen:Exited", fullscreenListener, true);
+  updateDeveloperMode(
+    Services.prefs.getBoolPref("devtools.debugger.remote-enabled", false)
+  );
+  browser.addProgressListener(
+    progressListener,
+    Ci.nsIWebProgress.NOTIFY_STATE_NETWORK |
+      Ci.nsIWebProgress.NOTIFY_LOCATION |
+      Ci.nsIWebProgress.NOTIFY_SECURITY
+  );
+  browser.addEventListener("DOMTitleChanged", () => {
+    dispatcher.dispatch("NavisAndroid:Title", {
+      title: browser.contentTitle ?? "",
+    });
+  });
+
+  dispatcher.dispatch("NavisAndroid:HostReady", {});
+  Services.obs.notifyObservers(null, "navis-android-startup-complete");
+}
+
+function shutdown() {
+  if (!dispatcher) {
+    return;
+  }
+  shuttingDown = true;
+  dispatcher.unregisterListener(commandListener, COMMANDS);
+  Services.obs.removeObserver(
+    developerModeObserver,
+    "navis-android-developer-mode"
+  );
+  Services.obs.removeObserver(
+    contentProcessObserver,
+    "oop-frameloader-crashed"
+  );
+  Services.obs.removeObserver(contentProcessObserver, "ipc:content-shutdown");
+  window.removeEventListener(
+    "MozDOMFullscreen:Entered",
+    fullscreenListener,
+    true
+  );
+  window.removeEventListener(
+    "MozDOMFullscreen:Exited",
+    fullscreenListener,
+    true
+  );
+  if (contentCrashPending) {
+    window.clearTimeout(contentCrashPending.timer);
+    contentCrashPending = null;
+  }
+  for (const waiter of [...pendingWindowSetups]) {
+    waiter.cancel(new Error("Navis Android host closed"));
+  }
+  sendExitDOMFullscreenEvent();
+  if (browser) {
+    browser.removeProgressListener(progressListener);
+  }
+  window.browserDOMWindow = null;
+  window.browser = null;
+  dispatcher = null;
+  browser = null;
+}
+
+window.addEventListener("load", startup, { once: true });
+window.addEventListener("unload", shutdown, { once: true });
