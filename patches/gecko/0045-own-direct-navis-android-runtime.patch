+
+#ifndef mozilla_widget_NavisAndroidSupport_h
+#define mozilla_widget_NavisAndroidSupport_h
+
+#include "mozilla/Atomics.h"
+#include "JavaBuiltins.h"
+#include "mozilla/java/NavisAndroidSessionNatives.h"
