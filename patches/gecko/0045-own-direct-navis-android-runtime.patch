+
+package org.mozilla.gecko.navis;
+
+import java.util.concurrent.CompletionStage;
+import org.mozilla.gecko.GeckoAppShell;
+import org.mozilla.gecko.annotation.WrapForJNI;
+import org.mozilla.gecko.util.ThreadUtils;
+import org.mozilla.geckoview.GeckoResult;
+import org.mozilla.geckoview.WebNotification;
+
+/** Process-wide JNI peer owned and installed by the Navis Android Runtime. */
+public final class NavisAndroidRuntime {
+  public interface Delegate {
+    float textScaleFactor();
+
+    boolean usesDarkTheme();
+
+    CompletionStage<Boolean> onOrientationLock(int orientation);
+
+    void onOrientationUnlock();
+  }
+
+  private static NavisAndroidRuntime sInstance;
+
+  private final Delegate mDelegate;
+
+  private NavisAndroidRuntime(final Delegate delegate) {
+    mDelegate = delegate;
+  }
+
+  public static synchronized NavisAndroidRuntime install(final Delegate delegate) {
+    if (delegate == null) {
+      throw new NullPointerException("delegate");
+    }
+    if (sInstance != null) {
+      throw new IllegalStateException("Only one Navis Android Runtime may be installed");
+    }
+    sInstance = new NavisAndroidRuntime(delegate);
+    return sInstance;
+  }
+
+  public synchronized void uninstall() {
+    if (sInstance != this) {
+      throw new IllegalStateException("This Navis Android Runtime is not installed");
+    }
+    sInstance = null;
+  }
+
+  /** Enables or disables the live Android DevTools socket for this engine process. */
+  public void setDeveloperMode(final boolean enabled) {
+    GeckoAppShell.notifyObservers(
+        "navis-android-developer-mode", enabled ? "true" : "false");
+  }
+
+  @WrapForJNI
+  private static synchronized NavisAndroidRuntime getInstance() {
+    return sInstance;
+  }
+
+  @WrapForJNI
+  private float textScaleFactor() {
+    return mDelegate.textScaleFactor();
+  }
+
+  @WrapForJNI
+  private boolean usesDarkTheme() {
+    return mDelegate.usesDarkTheme();
+  }
+
+  @WrapForJNI
+  private void notifyOnShow(final WebNotification notification) {
+    // Notification projection is deliberately outside the first direct-runtime
+    // slice. Fail closed instead of exposing GeckoView's notification object.
+    ThreadUtils.runOnUiThread(notification::dismiss);
+  }
+
+  @WrapForJNI
+  private void notifyOnClose(final WebNotification notification) {
+    ThreadUtils.runOnUiThread(notification::dismiss);
+  }
+
+  @WrapForJNI(calledFrom = "gecko")
+  private GeckoResult<Boolean> lockScreenOrientation(final int orientation) {
+    final GeckoResult<Boolean> result = new GeckoResult<>();
+    ThreadUtils.runOnUiThread(
+        () -> {
+          try {
+            final CompletionStage<Boolean> delegated =
+                mDelegate.onOrientationLock(orientation);
+            if (delegated == null) {
+              result.completeExceptionally(new UnsupportedOperationException("Orientation lock"));
+            } else {
+              delegated.whenComplete(
+                  (allowed, error) -> {
+                    if (error != null) {
+                      result.completeExceptionally(error);
+                    } else {
+                      result.complete(Boolean.TRUE.equals(allowed));
+                    }
+                  });
+            }
+          } catch (final Throwable error) {
+            result.completeExceptionally(error);
+          }
+        });
+    return result;
+  }
+
+  @WrapForJNI(calledFrom = "gecko")
+  private void unlockScreenOrientation() {
+    ThreadUtils.runOnUiThread(mDelegate::onOrientationUnlock);
+  }
+}
