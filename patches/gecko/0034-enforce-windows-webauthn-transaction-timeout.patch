+nsresult WinWebAuthnService::ArmTransactionTimeout(
+    uint64_t aTransactionId, uint32_t aTimeoutMilliseconds) {
+  MOZ_ASSERT(NS_IsMainThread());
+  MOZ_ASSERT(mActiveTransaction.isSome());
+  MOZ_ASSERT(!mTransactionTimer);
+  nsresult rv = NS_NewTimerWithCallback(
+      getter_AddRefs(mTransactionTimer),
+      [self = RefPtr{this}, aTransactionId](nsITimer*) {
+        if (self->mActiveTransaction.isSome() &&
+            self->mActiveTransaction.ref().transactionId == aTransactionId) {
+          self->Reset();
+        }
+      },
+      aTimeoutMilliseconds, nsITimer::TYPE_ONE_SHOT,
+      "WinWebAuthnService::TransactionTimeout"_ns);
+  if (NS_FAILED(rv)) {
+    mActiveTransaction.reset();
+  }
+  return rv;
+}
