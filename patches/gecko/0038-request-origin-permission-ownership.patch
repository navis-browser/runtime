diff --git a/dom/permission/tests/test_navis_request_origin.html b/dom/permission/tests/test_navis_request_origin.html
new file mode 100644
index 0000000000000000000000000000000000000000..b4d2a5ae39bd7d2348b6ada36dfd4559c3a97789
--- /dev/null
+++ b/dom/permission/tests/test_navis_request_origin.html
@@ -0,0 +1,43 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Navis request-origin permission ownership</title>
+<script src="/tests/SimpleTest/SimpleTest.js"></script>
+<link rel="stylesheet" href="/tests/SimpleTest/test.css">
+<script>
+SimpleTest.waitForExplicitFinish();
+
+async function run() {
+  const { AppConstants } = SpecialPowers.ChromeUtils.importESModule(
+    "resource://gre/modules/AppConstants.sys.mjs"
+  );
+  if (!AppConstants.MOZ_NAVIS_CORE) {
+    ok(true, "Request-origin permission ownership is a Navis product policy");
+    return;
+  }
+  const frameURL = "https://example.org/tests/dom/permission/tests/file_empty.html";
+  for (const [name, type] of [["geolocation", "geo"], ["camera", "camera"], ["microphone", "microphone"]]) {
+    for (const [top, child, expected] of [[1, 2, "denied"], [2, 1, "granted"], [1, 0, "prompt"]]) {
+      await SpecialPowers.pushPermissions([
+        { type, allow: top, context: document },
+        { type, allow: child, context: frameURL },
+      ]);
+      for (const allowed of [true, false]) {
+        const frame = document.createElement("iframe");
+        frame.allow = allowed ? name : `${name} 'none'`;
+        frame.src = frameURL;
+        const loaded = new Promise(resolve => frame.onload = resolve);
+        document.body.append(frame);
+        await loaded;
+        await SpecialPowers.spawn(frame, [name, allowed ? expected : "denied"], async (permission, state) => {
+          const status = await content.navigator.permissions.query({ name: permission });
+          is(status.state, state, "Only the requesting origin's grant applies, subject to Permissions Policy");
+        });
+        frame.remove();
+      }
+      await SpecialPowers.popPermissions();
+    }
+  }
+}
+
+run().catch(error => ok(false, String(error.stack || error))).finally(() => SimpleTest.finish());
+</script>
