+class RestrictedApplicationExtensionLocation extends DirectoryLocation {
+  // This is a packaged built-in rather than an ordinary foreign/sideloaded
+  // extension. The distinction lets Gecko discover it while every generic
+  // sideload scope remains disabled. XPIInstall still requires its AMO
+  // signature through isApplicationBuiltin.
+  get isApplicationBuiltin() {
+    return true;
+  }
+
+  get isBuiltin() {
+    return true;
+  }
+
+  readAddons() {
+    const addons = super.readAddons();
+    const allowedIds = new Set(
+      Services.prefs
+        .getStringPref(PREF_APPLICATION_BUILTIN_IDS, "")
+        .split(",")
+        .map(id => id.trim())
+        .filter(Boolean)
+    );
+    for (const id of addons.keys()) {
+      if (!allowedIds.has(id)) {
+        logger.warn(`Ignoring unregistered application extension: ${id}`);
+        addons.delete(id);
+      }
+    }
+    return addons;
+  }
+}
