diff --git a/toolkit/themes/shared/in-content/info-pages.css b/toolkit/themes/shared/in-content/info-pages.css
index 0a59673d6eab..099cb3a16051 100644
--- a/toolkit/themes/shared/in-content/info-pages.css
+++ b/toolkit/themes/shared/in-content/info-pages.css
@@ -188,3 +188,252 @@ td {
 .content-flex {
   flex: 1 1 65%;
 }
+
+/* A desktop embedder can opt into a compact Material presentation for the
+ * engine-owned recovery documents without changing their privileged loading,
+ * retry, certificate or process-recovery semantics. */
+@media -moz-pref("browser.desktop-embedder.material-error-pages") {
+  :root.desktop-embedder-error-document,
+  :host {
+    --embedder-error-background: #ffffff;
+    --embedder-error-surface: #f1f3f4;
+    --embedder-error-surface-hover: #e8eaed;
+    --embedder-error-text: #202124;
+    --embedder-error-secondary-text: #5f6368;
+    --embedder-error-outline: #dadce0;
+    --embedder-error-primary: #0b57d0;
+    --embedder-error-primary-hover: #0a4fbe;
+    --embedder-error-primary-active: #0847aa;
+    --embedder-error-on-primary: #ffffff;
+    --embedder-error-focus: #0b57d0;
+    --embedder-error-shadow: 0 1px 2px rgb(60 64 67 / 30%), 0 2px 6px 2px rgb(60 64 67 / 15%);
+    --background-color-canvas: var(--embedder-error-background);
+    --background-color-box: var(--embedder-error-surface);
+    --background-color-box-info: var(--embedder-error-surface);
+    --text-color: var(--embedder-error-text);
+    --link-color: var(--embedder-error-primary);
+    --border-color: var(--embedder-error-outline);
+    --focus-outline: 2px solid var(--embedder-error-focus);
+    --focus-outline-color: var(--embedder-error-focus);
+    --focus-outline-width: 2px;
+    --focus-outline-offset: 2px;
+    --button-min-height: 36px;
+    --button-border-radius: 18px;
+    --button-padding: 0 16px;
+    --button-border: 1px solid var(--embedder-error-outline);
+    --button-background-color: transparent;
+    --button-background-color-hover: var(--embedder-error-surface);
+    --button-background-color-active: var(--embedder-error-surface-hover);
+    --button-background-color-selected: var(--embedder-error-surface-hover);
+    --button-background-color-disabled: transparent;
+    --button-border-color-hover: var(--embedder-error-secondary-text);
+    --button-border-color-active: var(--embedder-error-text);
+    --button-border-color-selected: var(--embedder-error-text);
+    --button-border-color-disabled: var(--embedder-error-outline);
