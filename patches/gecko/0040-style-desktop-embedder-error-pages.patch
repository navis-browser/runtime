diff --git a/toolkit/themes/shared/aboutHttpsOnlyError.css b/toolkit/themes/shared/aboutHttpsOnlyError.css
index d405ef2759be..113c974419ab 100644
--- a/toolkit/themes/shared/aboutHttpsOnlyError.css
+++ b/toolkit/themes/shared/aboutHttpsOnlyError.css
@@ -93,3 +93,62 @@ button.disabled {
   opacity: var(--button-opacity-disabled);
   color: var(--button-text-color-disabled);
 }
+
+@media -moz-pref("browser.desktop-embedder.material-error-pages") {
+  body {
+    width: 100%;
+  }
+
+  .title {
+    margin: 0;
+    padding: 56px 0 0;
+    background-image: url("chrome://global/skin/icons/desktop-embedder-error.svg");
+    background-position: left top;
+    background-size: 40px;
+    stroke: var(--embedder-error-secondary-text);
+    -moz-context-properties: stroke;
+  }
+
+  .title:dir(rtl) {
+    background-position: right top;
+  }
+
+  .title > h2 {
+    margin-bottom: 6px;
+    color: var(--embedder-error-secondary-text);
+    font-size: 12px;
+    font-weight: 500;
+    line-height: 1.5;
+  }
+
+  #learn-more-container,
+  #explanation-continue {
+    margin-block: 16px;
+  }
+
+  .button-container {
+    justify-content: flex-start;
+  }
+
+  .suggestion-box {
+    position: static;
+    margin: 24px 0 0;
+    padding: 16px;
+    border-radius: 16px;
+    background: var(--embedder-error-surface);
+    box-shadow: var(--embedder-error-shadow);
+    animation: fade-in 160ms ease-out;
+  }
+
+  .suggestion-box > h2 {
+    color: var(--embedder-error-text);
+    font-size: 16px;
+    font-weight: 500;
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    .suggestion-box {
+      animation: none;
+    }
+  }
+}
diff --git a/toolkit/themes/shared/aboutNetError.css b/toolkit/themes/shared/aboutNetError.css
index daa7e772d651..cb60afea1e19 100644
--- a/toolkit/themes/shared/aboutNetError.css
+++ b/toolkit/themes/shared/aboutNetError.css
@@ -267,3 +267,191 @@ button:disabled {
     background-position-x: right;
   }
 }
+
+@media -moz-pref("browser.desktop-embedder.material-error-pages") {
+  body {
+    width: 100%;
+    background-image: none;
+  }
+
+  body.neterror .title,
+  body.certerror .title,
+  body.captiveportal .title,
+  body.blocked .title {
+    margin: 0;
+    padding: 56px 0 0;
+    background-image: url("chrome://global/skin/icons/desktop-embedder-error.svg");
+    background-position: left top;
+    background-size: 40px;
+    stroke: var(--embedder-error-secondary-text);
+    -moz-context-properties: stroke;
+  }
+
+  body.certerror .title:dir(rtl),
+  body.captiveportal .title:dir(rtl),
+  body.blocked .title:dir(rtl) {
+    background-position: right top;
+  }
+
+  #errorShortDesc {
+    margin: 0 0 10px;
+    color: var(--embedder-error-secondary-text);
+    font-size: 14px;
+    font-weight: 400;
+    line-height: 1.5;
+  }
+
+  #errorShortDesc2 {
+    margin: 0 0 12px;
+    color: var(--embedder-error-secondary-text);
+    font-size: 12px;
+    line-height: 1.5;
+  }
+
+  #errorLongDesc {
+    font-size: 14px;
+    line-height: 1.5;
+  }
+
+  #errorLongDesc > :first-child {
+    margin-top: 0;
+  }
+
+  #errorLongDesc > :last-child {
+    margin-bottom: 0;
+  }
+
+  #errorLongDesc ul {
+    margin-block: 8px 12px;
+    margin-inline-start: 20px;
+  }
+
+  #errorLongDesc li {
+    margin-bottom: 4px;
+  }
+
+  #learnMoreContainer {
+    margin-block: 12px 0;
+  }
+
+  #errorWhatToDoTitle {
+    margin-top: 24px;
+    color: var(--embedder-error-text);
+    font-weight: 500;
+  }
+
+  #certErrorAndCaptivePortalButtonContainer,
+  #netErrorButtonContainer {
+    align-items: center;
+    justify-content: flex-start;
+  }
+
+  #netErrorButtonContainer > button {
+    margin-top: 0;
+  }
+
+  button:disabled {
+    cursor: default;
+  }
+
+  .advanced-panel-container {
+    position: static;
+  }
+
+  .advanced-panel {
+    box-sizing: border-box;
+    width: 100%;
+    min-width: 0;
+    max-width: none;
+    margin: 24px 0 0;
+    padding: 20px;
+    border: 0;
+    border-radius: 16px;
+    background: var(--embedder-error-surface);
+    box-shadow: var(--embedder-error-shadow);
+  }
+
+  #advancedPanelButtonContainer {
+    gap: 8px;
+    justify-content: flex-start;
+    margin-top: 20px;
+    padding: 0;
+    background: transparent;
+  }
+
+  #badCertTechnicalInfo,
+  #viewCertificate {
+    margin-inline: 0;
+  }
+
+  #badCertTechnicalInfo {
+    margin-block: 0 16px;
+  }
+
+  #certificateErrorDebugInformation {
+    border: 0;
+  }
+
+  .trr-message-container,
+  #prefChangeContainer {
+    border: 0;
+    border-radius: 12px;
+    background: var(--embedder-error-surface);
+    padding: 16px;
+  }
+
+  .felt-privacy-body {
+    justify-content: center;
+  }
+
+  net-error-card {
+    box-sizing: border-box;
+    width: min(100%, 600px);
+    min-width: 0;
+    margin: 0;
+    padding: 0;
+  }
+
+  .felt-privacy-container {
+    display: block;
+  }
+
+  .felt-privacy-container::before {
+    display: block;
+    width: 40px;
+    height: 40px;
+    margin-bottom: 16px;
+    background: url("chrome://global/skin/icons/desktop-embedder-error.svg") center / 40px no-repeat;
+    content: "";
+    stroke: var(--embedder-error-secondary-text);
+    -moz-context-properties: stroke;
+  }
+
+  .img-container {
+    display: none;
+  }
+
+  .custom-net-error-card,
+  .advanced-container {
+    border-radius: 16px;
+  }
+
+  .advanced-container {
+    margin-top: 24px;
+    padding: 20px;
+    background: var(--embedder-error-surface);
+    box-shadow: var(--embedder-error-shadow);
+  }
+
+  @media (max-width: 970px) {
+    body.certerror .title {
+      margin: 0;
+      padding-top: 56px;
+      background-position: left top;
+    }
+
+    body.certerror .title:dir(rtl) {
+      background-position: right top;
+    }
+  }
+}
