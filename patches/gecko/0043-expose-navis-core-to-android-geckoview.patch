+
+bool NavisCoreSupport::SetNavigationIdentity(int64_t aHandle,
+                                             int64_t aSessionId,
+                                             int64_t aNavigationId,
+                                             int32_t aIdentity,
+                                             jni::String::Param aIdentityKey) {
+  NavisCoreRuntime* runtime = Runtime(aHandle);
