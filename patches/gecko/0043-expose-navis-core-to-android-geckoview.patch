From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: willvar <0@willvar.tw>
Date: Fri, 4 Sep 2026 02:08:00 +0800
Subject: [PATCH] Expose shared Navis Core to Android GeckoView

---
diff --git a/toolkit/moz.configure b/toolkit/moz.configure
index 4804666..61d4b32 100644
--- a/toolkit/moz.configure
+++ b/toolkit/moz.configure
@@ -52,6 +52,20 @@ option(
 set_config("MOZ_DESKTOP_EMBEDDER", True, when="--enable-desktop-embedder")
 set_define("MOZ_DESKTOP_EMBEDDER", True, when="--enable-desktop-embedder")
 
+option(
+    "--enable-navis-core",
+    help="Link the platform-neutral Navis Core state contract into libxul",
+)
+
+
+@depends("--enable-navis-core", "--enable-desktop-embedder")
+def navis_core(value, desktop_embedder):
+    return bool(value or desktop_embedder)
+
+
+set_config("MOZ_NAVIS_CORE", navis_core)
+set_define("MOZ_NAVIS_CORE", True, when=navis_core)
+
 option(
     "--enable-desktop-embedder-devtools",
     help="Build Gecko page developer tools for the desktop embedder",
@@ -148,10 +162,10 @@ option(
 )
 
 
-@depends("--enable-observability-runtime", "--enable-desktop-embedder")
-def observability_runtime(value, desktop_embedder):
-    if not value and not desktop_embedder:
-        die("--disable-observability-runtime is only supported by the desktop embedder")
+@depends("--enable-observability-runtime", navis_core)
+def observability_runtime(value, has_navis_core):
+    if not value and not has_navis_core:
+        die("--disable-observability-runtime requires a Navis Core consumer")
     return bool(value)
 
 
