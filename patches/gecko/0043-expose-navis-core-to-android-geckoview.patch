@@ -0,0 +1,91 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.geckoview.internal;
+
+import org.mozilla.gecko.annotation.WrapForJNI;
+
+/** Internal GeckoView bridge for the platform-neutral Navis Core contract. */
+public final class NavisCoreBridge {
+  private NavisCoreBridge() {}
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native long create();
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native void free(long handle);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native long registerWindow(long handle);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native void closeWindow(long handle, long windowId);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native long registerView(long handle, long windowId);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native long createSession(long handle, long viewId, boolean privateMode);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native boolean activateSession(long handle, long sessionId);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native void closeSession(long handle, long sessionId);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native void setCrashed(long handle, long sessionId, boolean crashed);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native long beginNavigation(
+      long handle, long sessionId, int command, String requestedUri);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native long observeNavigationStart(
+      long handle, long sessionId, String requestedUri, int kind);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native boolean setNavigationLocation(
+      long handle, long sessionId, long navigationId, String uri);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native boolean setNavigationTitle(
+      long handle, long sessionId, long navigationId, String title);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native boolean setNavigationSecurity(
+      long handle, long sessionId, long navigationId, int security);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native boolean setNavigationIdentity(
+      long handle, long sessionId, long navigationId, int identity, String identityKey);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native boolean setNavigationHistory(
+      long handle,
+      long sessionId,
+      long navigationId,
+      boolean canGoBack,
+      boolean canGoForward);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native boolean finishNavigation(
+      long handle,
+      long sessionId,
+      long navigationId,
+      boolean hasFailure,
+      int failureCode);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native boolean stopNavigation(long handle, long sessionId, long navigationId);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native NavisCoreSnapshot navigationSnapshot(long handle, long sessionId);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native void checkInvariants(long handle);
+
+  @WrapForJNI(calledFrom = "ui")
+  public static native boolean shutdown(long handle);
+}
diff --git a/mobile/android/geckoview/src/main/java/org/mozilla/geckoview/internal/NavisCoreSnapshot.java b/mobile/android/geckoview/src/main/java/org/mozilla/geckoview/internal/NavisCoreSnapshot.java
new file mode 100644
index 0000000..73151b1
--- /dev/null
+++ b/mobile/android/geckoview/src/main/java/org/mozilla/geckoview/internal/NavisCoreSnapshot.java
@@ -0,0 +1,51 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.geckoview.internal;
+
+import org.mozilla.gecko.annotation.WrapForJNI;
+
+/** Immutable Java copy of a borrowed Navis Core navigation snapshot. */
+public final class NavisCoreSnapshot {
+  public final long revision;
+  public final long navigationId;
+  public final String url;
+  public final String title;
+  public final int activity;
+  public final int security;
+  public final int identity;
+  public final String identityKey;
+  public final boolean canGoBack;
+  public final boolean canGoForward;
+  public final boolean hasFailure;
+  public final int failureCode;
+
+  @WrapForJNI(calledFrom = "ui")
+  public NavisCoreSnapshot(
+      long revision,
+      long navigationId,
+      String url,
+      String title,
+      int activity,
+      int security,
+      int identity,
+      String identityKey,
+      boolean canGoBack,
+      boolean canGoForward,
+      boolean hasFailure,
+      int failureCode) {
+    this.revision = revision;
+    this.navigationId = navigationId;
+    this.url = url;
+    this.title = title;
+    this.activity = activity;
+    this.security = security;
+    this.identity = identity;
+    this.identityKey = identityKey;
+    this.canGoBack = canGoBack;
+    this.canGoForward = canGoForward;
+    this.hasFailure = hasFailure;
+    this.failureCode = failureCode;
+  }
+}
diff --git a/widget/android/NavisCoreSupport.cpp b/widget/android/NavisCoreSupport.cpp
new file mode 100644
index 0000000..4dc3b18
--- /dev/null
+++ b/widget/android/NavisCoreSupport.cpp
@@ -0,0 +1,378 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "NavisCoreSupport.h"
+
+#include <cstdint>
+#include <limits>
+
+#include "NavisCoreFFI.h"
+#include "mozilla/jni/Utils.h"
+#include "nsPrintfCString.h"
+#include "nsString.h"
+
+namespace mozilla::widget {
+namespace {
+
+NavisCoreRuntime* Runtime(int64_t aHandle) {
+  if (!aHandle) {
+    jni::ThrowException("java/lang/IllegalStateException",
+                        "Navis Core runtime is closed");
+    return nullptr;
+  }
+  return reinterpret_cast<NavisCoreRuntime*>(static_cast<uintptr_t>(aHandle));
+}
+
+bool Id(int64_t aValue, uint64_t* aOutput) {
+  if (aValue <= 0) {
+    jni::ThrowException("java/lang/IllegalArgumentException",
+                        "Navis Core identifier must be positive");
+    return false;
+  }
+  *aOutput = static_cast<uint64_t>(aValue);
+  return true;
+}
+
+bool Status(NavisCoreStatus aStatus) {
+  if (aStatus == NAVIS_CORE_OK) {
+    return true;
+  }
+  const char* exception = aStatus == NAVIS_CORE_INVALID_ARGUMENT
+                              ? "java/lang/IllegalArgumentException"
+                              : "java/lang/IllegalStateException";
+  const nsPrintfCString message("Navis Core operation failed with status %u",
+                                static_cast<uint32_t>(aStatus));
+  jni::ThrowException(exception, message.get());
+  return false;
+}
+
+int64_t JavaId(uint64_t aValue) {
+  if (aValue > static_cast<uint64_t>(std::numeric_limits<int64_t>::max())) {
+    jni::ThrowException("java/lang/IllegalStateException",
+                        "Navis Core identifier exceeds the Java ABI");
+    return 0;
+  }
+  return static_cast<int64_t>(aValue);
+}
+
+bool CopyBorrowedString(const uint8_t* aValue, size_t aLength,
+                        nsCString* aOutput) {
+  if (!aLength) {
+    aOutput->Truncate();
+    return true;
+  }
+  if (!aValue || aLength > std::numeric_limits<uint32_t>::max()) {
+    jni::ThrowException("java/lang/IllegalStateException",
+                        "Navis Core returned an invalid borrowed string");
+    return false;
+  }
+  aOutput->Assign(reinterpret_cast<const char*>(aValue),
+                  static_cast<uint32_t>(aLength));
+  return true;
+}
+
+bool RequiredString(jni::String::Param aValue, nsCString* aOutput) {
+  if (!aValue) {
+    jni::ThrowException("java/lang/NullPointerException",
+                        "Navis Core string must not be null");
+    return false;
+  }
+  *aOutput = aValue->ToCString();
+  return true;
+}
+
+const uint8_t* Bytes(const nsACString& aValue) {
+  return reinterpret_cast<const uint8_t*>(aValue.BeginReading());
+}
+
+}  // namespace
+
+int64_t NavisCoreSupport::Create() {
+  return static_cast<int64_t>(
+      reinterpret_cast<uintptr_t>(navis_core_runtime_new()));
+}
+
+void NavisCoreSupport::Free(int64_t aHandle) {
+  if (NavisCoreRuntime* runtime = Runtime(aHandle)) {
+    navis_core_runtime_free(runtime);
+  }
+}
+
+int64_t NavisCoreSupport::RegisterWindow(int64_t aHandle) {
+  NavisCoreRuntime* runtime = Runtime(aHandle);
+  uint64_t output = 0;
+  return runtime && Status(navis_core_runtime_register_window(runtime, &output))
+             ? JavaId(output)
+             : 0;
+}
+
+void NavisCoreSupport::CloseWindow(int64_t aHandle, int64_t aWindowId) {
+  NavisCoreRuntime* runtime = Runtime(aHandle);
+  uint64_t window = 0;
+  if (runtime && Id(aWindowId, &window)) {
+    Status(navis_core_runtime_close_window(runtime, window));
+  }
+}
+
+int64_t NavisCoreSupport::RegisterView(int64_t aHandle, int64_t aWindowId) {
+  NavisCoreRuntime* runtime = Runtime(aHandle);
+  uint64_t window = 0;
+  uint64_t output = 0;
+  return runtime && Id(aWindowId, &window) &&
+                 Status(
+                     navis_core_runtime_register_view(runtime, window, &output))
+             ? JavaId(output)
+             : 0;
+}
+
+int64_t NavisCoreSupport::CreateSession(int64_t aHandle, int64_t aViewId,
+                                        bool aPrivateMode) {
+  NavisCoreRuntime* runtime = Runtime(aHandle);
+  uint64_t view = 0;
+  uint64_t output = 0;
+  return runtime && Id(aViewId, &view) &&
+                 Status(navis_core_runtime_create_session_with_mode(
+                     runtime, view, aPrivateMode, &output))
+             ? JavaId(output)
+             : 0;
+}
+
+bool NavisCoreSupport::ActivateSession(int64_t aHandle, int64_t aSessionId) {
+  NavisCoreRuntime* runtime = Runtime(aHandle);
+  uint64_t session = 0;
+  bool changed = false;
+  return runtime && Id(aSessionId, &session) &&
+                 Status(navis_core_runtime_activate_session(runtime, session,
+                                                            &changed))
+             ? changed
+             : false;
+}
+
+void NavisCoreSupport::CloseSession(int64_t aHandle, int64_t aSessionId) {
+  NavisCoreRuntime* runtime = Runtime(aHandle);
+  uint64_t session = 0;
+  if (runtime && Id(aSessionId, &session)) {
+    Status(navis_core_runtime_close_session(runtime, session));
+  }
+}
+
+void NavisCoreSupport::SetCrashed(int64_t aHandle, int64_t aSessionId,
+                                  bool aCrashed) {
+  NavisCoreRuntime* runtime = Runtime(aHandle);
+  uint64_t session = 0;
+  if (runtime && Id(aSessionId, &session)) {
+    Status(navis_core_runtime_set_crashed(runtime, session, aCrashed));
+  }
+}
+
+int64_t NavisCoreSupport::BeginNavigation(int64_t aHandle, int64_t aSessionId,
+                                          int32_t aCommand,
+                                          jni::String::Param aRequestedUri) {
+  NavisCoreRuntime* runtime = Runtime(aHandle);
+  uint64_t session = 0;
+  uint64_t output = 0;
+  nsCString uri;
+  const bool hasUri = static_cast<bool>(aRequestedUri);
+  if (hasUri) {
+    uri = aRequestedUri->ToCString();
+  }
+  return runtime && Id(aSessionId, &session) &&
+                 Status(navis_core_runtime_begin_navigation(
+                     runtime, session, static_cast<uint32_t>(aCommand),
+                     Bytes(uri), uri.Length(), hasUri, &output))
+             ? JavaId(output)
+             : 0;
+}
+
+int64_t NavisCoreSupport::ObserveNavigationStart(
+    int64_t aHandle, int64_t aSessionId, jni::String::Param aRequestedUri,
+    int32_t aKind) {
+  NavisCoreRuntime* runtime = Runtime(aHandle);
+  uint64_t session = 0;
+  uint64_t output = 0;
+  nsCString uri;
+  const bool hasUri = static_cast<bool>(aRequestedUri);
+  if (hasUri) {
+    uri = aRequestedUri->ToCString();
+  }
+  return runtime && Id(aSessionId, &session) &&
+                 Status(navis_core_runtime_observe_navigation_start(
+                     runtime, session, Bytes(uri), uri.Length(), hasUri,
+                     static_cast<uint32_t>(aKind), &output))
+             ? JavaId(output)
+             : 0;
+}
+
+bool NavisCoreSupport::SetNavigationLocation(int64_t aHandle,
+                                             int64_t aSessionId,
+                                             int64_t aNavigationId,
+                                             jni::String::Param aUri) {
+  NavisCoreRuntime* runtime = Runtime(aHandle);
+  uint64_t session = 0;
+  uint64_t navigation = 0;
+  nsCString uri;
+  bool changed = false;
+  return runtime && Id(aSessionId, &session) &&
+                 Id(aNavigationId, &navigation) && RequiredString(aUri, &uri) &&
+                 Status(navis_core_runtime_set_navigation_location(
+                     runtime, session, navigation, Bytes(uri), uri.Length(),
+                     &changed))
+             ? changed
+             : false;
+}
+
+bool NavisCoreSupport::SetNavigationTitle(int64_t aHandle, int64_t aSessionId,
+                                          int64_t aNavigationId,
+                                          jni::String::Param aTitle) {
+  NavisCoreRuntime* runtime = Runtime(aHandle);
+  uint64_t session = 0;
+  uint64_t navigation = 0;
+  nsCString title;
+  bool changed = false;
+  return runtime && Id(aSessionId, &session) &&
+                 Id(aNavigationId, &navigation) &&
+                 RequiredString(aTitle, &title) &&
+                 Status(navis_core_runtime_set_navigation_title(
+                     runtime, session, navigation, Bytes(title), title.Length(),
+                     &changed))
+             ? changed
+             : false;
+}
+
+bool NavisCoreSupport::SetNavigationSecurity(int64_t aHandle,
+                                             int64_t aSessionId,
+                                             int64_t aNavigationId,
+                                             int32_t aSecurity) {
+  NavisCoreRuntime* runtime = Runtime(aHandle);
