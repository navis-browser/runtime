+
+bool NavisCoreSupport::StopNavigation(int64_t aHandle, int64_t aSessionId,
+                                      int64_t aNavigationId) {
+  NavisCoreRuntime* runtime = Runtime(aHandle);
+  uint64_t session = 0;
+  uint64_t navigation = 0;
+  bool changed = false;
+  return runtime && Id(aSessionId, &session) &&
+                 Id(aNavigationId, &navigation) &&
+                 Status(navis_core_runtime_stop_navigation(
+                     runtime, session, navigation, &changed))
+             ? changed
+             : false;
+}
+
+// Annotation-generated native traits expose top-level Java return objects as
+// jni::Object::LocalRef; snapshot construction below remains strongly typed.
+jni::Object::LocalRef NavisCoreSupport::NavigationSnapshot(int64_t aHandle,
+                                                           int64_t aSessionId) {
+  NavisCoreRuntime* runtime = Runtime(aHandle);
+  uint64_t session = 0;
+  NavisCoreNavigationSnapshot snapshot{};
+  if (!runtime || !Id(aSessionId, &session) ||
+      !Status(navis_core_runtime_navigation_snapshot(runtime, session,
+                                                     &snapshot))) {
+    return nullptr;
+  }
+  nsCString url;
+  nsCString title;
+  nsCString identityKey;
+  if (!CopyBorrowedString(snapshot.url, snapshot.url_length, &url) ||
+      !CopyBorrowedString(snapshot.title, snapshot.title_length, &title) ||
+      !CopyBorrowedString(snapshot.identity_key, snapshot.identity_key_length,
+                          &identityKey)) {
+    return nullptr;
+  }
+  const int64_t revision = JavaId(snapshot.revision);
+  const int64_t navigationId = JavaId(snapshot.navigation_id);
+  if ((snapshot.revision && !revision) ||
+      (snapshot.navigation_id && !navigationId)) {
+    return nullptr;
+  }
+  return java::NavisCoreSnapshot::New(
+      revision, navigationId, jni::StringParam(url), jni::StringParam(title),
+      static_cast<int32_t>(snapshot.activity),
+      static_cast<int32_t>(snapshot.security),
+      static_cast<int32_t>(snapshot.identity), jni::StringParam(identityKey),
+      snapshot.can_go_back, snapshot.can_go_forward, snapshot.has_failure,
+      static_cast<int32_t>(snapshot.failure_code));
+}
+
+void NavisCoreSupport::CheckInvariants(int64_t aHandle) {
+  if (NavisCoreRuntime* runtime = Runtime(aHandle)) {
+    Status(navis_core_runtime_check_invariants(runtime));
+  }
+}
+
+bool NavisCoreSupport::Shutdown(int64_t aHandle) {
+  NavisCoreRuntime* runtime = Runtime(aHandle);
+  bool changed = false;
+  return runtime && Status(navis_core_runtime_shutdown(runtime, &changed))
+             ? changed
+             : false;
+}
+
+}  // namespace mozilla::widget
