+  _navisMaterializedFile(uri) {
+    const root = lazy.FileUtils.getDir("TmpD", []);
+    root.append("navis-upload-staging");
+    root.normalize();
+    const file = Services.io.newURI(uri).QueryInterface(Ci.nsIFileURL).file;
+    // file:// is not an authorization token: only our exact app-private staging subtree is valid.
+    if (file.isSymlink()) throw new Error("Symbolic upload path rejected");
+    file.normalize();
+    if (!root.contains(file) || !file.exists()) throw new Error("Upload path is outside staging");
+    const relative = file.path.substring(root.path.length + 1).split("/");
+    if (relative.length < 2 || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(relative[0])) {
+      throw new Error("Upload path has no selection owner");
+    }
+    for (let parent = file.parent; parent && !parent.equals(root); parent = parent.parent) {
+      if (parent.isSymlink()) throw new Error("Symbolic upload parent rejected");
+    }
+    this._activeStagedDirectories.add(`${root.path}/${relative[0]}`);
+    return file;
