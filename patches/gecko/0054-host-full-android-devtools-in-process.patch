--- /dev/null
+++ b/mobile/shared/modules/navis/NavisAndroidLocales.sys.mjs
@@ -0,0 +1,40 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { AddonManager } from "resource://gre/modules/AddonManager.sys.mjs";
+
+const ID = "langpack-zh-CN@firefox.mozilla.org";
+const BASE = "resource://android/assets/navis_locales/zh-CN/";
+let readiness;
+
+/** Installs only the immutable, build-verified copy of the shared desktop locale. */
+export function ensureNavisAndroidLocales() {
+  if (!readiness) {
+    readiness = (async () => {
+      await AddonManager.readyPromise;
+      const metadata = await (await fetch(BASE + "metadata.json")).json();
+      if (metadata.id !== ID || metadata.locale !== "zh-CN" || typeof metadata.version !== "string") {
+        throw new Error("The packaged Navis language metadata is invalid");
+      }
+      let addon = await AddonManager.getAddonByID(ID);
+      if (addon && addon.scope !== AddonManager.SCOPE_APPLICATION) {
+        throw new Error("The application locale ID belongs to another install scope");
+      }
+      if (!addon || addon.version !== metadata.version || addon.getResourceURI("").spec !== BASE) {
+        addon = await AddonManager.installBuiltinAddon(BASE);
+      }
+      if (addon.id !== ID || addon.type !== "locale" || addon.version !== metadata.version ||
+          addon.scope !== AddonManager.SCOPE_APPLICATION) {
+        throw new Error("The built-in Navis language pack is invalid");
+      }
+      if (addon.userDisabled) await addon.enable();
+      await addon.startupPromise;
+      if (!addon.isActive) throw new Error("The built-in Navis language pack did not start");
+    })().catch(error => {
+      readiness = undefined;
+      throw error;
+    });
+  }
+  return readiness;
+}
