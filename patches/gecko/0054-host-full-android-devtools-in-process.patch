index 0000000..ce1f9d0
--- /dev/null
+++ b/mobile/shared/modules/navis/NavisAndroidDevTools.sys.mjs
@@ -0,0 +1,106 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const TOOLS = new Set([
+  "inspector", "webconsole", "jsdebugger", "styleeditor", "netmonitor",
+  "storage", "memory", "performance", "accessibility", "application", "options",
+]);
+
+/** The shared Gecko toolbox, hosted by a Navis native window and local pipe. */
+export function createNavisAndroidDevTools(window) {
+  let frame;
+  let toolbox;
+  let client;
+  let commands;
+  let closed = false;
+  return {
+    async open(targetSessionId, tool) {
+      if (!Number.isSafeInteger(targetSessionId) || targetSessionId <= 0 || !TOOLS.has(tool)) {
+        throw new TypeError("Invalid developer tools target");
+      }
+      const targetWindow = [...Services.wm.getEnumerator("navigator:navis-android")]
+        .find(candidate => candidate.tab?.id === targetSessionId && !candidate.tab.isPopup);
+      const target = targetWindow?.browser;
+      if (!target?.browsingContext || targetWindow.closed) {
+        throw new Error("The inspected tab has closed");
+      }
+      const { PrivateBrowsingUtils } = ChromeUtils.importESModule(
+        "resource://gre/modules/PrivateBrowsingUtils.sys.mjs"
+      );
+      if (PrivateBrowsingUtils.isBrowserPrivate(target) !== PrivateBrowsingUtils.isWindowPrivate(window)) {
+        throw new Error("Developer tools privacy context must match the inspected tab");
+      }
+      const { ensureNavisAndroidLocales } = ChromeUtils.importESModule(
+        "resource://gre/modules/NavisAndroidLocales.sys.mjs"
+      );
+      await ensureNavisAndroidLocales();
+      if (closed) throw new Error("Developer tools host closed");
+
+      // This non-remote chrome frame is created only in a dedicated native host.
+      // Ordinary content never navigates to a privileged toolbox URL.
+      frame = window.document.createXULElement("browser");
+      frame.setAttribute("type", "content");
+      frame.setAttribute("flex", "1");
+      frame.setAttribute("disablehistory", "true");
+      frame.setAttribute("manualactiveness", "true");
+      frame.style.minWidth = "0";
+      frame.style.minHeight = "0";
+      window.document.documentElement.appendChild(frame);
+      const loaded = new Promise((resolve, reject) => {
+        const timer = window.setTimeout(() => reject(new Error("Toolbox document timed out")), 20_000);
+        frame.addEventListener("DOMContentLoaded", event => {
+          if (event.target.documentURI !== "about:devtools-toolbox") return;
+          window.clearTimeout(timer);
+          resolve();
+        }, { capture: true });
+      });
+      frame.loadURI(Services.io.newURI("about:devtools-toolbox"), {
+        triggeringPrincipal: Services.scriptSecurityManager.getSystemPrincipal(),
+      });
+      frame.docShellIsActive = true;
+      await loaded;
+      if (closed) throw new Error("Developer tools host closed");
+
+      const { require } = ChromeUtils.importESModule(
+        "resource://devtools/shared/loader/Loader.sys.mjs"
+      );
+      const { DevToolsServer } = require("devtools/server/devtools-server");
+      const { DevToolsClient } = require("devtools/client/devtools-client");
+      const { CommandsFactory } = require("devtools/shared/commands/commands-factory");
+      const { gDevTools } = require("devtools/client/framework/devtools");
+      const { Toolbox } = require("devtools/client/framework/toolbox");
+      DevToolsServer.init();
+      DevToolsServer.registerAllActors();
+      DevToolsServer.chromeWindowType = "navigator:navis-android";
+      DevToolsServer.setRootActor(require("resource://gre/modules/dbg-browser-actors.js").createRootActor);
+      client = new DevToolsClient(DevToolsServer.connectPipe());
+      await client.connect();
+      commands = await CommandsFactory.forRemoteTab(target.browserId, { client });
+      if (closed) {
+        await commands.destroy();
+        throw new Error("Developer tools host closed");
+      }
+      toolbox = await gDevTools.showToolbox(commands, {
+        toolId: tool,
+        hostType: Toolbox.HostType.PAGE,
+        hostOptions: { customIframe: frame },
+      });
+      if (closed) {
+        await toolbox.destroy();
+        throw new Error("Developer tools host closed");
+      }
+      window.document.title = "Developer tools";
+      console.info("NavisAndroid DevTools ready", { targetSessionId, tool, transport: "pipe" });
+    },
+    close() {
+      if (closed) return;
+      closed = true;
+      // Toolbox destruction releases its commands/client and target actors.
+      const cleanup = toolbox ? toolbox.destroy() : commands ? commands.destroy() : client?.close();
+      Promise.resolve(cleanup).catch(Cu.reportError);
+      frame?.remove();
+      frame = null;
+    },
+  };
+}
diff --git a/mobile/shared/modules/navis/NavisAndroidLocales.sys.mjs b/mobile/shared/modules/navis/NavisAndroidLocales.sys.mjs
new file mode 100644
