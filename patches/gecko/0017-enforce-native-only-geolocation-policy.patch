diff --git a/dom/geolocation/MLSFallback.cpp b/dom/geolocation/MLSFallback.cpp
index 366ece527c9d..c58f7d108ce2 100644
--- a/dom/geolocation/MLSFallback.cpp
+++ b/dom/geolocation/MLSFallback.cpp
@@ -6,6 +6,8 @@
 
 #include "GeolocationPosition.h"
 #include "mozilla/Logging.h"
+#include "mozilla/StaticPrefs_geo.h"
+#include "mozilla/dom/GeolocationPositionErrorBinding.h"
 #include "mozilla/glean/DomGeolocationMetrics.h"
 #include "nsComponentManagerUtils.h"
 #include "nsIGeolocationProvider.h"
@@ -40,6 +42,14 @@ nsresult MLSFallback::Startup(nsIGeolocationUpdate* aWatcher,
 
   mUpdateWatcher = aWatcher;
 
+  // A native-only product still needs the delayed fallback object as a
+  // watchdog for native providers that never answer. It must report the
+  // standard unavailable result instead of creating the network provider.
+  if (mozilla::StaticPrefs::geo_provider_native_only() && mDelayMs == 0) {
+    mUpdateWatcher = nullptr;
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+
   // No need to schedule a timer callback if there is no startup delay.
   if (mDelayMs == 0) {
     mozilla::glean::geolocation::fallback.EnumGet(MapReasonToLabel(aReason))
@@ -75,6 +85,15 @@ nsresult MLSFallback::Shutdown(ShutdownReason aReason) {
 
 NS_IMETHODIMP
 MLSFallback::Notify(nsITimer* aTimer) {
+  if (mozilla::StaticPrefs::geo_provider_native_only()) {
+    nsCOMPtr<nsIGeolocationUpdate> watcher = mUpdateWatcher;
+    mUpdateWatcher = nullptr;
+    return watcher ? watcher->NotifyError(
+                         mozilla::dom::GeolocationPositionError_Binding::
+                             POSITION_UNAVAILABLE)
+                   : NS_OK;
+  }
+
   mozilla::glean::geolocation::fallback
       .EnumGet(mozilla::glean::geolocation::FallbackLabel::eOnTimeout)
       .Add();
@@ -88,6 +107,10 @@ MLSFallback::GetName(nsACString& aName) {
 }
 
 nsresult MLSFallback::CreateMLSFallbackProvider() {
+  if (mozilla::StaticPrefs::geo_provider_native_only()) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+
   if (mMLSFallbackProvider || !mUpdateWatcher) {
     return NS_OK;
   }
diff --git a/dom/system/linux/GeoclueLocationProvider.cpp b/dom/system/linux/GeoclueLocationProvider.cpp
index d553c5e96729..f559ac0c7c4e 100644
--- a/dom/system/linux/GeoclueLocationProvider.cpp
+++ b/dom/system/linux/GeoclueLocationProvider.cpp
@@ -342,6 +342,10 @@ void GCLocProviderPriv::UpdateLastPosition() {
 }
 
 nsresult GCLocProviderPriv::FallbackToMLS(MLSFallback::FallbackReason aReason) {
+  if (StaticPrefs::geo_provider_native_only()) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+
   GCL_LOG(Debug, "trying to fall back to MLS");
   StopMLSFallback();
 
@@ -911,6 +915,10 @@ void GCLocProviderPriv::MLSFallbackTimerFired() {
   GCL_LOG(Info,
           "Didn't get a location in a reasonable amount of time, trying to "
           "fall back to MLS");
+  if (StaticPrefs::geo_provider_native_only()) {
+    NotifyError(GeolocationPositionError_Binding::POSITION_UNAVAILABLE);
+    return;
+  }
   FallbackToMLS(MLSFallback::FallbackReason::Timeout);
 }
 
