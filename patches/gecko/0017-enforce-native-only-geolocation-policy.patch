diff --git a/modules/libpref/init/StaticPrefList.yaml b/modules/libpref/init/StaticPrefList.yaml
index 239164bb2c79..da98252cf7c7 100644
--- a/modules/libpref/init/StaticPrefList.yaml
+++ b/modules/libpref/init/StaticPrefList.yaml
@@ -7079,6 +7079,15 @@
   value: 6000
   mirror: always
 
+# If true, geolocation may use only the operating-system provider. The
+# network provider and the network fallback used by Linux providers are not
+# selected. Products enabling this policy receive POSITION_UNAVAILABLE when
+# the native provider cannot supply a position.
+- name: geo.provider.native_only
+  type: bool
+  value: false
+  mirror: always
+
 #ifdef MOZ_ENABLE_DBUS
 # Whether to use Geoclue location provider (if available on the system).
 - name: geo.provider.use_geoclue
