From 75efc3640d9fd81e28804001990bea0259a70b41 Mon Sep 17 00:00:00 2001
From: willvar <0@willvar.tw>
Date: Sat, 29 Aug 2026 23:20:00 +0800
Subject: [PATCH] Retain the certificate decoder without its Firefox frontend

---
 toolkit/components/certviewer/jar.mn    |  7 +++++++
 toolkit/components/certviewer/moz.build | 15 ++++++++-------
 toolkit/components/moz.build            |  1 -
 3 files changed, 14 insertions(+), 7 deletions(-)

diff --git a/toolkit/components/certviewer/jar.mn b/toolkit/components/certviewer/jar.mn
--- a/toolkit/components/certviewer/jar.mn
+++ b/toolkit/components/certviewer/jar.mn
@@ -3,6 +3,12 @@
 # file, You can obtain one at http://mozilla.org/MPL/2.0/.
 
 toolkit.jar:
+#ifdef MOZ_DESKTOP_EMBEDDER
+  content/global/certviewer/certDecoder.mjs  (content/certDecoder.mjs)
+  content/global/certviewer/components/utils.mjs  (content/components/utils.mjs)
+  content/global/certviewer/components/logNameTable.mjs  (content/components/logNameTable.mjs)
+  content/global/certviewer/vendor/pkijs.js  (content/vendor/pkijs.js)
+#else
   content/global/certviewer/certviewer.html  (content/certviewer.html)
   content/global/certviewer/certviewer.css   (content/certviewer.css)
   content/global/certviewer/certviewer.mjs   (content/certviewer.mjs)
@@ -10,3 +16,4 @@ toolkit.jar:
   content/global/certviewer/components/      (content/components/*.css)
   content/global/certviewer/certDecoder.mjs  (content/certDecoder.mjs)
   content/global/certviewer/vendor/pkijs.js  (content/vendor/pkijs.js)
+#endif
diff --git a/toolkit/components/certviewer/moz.build b/toolkit/components/certviewer/moz.build
--- a/toolkit/components/certviewer/moz.build
+++ b/toolkit/components/certviewer/moz.build
@@ -4,14 +4,15 @@
 
 JAR_MANIFESTS += ["jar.mn"]
 
-BROWSER_CHROME_MANIFESTS += ["tests/browser/browser.toml"]
+if not CONFIG["MOZ_DESKTOP_EMBEDDER"]:
+    BROWSER_CHROME_MANIFESTS += ["tests/browser/browser.toml"]
 
-MOCHITEST_CHROME_MANIFESTS += ["tests/chrome/chrome.toml"]
+    MOCHITEST_CHROME_MANIFESTS += ["tests/chrome/chrome.toml"]
 
-EXTRA_JS_MODULES += [
-    "AboutCertViewerChild.sys.mjs",
-    "AboutCertViewerParent.sys.mjs",
-]
+    EXTRA_JS_MODULES += [
+        "AboutCertViewerChild.sys.mjs",
+        "AboutCertViewerParent.sys.mjs",
+    ]
 
 with Files("**"):
     BUG_COMPONENT = ("Firefox", "Security")
diff --git a/toolkit/components/moz.build b/toolkit/components/moz.build
--- a/toolkit/components/moz.build
+++ b/toolkit/components/moz.build
@@ -101,7 +101,6 @@ if CONFIG["MOZ_DESKTOP_EMBEDDER"]:
         "aboutprocesses",
         "bitsdownload",
         "captchadetection",
-        "certviewer",
         "cookiebanners",
         "contentrelevancy",
         "contextualidentity",
-- 
2.55.0
