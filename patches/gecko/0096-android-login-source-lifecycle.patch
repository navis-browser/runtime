+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Parent-process authority, never page-supplied origins or URL heuristics.
+// A chrome host can outlive many remote documents, so its Window is not a
+// sufficient lifetime for a form candidate or an autocomplete selection.
+const owners = new Map();
+const invocation = new WeakMap();
+const EMPTY_PROMPT = Object.freeze({ dismiss() {} });
+
+function origin(global) {
+  return global?.documentPrincipal?.originNoSuffix ?? null;
+}
+
+function valid(capture) {
+  if (!capture?.live) return false;
+  try {
+    const { browser, context, global, kind, landing } = capture;
+    const top = browser.browsingContext;
+    if (!owners.has(browser) || !top || top.isDiscarded ||
+        (kind !== "select" && top.originAttributes.privateBrowsingId > 0) ||
+        browser.navisNativePresentation) return false;
+    // Auth challenges are attested by LoginManagerAuthPrompter, not inferred
+    // from an httpRealm string on an arbitrary form candidate. Their channel
+    // cancellation policy is intentionally unchanged in this form-lifetime patch.
+    if (kind === "auth") return true;
+    // Once a submission's replacement document has been observed, going back
+    // to an older WindowGlobal must not resurrect that capture.
+    if (landing) return landing.browsingContext.top === top && landing.isCurrentGlobal && landing.browsingContext.ancestorsAreCurrent &&
+      !landing.browsingContext.isInBFCache && !landing.browsingContext.isDiscarded;
+    if (context.top === top && !context.isDiscarded && context.currentWindowGlobal === global &&
+        global.isCurrentGlobal && context.ancestorsAreCurrent && !context.isInBFCache) return true;
+    if (kind !== "save" || !["form-submit-event", "page-navigation", "iframe-pagehide"].includes(capture.reason)) return false;
+    // The final parent-side DocumentLoadListener channel retains the initiating
+    // document's innerWindowId across HTTP redirects. RemoteWebProgressRequest
+    // does NOT implement loadInfo and must not be used as a substitute here.
+    for (const target of new Set([context, top])) {
+      // COOP can replace the top BrowsingContext of the same product browser.
+      // Only the new context's real initiating channel may retain a Save token;
+      // it never makes a Select token transferable to a replacement document.
+      if (target.top !== top || target.isDiscarded || target.isInBFCache || !target.ancestorsAreCurrent) continue;
+      const current = target.currentWindowGlobal;
+      if (!current?.isCurrentGlobal) continue;
+      const info = current.documentChannel?.loadInfo;
+      if (!info || info.triggeringWindowId !== global.innerWindowId) continue;
+      if (capture.reason === "form-submit-event" && !info.isFormSubmission) continue;
+      capture.landing = current;
+      return true;
+    }
+  } catch (_) {
+    // Missing/dead authoritative engine objects are not a licence to persist.
+  }
+  return false;
+}
+
+function release(capture, dismiss = false) {
+  if (!capture?.live) return;
+  capture.live = false;
+  const state = owners.get(capture.browser);
+  state?.captures.delete(capture.token);
+  if (state?.save === capture) state.save = null;
+  const prompt = capture.prompt;
+  capture.prompt = null;
+  if (dismiss) prompt?.dismiss();
+}
+
+function sweep(browser) {
+  for (const capture of [...(owners.get(browser)?.captures.values() ?? [])]) {
+    if (!valid(capture)) release(capture, true);
+  }
+}
+
+function create(actor, browser, kind, reason) {
+  const state = owners.get(browser);
+  if (!state) return null;
+  try {
+    const context = actor.browsingContext;
+    const global = actor.manager;
+    if (!global?.innerWindowId || context.top !== browser.browsingContext ||
+        !/^https?:\/\//.test(origin(global) ?? "")) return null;
+    const capture = { browser, context, global, top: context.top, kind, reason,
+      origin: origin(global), landing: null, live: true, prompt: null,
+      token: Services.uuid.generateUUID().toString().replaceAll(/[{}-]/g, "") };
+    if (!valid(capture)) return null;
+    // An old actor can arrive after a newer document has already offered a
+    // candidate. Its valid original submission is not authority to replace
+    // that newer prompt. Validate *before* touching the current owner.
+    if (kind === "save" && capture.landing && state.save && valid(state.save)) return null;
+    if (kind === "save") release(state.save, true);
+    if (state.captures.size >= 32) return null;
+    state.captures.set(capture.token, capture);
+    if (kind === "save") state.save = capture;
+    return capture;
+  } catch (_) { return null; }
+}
+
+export const NavisAndroidLoginLifecycle = Object.freeze({
+  attach(browser) {
+    if (owners.has(browser)) return;
+    const listener = {
+      QueryInterface: ChromeUtils.generateQI(["nsIWebProgressListener", "nsISupportsWeakReference"]),
+      onLocationChange(_progress, _request, _uri, flags) {
+        if (!(flags & Ci.nsIWebProgressListener.LOCATION_CHANGE_SAME_DOCUMENT)) sweep(browser);
+      },
+      onStateChange(_progress, _request, flags) {
+        if (flags & Ci.nsIWebProgressListener.STATE_STOP) sweep(browser);
+      },
+    };
+    owners.set(browser, { captures: new Map(), save: null, listener });
+    browser.addProgressListener(listener, Ci.nsIWebProgress.NOTIFY_LOCATION | Ci.nsIWebProgress.NOTIFY_STATE_NETWORK);
+  },
+  detach(browser) {
+    const state = owners.get(browser);
+    if (!state) return;
+    for (const capture of [...state.captures.values()]) release(capture, true);
+    owners.delete(browser);
+    browser.removeProgressListener(state.listener);
+  },
+  createSave: (actor, browser, reason = "edit") => create(actor, browser, "save", reason),
+  createSelection: (actor, browser) => create(actor, browser, "select", "selection"),
+  valid,
+  release,
+  reconcile: sweep,
+  bind(capture, prompt, loginOrigin, httpRealm = null) {
+    if (!valid(capture) || (loginOrigin !== undefined && loginOrigin !== capture.origin)) return false;
+    if (capture.kind === "auth" ? httpRealm !== capture.realm : httpRealm !== null) return false;
+    capture.prompt = prompt;
+    return true;
+  },
+  current: browser => invocation.get(browser) ?? null,
+  authPrompter(prompter, browser, login) {
+    const state = owners.get(browser);
+    if (!state || typeof login.httpRealm !== "string" || login.formActionOrigin !== null) return this.wrapPrompter(prompter, browser, null);
+    release(state.save, true);
+    const capture = { browser, top: browser.browsingContext, kind: "auth", live: true,
+      origin: login.origin, realm: login.httpRealm, prompt: null,
+      token: Services.uuid.generateUUID().toString().replaceAll(/[{}-]/g, "") };
+    state.captures.set(capture.token, capture);
+    state.save = capture;
+    return this.wrapPrompter(prompter, browser, capture);
+  },
+  wrapPrompter(prompter, browser, capture) {
+    const result = {};
+    for (const method of ["promptToSavePassword", "promptToChangePassword", "promptToChangePasswordWithUsernames"]) {
+      result[method] = (...args) => {
+        if (!valid(capture)) { release(capture, true); return EMPTY_PROMPT; }
+        const previous = invocation.get(browser);
+        invocation.set(browser, capture);
+        try { return prompter[method](...args); }
+        finally {
+          if (previous) invocation.set(browser, previous);
+          else invocation.delete(browser);
+        }
+      };
+    }
+    return result;
+  },
+  authorizeSave(browser, token) {
+    if (typeof token !== "string" || !/^[a-f0-9]{32}$/.test(token)) return false;
+    const capture = owners.get(browser)?.captures.get(token);
+    if (!["save", "auth"].includes(capture?.kind) || !valid(capture)) {
+      release(capture, true);
+      return false;
+    }
+    return true;
+  },
+});
