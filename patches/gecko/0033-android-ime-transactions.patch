+package org.mozilla.gecko.navis;
+
+import android.content.Context;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.RemoteException;
+import android.text.Editable;
+import android.text.InputType;
+import android.text.Selection;
+import android.text.SpannableStringBuilder;
+import android.util.Log;
+import android.view.KeyEvent;
+import android.view.KeyCharacterMap;
+import android.view.View;
+import android.view.inputmethod.BaseInputConnection;
+import android.view.inputmethod.EditorInfo;
+import android.view.inputmethod.InputConnection;
+import android.view.inputmethod.InputMethodManager;
+import java.util.ArrayDeque;
+import java.util.Objects;
+import org.mozilla.gecko.IGeckoEditableChild;
+import org.mozilla.gecko.IGeckoEditableParent;
+import org.mozilla.gecko.annotation.WrapForJNI;
+import org.mozilla.gecko.util.ThreadUtils;
+
+/**
+ * Navis-owned Android IME peer backed by GeckoEditableChild.
+ *
+ * <p>This class intentionally exposes only Android platform input types. The binder protocol and
+ * generated-JNI constants remain private engine details, with no GeckoSession or SessionTextInput
+ * owner in the direct runtime graph.
+ */
+final class NavisAndroidTextInput extends IGeckoEditableParent.Stub {
+  private static final String LOGTAG = "NavisAndroidIME";
+
+  interface EditableClient {
+    @WrapForJNI int ONE_SHOT = 1;
+    @WrapForJNI int START_MONITOR = 2;
+    @WrapForJNI int END_MONITOR = 3;
+  }
+
+  interface EditableListener {
+    @WrapForJNI int NOTIFY_IME_OF_TOKEN = -3;
+    @WrapForJNI int NOTIFY_IME_OPEN_VKB = -2;
+    @WrapForJNI int NOTIFY_IME_REPLY_EVENT = -1;
+    @WrapForJNI int NOTIFY_IME_OF_FOCUS = 1;
+    @WrapForJNI int NOTIFY_IME_OF_BLUR = 2;
+    @WrapForJNI int NOTIFY_IME_TO_COMMIT_COMPOSITION = 8;
+    @WrapForJNI int NOTIFY_IME_TO_CANCEL_COMPOSITION = 9;
+
+    @WrapForJNI int IME_FLAG_PRIVATE_BROWSING = 1 << 0;
+    @WrapForJNI int IME_FLAG_USER_ACTION = 1 << 1;
+    @WrapForJNI int IME_FOCUS_NOT_CHANGED = 1 << 2;
+  }
+
+  interface Host {
+    void getClientToScreenOffset(android.graphics.Matrix matrix);
+  }
+
+  private static final int IME_STATE_UNKNOWN = -1;
+  private static final int IME_STATE_DISABLED = 0;
+  private static final int IME_STATE_ENABLED = 1;
+  private static final int IME_STATE_PASSWORD = 2;
+
+  private static final int IME_RANGE_CARETPOSITION = 1;
+  private static final int IME_RANGE_RAWINPUT = 2;
+  private static final int IME_RANGE_UNDERLINE = 1;
+  private static final int IME_RANGE_LINE_SOLID = 1;
+
+  private final Host mHost;
+  private final Handler mUiHandler = ThreadUtils.getUiHandler();
+  // Follow GeckoEditable's current/shadow ownership: only native notifications
+  // change confirmed text; only InputConnection changes the optimistic shadow.
+  // Both sides run on our single IC/UI handler, but replies remain asynchronous.
+  private final SpannableStringBuilder mCurrentText = new SpannableStringBuilder();
+  private final SpannableStringBuilder mText = new SpannableStringBuilder();
+  private final ArrayDeque<PendingAction> mActions = new ArrayDeque<>();
+
+  private View mView;
+  private volatile InputConnectionImpl mConnection;
+  private IGeckoEditableChild mDefaultChild;
+  private IGeckoEditableChild mFocusedChild;
+  private IBinder mFocusedToken;
+  private int mImeState = IME_STATE_DISABLED;
+  private String mTypeHint = "";
+  private String mModeHint = "";
+  private String mActionHint = "";
+  private String mAutocapitalize = "";
+  private boolean mAutocorrect;
+  private volatile boolean mClosed;
+  private long mEditorGeneration;
+  private int mBatchDepth;
+  private int mEditDepth;
+  private boolean mNeedSync;
+  private boolean mHasComposition;
+  private boolean mSyncScheduled;
+  private boolean mAwaitingSelection;
+
+  private static final class PendingAction {
+    final long generation;
+    final IBinder token;
+
+    PendingAction(final long generation, final IBinder token) {
+      this.generation = generation;
+      this.token = token;
+    }
+  }
+
+  @FunctionalInterface
+  private interface ChildAction {
+    void run(IGeckoEditableChild child) throws RemoteException;
+  }
+
+  NavisAndroidTextInput(final Host host) {
+    mHost = Objects.requireNonNull(host, "host");
+    Selection.setSelection(mCurrentText, 0);
+    Selection.setSelection(mText, 0);
+  }
+
+  void setView(final View view) {
+    ThreadUtils.assertOnUiThread();
+    if (mClosed || mView == view) {
+      return;
+    }
+    if (mConnection != null) mConnection.mClosed = true;
+    mView = view;
+    mConnection = null;
+    mBatchDepth = 0;
+    if (view == null) {
+      // Retain native focus/confirmed state across Surface recreation, but a
+      // detached Android InputConnection must never write into a replacement.
+      BaseInputConnection.removeComposingSpans(mText);
+    }
+    restartInput(false);
+  }
+
+  void close() {
+    ThreadUtils.assertOnUiThread();
+    if (mClosed) return;
+    mClosed = true;
+    if (mConnection != null) mConnection.mClosed = true;
+    mConnection = null;
+    mView = null;
+    mDefaultChild = mFocusedChild = null;
+    mFocusedToken = null;
+    resetEditor();
+  }
+
+  private boolean onInputThread() {
+    return Looper.myLooper() == mUiHandler.getLooper();
+  }
+
+  private void postCallback(final Runnable callback) {
+    // Even in-process native callbacks are queued, never reentrant inside a
+    // BaseInputConnection edit or a partially submitted native transaction.
+    if (!mClosed) mUiHandler.post(() -> { if (!mClosed) callback.run(); });
+  }
+
+  private void resetEditor() {
+    mEditorGeneration++;
+    mActions.clear();
+    mBatchDepth = 0;
+    mNeedSync = false;
+    mHasComposition = false;
+    mAwaitingSelection = false;
+    if (mConnection != null) mConnection.mClosed = true;
+    mConnection = null;
+    mCurrentText.clear();
+    mCurrentText.clearSpans();
+    mText.clear();
+    mText.clearSpans();
+    Selection.setSelection(mCurrentText, 0);
+    Selection.setSelection(mText, 0);
+  }
+
+  Handler getHandler(final Handler defaultHandler) {
+    synchronized (this) {
+      return mConnection == null ? defaultHandler : mUiHandler;
+    }
+  }
+
+  InputConnection onCreateInputConnection(final EditorInfo attributes) {
+    Objects.requireNonNull(attributes, "attributes");
+    if (!onInputThread() || mClosed) return null;
+    // Android obtains the new connection before deactivating/closing the old
+    // one. Never reuse a permanently closable IC across that restart boundary.
+    // Keep the editor text and native reply queue; only the old IC/batch ends.
+    if (mConnection != null) mConnection.mClosed = true;
+    mConnection = null;
+    mBatchDepth = 0;
+    synchronizeShadow();
+    configureEditorInfo(attributes);
+    if (mImeState == IME_STATE_DISABLED || mView == null || mFocusedChild == null) return null;
+    mConnection = new InputConnectionImpl(mView);
+    return mConnection;
+  }
+
+  boolean onKeyPreIme(final int keyCode, final KeyEvent event) {
+    // Let Android's IME process the key first, as GeckoEditable does. A consumed
+    // pre-IME key must not also bypass the IME and modify Gecko's editor.
+    return false;
+  }
+
+  boolean onKeyDown(final int keyCode, final KeyEvent event) {
+    return sendKeyEvent(event);
+  }
+
+  boolean onKeyUp(final int keyCode, final KeyEvent event) {
+    return sendKeyEvent(event);
+  }
+
+  boolean onKeyLongPress(final int keyCode, final KeyEvent event) {
+    return false;
+  }
+
+  boolean onKeyMultiple(final int keyCode, final int repeatCount, final KeyEvent event) {
+    if (!onInputThread() || mClosed || event == null) return false;
+    if (keyCode == KeyEvent.KEYCODE_UNKNOWN) {
+      final String characters = event.getCharacters();
+      if (characters == null || characters.isEmpty()) return false;
+      final KeyEvent[] events = KeyCharacterMap.load(KeyCharacterMap.VIRTUAL_KEYBOARD)
+          .getEvents(characters.toCharArray());
+      if (events != null) {
+        for (final KeyEvent key : events) if (!sendKeyEvent(key)) return false;
+        return true;
+      }
+      // Non-keyboard Unicode (including non-BMP text) remains a real IME edit,
+      // not a fabricated key code or a native ACTION_MULTIPLE crash.
+      // This is not a framework restart: preserve the keyboard's served IC.
+      final InputConnection connection = mConnection != null && mConnection.valid()
+          ? mConnection : onCreateInputConnection(new EditorInfo());
+      return connection != null && connection.commitText(characters, 1);
+    }
+    for (int index = 0; index < repeatCount; index++) {
+      if (!sendKeyEvent(KeyEvent.changeAction(event, KeyEvent.ACTION_DOWN))
+          || !sendKeyEvent(KeyEvent.changeAction(event, KeyEvent.ACTION_UP))) return false;
+    }
+    return repeatCount > 0;
+  }
+
+  // Match GeckoEditable: Android owns these keys. Returning false lets the
+  // IME, Activity back dispatcher and system handle them in their usual order.
+  static boolean shouldProcessKey(final int keyCode) {
+    switch (keyCode) {
+      case KeyEvent.KEYCODE_MENU:
+      case KeyEvent.KEYCODE_BACK:
+      case KeyEvent.KEYCODE_FORWARD:
+      case KeyEvent.KEYCODE_VOLUME_UP:
+      case KeyEvent.KEYCODE_VOLUME_DOWN:
+      case KeyEvent.KEYCODE_VOLUME_MUTE:
+      case KeyEvent.KEYCODE_SEARCH:
+      case KeyEvent.KEYCODE_HEADSETHOOK:
+        return false;
+      default:
+        return true;
+    }
+  }
+
+  private boolean sendKeyEvent(final KeyEvent event) {
+    if (event == null || !shouldProcessKey(event.getKeyCode())
+        || !onInputThread() || mClosed || mView == null) {
+      return false;
+    }
+    if (event.getAction() == KeyEvent.ACTION_MULTIPLE) {
+      return onKeyMultiple(event.getKeyCode(), event.getRepeatCount(), event);
+    }
+    if (event.getAction() != KeyEvent.ACTION_DOWN && event.getAction() != KeyEvent.ACTION_UP) return false;
+    final IGeckoEditableChild child = currentChild();
+    if (child == null) {
+      return false;
+    }
+    final ChildAction key = target -> {
+      if (event.getAction() == KeyEvent.ACTION_DOWN && mHasComposition) {
+        target.onImeRequestCommit();
+        mHasComposition = false;
+        BaseInputConnection.removeComposingSpans(mText);
+      }
+      target.onKeyEvent(
+          event.getAction(),
+          event.getKeyCode(),
+          event.getScanCode(),
+          event.getMetaState(),
+          event.getMetaState(),
+          event.getEventTime(),
+          event.getUnicodeChar(),
+          event.getRepeatCount(),
+          event.getFlags(),
+          false,
+          false,
+          event);
+    };
+    if (mFocusedChild != null) return submit(key, true);
+    try { key.run(child); return true; }
+    catch (final RemoteException error) { return false; }
+  }
+
+  private boolean submit(final ChildAction operation, final boolean synchronize) {
+    final IGeckoEditableChild child = mFocusedChild;
+    if (mClosed || mView == null || child == null || mFocusedToken == null) return false;
+    final PendingAction action = new PendingAction(mEditorGeneration, mFocusedToken);
+    mActions.addLast(action);
+    mNeedSync = true;
+    try {
+      operation.run(child);
+      // ReplaceText replies itself. Keys/selection/commit require this barrier.
+      if (synchronize) child.onImeSynchronize();
+      return true;
+    } catch (final RemoteException error) {
+      mActions.remove(action);
+      Log.e(LOGTAG, "Unable to submit Android input transaction", error);
+      synchronizeShadow();
+      return false;
+    }
+  }
+
+  private void synchronizeShadow() {
+    if (!mNeedSync || mClosed || !mActions.isEmpty() || mBatchDepth != 0 || mEditDepth != 0
+        || mAwaitingSelection) return;
+    mNeedSync = false;
+    // Pending edits are never overwritten by older Gecko notifications. Once
+    // all replies arrive, Gecko wins, including script-normalized/rejected input.
+    if (!mText.toString().contentEquals(mCurrentText)) {
+      mText.replace(0, mText.length(), mCurrentText);
+      BaseInputConnection.removeComposingSpans(mText);
+      mHasComposition = false;
+    }
+    Selection.setSelection(mText, Selection.getSelectionStart(mCurrentText),
+        Selection.getSelectionEnd(mCurrentText));
+    final InputMethodManager manager = inputMethodManager();
+    if (manager != null && mView != null) {
+      manager.updateSelection(mView, Selection.getSelectionStart(mText), Selection.getSelectionEnd(mText),
+          BaseInputConnection.getComposingSpanStart(mText), BaseInputConnection.getComposingSpanEnd(mText));
+    }
+  }
+
+  private void scheduleShadowSync() {
+    if (mSyncScheduled || mClosed) return;
+    mSyncScheduled = true;
+    mUiHandler.post(() -> {
+      mSyncScheduled = false;
+      synchronizeShadow();
+    });
+  }
+
+  private void configureEditorInfo(final EditorInfo attributes) {
+    attributes.inputType = InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE;
+    if (mImeState == IME_STATE_PASSWORD || "password".equalsIgnoreCase(mTypeHint)) {
+      attributes.inputType =
+          InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_PASSWORD;
+    } else if ("email".equalsIgnoreCase(mTypeHint)) {
+      attributes.inputType =
+          InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_EMAIL_ADDRESS;
+    } else if ("url".equalsIgnoreCase(mTypeHint)) {
+      attributes.inputType = InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_URI;
+    } else if ("number".equalsIgnoreCase(mTypeHint)
+        || "numeric".equalsIgnoreCase(mModeHint)
+        || "decimal".equalsIgnoreCase(mModeHint)) {
+      attributes.inputType = InputType.TYPE_CLASS_NUMBER;
+      if ("decimal".equalsIgnoreCase(mModeHint)) {
+        attributes.inputType |= InputType.TYPE_NUMBER_FLAG_DECIMAL;
+      }
+    } else if ("tel".equalsIgnoreCase(mTypeHint)) {
+      attributes.inputType = InputType.TYPE_CLASS_PHONE;
+    }
+
+    if (!mAutocorrect) {
+      attributes.inputType |= InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS;
+    }
+    if ("sentences".equalsIgnoreCase(mAutocapitalize)) {
+      attributes.inputType |= InputType.TYPE_TEXT_FLAG_CAP_SENTENCES;
+    } else if ("words".equalsIgnoreCase(mAutocapitalize)) {
+      attributes.inputType |= InputType.TYPE_TEXT_FLAG_CAP_WORDS;
+    } else if ("characters".equalsIgnoreCase(mAutocapitalize)) {
+      attributes.inputType |= InputType.TYPE_TEXT_FLAG_CAP_CHARACTERS;
+    }
+
+    if ("go".equalsIgnoreCase(mActionHint)) {
+      attributes.imeOptions = EditorInfo.IME_ACTION_GO;
+    } else if ("next".equalsIgnoreCase(mActionHint)) {
+      attributes.imeOptions = EditorInfo.IME_ACTION_NEXT;
+    } else if ("search".equalsIgnoreCase(mActionHint)) {
+      attributes.imeOptions = EditorInfo.IME_ACTION_SEARCH;
+    } else if ("send".equalsIgnoreCase(mActionHint)) {
+      attributes.imeOptions = EditorInfo.IME_ACTION_SEND;
+    } else if ("done".equalsIgnoreCase(mActionHint)) {
+      attributes.imeOptions = EditorInfo.IME_ACTION_DONE;
+    } else {
+      attributes.imeOptions = EditorInfo.IME_ACTION_NONE;
+    }
+    attributes.initialSelStart = Math.max(0, Selection.getSelectionStart(mText));
+    attributes.initialSelEnd = Math.max(0, Selection.getSelectionEnd(mText));
+  }
+
+  private InputMethodManager inputMethodManager() {
+    final View view = mView;
+    if (view == null) {
+      return null;
+    }
+    return (InputMethodManager) view.getContext().getSystemService(Context.INPUT_METHOD_SERVICE);
+  }
+
+  private void restartInput(final boolean show) {
+    final View expectedView = mView;
+    final long generation = mEditorGeneration;
+    mUiHandler.post(
+        () -> {
+          final View view = mView;
+          final InputMethodManager manager = inputMethodManager();
+          if (mClosed || view == null || view != expectedView || generation != mEditorGeneration || manager == null) {
+            return;
+          }
+          manager.restartInput(view);
+          if (show && view.hasFocus()) {
+            manager.showSoftInput(view, InputMethodManager.SHOW_IMPLICIT);
+          }
+        });
+  }
+
+  private void hideSoftInput() {
+    final View expectedView = mView;
+    final long generation = mEditorGeneration;
+    mUiHandler.post(
+        () -> {
+          final View view = mView;
+          final InputMethodManager manager = inputMethodManager();
+          if (!mClosed && view != null && view == expectedView && generation == mEditorGeneration && manager != null) {
+            manager.hideSoftInputFromWindow(view.getWindowToken(), 0);
+          }
+        });
+  }
+
+  private IGeckoEditableChild currentChild() {
+    return mFocusedChild != null ? mFocusedChild : mDefaultChild;
+  }
+
+  private boolean accepts(final IBinder token, final boolean allowDefault) {
+    return token != null
+        && (token == mFocusedToken
+            || (allowDefault && mFocusedToken == null && mDefaultChild != null
+                && token == mDefaultChild.asBinder()));
+  }
+
+  @Override
+  public void setDefaultChild(final IGeckoEditableChild child) {
+    postCallback(() -> mDefaultChild = child);
+  }
+
+  @Override
+  public void notifyIME(final IGeckoEditableChild child, final int type) {
+    final IBinder token = child == null ? null : child.asBinder();
+    postCallback(() -> {
+      if (type == EditableListener.NOTIFY_IME_OF_TOKEN) {
+        // A token is an editor-focus boundary, including a different editor
+        // within the same process/binder. No old IC or action crosses it.
+        resetEditor();
+        mFocusedChild = null;
+        mFocusedToken = token;
+        return;
+      }
+      if (type != EditableListener.NOTIFY_IME_OPEN_VKB && !accepts(token, true)) {
+        return;
+      }
+      if (type == EditableListener.NOTIFY_IME_OF_FOCUS) {
+        mFocusedChild = child;
+      } else if (type == EditableListener.NOTIFY_IME_OF_BLUR) {
+        mFocusedChild = null;
+        mFocusedToken = null;
+        mImeState = IME_STATE_DISABLED;
+        resetEditor();
+      }
+
+      switch (type) {
+      case EditableListener.NOTIFY_IME_OF_FOCUS:
+        restartInput(true);
+        break;
+      case EditableListener.NOTIFY_IME_OF_BLUR:
+        hideSoftInput();
+        break;
+      case EditableListener.NOTIFY_IME_OPEN_VKB:
+        restartInput(true);
+        break;
+      case EditableListener.NOTIFY_IME_TO_COMMIT_COMPOSITION:
+      case EditableListener.NOTIFY_IME_TO_CANCEL_COMPOSITION:
+        // Gecko has already committed/cancelled. Do not echo another request.
+        BaseInputConnection.removeComposingSpans(mText);
+        mHasComposition = false;
+        mNeedSync = true;
+        scheduleShadowSync();
+        break;
+      case EditableListener.NOTIFY_IME_REPLY_EVENT:
+        final PendingAction action = mActions.peekFirst();
+        if (action != null && action.generation == mEditorGeneration && action.token == token) {
+          mActions.removeFirst();
+          // FlushIMEChanges sends text, ordered replies, then selection.
+          // Queue the sync behind that batch instead of exposing old selection.
+          scheduleShadowSync();
+        }
+        break;
+      default:
+        break;
+      }
+    });
+  }
+
+  @Override
+  public void notifyIMEContext(
+      final IBinder token,
+      final int state,
+      final String typeHint,
+      final String modeHint,
+      final String actionHint,
+      final String autocapitalize,
+      final boolean autocorrect,
+      final int flags) {
+    postCallback(() -> {
+      if (!accepts(token, true)) {
+        return;
+      }
+      mImeState = state;
+      mTypeHint = typeHint == null ? "" : typeHint;
+      mModeHint = modeHint == null ? "" : modeHint;
+      mActionHint = actionHint == null ? "" : actionHint;
+      mAutocapitalize = autocapitalize == null ? "" : autocapitalize;
+      mAutocorrect = autocorrect;
+      if (state == IME_STATE_DISABLED) {
+        hideSoftInput();
+      } else {
+        restartInput((flags & EditableListener.IME_FLAG_USER_ACTION) != 0);
+      }
+    });
+  }
+
+  @Override
+  public void onSelectionChange(
+      final IBinder token,
+      final int start,
+      final int end,
+      final boolean causedOnlyByComposition) {
+    postCallback(() -> {
+      if (!accepts(token, false)) {
+        return;
+      }
+      final int safeStart = Math.max(0, Math.min(start, mCurrentText.length()));
+      final int safeEnd = Math.max(0, Math.min(end, mCurrentText.length()));
+      Selection.setSelection(mCurrentText, safeStart, safeEnd);
+      mAwaitingSelection = false;
+      mNeedSync = true;
+      scheduleShadowSync();
+    });
+  }
+
+  @Override
+  public void onTextChange(
+      final IBinder token,
+      final CharSequence text,
+      final int start,
+      final int unboundedOldEnd,
+      final boolean causedOnlyByComposition) {
+    // Binder may hand us mutable CharSequence storage. Snapshot at the boundary.
+    final String replacement = text == null ? "" : text.toString();
+    postCallback(() -> {
+      if (!accepts(token, false)) return;
+      if (unboundedOldEnd >= Integer.MAX_VALUE / 2) {
+        // A recovery snapshot supersedes confirmed text, not outstanding replies.
+        // Native FlushIMEText still emits those replies. Keep their FIFO slots:
+        // an input event can run between our queued text and reply callbacks.
+        // A real editor change already clears the queue at the TOKEN boundary.
+        mCurrentText.clearSpans();
+      }
+      final int safeStart = Math.max(0, Math.min(start, mCurrentText.length()));
+      final int safeEnd = Math.max(safeStart, Math.min(unboundedOldEnd, mCurrentText.length()));
+      mCurrentText.replace(safeStart, safeEnd, replacement);
+      mAwaitingSelection = true;
+      mNeedSync = true;
+      // Native always follows changed text with selection. Replies also schedule
+      // synchronization for rejected/no-op edits that produced no text callback.
+    });
+  }
+
+  @Override
+  public void onDefaultKeyEvent(final IBinder token, final KeyEvent event) {
+    // The product View already participates in Android dispatch. Re-dispatching here would recurse.
+  }
+
+  @Override
+  public void updateCompositionRects(
+      final IBinder token,
+      final android.graphics.RectF[] rects,
+      final android.graphics.RectF caretRect) {
+    // CursorAnchorInfo is optional for the first direct-runtime IME slice. Text and composition
+    // remain functional; handwriting/cursor-anchor refinement stays isolated here.
+  }
+
+  private final class InputConnectionImpl extends BaseInputConnection {
+    private final View mBoundView;
+    private final long mGeneration;
+    private boolean mClosed;
+
+    InputConnectionImpl(final View view) {
+      super(view, true);
+      mBoundView = view;
+      mGeneration = mEditorGeneration;
+    }
+
+    private boolean valid() {
+      return onInputThread() && !NavisAndroidTextInput.this.mClosed && !mClosed
+          && mConnection == this && mView == mBoundView && mGeneration == mEditorGeneration
+          && mFocusedChild != null && mImeState != IME_STATE_DISABLED;
+    }
+
+    @Override
+    public Editable getEditable() {
+      return valid() ? mText : null;
+    }
+
+    @Override
+    public boolean sendKeyEvent(final KeyEvent event) {
+      return valid() && NavisAndroidTextInput.this.sendKeyEvent(event);
+    }
+
+    @Override
+    public void closeConnection() {
+      mClosed = true;
+      if (onInputThread() && mConnection == this) {
+        mBatchDepth = 0;
+        scheduleShadowSync();
+      }
+    }
+
+    @Override
+    public boolean beginBatchEdit() {
+      if (!valid()) return false;
+      mBatchDepth++;
+      return true;
+    }
+
+    @Override
+    public boolean endBatchEdit() {
+      if (!valid() || mBatchDepth == 0) return false;
+      mBatchDepth--;
+      if (mBatchDepth == 0) scheduleShadowSync();
+      return true;
+    }
+
+    @Override
+    public boolean commitText(final CharSequence text, final int newCursorPosition) {
+      return edit(() -> super.commitText(text, newCursorPosition));
+    }
+
+    @Override
+    public boolean setComposingText(final CharSequence text, final int newCursorPosition) {
+      return edit(() -> super.setComposingText(text, newCursorPosition));
+    }
+
+    @Override
+    public boolean setComposingRegion(final int start, final int end) {
+      if (!valid() || start < 0 || end < 0 || start > mText.length() || end > mText.length()) return false;
+      final boolean changed = super.setComposingRegion(start, end);
+      return changed && updateGeckoSelection();
+    }
+
+    @Override
+    public boolean finishComposingText() {
+      if (!valid()) return false;
+      final boolean changed = super.finishComposingText();
+      mHasComposition = false;
+      return changed && submit(IGeckoEditableChild::onImeRequestCommit, true);
+    }
+
+    @Override
+    public boolean deleteSurroundingText(final int beforeLength, final int afterLength) {
+      if (beforeLength < 0 || afterLength < 0) return false;
+      return edit(() -> super.deleteSurroundingText(beforeLength, afterLength));
+    }
+
+    @Override
+    public boolean deleteSurroundingTextInCodePoints(final int beforeLength, final int afterLength) {
+      if (beforeLength < 0 || afterLength < 0) return false;
+      return edit(() -> super.deleteSurroundingTextInCodePoints(beforeLength, afterLength));
+    }
+
+    @Override
+    public boolean setSelection(final int start, final int end) {
+      if (!valid() || start < 0 || end < 0 || start > mText.length() || end > mText.length()) {
+        return false;
+      }
+      final boolean changed = super.setSelection(start, end);
+      return changed && (mEditDepth != 0 || updateGeckoSelection());
+    }
+
+    @Override
+    public boolean performEditorAction(final int actionCode) {
+      if (!valid()) return false;
+      final int code = actionCode == EditorInfo.IME_ACTION_NEXT ? KeyEvent.KEYCODE_TAB : KeyEvent.KEYCODE_ENTER;
+      return sendKeyEvent(new KeyEvent(KeyEvent.ACTION_DOWN, code))
+          && sendKeyEvent(new KeyEvent(KeyEvent.ACTION_UP, code));
+    }
+
+    private boolean edit(final java.util.function.BooleanSupplier operation) {
+      if (!valid()) return false;
+      final String before = mText.toString();
+      final int oldCompositionStart = BaseInputConnection.getComposingSpanStart(mText);
+      final int oldCompositionEnd = BaseInputConnection.getComposingSpanEnd(mText);
+      mEditDepth++;
+      try {
+        if (!operation.getAsBoolean()) return false;
+        final String after = mText.toString();
+        if (!before.equals(after)) {
+          int start = 0;
+          while (start < before.length() && start < after.length()
+              && before.charAt(start) == after.charAt(start)) start++;
+          // Keep surrogate pairs intact at the replacement boundary.
+          if (start > 0 && start < after.length() && Character.isLowSurrogate(after.charAt(start))
+              && Character.isHighSurrogate(after.charAt(start - 1))) start--;
+          int oldEnd = before.length();
+          int newEnd = after.length();
+          while (oldEnd > start && newEnd > start
+              && before.charAt(oldEnd - 1) == after.charAt(newEnd - 1)) { oldEnd--; newEnd--; }
+          if (newEnd > 0 && newEnd < after.length() && Character.isHighSurrogate(after.charAt(newEnd - 1))
+              && Character.isLowSurrogate(after.charAt(newEnd))) { oldEnd++; newEnd++; }
+
+          final int compositionStart = BaseInputConnection.getComposingSpanStart(mText);
+          final int compositionEnd = BaseInputConnection.getComposingSpanEnd(mText);
+          if (compositionStart >= 0) {
+            // Like GeckoEditable's span-bearing replacement action, transmit
+            // the complete composing range rather than composing only its suffix.
+            start = Math.min(start, compositionStart);
+            if (oldCompositionStart >= 0) start = Math.min(start, oldCompositionStart);
+            oldEnd = Math.max(oldEnd, oldCompositionEnd);
+            newEnd = Math.max(newEnd, compositionEnd);
+            final int trailing = Math.min(before.length() - oldEnd, after.length() - newEnd);
+            oldEnd = before.length() - trailing;
+            newEnd = after.length() - trailing;
+          }
+          final int replaceStart = start;
+          final int replaceEnd = oldEnd;
+          final String replacement = after.substring(start, newEnd);
+          final int caret = Math.max(0, Selection.getSelectionEnd(mText));
+          if (!submit(child -> {
+            if (compositionStart >= 0) {
+              addCompositionRanges(child, caret - replaceStart, compositionEnd - replaceStart);
+            }
+            child.onImeReplaceText(replaceStart, replaceEnd, replacement);
+          }, false)) return false;
+        }
+        return updateGeckoSelection();
+      } finally {
+        mEditDepth--;
+        scheduleShadowSync();
+      }
+    }
+
+    private boolean updateGeckoSelection() {
+      final int start = Math.max(0, Selection.getSelectionStart(mText));
+      final int end = Math.max(0, Selection.getSelectionEnd(mText));
+      final int compositionStart = BaseInputConnection.getComposingSpanStart(mText);
+      final int compositionEnd = BaseInputConnection.getComposingSpanEnd(mText);
+      mHasComposition = compositionStart >= 0 && compositionEnd >= compositionStart;
+      final boolean composing = mHasComposition;
+      return submit(child -> {
+        if (composing) {
+          addCompositionRanges(child, end - compositionStart, compositionEnd - compositionStart);
+          child.onImeUpdateComposition(compositionStart, compositionEnd, 0);
+        } else {
+          child.onImeUpdateComposition(start, end, 0);
+        }
+      }, true);
+    }
+
+    private void addCompositionRanges(final IGeckoEditableChild child, final int caret, final int length)
+        throws RemoteException {
+      final int safeCaret = Math.max(0, Math.min(caret, length));
+      child.onImeAddCompositionRange(safeCaret, safeCaret, IME_RANGE_CARETPOSITION, 0, 0, false, 0, 0, 0);
+      child.onImeAddCompositionRange(0, length, IME_RANGE_RAWINPUT, IME_RANGE_UNDERLINE,
+          IME_RANGE_LINE_SOLID, false, 0, 0, 0);
+    }
+  }
