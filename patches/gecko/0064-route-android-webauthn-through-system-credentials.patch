+    if (sPending != null && sPending.scope.sessionId == sessionId) {
+      cancelPending("ABORT_ERR");
+    }
+  }
+
+  static void unregisterSession(final long sessionId) {
+    ThreadUtils.assertOnUiThread();
+    invalidateSession(sessionId);
+    SCOPES.values().removeIf(scope -> scope.sessionId == sessionId);
+  }
