+  }
+
+  private interface Provider<T> {
+    GeckoResult<T> request(Activity activity, CancellationSignal cancellation,
+        String origin, byte[] hash, String requestJson);
+  }
+
+  private static <T> GeckoResult<T> request(
+      final long transactionId, final long browsingContextId, final String origin,
+      final byte[] clientDataHash, final String requestJson, final long timeoutMs,
+      final Provider<T> provider) {
+    final GeckoResult<T> result = new GeckoResult<>();
+    // Native-owned arguments are copied before the JNI call returns. No page-supplied
+    // request/event can directly select a browsing context or substitute the origin.
+    final byte[] hash = clientDataHash == null ? null : clientDataHash.clone();
+    ThreadUtils.runOnUiThread(() -> {
+      if (transactionId == 0 || origin == null || origin.length() > 8192
+          || hash == null || hash.length != 32 || requestJson == null
+          || requestJson.length() > 1024 * 1024) {
+        result.completeExceptionally(new WebAuthnUtils.Exception("DATA_ERR"));
+        return;
+      }
+      final Scope scope = SCOPES.get(browsingContextId);
+      final Activity activity = sActivity.get();
+      if (scope == null || !scope.active || activity == null
+          || activity.isFinishing() || activity.isDestroyed()) {
+        result.completeExceptionally(new WebAuthnUtils.Exception("ABORT_ERR"));
+        return;
+      }
+      final String capability = availability();
+      if (!"AVAILABLE".equals(capability)) {
+        result.completeExceptionally(new WebAuthnUtils.Exception(
+            "ORIGIN_PERMISSION_MISSING".equals(capability) ? "SECURITY_ERR" : "NOT_SUPPORTED_ERR"));
+        return;
+      }
+      cancelPending("ABORT_ERR");
+      final Pending<T> pending = new Pending<>(transactionId, scope, activity, result);
+      sPending = pending;
+      ThreadUtils.getUiHandler().postDelayed(pending.timeout,
+          Math.max(1000L, Math.min(timeoutMs > 0 ? timeoutMs : 120000L, 120000L)));
+      try {
+        provider.request(activity, pending.cancellation, origin, hash, requestJson)
+            .withHandler(ThreadUtils.getUiHandler()).accept(pending::succeed, pending::fail);
+      } catch (final RuntimeException error) {
+        pending.fail(error);
+      }
+    });
+    return result;
+  }
+
+  private static final class Pending<T> {
+    final long transactionId;
+    final Scope scope;
+    final long generation;
+    final Activity activity;
+    final GeckoResult<T> result;
+    final CancellationSignal cancellation = new CancellationSignal();
+    final Runnable timeout = () -> cancel("TIMEOUT_ERR");
+    boolean completed;
+
+    Pending(final long transactionId, final Scope scope, final Activity activity,
+        final GeckoResult<T> result) {
+      this.transactionId = transactionId;
+      this.scope = scope;
+      this.generation = scope.generation;
+      this.activity = activity;
+      this.result = result;
+    }
+
+    void succeed(final T value) {
+      ThreadUtils.assertOnUiThread();
+      if (completed) return;
+      if (sActivity.get() != activity || activity.isFinishing() || activity.isDestroyed()
+          || SCOPES.get(scope.browsingContextId) != scope || !scope.active
+          || generation != scope.generation) {
+        cancel("ABORT_ERR");
+        return;
+      }
+      if (value == null) {
+        fail(new WebAuthnUtils.Exception("DATA_ERR"));
+        return;
+      }
+      finish();
+      result.complete(value);
+    }
+
+    void fail(final Throwable error) {
+      ThreadUtils.assertOnUiThread();
+      if (completed) return;
+      finish();
+      result.completeExceptionally(error instanceof WebAuthnUtils.Exception ? error
+          : new WebAuthnUtils.Exception(error instanceof SecurityException
+              ? "SECURITY_ERR" : "UNKNOWN_ERR"));
+    }
+
+    void cancel(final String reason) {
+      if (completed) return;
+      finish();
+      try {
+        cancellation.cancel();
+      } catch (final RuntimeException ignored) {
+        // Provider/OEM cancellation failure cannot escape into the Activity lifecycle.
+      } finally {
+        // Some OEM providers never reply to cancellation (or throw here). Gecko's
+        // promise must still settle, and late provider replies must remain ignored.
+        result.completeExceptionally(new WebAuthnUtils.Exception(reason));
+      }
+    }
+
+    void finish() {
+      completed = true;
+      ThreadUtils.getUiHandler().removeCallbacks(timeout);
+      if (sPending == this) sPending = null;
+    }
+  }
+
+  private static void cancelPending(final String reason) {
+    if (sPending != null) sPending.cancel(reason);
+  }
+}
