@@ -0,0 +1,253 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.gecko.navis;
+
+import android.app.Activity;
+import android.os.CancellationSignal;
+import java.lang.ref.WeakReference;
+import java.util.HashMap;
+import java.util.Map;
+import org.mozilla.gecko.annotation.WrapForJNI;
+import org.mozilla.gecko.util.ThreadUtils;
+import org.mozilla.gecko.util.WebAuthnUtils;
+import org.mozilla.geckoview.GeckoResult;
+
+/**
+ * Navis-owned JNI transport for the OS credential provider, not an authenticator/store.
+ * Gecko has already validated the requesting origin and RP. Only a registered, active
+ * native content session may present credentials in the current foreground Activity.
+ * All mutable transaction/session state is confined to Android's UI thread.
+ */
+public final class NavisAndroidWebAuthn {
+  private static final Map<Long, Scope> SCOPES = new HashMap<>();
+  private static WeakReference<Activity> sActivity = new WeakReference<>(null);
+  private static Pending<?> sPending;
+
+  private NavisAndroidWebAuthn() {}
+
+  private static final class Scope {
+    final long sessionId;
+    final long browsingContextId;
+    long generation;
+    boolean active;
+
+    Scope(final long sessionId, final long browsingContextId, final boolean active) {
+      this.sessionId = sessionId;
+      this.browsingContextId = browsingContextId;
+      this.active = active;
+    }
+  }
+
+  public static void bindActivity(final Activity activity) {
+    ThreadUtils.assertOnUiThread();
+    if (sActivity.get() != activity) cancelPending("ABORT_ERR");
+    sActivity = new WeakReference<>(activity);
+  }
+
+  public static void unbindActivity() {
+    ThreadUtils.assertOnUiThread();
+    sActivity.clear();
+    cancelPending("ABORT_ERR");
+  }
+
+  public static String availability() {
+    ThreadUtils.assertOnUiThread();
+    final Activity activity = sActivity.get();
+    if (activity == null || activity.isFinishing() || activity.isDestroyed()) {
+      return "NO_FOREGROUND_ACTIVITY";
+    }
+    return NavisAndroidCredentialProvider.availability(activity);
+  }
+
+  static void registerSession(
+      final long sessionId, final long browsingContextId, final boolean active) {
+    ThreadUtils.assertOnUiThread();
+    unregisterSession(sessionId);
+    if (browsingContextId > 0) {
+      SCOPES.put(browsingContextId, new Scope(sessionId, browsingContextId, active));
+    }
+  }
+
+  static void setSessionActive(final long sessionId, final boolean active) {
