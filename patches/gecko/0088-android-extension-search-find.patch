diff --git a/mobile/shared/components/extensions/ext-search.js b/mobile/shared/components/extensions/ext-search.js
new file mode 100644
--- /dev/null
+++ b/mobile/shared/components/extensions/ext-search.js
@@ -0,0 +1,90 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+"use strict";
+
+{
+  const { NavisAndroidExtensionProfile } = ChromeUtils.importESModule(
+    "resource://gre/modules/NavisAndroidExtensionProfile.sys.mjs"
+  );
+  const { NavisAndroidExtensionTabBridge } = ChromeUtils.importESModule(
+    "resource://gre/modules/NavisAndroidWebExtensionHost.sys.mjs"
+  );
+  const { ExtensionError } = ExtensionUtils;
+
+  function checkContext(context) {
+    if (context.unloaded || context.extension.hasShutdown ||
+        !context.extension.hasPermission("search") ||
+        (context.incognito && !context.privateBrowsingAllowed)) {
+      throw new ExtensionError("Extension search access is not allowed");
+    }
+  }
+
+  this.search = class extends ExtensionAPI {
+    getAPI(context) {
+      const { extension } = context;
+      async function open(query, engine, properties, fallback) {
+        checkContext(context);
+        if (properties.tabId != null && properties.disposition != null) {
+          throw new ExtensionError("tabId and disposition cannot be combined");
+        }
+        if (typeof query !== "string" || !query.trim() || query.length > 8192) {
+          throw new ExtensionError("A bounded search query is required");
+        }
+        const disposition = properties.disposition || fallback;
+        if (!["CURRENT_TAB", "NEW_TAB", "NEW_WINDOW"].includes(disposition)) {
+          throw new ExtensionError("Invalid search disposition");
+        }
+        const target = properties.tabId != null
+          ? tabTracker.getTab(properties.tabId)
+          : disposition === "CURRENT_TAB" ? tabTracker.activeTab : null;
+        if ((properties.tabId != null || disposition === "CURRENT_TAB") &&
+            (!target || !extension.tabManager.canAccessTab(target))) {
+          throw new ExtensionError("The search target is not accessible");
+        }
+        const { url } = await NavisAndroidExtensionProfile.request(extension, context,
+          "search:resolve", { query, engine: engine ?? null });
+        checkContext(context);
+        if (typeof url !== "string" || !/^https?:\/\//.test(url) ||
+            !context.checkLoadURL(url, { dontReportErrors: true })) {
+          throw new ExtensionError("Invalid search URL");
+        }
+        if (target) {
+          // Re-resolve the exact captured target, not a newly active tab after the await.
+          if (tabTracker.getTab(target.id, null) !== target ||
+              !extension.tabManager.canAccessTab(target)) {
+            throw new ExtensionError("The search target is no longer available");
+          }
+          await NavisAndroidExtensionTabBridge.update(extension.id, target.id, { url });
+        } else if (disposition === "NEW_TAB") {
+          await NavisAndroidExtensionTabBridge.create(extension.id, { url, active: true });
+        } else {
+          // Use the actual windows backend; never pretend a new tab is a new window.
+          const create = await context.apiCan.asyncFindAPIPath("windows.create");
+          checkContext(context);
+          if (typeof create !== "function") throw new ExtensionError("The windows backend is unavailable");
+          const active = tabTracker.activeTab;
+          if (!active || !extension.tabManager.canAccessTab(active)) {
+            throw new ExtensionError("The active search window is not accessible");
+          }
+          const { PrivateBrowsingUtils } = ChromeUtils.importESModule(
+            "resource://gre/modules/PrivateBrowsingUtils.sys.mjs"
+          );
+          await create({ url, incognito: PrivateBrowsingUtils.isBrowserPrivate(active.browser) });
+        }
+      }
+      return { search: {
+        get() {
+          checkContext(context);
+          return NavisAndroidExtensionProfile.request(extension, context, "search:get");
+        },
+        search(properties) {
+          return open(properties.query, properties.engine, properties, "NEW_TAB");
+        },
+        query(properties) {
+          return open(properties.text, null, properties, "CURRENT_TAB");
+        },
+      } };
+    }
+  };
+}
diff --git a/mobile/shared/components/extensions/ext-find.js b/mobile/shared/components/extensions/ext-find.js
new file mode 100644
--- /dev/null
+++ b/mobile/shared/components/extensions/ext-find.js
@@ -0,0 +1,70 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+"use strict";
+
+// Keep Gecko's frame traversal, range/rect calculation and highlighting intact.
+Services.scriptloader.loadSubScript("chrome://geckoview/content/ext-find-gecko.js", this);
+
+{
+  const GeckoFind = this.find;
+  const { ExtensionError } = ExtensionUtils;
+  const queues = new WeakMap();
+
+  function capture(context, tabId) {
+    const tab = tabId == null ? tabTracker.activeTab : tabTracker.getTab(tabId);
+    const browser = tab?.linkedBrowser;
+    const global = browser?.browsingContext?.currentWindowGlobal;
+    function check() {
+      if (context.unloaded || context.extension.hasShutdown ||
+          !context.extension.hasPermission("find") || !tab || !browser || !global ||
+          (context.incognito && !context.privateBrowsingAllowed) ||
+          tabTracker.getTab(tab.id, null) !== tab ||
+          !context.extension.tabManager.canAccessTab(tab) ||
+          browser.navisNativePresentation !== false ||
+          browser.browsingContext?.currentWindowGlobal !== global) {
+        throw new ExtensionError("The find target is not an accessible web document");
+      }
+    }
+    check();
+    return { browser, tabId: tab.id, check };
+  }
+
+  // Gecko caches result ranges per top-level actor. Serialize calls on the same
+  // browser so a late old-document result cannot overwrite a newer search cache.
+  function enqueue(target, operation) {
+    const previous = queues.get(target.browser) || Promise.resolve();
+    const next = previous.catch(() => {}).then(async () => {
+      target.check();
+      const result = await operation();
+      target.check();
+      return result;
+    });
+    queues.set(target.browser, next);
+    const release = () => {
+      if (queues.get(target.browser) === next) queues.delete(target.browser);
+    };
+    next.then(release, release);
+    return next;
+  }
+
+  this.find = class extends GeckoFind {
+    getAPI(context) {
+      const upstream = super.getAPI(context).find;
+      return { find: {
+        async find(queryphrase, params = {}) {
+          const target = capture(context, params?.tabId);
+          return enqueue(target, () => upstream.find(queryphrase, { ...params, tabId: target.tabId }));
+        },
+        async highlightResults(params = {}) {
+          const target = capture(context, params?.tabId);
+          return enqueue(target, () => upstream.highlightResults({ ...params, tabId: target.tabId }));
+        },
+        async removeHighlighting(tabId) {
+          const target = capture(context, tabId);
+          return enqueue(target, () => upstream.removeHighlighting(target.tabId));
+        },
+      } };
+    }
+  };
+}

