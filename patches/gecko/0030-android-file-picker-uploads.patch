+  async _resolveMaterializedDirectory(uri) {
+    const directory = this._navisMaterializedFile(uri);
+    if (!directory.isDirectory()) throw new Error("Expected a selected directory");
+    const files = [];
+    let entries = 0;
+    let bytes = 0;
+    const visit = async (path, relative, depth) => {
+      if (depth > 32) throw new Error("Upload directory is too deep");
+      for (const child of await IOUtils.getChildren(path)) {
+        if (++entries > 2048) throw new Error("Too many upload directory entries");
+        const native = this._navisMaterializedFile(Services.io.newFileURI(new lazy.FileUtils.File(child)).spec);
+        const info = await IOUtils.stat(child);
+        const relativePath = `${relative}/${native.leafName}`;
+        if (info.type === "directory") {
+          await visit(child, relativePath, depth + 1);
+        } else if (info.type === "regular") {
+          bytes += info.size;
+          if (files.length >= MAX_TEMPORARY_FILES || info.size > MAX_TEMPORARY_FILE_BYTES || bytes > MAX_TEMPORARY_TOTAL_BYTES) {
