+nsresult EmptyObject(JSContext* aCx, JS::MutableHandle<JS::Value> aResult) {
+  JS::Rooted<JSObject*> object(aCx, JS_NewPlainObject(aCx));
+  if (!object) {
+    return NS_ERROR_OUT_OF_MEMORY;
+  }
+  aResult.setObject(*object);
+  return NS_OK;
+}
+
+nsresult EmptyArray(JSContext* aCx, JS::MutableHandle<JS::Value> aResult) {
+  JS::Rooted<JSObject*> array(aCx, JS::NewArrayObject(aCx, 0));
+  if (!array) {
+    return NS_ERROR_OUT_OF_MEMORY;
+  }
+  aResult.setObject(*array);
+  return NS_OK;
+}
+
+bool NoopMethod(JSContext* aCx, unsigned aArgc, JS::Value* aVp) {
+  JS::CallArgs args = JS::CallArgsFromVp(aArgc, aVp);
+  args.rval().setUndefined();
+  return true;
+}
+
+bool EmptyObjectMethod(JSContext* aCx, unsigned aArgc, JS::Value* aVp) {
+  JS::CallArgs args = JS::CallArgsFromVp(aArgc, aVp);
+  JS::Rooted<JSObject*> object(aCx, JS_NewPlainObject(aCx));
+  if (!object) {
+    return false;
+  }
+  args.rval().setObject(*object);
+  return true;
+}
+
+bool EmptyArrayMethod(JSContext* aCx, unsigned aArgc, JS::Value* aVp) {
+  JS::CallArgs args = JS::CallArgsFromVp(aArgc, aVp);
+  JS::Rooted<JSObject*> array(aCx, JS::NewArrayObject(aCx, 0));
+  if (!array) {
+    return false;
+  }
+  args.rval().setObject(*array);
+  return true;
+}
+
+nsresult EmptyHistogram(JSContext* aCx, bool aKeyed,
+                        JS::MutableHandle<JS::Value> aResult) {
+  JS::Rooted<JSObject*> object(aCx, JS_NewPlainObject(aCx));
+  if (!object || !JS_DefineFunction(aCx, object, "name", NoopMethod, 0, 0) ||
+      !JS_DefineFunction(aCx, object, "snapshot", EmptyObjectMethod, 0, 0) ||
+      !JS_DefineFunction(aCx, object, "clear", NoopMethod, 0, 0) ||
+      (aKeyed &&
+       !JS_DefineFunction(aCx, object, "keys", EmptyArrayMethod, 0, 0))) {
+    return NS_ERROR_OUT_OF_MEMORY;
+  }
+  aResult.setObject(*object);
+  return NS_OK;
+}
