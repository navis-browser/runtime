diff --git a/dom/base/Document.cpp b/dom/base/Document.cpp
--- a/dom/base/Document.cpp
+++ b/dom/base/Document.cpp
@@ -13534,11 +13534,42 @@ bool Document::CanRewriteURL(nsIURI* aTargetURL, bool aReportErrors) const {
     return NS_SUCCEEDED(principal->CheckMayLoad(aTargetURL, false));
   }
 
+#if defined(MOZ_DESKTOP_EMBEDDER_INTERNAL_SCHEME) && !defined(ANDROID)
+  // The desktop settings document owns these same-origin SPA routes. Do not
+  // grant path rewriting to other internal hosts or arbitrary internal paths.
+  bool navisSettingsRewrite = false;
+  if (scheme.EqualsLiteral(MOZ_DESKTOP_EMBEDDER_INTERNAL_SCHEME)) {
+    const auto isSettingsRoute = [](nsIURI* aURI) {
+      nsAutoCString host, userPass, path, query;
+      int32_t port = -1;
+      if (NS_FAILED(aURI->GetAsciiHost(host)) || host != "settings"_ns ||
+          NS_FAILED(aURI->GetUserPass(userPass)) || !userPass.IsEmpty() ||
+          NS_FAILED(aURI->GetPort(&port)) || port != -1 ||
+          NS_FAILED(aURI->GetFilePath(path)) ||
+          NS_FAILED(aURI->GetQuery(query)) || !query.IsEmpty()) {
+        return false;
+      }
+      if (path.Length() > 1 && path.Last() == '/') {
+        path.Truncate(path.Length() - 1);
+      }
+      return path == "/"_ns || path == "/search"_ns || path == "/privacy"_ns ||
+             path == "/appearance"_ns || path == "/downloads"_ns ||
+             path == "/help"_ns;
+    };
+    navisSettingsRewrite =
+        isSettingsRoute(mDocumentURI) && isSettingsRoute(aTargetURL);
+  }
+#endif
+
   // If the URI isn't allowed to change path with pushState, we know it doesn't
   // match (as we checked EqualsExceptRef above), so return immediately.
   if (scheme != "http"_ns && scheme != "https"_ns &&
       scheme != "moz-extension"_ns && scheme != "chrome"_ns &&
-      scheme != "resource"_ns) {
+      scheme != "resource"_ns
+#if defined(MOZ_DESKTOP_EMBEDDER_INTERNAL_SCHEME) && !defined(ANDROID)
+      && !navisSettingsRewrite
+#endif
+  ) {
     return false;
   }
 
