+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.gecko.navis;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import org.mozilla.gecko.util.GeckoBundle;
+
+/** Immutable, bounded context-menu data crossing the direct runtime peer. */
+public final class NavisAndroidContextMenu {
+  public static final int MAX_ITEMS = 256;
+  public static final int MAX_TEXT = 4096;
+
+  public static final class PageAction {
+    public final String id;
+    public final boolean enabled;
+
+    private PageAction(final GeckoBundle bundle) {
+      id = bounded(bundle.getString("id", ""), 32);
+      enabled = bundle.getBoolean("enabled", false);
+      if (!id.matches("[a-z-]{1,32}")) {
+        throw new IllegalArgumentException("Invalid Navis page action");
+      }
+    }
+  }
+
+  public static final class Item {
+    public final String id;
+    public final String parentId;
+    public final String extensionId;
+    public final String extensionName;
+    public final String title;
+    public final String type;
+    public final boolean checked;
+    public final boolean enabled;
+
+    private Item(final GeckoBundle bundle) {
+      id = bounded(bundle.getString("id", ""), 256);
+      final String rawParentId = bounded(bundle.getString("parentId", ""), 256);
+      parentId = rawParentId.isEmpty() ? null : rawParentId;
+      extensionId = bounded(bundle.getString("extensionId", ""), 256);
+      extensionName = bounded(bundle.getString("extensionName", ""), 64);
+      title = bounded(bundle.getString("title", ""), 64);
+      type = bounded(bundle.getString("type", "normal"), 16);
+      checked = bundle.getBoolean("checked", false);
+      enabled = bundle.getBoolean("enabled", false);
+      if (id.isEmpty() || (title.isEmpty() && !"separator".equals(type)) || extensionId.isEmpty()) {
+        throw new IllegalArgumentException("Invalid Navis context-menu item");
+      }
+    }
+
+    static Item fromBundle(final GeckoBundle bundle) {
+      return new Item(bundle);
+    }
+  }
+
+  public final String token;
+  public final long tabId;
+  public final String pageUrl;
+  public final String frameUrl;
+  public final int frameId;
+  public final boolean inFrame;
+  public final boolean onLink;
+  public final boolean onImage;
+  public final boolean onAudio;
+  public final boolean onVideo;
+  public final boolean isTextSelected;
+  public final boolean editable;
+  public final String linkUrl;
+  public final String linkText;
+  public final String srcUrl;
+  public final String selectionText;
+  public final String mediaType;
+  public final List<Item> items;
+  public final List<PageAction> pageActions;
+
+  private NavisAndroidContextMenu(final GeckoBundle bundle) {
+    token = bounded(bundle.getString("token", ""), 32);
+    pageUrl = bounded(bundle.getString("pageUrl", ""), MAX_TEXT);
+    frameUrl = bounded(bundle.getString("frameUrl", ""), MAX_TEXT);
+    frameId = bundle.getInt("frameId", 0);
+    tabId = bundle.getLong("tabId", 0L);
+    inFrame = bundle.getBoolean("inFrame", false);
+    onLink = bundle.getBoolean("onLink", false);
+    onImage = bundle.getBoolean("onImage", false);
+    onAudio = bundle.getBoolean("onAudio", false);
+    onVideo = bundle.getBoolean("onVideo", false);
+    isTextSelected = bundle.getBoolean("isTextSelected", false);
+    editable = bundle.getBoolean("editable", false);
+    linkUrl = bounded(bundle.getString("linkUrl", ""), MAX_TEXT);
+    linkText = bounded(bundle.getString("linkText", ""), MAX_TEXT);
+    srcUrl = bounded(bundle.getString("srcUrl", ""), MAX_TEXT);
+    selectionText = bounded(bundle.getString("selectionText", ""), MAX_TEXT);
+    mediaType = bounded(bundle.getString("mediaType", ""), 16);
+    if (token.length() != 32 || tabId <= 0 || pageUrl.isEmpty()) {
+      throw new IllegalArgumentException("Invalid Navis context-menu request");
+    }
+    final GeckoBundle[] bundles = bundle.getBundleArray("items");
+    if (bundles == null || bundles.length > MAX_ITEMS) {
+      throw new IllegalArgumentException("Invalid Navis context-menu item count");
+    }
+    final ArrayList<Item> parsed = new ArrayList<>(bundles.length);
+    for (final GeckoBundle item : bundles) {
+      if (item != null) parsed.add(Item.fromBundle(item));
+    }
+    items = Collections.unmodifiableList(parsed);
+    final GeckoBundle[] pageBundles = bundle.getBundleArray("pageActions");
+    final ArrayList<PageAction> actions = new ArrayList<>();
+    if (pageBundles != null) {
+      if (pageBundles.length > 32) throw new IllegalArgumentException("Too many Navis page actions");
+      for (final GeckoBundle action : pageBundles) {
+        if (action != null) actions.add(new PageAction(action));
+      }
+    }
+    pageActions = Collections.unmodifiableList(actions);
+  }
+
+  public static NavisAndroidContextMenu fromBundle(final GeckoBundle bundle) {
+    if (bundle == null) throw new IllegalArgumentException("Missing context-menu request");
+    return new NavisAndroidContextMenu(bundle);
+  }
+
+  private static String bounded(final String value, final int max) {
+    if (value == null) return "";
+    return value.length() <= max ? value : value.substring(0, max);
+  }
+}
