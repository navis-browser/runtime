diff --git a/mobile/shared/modules/navis/NavisAndroidContextMenus.sys.mjs b/mobile/shared/modules/navis/NavisAndroidContextMenus.sys.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..02edd812455908a9889dd818a495a4ef857c7be4
--- /dev/null
+++ b/mobile/shared/modules/navis/NavisAndroidContextMenus.sys.mjs
@@ -0,0 +1,436 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+// The browser extension menus implementation remains the source of truth for
+// matching contexts and click semantics.  This module is only the direct
+// Android presentation seam: no XUL menu, GeckoView Session, or extension URL
+// is created here.
+const MAX_ITEMS = 256;
+const MAX_TEXT = 4096;
+const MAX_LABEL = 64;
+const TOKEN_RE = /^[0-9a-f]{32}$/;
+const PAGE_COMMAND_PREFIX = "navis-context:";
+const PAGE_COMMANDS = new Set([
+  "play-media", "pause-media", "mute-media", "unmute-media",
+  "show-media-controls", "hide-media-controls", "undo", "redo", "cut", "copy", "paste", "select-all",
+]);
+
+function sourceIsCurrent(actor) {
+  try { return Boolean(actor?.manager?.isCurrentGlobal); }
+  catch { return false; }
+}
+
+const { PrivateBrowsingUtils } = ChromeUtils.importESModule(
+  "resource://gre/modules/PrivateBrowsingUtils.sys.mjs"
+);
+
+const registeredItems = new Set();
+let pending;
+
+function bounded(value, limit = MAX_TEXT) {
+  return typeof value === "string" ? value.slice(0, limit) : null;
+}
+
+function immutableItem(item, contextData) {
+  const extension = item.extension;
+  const browser = contextData.tab?.linkedBrowser;
+  if (!browser) {
+    return null;
+  }
+  // The synthetic root is a grouping implementation detail, never an
+  // actionable extension menu entry.
+  if (!item.parent) {
+    return null;
+  }
+  const privateTab = (() => {
+    try {
+      return PrivateBrowsingUtils.isBrowserPrivate(browser);
+    } catch {
+      return null;
+    }
+  })();
+  if (privateTab === null) {
+    return null;
+  }
+  if (!extension?.isActive || extension.hasShutdown ||
+      (privateTab && !extension.privateBrowsingAllowed)) {
+    return null;
+  }
+  try {
+    if (!item.enabledForContext(contextData)) {
+      return null;
+    }
+  } catch {
+    return null;
+  }
+  const menuId = String(item.id);
+  const id = `${extension.id}::${menuId}`;
+  if (!menuId || id.length > 256) {
+    return null;
+  }
+  let title = bounded(item.title, MAX_LABEL) || "";
+  if (contextData.isTextSelected && title.includes("%s")) {
+    title = title.replace(/%s/g, bounded(contextData.selectionText?.trim(), MAX_LABEL) || "");
+  }
+  return Object.freeze({
+    id,
+    menuId,
+    parentId: item.parent?.parent
+      ? `${extension.id}::${String(item.parent.id)}` : null,
+    extensionId: bounded(extension.id, 256),
+    extensionName: bounded(extension.name, MAX_LABEL) || "Extension",
+    title: title.slice(0, MAX_LABEL),
+    type: item.type === "checkbox" || item.type === "radio" || item.type === "separator"
+      ? item.type : "normal",
+    command: bounded(item.command, 128) || null,
+    checked: Boolean(item.checked),
+    enabled: Boolean(item.enabled),
+  });
+}
+
+function contextFromPayload(payload, tab, menu) {
+  const pageUrl = bounded(payload?.pageUrl || payload?.baseUri);
+  if (!pageUrl) {
+    return null;
+  }
+  const linkUrl = bounded(payload?.linkUrl || payload?.uri);
+  let linkURI = null;
+  try {
+    if (linkUrl) linkURI = Services.io.newURI(linkUrl);
+  } catch {
+    linkURI = null;
+  }
+  return {
+    menu,
+    tab,
+    pageUrl,
+    frameUrl: bounded(payload?.frameUrl || pageUrl),
+    frameId: Number.isSafeInteger(payload?.frameId) ? payload.frameId : 0,
+    inFrame: Boolean(payload?.inFrame),
+    onLink: Boolean(payload?.onLink || payload?.uri),
+    onImage: Boolean(payload?.onImage),
+    onAudio: Boolean(payload?.onAudio),
+    onVideo: Boolean(payload?.onVideo),
+    onSelection: Boolean(payload?.isTextSelected),
+    isTextSelected: Boolean(payload?.isTextSelected),
+    selectionText: bounded(payload?.selectionText),
+    linkUrl,
+    linkURI,
+    linkText: bounded(payload?.linkText),
+    srcUrl: bounded(payload?.srcUrl || payload?.elementSrc),
+    mediaType: bounded(payload?.mediaType),
+    editable: Boolean(payload?.editable),
+    onEditable: Boolean(payload?.editable),
+    onPassword: Boolean(payload?.onPassword),
+    targetToken: Number.isSafeInteger(payload?.targetToken) && payload.targetToken > 0
+      ? payload.targetToken : 0,
+    pageActions: Object.freeze((Array.isArray(payload?.pageActions) ? payload.pageActions : [])
+      .slice(0, 32).filter(action => PAGE_COMMANDS.has(action?.id))
+      .map(action => Object.freeze({ id: action.id, enabled: Boolean(action.enabled) }))),
+    targetElementId: Number.isSafeInteger(payload?.targetElementId)
+      ? payload.targetElementId
+      : 0,
+    modifiers: Array.isArray(payload?.modifiers) ? payload.modifiers.slice(0, 8) : [],
+    button: Number.isInteger(payload?.button) ? payload.button : 2,
+  };
+}
+
+function buildItems(contextData) {
+  const items = [];
+  const itemsById = new Map();
+  const extensions = new Set();
+  for (const item of registeredItems) {
+    if (items.length >= MAX_ITEMS) break;
+    const dto = immutableItem(item, contextData);
+    if (!dto || itemsById.has(dto.id)) continue;
+    items.push(dto);
+    itemsById.set(dto.id, item);
+    extensions.add(item.extension);
+  }
+  // Stable DFS preserves root/child order. The synthetic root is represented
+  // by null and is never sent to Android as a parent item.
+  const children = new Map();
+  for (const item of items) {
+    const list = children.get(item.parentId) || [];
+    list.push(item);
+    children.set(item.parentId, list);
+  }
+  const ordered = [];
+  const visit = parentId => {
+    for (const item of children.get(parentId) || []) {
+      ordered.push(item);
+      visit(item.id);
+    }
+  };
+  visit(null);
+  return { items: ordered, itemsById, extensions };
+}
+
+function nativeRequest(token, tab, contextData, items) {
+  return Object.freeze({
+    token,
+    tabId: tab?.id || 0,
+    pageUrl: contextData.pageUrl,
+    frameUrl: contextData.frameUrl,
+    frameId: contextData.frameId,
+    inFrame: contextData.inFrame,
+    onLink: contextData.onLink,
+    onImage: contextData.onImage,
+    onAudio: contextData.onAudio,
+    onVideo: contextData.onVideo,
+    isTextSelected: contextData.isTextSelected,
+    editable: contextData.editable,
+    linkUrl: contextData.linkUrl,
+    linkText: contextData.linkText,
+    srcUrl: contextData.srcUrl,
+    selectionText: contextData.selectionText,
+    mediaType: contextData.mediaType,
+    button: contextData.button,
+    modifiers: Object.freeze(contextData.modifiers),
+    items: Object.freeze(items),
+    pageActions: contextData.pageActions,
+  });
+}
+
+function finishPending() {
+  const current = pending;
+  pending = null;
+  if (!current) {
+    return;
+  }
+  try {
+    current.sourceActor?.sendAsyncMessage("NavisAndroid:ContextDismiss", {
+      token: current.contextData.targetToken,
+    });
+  } catch {}
+  try {
+    current.cancelNative?.();
+  } catch (error) {
+    Cu.reportError(error);
+  }
+  for (const extension of current.extensions) {
+    try {
+      extension.emit("webext-menu-hidden");
+    } catch (error) {
+      Cu.reportError(error);
+    }
+  }
+}
+
+const NavisAndroidContextMenus = {
+  registerMenuItem(item) {
+    registeredItems.add(item);
+    pending?.rebuild?.();
+  },
+
+  unregisterMenuItem(item) {
+    registeredItems.delete(item);
+    if (pending) {
+      for (const [id, pendingItem] of pending.itemsById) {
+        if (pendingItem === item) pending.itemsById.delete(id);
+      }
+      pending.rebuild?.();
+    }
+  },
+
+  unregisterExtension(extension) {
+    for (const item of registeredItems) {
+      if (item.extension === extension) registeredItems.delete(item);
+    }
+    if (pending && pending.extensions.has(extension)) finishPending();
+  },
+
+  refreshMenuItem(item) {
+    if (pending && registeredItems.has(item)) {
+      // onShown listeners may update/create/remove items. Refresh is an
+      // in-place DTO update on the same token, never a cancellation.
+      pending.rebuild?.();
+    }
+  },
+
+  close() {
+    finishPending();
+  },
+
+  createBridge({ getWindow, getTab, getDispatcher, isLive, invokeCommand }) {
+    const bridge = {
+      async show(payload, sourceActor = null) {
+        if (!isLive() || pending) {
+          finishPending();
+        }
+        if (!isLive() || (sourceActor && !sourceIsCurrent(sourceActor))) {
+          return null;
+        }
+        const win = getWindow();
+        const tab = getTab();
+        if (!tab?.getActive?.()) {
+          return null;
+        }
+        const menu = {
+          id: "contentAreaContextMenu",
+          documentGlobal: win,
+          ownerDocument: win?.document,
+        };
+        const contextData = contextFromPayload(payload, tab, menu);
+        if (!contextData) {
+          return null;
+        }
+        const built = buildItems(contextData);
+        const { items, itemsById, extensions } = built;
+        // Navis supplies ordinary page/link actions even when no extension
+        // contributes an item. Keep the same single-use native transaction.
+        const token = Services.uuid.generateUUID().toString()
+          .slice(1, -1).replace(/-/g, "");
+        pending = {
+          token,
+          win,
+          tab,
+          contextData,
+          sourceActor,
+          items,
+          itemsById,
+          extensions,
+          rebuild() {
+            if (pending?.token !== token || !isLive()) return;
+            const next = buildItems(contextData);
+            pending.itemsById = next.itemsById;
+            pending.extensions = next.extensions;
+            pending.items = next.items;
+            try {
+              pending.updateNative?.(nativeRequest(token, tab, contextData, next.items));
+            } catch (error) {
+              finishPending();
+            }
+          },
+          cancelNative: () => getDispatcher().sendRequest(
+            "GeckoView:ContextMenu:Cancel", { token }),
+          updateNative: request => getDispatcher().sendRequest(
+            "GeckoView:ContextMenu:Update", request),
+        };
+        for (const extension of extensions) {
+          try {
+            extension.emit("webext-menu-shown", items
+              .filter(item => item.extensionId === extension.id)
+              .map(item => item.menuId), contextData);
+          } catch (error) {
+            Cu.reportError(error);
+          }
+        }
+        let result;
+        try {
+          result = await getDispatcher().sendRequestForResult(
+            "GeckoView:ContextMenu", nativeRequest(
+              token, tab, contextData,
+              pending?.token === token ? pending.items : items));
+        } catch (error) {
+          if (pending?.token === token) finishPending();
+          return null;
+        }
+        return bridge.select(token, result?.itemId);
+      },
+
+      async select(token, itemId) {
+        const current = pending;
+        if (!TOKEN_RE.test(token || "") || !current || current.token !== token || !isLive() ||
+            getWindow() !== current.win || getTab() !== current.tab ||
+            !current.tab?.getActive?.()) {
+          return null;
+        }
+        if (typeof itemId !== "string" || itemId.length > 256) {
+          finishPending();
+          return null;
+        }
+        if (current.sourceActor && !sourceIsCurrent(current.sourceActor)) {
+          finishPending();
+          return null;
+        }
+        if (itemId.startsWith(PAGE_COMMAND_PREFIX)) {
+          const command = itemId.slice(PAGE_COMMAND_PREFIX.length);
+          if (!sourceIsCurrent(current.sourceActor) || !current.contextData.targetToken ||
+              !current.contextData.pageActions.some(action => action.id === command && action.enabled)) {
+            finishPending();
+            return null;
+          }
+          try {
+            const result = await current.sourceActor.sendQuery("NavisAndroid:ContextAction", {
+              token: current.contextData.targetToken, command,
+            });
+            if (pending === current) finishPending();
+            return result?.handled ? Object.freeze({}) : null;
+          } catch {
+            if (pending === current) finishPending();
+            return null;
+          }
+        }
+        const item = current.itemsById.get(itemId);
+        if (!item || item.type === "separator" || !item.enabled ||
+            !item.extension?.isActive || item.extension.hasShutdown) {
+          finishPending();
+          return null;
+        }
+        try {
+          if (!item.enabledForContext(current.contextData)) {
+            finishPending();
+            return null;
