From 560e14e567ecd09e0fa6846aaff23246b29fbddd Mon Sep 17 00:00:00 2001
From: willvar <0@willvar.tw>
Date: Sat, 29 Aug 2026 19:06:03 +0800
Subject: [PATCH] Allow explicit system automation only in test builds

---
 remote/components/RemoteAgent.sys.mjs         |  8 +++--
 remote/marionette/driver.sys.mjs              | 10 +++---
 testing/web-platform/mach_commands.py         | 11 +++++--
 .../extensions/parent/ext-storage.js          | 33 +++++++++++++++++++
 toolkit/modules/AppConstants.sys.mjs          |  7 ++++
 5 files changed, 60 insertions(+), 9 deletions(-)

diff --git a/remote/components/RemoteAgent.sys.mjs b/remote/components/RemoteAgent.sys.mjs
index c25eeb7f5f0a..a9e5d09af813 100644
--- a/remote/components/RemoteAgent.sys.mjs
+++ b/remote/components/RemoteAgent.sys.mjs
@@ -45,8 +45,12 @@ class RemoteAgentParentProcess {
   constructor() {
     this.#allowHosts = null;
     this.#allowOrigins = null;
+    // Desktop Embedder production builds never expose parent-process
+    // automation. Gecko's own WPT harness needs it to install and restore
+    // per-test preferences, so retain the explicit upstream opt-in only in
+    // --enable-tests builds.
     this.#allowSystemAccess =
-      !AppConstants.MOZ_DESKTOP_EMBEDDER &&
+      (!AppConstants.MOZ_DESKTOP_EMBEDDER || AppConstants.ENABLE_TESTS) &&
       Services.env.exists(ENV_ALLOW_SYSTEM_ACCESS);
     this.#browserStartupFinished = lazy.Deferred();
     this.#enabled = false;
@@ -101,7 +105,7 @@ class RemoteAgentParentProcess {
     // Desktop Embedder exposes content automation only. Privileged parent-
     // process script execution would become a generic side door around the
     // product's deliberately absent extension-install and management APIs.
-    if (AppConstants.MOZ_DESKTOP_EMBEDDER) {
+    if (AppConstants.MOZ_DESKTOP_EMBEDDER && !AppConstants.ENABLE_TESTS) {
       return;
     }
 
diff --git a/remote/marionette/driver.sys.mjs b/remote/marionette/driver.sys.mjs
index 525f5b314a6e..d556116e7148 100644
--- a/remote/marionette/driver.sys.mjs
+++ b/remote/marionette/driver.sys.mjs
@@ -4415,11 +4415,11 @@ export class GeckoDriver {
     "Marionette:Quit": GeckoDriver.prototype.quit,
     "Marionette:RegisterChromeHandler":
       GeckoDriver.prototype.registerChromeHandler,
-    ...(AppConstants.MOZ_DESKTOP_EMBEDDER
-      ? {}
-      : {
-          "Marionette:SetContext": GeckoDriver.prototype.setContext,
-        }),
+    // Desktop Embedder keeps this command for content-only harnesses. Its
+    // context setter still calls assert.hasSystemAccess() for "chrome";
+    // production builds deny that access, while explicit --enable-tests builds
+    // may opt in for Gecko's own harnesses.
+    "Marionette:SetContext": GeckoDriver.prototype.setContext,
     "Marionette:SetScreenOrientation":
       GeckoDriver.prototype.setScreenOrientation,
     "Marionette:UnregisterChromeHandler":
diff --git a/testing/web-platform/mach_commands.py b/testing/web-platform/mach_commands.py
index 1caba01f3e91..b4390ea8ecba 100644
--- a/testing/web-platform/mach_commands.py
+++ b/testing/web-platform/mach_commands.py
@@ -20,6 +20,13 @@ here = os.path.abspath(os.path.dirname(__file__))
 INTEROP_REQUIREMENTS_PATH = os.path.join(here, "interop_requirements.txt")
 
 
+def is_supported_gecko_product(command_context):
+    return (
+        conditions.is_firefox_or_android(command_context)
+        or command_context.substs.get("MOZ_DESKTOP_EMBEDDER")
+    )
+
+
 class WebPlatformTestsRunnerSetup(MozbuildObject):
     default_log_type = "mach"
 
@@ -476,7 +483,7 @@ def create_parser_testpaths():
 @Command(
     "web-platform-tests",
     category="testing",
-    conditions=[conditions.is_firefox_or_android],
+    conditions=[is_supported_gecko_product],
     description="Run web-platform-tests.",
     parser=create_parser_wpt,
     virtualenv_name="wpt",
@@ -529,7 +536,7 @@ def run_web_platform_tests(command_context, **params):
 @Command(
     "wpt",
     category="testing",
-    conditions=[conditions.is_firefox_or_android],
+    conditions=[is_supported_gecko_product],
     description="Run web-platform-tests.",
     parser=create_parser_wpt,
     virtualenv_name="wpt",
diff --git a/toolkit/components/extensions/parent/ext-storage.js b/toolkit/components/extensions/parent/ext-storage.js
index 62a0221891ae..b3fb7039bed6 100644
--- a/toolkit/components/extensions/parent/ext-storage.js
+++ b/toolkit/components/extensions/parent/ext-storage.js
@@ -79,8 +79,41 @@ async function recordSyncQuotaTelemetry(extension, context) {
 
 // WeakMap[extension -> Promise<SerializableMap?>]
 const managedStorage = new WeakMap();
+const PREF_APPLICATION_BUILTIN_TEST_MANAGED_STORAGE =
+  "extensions.applicationBuiltins.testManagedStorage";
+
+const lookupApplicationBuiltinTestManagedStorage = extensionId => {
+  if (!AppConstants.MOZ_DESKTOP_EMBEDDER || !AppConstants.ENABLE_TESTS) {
+    return null;
+  }
+
+  const serialized = Services.prefs.getStringPref(
+    PREF_APPLICATION_BUILTIN_TEST_MANAGED_STORAGE,
+    ""
+  );
+  if (!serialized) {
+    return null;
+  }
+
+  try {
+    const policies = JSON.parse(serialized);
+    const extensionPolicy = policies?.[extensionId];
+    if (extensionPolicy && typeof extensionPolicy === "object") {
+      return ExtensionStorage._serializableMap(extensionPolicy);
+    }
+  } catch (error) {
+    Cu.reportError(
+      `Invalid ${PREF_APPLICATION_BUILTIN_TEST_MANAGED_STORAGE}: ${error}`
+    );
+  }
+  return null;
+};
 
 const lookupManagedStorage = async (extensionId, context) => {
+  const testPolicy = lookupApplicationBuiltinTestManagedStorage(extensionId);
+  if (testPolicy) {
+    return testPolicy;
+  }
   if (Services.policies) {
     let extensionPolicy = Services.policies.getExtensionPolicy(extensionId);
     if (extensionPolicy) {
diff --git a/toolkit/modules/AppConstants.sys.mjs b/toolkit/modules/AppConstants.sys.mjs
index c4585059a53b..c2703a53bb28 100644
--- a/toolkit/modules/AppConstants.sys.mjs
+++ b/toolkit/modules/AppConstants.sys.mjs
@@ -140,6 +140,13 @@ export var AppConstants = Object.freeze({
   false,
 #endif
 
+  ENABLE_TESTS:
+#ifdef ENABLE_TESTS
+  true,
+#else
+  false,
+#endif
+
   MOZ_WEBEXTENSIONS_RUNTIME:
 #ifdef MOZ_WEBEXTENSIONS_RUNTIME
   true,
