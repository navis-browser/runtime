 const navigationProgress = new AndroidNavigationProgress();
 
+// pagetitlechanged belongs to the remote <browser>, not the child document's
+// DOMTitleChanged event. Never trust an event's old document/title payload:
+// read the current WindowGlobal and bind it to the committed navigation URI.
+class AndroidPageTitles {
+  current = null;
+  last = null;
+
+  invalidate() {
+    this.current = null;
+    this.last = null;
+  }
+
+  location(uri, navigation) {
+    this.invalidate();
+    if (!navigation.errorPage && navigation.generation > 0 &&
+        !navigationProgress.overlapping && typeof uri === "string" &&
+        uri.length > 0 && uri.length <= 65536) {
+      this.current = { uri, generation: navigation.generation };
+      this.publish();
+    }
+  }
+
+  publish() {
+    const current = this.current;
+    if (shuttingDown || !current || !browser || !dispatcher ||
+        navigationProgress.overlapping ||
+        current.generation !== navigationProgress.generation) return;
+    const global = browser.browsingContext?.currentWindowGlobal;
+    const documentURI = global?.documentURI?.spec;
+    // A location notification may precede replacement of the WindowGlobal.
+    // Ignore the old page until the matching document is really current.
+    if (!documentURI || !global.innerWindowId ||
+        documentURI.split("#", 1)[0] !== current.uri.split("#", 1)[0]) return;
+    const title = (global.documentTitle ?? "").slice(0, 65536);
+    const key = JSON.stringify([current.generation, current.uri, global.innerWindowId, title]);
+    if (this.last === key) return;
+    this.last = key;
+    dispatcher.dispatch("NavisAndroid:Title", { ...current, title });
+  }
+
+  handleEvent(event) {
+    if (event.type === "pagetitlechanged" && event.target === browser) this.publish();
+  }
+}
+
+const pageTitles = new AndroidPageTitles();
