+/** Private direct-runtime peer for the Android WebExtensions downloads API. */
+public final class NavisAndroidExtensionDownloads implements AutoCloseable {
+  private static final String DISPATCHER_NAME = "navis-android-extension-downloads";
+
+  private static final String COMMAND_DOWNLOAD = "NavisAndroid:Downloads:Download";
+  private static final String COMMAND_LIST = "NavisAndroid:Downloads:List";
+  private static final String COMMAND_PAUSE = "NavisAndroid:Downloads:Pause";
+  private static final String COMMAND_RESUME = "NavisAndroid:Downloads:Resume";
+  private static final String COMMAND_CANCEL = "NavisAndroid:Downloads:Cancel";
+  private static final String COMMAND_ERASE = "NavisAndroid:Downloads:Erase";
+  private static final String COMMAND_OPEN = "NavisAndroid:Downloads:Open";
+  private static final String COMMAND_SHOW = "NavisAndroid:Downloads:Show";
+  private static final String COMMAND_SHOW_DEFAULT_FOLDER =
+      "NavisAndroid:Downloads:ShowDefaultFolder";
+  private static final String COMMAND_REMOVE_FILE = "NavisAndroid:Downloads:RemoveFile";
+  private static final String COMMAND_GET_FILE_ICON = "NavisAndroid:Downloads:GetFileIcon";
+
+  private static final String EVENT_CREATED = "NavisAndroid:Downloads:Created";
+  private static final String EVENT_CHANGED = "NavisAndroid:Downloads:Changed";
+  private static final String EVENT_ERASED = "NavisAndroid:Downloads:Erased";
+
+  private static final int MAX_URI_CHARS = 64 * 1024;
+  private static final int MAX_PATH_CHARS = 4 * 1024;
+  private static final int MAX_BODY_BYTES = 8 * 1024 * 1024;
+  private static final int MAX_HEADERS = 64;
+  private static final int MAX_HEADER_NAME_CHARS = 256;
+  private static final int MAX_HEADER_VALUE_CHARS = 16 * 1024;
+  private static final int MAX_ERASE_IDS = 10_000;
+  private static final long MAX_SAFE_INTEGER = 9_007_199_254_740_991L;
+
+  private static final Set<String> FORBIDDEN_HEADERS =
+      Collections.unmodifiableSet(
+          new HashSet<>(
+              Arrays.asList(
+          "ACCEPT-CHARSET",
+          "ACCEPT-ENCODING",
+          "ACCESS-CONTROL-REQUEST-HEADERS",
+          "ACCESS-CONTROL-REQUEST-METHOD",
+          "CONNECTION",
+          "CONTENT-LENGTH",
+          "COOKIE",
+          "COOKIE2",
+          "DATE",
+          "DNT",
+          "EXPECT",
+          "HOST",
+          "KEEP-ALIVE",
+          "ORIGIN",
+          "TE",
+          "TRAILER",
+          "TRANSFER-ENCODING",
+          "UPGRADE",
+          "VIA")));
+
+  public static final class Header {
+    public final String name;
+    public final String value;
+
+    private Header(final String name, final String value) {
+      this.name = name;
+      this.value = value;
+    }
+  }
+
+  public static final class Request {
+    public final String extensionId;
+    public final String extensionName;
+    public final String sourceUri;
+    public final String suggestedRelativePath;
+    public final boolean privateMode;
+    public final boolean privateBrowsingAllowed;
+    public final boolean saveAs;
+    public final String conflictAction;
+    public final String method;
+    public final Header[] headers;
+    public final String body;
+    public final boolean allowHttpErrors;
+
+    private Request(final GeckoBundle message) {
+      if (message == null) {
+        throw new IllegalArgumentException("Missing extension download request");
+      }
+      extensionId = requiredString(message, "extensionId", 256);
+      extensionName = boundedString(message.getString("extensionName", ""), 256);
+      sourceUri = requiredString(message, "url", MAX_URI_CHARS);
+      requireSupportedUri(sourceUri);
+      if (sourceUri.toLowerCase(Locale.ROOT).startsWith("moz-extension://")) {
+        final String baseUri = requiredString(message, "extensionBaseUri", 1024);
+        if (!baseUri.startsWith("moz-extension://")
+            || !baseUri.endsWith("/")
+            || !sourceUri.startsWith(baseUri)) {
+          throw new IllegalArgumentException("An extension cannot download another extension's resource");
+        }
+      }
+      suggestedRelativePath = optionalString(message, "filename", MAX_PATH_CHARS);
+      validateRelativePath(suggestedRelativePath);
+      privateMode = message.getBoolean("incognito", false);
+      privateBrowsingAllowed = message.getBoolean("privateBrowsingAllowed", false);
+      if (privateMode && !privateBrowsingAllowed) {
+        throw new IllegalArgumentException("Private browsing access not allowed");
+      }
+      validateCookieStore(message.getString("cookieStoreId"), privateMode);
+      saveAs = message.getBoolean("saveAs", false);
+      conflictAction = message.getString("conflictAction", "uniquify").toUpperCase(Locale.ROOT);
+      if (!conflictAction.equals("UNIQUIFY")
+          && !conflictAction.equals("OVERWRITE")
+          && !conflictAction.equals("PROMPT")) {
+        throw new IllegalArgumentException("Invalid filename conflict action");
+      }
+      method = message.getString("method", "GET").toUpperCase(Locale.ROOT);
+      if (!method.equals("GET") && !method.equals("POST")) {
+        throw new IllegalArgumentException("Invalid download request method");
+      }
+      headers = parseHeaders(message.getBundleArray("headers"));
+      body = optionalString(message, "body", MAX_BODY_BYTES);
+      if (body != null && body.getBytes(StandardCharsets.UTF_8).length > MAX_BODY_BYTES) {
+        throw new IllegalArgumentException("Download request body is too large");
+      }
+      allowHttpErrors = message.getBoolean("allowHttpErrors", false);
+    }
+  }
+
+  public static final class Destination {
+    public final long sessionId;
+    public final String destinationUri;
+    public final String replaceExistingUri;
+    public final boolean requireExactFileName;
+
+    public Destination(final long sessionId, final String destinationUri) {
+      this(sessionId, destinationUri, null, false);
+    }
+
+    public Destination(final long sessionId, final String destinationUri,
+        final String replaceExistingUri, final boolean requireExactFileName) {
+      if (sessionId <= 0) {
+        throw new IllegalArgumentException("Invalid extension download session");
+      }
+      if (destinationUri != null && !destinationUri.startsWith("content://")) {
+        throw new IllegalArgumentException("Invalid extension download destination");
+      }
+      this.sessionId = sessionId;
+      this.destinationUri = destinationUri;
+      if (replaceExistingUri != null && (destinationUri != null ||
+          (!replaceExistingUri.startsWith("content://") && !replaceExistingUri.startsWith("file://")))) {
+        throw new IllegalArgumentException("Invalid replacement download destination");
+      }
+      this.replaceExistingUri = replaceExistingUri;
+      this.requireExactFileName = requireExactFileName;
+    }
+  }
+
+  public static final class Response {
+    public final String finalUri;
+    public final int statusCode;
+    public final String contentType;
+    public final String contentDisposition;
+    public final Long contentLength;
+    public final InputStream body;
+
+    private Response(final WebResponse response) {
+      finalUri = boundedString(response.uri, MAX_URI_CHARS);
+      statusCode = response.statusCode;
+      contentType = boundedNullable(response.headers.get("content-type"), 256);
+      contentDisposition = boundedNullable(response.headers.get("content-disposition"), 4096);
+      contentLength = parsePositiveLong(response.headers.get("content-length"));
+      body = response.body;
+    }
+  }
+
+  public static final class Record {
+    public final long id;
+    public final String sourceUri;
+    public final String referrer;
+    public final String filename;
+    public final boolean privateMode;
+    public final String mimeType;
+    public final String startTime;
+    public final String endTime;
+    public final String state;
+    public final boolean paused;
+    public final boolean canResume;
+    public final String error;
+    public final long bytesReceived;
+    public final long totalBytes;
+    public final long fileSize;
+    public final boolean exists;
+    public final String byExtensionId;
+    public final String byExtensionName;
+
+    public Record(
+        final long id,
+        final String sourceUri,
+        final String referrer,
+        final String filename,
+        final boolean privateMode,
+        final String mimeType,
+        final String startTime,
+        final String endTime,
+        final String state,
+        final boolean paused,
+        final boolean canResume,
+        final String error,
+        final long bytesReceived,
+        final long totalBytes,
+        final long fileSize,
+        final boolean exists,
+        final String byExtensionId,
+        final String byExtensionName) {
+      if (id <= 0 || id > MAX_SAFE_INTEGER) {
+        throw new IllegalArgumentException("Invalid extension download ID");
+      }
+      this.id = id;
+      this.sourceUri = boundedString(sourceUri, MAX_URI_CHARS);
+      this.referrer = boundedString(referrer, MAX_URI_CHARS);
+      this.filename = boundedString(filename, MAX_URI_CHARS);
+      this.privateMode = privateMode;
+      this.mimeType = boundedString(mimeType, 256);
+      this.startTime = boundedString(startTime, 64);
+      this.endTime = boundedNullable(endTime, 64);
+      this.state = requiredValue(state, "IN_PROGRESS", "INTERRUPTED", "COMPLETE");
+      this.paused = paused;
+      this.canResume = canResume;
+      this.error = boundedNullable(error, 64);
+      this.bytesReceived = Math.max(0L, bytesReceived);
+      this.totalBytes = Math.max(-1L, totalBytes);
+      this.fileSize = Math.max(-1L, fileSize);
+      this.exists = exists;
+      this.byExtensionId = boundedNullable(byExtensionId, 256);
+      this.byExtensionName = boundedNullable(byExtensionName, 256);
+    }
+
+    private GeckoBundle toBundle() {
+      final GeckoBundle value = new GeckoBundle(20);
+      value.putLong("id", id);
+      value.putString("url", sourceUri);
+      value.putString("referrer", referrer);
+      value.putString("filename", filename);
+      value.putBoolean("incognito", privateMode);
+      value.putString("cookieStoreId", privateMode ? "firefox-private" : "firefox-default");
+      value.putString("danger", "safe");
+      value.putString("mime", mimeType);
+      value.putString("startTime", startTime);
+      value.putString("endTime", endTime);
+      value.putString("state", state.toLowerCase(Locale.ROOT));
+      value.putBoolean("paused", paused);
+      value.putBoolean("canResume", canResume);
+      value.putString("error", error);
+      value.putLong("bytesReceived", bytesReceived);
+      value.putLong("totalBytes", totalBytes);
+      value.putLong("fileSize", fileSize);
+      value.putBoolean("exists", exists);
+      value.putString("byExtensionId", byExtensionId);
+      value.putString("byExtensionName", byExtensionName);
+      return value;
+    }
+  }
+
+  public interface Delegate {
+    CompletionStage<Destination> onPrepare(Request request);
+
+    CompletionStage<Record> onStart(Request request, Destination destination, Response response);
+
+    CompletionStage<Record[]> onList(boolean privateBrowsingAllowed);
+
+    CompletionStage<Void> onPause(long id, boolean privateBrowsingAllowed);
+
+    CompletionStage<Void> onResume(long id, boolean privateBrowsingAllowed);
+
+    CompletionStage<Void> onCancel(long id, boolean privateBrowsingAllowed);
+
+    CompletionStage<long[]> onErase(long[] ids, boolean privateBrowsingAllowed);
+
+    CompletionStage<Void> onOpen(long id, boolean privateBrowsingAllowed);
+
+    CompletionStage<Boolean> onShow(long id, boolean privateBrowsingAllowed);
+
+    CompletionStage<Void> onShowDefaultFolder();
+
+    CompletionStage<Void> onRemoveFile(long id, boolean privateBrowsingAllowed);
+
+    CompletionStage<String> onGetFileIcon(long id, int size, boolean privateBrowsingAllowed);
+  }
+
+  private static NavisAndroidExtensionDownloads sInstance;
+
+  private final Delegate mDelegate;
+  private final EventDispatcher mDispatcher;
+  private final NavisAndroidWebExecutor mExecutor = new NavisAndroidWebExecutor();
+  private final Handler mUiHandler = new Handler(Looper.getMainLooper());
+  private final BundleEventListener mListener = this::handleMessage;
+  private final Set<PendingCommand> mPending = new HashSet<>();
+  private boolean mClosed;
+
+  private NavisAndroidExtensionDownloads(final Delegate delegate) {
+    mDelegate = delegate;
+    mDispatcher = EventDispatcher.byName(DISPATCHER_NAME);
+    mDispatcher.registerUiThreadListener(
+        mListener,
+        COMMAND_DOWNLOAD,
+        COMMAND_LIST,
+        COMMAND_PAUSE,
+        COMMAND_RESUME,
+        COMMAND_CANCEL,
+        COMMAND_ERASE,
+        COMMAND_OPEN,
+        COMMAND_SHOW,
+        COMMAND_SHOW_DEFAULT_FOLDER,
+        COMMAND_REMOVE_FILE,
+        COMMAND_GET_FILE_ICON);
+  }
+
+  public static synchronized NavisAndroidExtensionDownloads install(final Delegate delegate) {
+    ThreadUtils.assertOnUiThread();
+    if (delegate == null) {
+      throw new NullPointerException("delegate");
+    }
+    if (sInstance != null) {
+      throw new IllegalStateException("Only one Navis extension-download peer may be installed");
+    }
+    sInstance = new NavisAndroidExtensionDownloads(delegate);
+    return sInstance;
+  }
+
+  public void publishCreated(final Record item) {
+    publish(EVENT_CREATED, item == null ? null : item.toBundle());
+  }
+
+  public void publishChanged(final Record previous, final Record current) {
+    if (previous == null || current == null || previous.id != current.id) {
+      return;
+    }
+    final GeckoBundle value = new GeckoBundle(2);
+    value.putBundle("previous", previous.toBundle());
+    value.putBundle("current", current.toBundle());
+    publish(EVENT_CHANGED, value);
+  }
+
+  public void publishErased(final long id, final boolean privateMode) {
+    if (!validId(id)) {
+      return;
+    }
+    final GeckoBundle value = new GeckoBundle(2);
+    value.putLong("id", id);
+    value.putBoolean("incognito", privateMode);
+    publish(EVENT_ERASED, value);
+  }
+
+  private void publish(final String event, final GeckoBundle value) {
+    final Runnable action = () -> {
+      if (!mClosed) {
+        mDispatcher.dispatch(event, value);
+      }
+    };
+    if (Looper.myLooper() == Looper.getMainLooper()) {
+      action.run();
+    } else {
+      mUiHandler.post(action);
+    }
+  }
+
+  private void handleMessage(
+      final String event, final GeckoBundle message, final EventCallback callback) {
+    ThreadUtils.assertOnUiThread();
+    if (callback == null) {
+      return;
+    }
+    if (mClosed) {
+      callback.sendError("Extension downloads are closed");
+      return;
+    }
+    try {
+      switch (event) {
+        case COMMAND_DOWNLOAD:
+          download(new Request(message), callback);
+          return;
+        case COMMAND_LIST:
+          runStage(
+              callback,
+              () -> mDelegate.onList(privateAllowed(message)),
+              records -> {
+                final GeckoBundle result = new GeckoBundle(1);
+                final GeckoBundle[] items = new GeckoBundle[records.length];
+                for (int index = 0; index < records.length; index++) {
+                  items[index] = records[index].toBundle();
+                }
+                result.putBundleArray("items", items);
+                return result;
+              });
+          return;
+        case COMMAND_PAUSE:
+          runVoid(
+              callback,
+              () -> mDelegate.onPause(requiredId(message), privateAllowed(message)));
+          return;
+        case COMMAND_RESUME:
+          runVoid(
+              callback,
+              () -> mDelegate.onResume(requiredId(message), privateAllowed(message)));
+          return;
+        case COMMAND_CANCEL:
+          runVoid(
+              callback,
+              () -> mDelegate.onCancel(requiredId(message), privateAllowed(message)));
+          return;
+        case COMMAND_ERASE:
+          final long[] ids = requiredIds(message);
+          runStage(
+              callback,
+              () -> mDelegate.onErase(ids, privateAllowed(message)),
+              erased -> {
+                final GeckoBundle result = new GeckoBundle(1);
+                result.putLongArray("ids", erased);
+                return result;
+              });
+          return;
+        case COMMAND_OPEN:
+          runVoid(
+              callback,
+              () -> mDelegate.onOpen(requiredId(message), privateAllowed(message)));
+          return;
+        case COMMAND_SHOW:
+          runStage(
+              callback,
+              () -> mDelegate.onShow(requiredId(message), privateAllowed(message)),
+              value -> value);
+          return;
+        case COMMAND_SHOW_DEFAULT_FOLDER:
+          runVoid(callback, mDelegate::onShowDefaultFolder);
+          return;
+        case COMMAND_REMOVE_FILE:
+          runVoid(callback, () -> mDelegate.onRemoveFile(requiredId(message), privateAllowed(message)));
+          return;
+        case COMMAND_GET_FILE_ICON:
+          final int size = message.getInt("size", 32);
+          if (size != 16 && size != 32) {
+            throw new IllegalArgumentException("File icon size must be 16 or 32");
+          }
+          runStage(callback,
+              () -> mDelegate.onGetFileIcon(requiredId(message), size, privateAllowed(message)),
+              value -> {
+                if (value == null || !value.startsWith("data:image/png;base64,") ||
+                    value.length() > 96 * 1024) {
+                  throw new IllegalArgumentException("Invalid Android file icon");
+                }
+                return value;
+              });
+          return;
+        default:
+          callback.sendError("Unknown extension download operation");
+      }
+    } catch (final Throwable error) {
+      callback.sendError(publicMessage(error));
+    }
+  }
+
+  /** Repeats a product-requested, bodyless GET using the original extension fetch context. */
+  public CompletionStage<Boolean> retryDownload(final Request request) {
+    final CompletableFuture<Boolean> result = new CompletableFuture<>();
+    onUi(
+        () -> {
+          if (mClosed || request == null || !request.method.equals("GET")
+              || request.body != null || !isHttp(request.sourceUri)) {
+            result.completeExceptionally(new IllegalStateException("Download cannot safely be retried"));
+            return;
+          }
+          download(
+              request,
+              new EventCallback() {
+                @Override
+                public void sendSuccess(final Object value) {
+                  result.complete(value instanceof GeckoBundle);
+                }
+
+                @Override
+                public void sendError(final Object error) {
+                  result.completeExceptionally(new IllegalStateException(String.valueOf(error)));
+                }
+              });
+        });
+    return result;
+  }
+
+  private void download(final Request request, final EventCallback callback) {
+    final PendingCommand pending = new PendingCommand(callback);
+    mPending.add(pending);
+    final CompletionStage<Destination> prepared;
+    try {
+      prepared = requireStage(mDelegate.onPrepare(request));
+    } catch (final Throwable error) {
+      pending.fail(error);
+      return;
+    }
+    prepared.whenComplete(
+        (destination, error) ->
+            onUi(
+                () -> {
+                  if (error != null) {
+                    pending.fail(error);
+                    return;
+                  }
+                  if (destination == null) {
+                    pending.fail(new IllegalStateException("Download target was not selected"));
+                    return;
+                  }
+                  fetch(request, destination, pending);
+                }));
+  }
+
+  private void fetch(
+      final Request request, final Destination destination, final PendingCommand pending) {
+    if (!pending.active()) {
+      return;
+    }
+    final WebRequest webRequest;
+    try {
+      final WebRequest.Builder builder = new WebRequest.Builder(request.sourceUri).method(request.method);
+      for (final Header header : request.headers) {
+        if (header.name.equalsIgnoreCase("referer")) {
+          builder.referrer(header.value);
+        } else {
