+  private static String boundedNullable(final String value, final int maximum) {
+    if (value == null) {
+      return null;
+    }
+    return boundedString(value, maximum);
+  }
+
+  private static Long parsePositiveLong(final String value) {
+    if (value == null) {
+      return null;
+    }
+    try {
