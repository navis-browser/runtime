@@ -0,0 +1,56 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.gecko.navis;
+
+import java.util.concurrent.CompletionException;
+import java.util.concurrent.ExecutionException;
+import org.mozilla.gecko.EventDispatcher;
+import org.mozilla.gecko.util.GeckoBundle;
+
+/** Preserves only reviewed binding phases, never exception text or popup identifiers. */
+final class NavisAndroidPopupBindingFailure {
+  private NavisAndroidPopupBindingFailure() {}
+
+  static String code(final Throwable failure) {
+    Throwable error = failure;
+    for (int depth = 0; depth < 4
+        && (error instanceof CompletionException || error instanceof ExecutionException);
+        depth++) {
+      error = error.getCause();
+    }
+    if (error instanceof EventDispatcher.QueryException) {
+      final Object data = ((EventDispatcher.QueryException) error).data;
+      if (data instanceof GeckoBundle) {
+        final String candidate;
+        try {
+          candidate = ((GeckoBundle) data).getString("code");
+        } catch (final RuntimeException invalidData) {
+          return "popup-bind-failed";
+        }
+        if (candidate != null) {
+          switch (candidate) {
+            case "popup-invalid-target":
+            case "popup-transaction-stale":
+            case "popup-owner-invalid":
+            case "popup-owner-reused":
+            case "popup-owner-name":
+            case "popup-source-inaccessible":
+            case "popup-source-inactive":
+            case "popup-private-mismatch":
+            case "popup-target-reused":
+            case "popup-viewtype":
+            case "popup-viewtype-failed":
+            case "popup-insertion-failed":
+            case "popup-load-failed":
+              return candidate;
+            default:
+              break;
+          }
+        }
+      }
+    }
+    return "popup-bind-failed";
+  }
+}
