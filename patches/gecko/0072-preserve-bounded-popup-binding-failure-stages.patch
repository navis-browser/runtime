diff --git a/mobile/android/geckoview/src/main/java/org/mozilla/gecko/navis/NavisAndroidPopupBindingFailure.java b/mobile/android/geckoview/src/main/java/org/mozilla/gecko/navis/NavisAndroidPopupBindingFailure.java
