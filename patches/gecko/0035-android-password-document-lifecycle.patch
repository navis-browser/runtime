+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.gecko.navis;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.Set;
+import java.util.concurrent.CompletionStage;
+import java.util.concurrent.CompletableFuture;
+import org.mozilla.gecko.EventDispatcher;
+import org.mozilla.gecko.util.BundleEventListener;
+import org.mozilla.gecko.util.EventCallback;
+import org.mozilla.gecko.util.GeckoBundle;
+import org.mozilla.gecko.util.ThreadUtils;
+
+/**
+ * Navis-owned receiver for Gecko's real password-manager storage events.
+ *
+ * <p>This is a private process peer, not GeckoView's {@code Autocomplete.StorageProxy}. It listens
+ * on Gecko's global dispatcher because {@code storage-geckoview.sys.mjs} deliberately treats login
+ * storage as process-wide. Credential values never reach product UI and are never logged.
+ */
+public final class NavisAndroidLogins implements AutoCloseable {
+  public static final int USED_FIELD_PASSWORD = 1;
+
+  private static final String FETCH_LOGIN_EVENT = "GeckoView:Autocomplete:Fetch:Login";
+  private static final String SAVE_LOGIN_EVENT = "GeckoView:Autocomplete:Save:Login";
+  private static final String USED_LOGIN_EVENT = "GeckoView:Autocomplete:Used:Login";
+  private static final String STORAGE_ATTACHED_EVENT = "GeckoView:StorageDelegate:Attached";
+
+  private static final int MAX_FETCH_RESULTS = 500;
+  private static final int MAX_GUID_CHARS = 128;
+  private static final int MAX_ORIGIN_CHARS = 16 * 1024;
+  private static final int MAX_REALM_CHARS = 4 * 1024;
+  private static final int MAX_USERNAME_CHARS = 4 * 1024;
+  private static final int MAX_PASSWORD_CHARS = 16 * 1024;
+
+  /** Private, engine-neutral value crossing only the direct Runtime adapter. */
+  public static final class Login {
+    public final String guid;
+    public final String origin;
+    public final String formActionOrigin;
+    public final String httpRealm;
+    public final String username;
+    public final String password;
+
+    public Login(
+        final String guid,
+        final String origin,
+        final String formActionOrigin,
+        final String httpRealm,
+        final String username,
+        final String password) {
+      this.guid = guid;
+      this.origin = origin;
+      this.formActionOrigin = formActionOrigin;
+      this.httpRealm = httpRealm;
+      this.username = username;
+      this.password = password;
+    }
+
+    static Login fromBundle(final GeckoBundle bundle) {
+      if (bundle == null) {
+        return null;
+      }
+      final Login login =
+          new Login(
+              bundle.getString("guid"),
+              bundle.getString("origin", ""),
+              bundle.getString("formActionOrigin"),
+              bundle.getString("httpRealm"),
+              bundle.getString("username", ""),
+              bundle.getString("password", ""));
+      return login.isValid() ? login : null;
+    }
+
+    private boolean isValid() {
+      return withinNullable(guid, MAX_GUID_CHARS)
+          && withinRequired(origin, MAX_ORIGIN_CHARS)
+          && withinNullable(formActionOrigin, MAX_ORIGIN_CHARS)
+          && withinNullable(httpRealm, MAX_REALM_CHARS)
+          && !(formActionOrigin != null && httpRealm != null)
+          && username != null
+          && username.length() <= MAX_USERNAME_CHARS
+          && password != null
+          && !password.isEmpty()
+          && password.length() <= MAX_PASSWORD_CHARS;
+    }
+
+    private GeckoBundle toBundle() {
+      final GeckoBundle bundle = new GeckoBundle(6);
+      bundle.putString("guid", guid);
+      bundle.putString("origin", origin);
+      bundle.putString("formActionOrigin", formActionOrigin);
+      bundle.putString("httpRealm", httpRealm);
+      bundle.putString("username", username);
+      bundle.putString("password", password);
+      return bundle;
+    }
+  }
+
+  public interface Delegate {
+    CompletionStage<Login[]> onLoginFetch(String domain);
+
+    CompletionStage<Void> onLoginSave(Login login);
+
+    void onLoginUsed(Login login, int usedFields);
+  }
+
+  private static NavisAndroidLogins sInstance;
+
+  private final Delegate mDelegate;
+  private final EventDispatcher mDispatcher;
+  private final BundleEventListener mListener = this::handleMessage;
+  private final Set<PendingFetch> mPendingFetches = new HashSet<>();
+  private final Set<CompletableFuture<Void>> mPendingSaves = new HashSet<>();
+  private boolean mRegistered;
+  private boolean mClosed;
+
+  private NavisAndroidLogins(final Delegate delegate) {
+    mDelegate = delegate;
+    mDispatcher = EventDispatcher.getInstance();
+  }
+
+  public static synchronized NavisAndroidLogins install(final Delegate delegate) {
+    ThreadUtils.assertOnUiThread();
+    if (delegate == null) {
+      throw new NullPointerException("delegate");
+    }
+    if (sInstance != null) {
+      throw new IllegalStateException("Only one Navis Android login peer may be installed");
+    }
+    final NavisAndroidLogins installed = new NavisAndroidLogins(delegate);
+    try {
+      installed.register();
+      sInstance = installed;
+      return installed;
+    } catch (final RuntimeException | Error error) {
+      installed.unregister();
+      throw error;
+    }
+  }
+
+  private void register() {
+    mDispatcher.registerUiThreadListener(
+        mListener, FETCH_LOGIN_EVENT, SAVE_LOGIN_EVENT, USED_LOGIN_EVENT);
+    mRegistered = true;
+    // Preserve the upstream storage-delegate signal for engine consumers such
+    // as login detection, without installing GeckoView's Runtime owner.
+    mDispatcher.dispatch(STORAGE_ATTACHED_EVENT, null);
+  }
+
+  private void unregister() {
+    if (!mRegistered) {
+      return;
+    }
+    mRegistered = false;
+    mDispatcher.unregisterUiThreadListener(
+        mListener, FETCH_LOGIN_EVENT, SAVE_LOGIN_EVENT, USED_LOGIN_EVENT);
+  }
+
+  private void handleMessage(
+      final String event, final GeckoBundle message, final EventCallback callback) {
+    ThreadUtils.assertOnUiThread();
+    if (mClosed) {
+      fail(callback, "Navis login storage is closed");
+      return;
+    }
+    try {
+      switch (event) {
+        case FETCH_LOGIN_EVENT:
+          fetch(message, callback);
+          return;
+        case SAVE_LOGIN_EVENT:
+          final Login saved = Login.fromBundle(message == null ? null : message.getBundle("login"));
+          if (saved == null) {
+            fail(callback, "Invalid login save payload");
+            return;
+          }
+          save(saved).whenComplete((ignored, error) -> {
+            if (error == null) succeed(callback, null);
+            else fail(callback, "Navis login save failed");
+          });
+          return;
+        case USED_LOGIN_EVENT:
+          final Login used = Login.fromBundle(message == null ? null : message.getBundle("login"));
+          if (used == null) {
+            fail(callback, "Invalid login-used payload");
+            return;
+          }
+          mDelegate.onLoginUsed(used, message.getInt("usedFields"));
+          succeed(callback, null);
+          return;
+        default:
+          fail(callback, "Unknown Navis login event");
+      }
+    } catch (final Throwable error) {
+      // Never reflect exception messages: platform failures may include a
+      // provider URI or record value, which must not cross back into chrome.
+      fail(callback, "Navis login storage rejected the request");
+    }
+  }
+
+  /** Engine-private save. Completion means Keystore/SQLite commit, never mere enqueue. */
+  static CompletionStage<Void> save(final Login login) {
+    ThreadUtils.assertOnUiThread();
+    final CompletableFuture<Void> result = new CompletableFuture<>();
+    final NavisAndroidLogins owner = sInstance;
+    if (owner == null || owner.mClosed || login == null || !login.isValid()) {
+      result.completeExceptionally(new IllegalStateException("Navis login storage is unavailable"));
+      return result;
+    }
+    owner.mPendingSaves.add(result);
+    try {
+      owner.mDelegate.onLoginSave(login).whenComplete((ignored, error) ->
+          ThreadUtils.runOnUiThread(() -> {
+            if (!owner.mPendingSaves.remove(result)) return;
+            if (error == null && !owner.mClosed) result.complete(null);
+            else result.completeExceptionally(new IllegalStateException("Navis login save failed"));
+          }));
+    } catch (final Throwable error) {
+      owner.mPendingSaves.remove(result);
+      result.completeExceptionally(new IllegalStateException("Navis login save failed"));
+    }
+    return result;
+  }
+
+  private void fetch(final GeckoBundle message, final EventCallback callback) {
+    if (callback == null) {
+      return;
+    }
+    final String domain = message == null ? null : message.getString("domain");
+    if (domain != null && (domain.isEmpty() || domain.length() > MAX_ORIGIN_CHARS)) {
+      callback.sendSuccess(new GeckoBundle[0]);
+      return;
+    }
+
+    final CompletionStage<Login[]> stage;
+    try {
+      stage = mDelegate.onLoginFetch(domain);
+    } catch (final Throwable error) {
+      callback.sendError("Navis login fetch failed");
+      return;
+    }
+    if (stage == null) {
+      callback.sendSuccess(new GeckoBundle[0]);
+      return;
+    }
+
+    final PendingFetch pending = new PendingFetch(callback);
+    mPendingFetches.add(pending);
+    stage.whenComplete(
+        (logins, error) ->
+            ThreadUtils.runOnUiThread(() -> completeFetch(pending, logins, error)));
+  }
+
+  private void completeFetch(
+      final PendingFetch pending, final Login[] logins, final Throwable error) {
+    ThreadUtils.assertOnUiThread();
+    if (!mPendingFetches.remove(pending)) {
+      return;
+    }
+    if (mClosed) {
+      pending.callback.sendError("Navis login storage is closed");
+      return;
+    }
+    if (error != null) {
+      pending.callback.sendError("Navis login fetch failed");
+      return;
+    }
+
+    final ArrayList<GeckoBundle> bundles = new ArrayList<>();
+    if (logins != null) {
+      for (final Login login : logins) {
+        if (bundles.size() == MAX_FETCH_RESULTS) {
+          break;
+        }
+        if (login != null && login.isValid()) {
+          bundles.add(login.toBundle());
+        }
+      }
+    }
+    pending.callback.sendSuccess(bundles.toArray(new GeckoBundle[0]));
+  }
+
+  @Override
+  public void close() {
+    ThreadUtils.assertOnUiThread();
+    synchronized (NavisAndroidLogins.class) {
+      if (mClosed) {
+        return;
+      }
+      if (sInstance != this) {
+        throw new IllegalStateException("This Navis Android login peer is not installed");
+      }
+      mClosed = true;
+      sInstance = null;
+    }
+    unregister();
+    for (final CompletableFuture<Void> pending : new ArrayList<>(mPendingSaves)) {
+      pending.completeExceptionally(new IllegalStateException("Navis login storage is closed"));
+    }
+    mPendingSaves.clear();
+    for (final PendingFetch pending : mPendingFetches) {
+      pending.callback.sendError("Navis login storage is closed");
+    }
+    mPendingFetches.clear();
+  }
+
+  private static boolean withinRequired(final String value, final int maxChars) {
+    return value != null && !value.isEmpty() && value.length() <= maxChars;
+  }
+
+  private static boolean withinNullable(final String value, final int maxChars) {
+    return value == null || value.length() <= maxChars;
+  }
+
+  private static void succeed(final EventCallback callback, final Object value) {
+    if (callback != null) {
+      callback.sendSuccess(value);
+    }
+  }
+
+  private static void fail(final EventCallback callback, final String message) {
+    if (callback != null) {
+      callback.sendError(message);
+    }
+  }
+
+  private static final class PendingFetch {
+    final EventCallback callback;
+
+    PendingFetch(final EventCallback callback) {
+      this.callback = callback;
+    }
+  }
+}
