+  public CompletionStage<IconBitmap> renderIcon(final Icon icon, final int targetSize) {
+    try {
+      ensureOpen();
+      if (icon == null) {
+        return CompletableFuture.completedFuture(null);
+      }
+      if (targetSize < 1 || targetSize > MAX_ICON_DIMENSION) {
+        throw new IllegalArgumentException("Invalid extension icon target size");
+      }
+      final ImageResource.Collection.Builder builder = new ImageResource.Collection.Builder();
+      for (final Map.Entry<Integer, String> source : icon.sources.entrySet()) {
+        final int size = source.getKey();
+        builder.add(
+            new ImageResource(
+                source.getValue(),
+                null,
+                new ImageResource.Size[] {new ImageResource.Size(size, size)}));
+      }
+      final CompletableFuture<IconBitmap> result = new CompletableFuture<>();
+      final Runnable timeout = () -> result.complete(null);
+      result.whenComplete((ignored, error) -> mUiHandler.removeCallbacks(timeout));
+      mUiHandler.postDelayed(timeout, ICON_TIMEOUT_MS);
+      builder
+          .build()
+          .getBitmap(targetSize)
+          .withHandler(mUiHandler)
+          .accept(
+              bitmap -> {
+                if (bitmap == null) {
+                  result.complete(null);
+                  return;
+                }
+                try {
+                  final Bitmap normalized =
+                      bitmap.getWidth() > MAX_ICON_DIMENSION
+                              || bitmap.getHeight() > MAX_ICON_DIMENSION
+                          ? Bitmap.createScaledBitmap(bitmap, targetSize, targetSize, true)
+                          : bitmap;
+                  result.complete(new IconBitmap(normalized));
+                } catch (final Throwable error) {
+                  result.complete(null);
+                }
+              },
+              error -> result.complete(null));
+      return result;
+    } catch (final Throwable error) {
+      return failedFuture(error);
+    }
+  }
