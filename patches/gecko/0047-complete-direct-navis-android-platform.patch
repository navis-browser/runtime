+  },
+
+  createBridge({ getWindow, getTab, getDispatcher, isLive, invokeCommand }) {
+    const bridge = {
+      async show(payload) {
+        if (!isLive() || pending) {
+          finishPending();
+        }
+        if (!isLive()) {
+          return null;
+        }
+        const win = getWindow();
+        const tab = getTab();
+        if (!tab?.getActive?.()) {
+          return null;
+        }
+        const menu = {
+          id: "contentAreaContextMenu",
+          documentGlobal: win,
+          ownerDocument: win?.document,
+        };
+        const contextData = contextFromPayload(payload, tab, menu);
+        if (!contextData) {
+          return null;
+        }
+        const built = buildItems(contextData);
+        const { items, itemsById, extensions } = built;
+        if (!items.length) {
+          return null;
+        }
+        const token = Services.uuid.generateUUID().toString()
+          .slice(1, -1).replace(/-/g, "");
+        pending = {
+          token,
+          win,
+          tab,
+          contextData,
+          items,
+          itemsById,
+          extensions,
+          rebuild() {
+            if (pending?.token !== token || !isLive()) return;
+            const next = buildItems(contextData);
+            if (!next.items.length) {
+              finishPending();
+              return;
+            }
+            pending.itemsById = next.itemsById;
+            pending.extensions = next.extensions;
+            pending.items = next.items;
+            try {
+              pending.updateNative?.(nativeRequest(token, tab, contextData, next.items));
+            } catch (error) {
+              finishPending();
+            }
+          },
+          cancelNative: () => getDispatcher().sendRequest(
+            "GeckoView:ContextMenu:Cancel", { token }),
+          updateNative: request => getDispatcher().sendRequest(
+            "GeckoView:ContextMenu:Update", request),
+        };
+        for (const extension of extensions) {
+          try {
+            extension.emit("webext-menu-shown", items
+              .filter(item => item.extensionId === extension.id)
+              .map(item => item.menuId), contextData);
+          } catch (error) {
+            Cu.reportError(error);
+          }
+        }
+        let result;
+        try {
+          result = await getDispatcher().sendRequestForResult(
+            "GeckoView:ContextMenu", nativeRequest(
+              token, tab, contextData,
+              pending?.token === token ? pending.items : items));
+        } catch (error) {
+          if (pending?.token === token) finishPending();
+          return null;
+        }
+        return bridge.select(token, result?.itemId);
+      },
+
+      async select(token, itemId) {
+        const current = pending;
+        if (!TOKEN_RE.test(token || "") || !current || current.token !== token || !isLive() ||
+            getWindow() !== current.win || getTab() !== current.tab ||
+            !current.tab?.getActive?.()) {
+          return null;
+        }
+        if (typeof itemId !== "string" || itemId.length > 256) {
+          finishPending();
+          return null;
+        }
+        const item = current.itemsById.get(itemId);
+        if (!item || item.type === "separator" || !item.enabled ||
+            !item.extension?.isActive || item.extension.hasShutdown) {
+          finishPending();
+          return null;
+        }
+        try {
+          if (!item.enabledForContext(current.contextData)) {
+            finishPending();
+            return null;
+          }
+          const wasChecked = Boolean(item.checked);
+          if (item.type === "checkbox") item.checked = !wasChecked;
+          if (item.type === "radio") {
+            for (const sibling of item.parent?.children || []) {
+              if (sibling.type === "radio" && sibling.groupName === item.groupName) {
+                sibling.checked = false;
+              }
+            }
+            item.checked = true;
+          }
+          if (current.tab && (!current.contextData.webExtContextData ||
+              current.contextData.webExtContextData.extensionId !== item.extension.id)) {
+            item.tabManager.addActiveTabPermission(current.tab);
+          }
+          const info = item.getClickInfo(current.contextData, wasChecked);
+          info.modifiers = current.contextData.modifiers;
+          info.button = current.contextData.button;
+          if (item.command === "_execute_action" ||
+              item.command === "_execute_browser_action" ||
+              item.command === "_execute_page_action") {
+            const privateMode = (() => {
+              try {
+                return PrivateBrowsingUtils.isBrowserPrivate(current.tab.linkedBrowser);
+              } catch {
+                return null;
+              }
+            })();
+            const handled = privateMode !== null && await invokeCommand?.(
+              item.extension.id, current.tab.id, privateMode, item.command);
+            if (pending !== current) return null;
+            if (!handled) {
+              finishPending();
+              return null;
+            }
+            finishPending();
+            return Object.freeze({});
+          }
+          if (item.command === "_execute_sidebar_action") {
+            finishPending();
+            return null;
+          }
+          item.extension.emit("webext-menu-menuitem-click", info, current.tab);
+        } catch (error) {
+          Cu.reportError(error);
+        }
+        finishPending();
+        return Object.freeze({});
+      },
+    };
+    return Object.freeze(bridge);
+  },
+};
+
+function createNavisAndroidContextMenuBridge(options) {
+  return NavisAndroidContextMenus.createBridge(options);
+}
+
+export { NavisAndroidContextMenus, createNavisAndroidContextMenuBridge };
