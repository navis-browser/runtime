+    return null;
+  }
+  if (!extension?.isActive || extension.hasShutdown ||
+      (privateTab && !extension.privateBrowsingAllowed)) {
+    return null;
+  }
+  try {
+    if (!item.enabledForContext(contextData)) {
+      return null;
+    }
+  } catch {
+    return null;
+  }
+  const menuId = String(item.id);
+  const id = `${extension.id}::${menuId}`;
+  if (!menuId || id.length > 256) {
+    return null;
+  }
+  let title = bounded(item.title, MAX_LABEL) || "";
+  if (contextData.isTextSelected && title.includes("%s")) {
+    title = title.replace(/%s/g, bounded(contextData.selectionText?.trim(), MAX_LABEL) || "");
+  }
+  return Object.freeze({
+    id,
+    menuId,
+    parentId: item.parent?.parent
+      ? `${extension.id}::${String(item.parent.id)}` : null,
+    extensionId: bounded(extension.id, 256),
+    extensionName: bounded(extension.name, MAX_LABEL) || "Extension",
+    title: title.slice(0, MAX_LABEL),
+    type: item.type === "checkbox" || item.type === "radio" || item.type === "separator"
+      ? item.type : "normal",
+    command: bounded(item.command, 128) || null,
+    checked: Boolean(item.checked),
+    enabled: Boolean(item.enabled),
+  });
+}
+
+function contextFromPayload(payload, tab, menu) {
+  const pageUrl = bounded(payload?.pageUrl || payload?.baseUri);
+  if (!pageUrl) {
+    return null;
+  }
