+  /** Plain command DTO sent by Gecko's direct extension API to the product Runtime. */
+  public static final class TabCommand {
+    public final String extensionId;
+    public final TabOperation operation;
+    public final Long tabId;
+    public final String url;
+    public final Boolean active;
+    public final Boolean privateMode;
+    public final Integer index;
+
+    private TabCommand(final GeckoBundle value) {
+      if (value == null) {
+        throw new IllegalArgumentException("Missing extension tab command");
+      }
+      extensionId = boundedRequiredString(value, "extensionId", 256);
+      operation =
+          parseEnum(
+              TabOperation.class,
+              boundedRequiredString(value, "operation", 16).toUpperCase(Locale.ROOT));
+      tabId = value.containsKey("tabId") ? Long.valueOf(value.getLong("tabId", -1)) : null;
+      url = boundedString(value, "url", 16 * 1024);
+      active =
+          value.containsKey("active")
+              ? Boolean.valueOf(value.getBoolean("active", false))
+              : null;
+      privateMode =
+          value.containsKey("privateMode")
+              ? Boolean.valueOf(value.getBoolean("privateMode", false))
+              : null;
+      index = value.containsKey("index") ? Integer.valueOf(value.getInt("index", -1)) : null;
+      if (tabId != null && tabId.longValue() <= 0) {
+        throw new IllegalArgumentException("Invalid extension tab ID");
+      }
+      if (value.containsKey("url") && url.isEmpty()) {
+        throw new IllegalArgumentException("Invalid extension tab URL");
+      }
+      if (operation == TabOperation.CREATE && tabId != null) {
+        throw new IllegalArgumentException("Create must not target an existing tab");
+      }
+      if (operation != TabOperation.CREATE && tabId == null) {
+        throw new IllegalArgumentException("Extension tab command requires a target tab");
+      }
+      if (index != null && index.intValue() < 0) {
+        throw new IllegalArgumentException("Invalid extension tab index");
+      }
+      if (operation == TabOperation.REMOVE
+          && (value.containsKey("url") || active != null || index != null)) {
+        throw new IllegalArgumentException("Remove does not accept update properties");
+      }
+      if (operation != TabOperation.CREATE && privateMode != null) {
+        throw new IllegalArgumentException("Only create may select a browsing mode");
+      }
+      if (operation != TabOperation.CREATE && operation != TabOperation.MOVE && index != null) {
+        throw new IllegalArgumentException("Only create and move accept an index");
+      }
+      if (operation == TabOperation.MOVE
+          && (index == null || value.containsKey("url") || active != null)) {
+        throw new IllegalArgumentException("Move requires only a destination index");
+      }
+    }
+  }
