+    } catch (error) {
+      Cu.reportError(error);
+    }
+  }
+}
+
+const NavisAndroidContextMenus = {
+  registerMenuItem(item) {
+    registeredItems.add(item);
+    pending?.rebuild?.();
+  },
+
+  unregisterMenuItem(item) {
+    registeredItems.delete(item);
+    if (pending) {
+      for (const [id, pendingItem] of pending.itemsById) {
+        if (pendingItem === item) pending.itemsById.delete(id);
+      }
+      pending.rebuild?.();
+    }
+  },
+
+  unregisterExtension(extension) {
+    for (const item of registeredItems) {
+      if (item.extension === extension) registeredItems.delete(item);
+    }
+    if (pending && pending.extensions.has(extension)) finishPending();
+  },
+
+  refreshMenuItem(item) {
+    if (pending && registeredItems.has(item)) {
