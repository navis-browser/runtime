+  async handleShortcut(shortcut, tab, hostKey) {
+    const host = hosts.get(hostKey);
+    const key = normalized(shortcut);
+    const currentTab = hostTab(host);
+    // Do not dispatch a key from a stale/other tab or an inactive surface.
+    if (!host || !key || !tab || currentTab !== tab || !tab.getActive?.() ||
+        privateState(tab) === null) return false;
