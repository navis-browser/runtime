+      const shortcut = normalized(command?.shortcut);
+      if (typeof name === "string" && name.length <= MAX_NAME && shortcut) {
+        entries.set(shortcut, { extension, name });
+      }
+    }
+    commandsByExtension.set(extension, entries);
+    publishAll();
+  },
