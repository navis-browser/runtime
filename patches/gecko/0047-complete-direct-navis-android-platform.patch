+  }
+  return {
+    menu,
+    tab,
+    pageUrl,
+    frameUrl: bounded(payload?.frameUrl || pageUrl),
+    frameId: Number.isSafeInteger(payload?.frameId) ? payload.frameId : 0,
+    inFrame: Boolean(payload?.inFrame),
+    onLink: Boolean(payload?.onLink || payload?.uri),
+    onImage: Boolean(payload?.onImage),
+    onAudio: Boolean(payload?.onAudio),
+    onVideo: Boolean(payload?.onVideo),
+    onSelection: Boolean(payload?.isTextSelected),
+    isTextSelected: Boolean(payload?.isTextSelected),
+    selectionText: bounded(payload?.selectionText),
+    linkUrl,
+    linkURI,
+    linkText: bounded(payload?.linkText),
+    srcUrl: bounded(payload?.srcUrl || payload?.elementSrc),
+    mediaType: bounded(payload?.mediaType),
+    editable: Boolean(payload?.editable),
+    onEditable: Boolean(payload?.editable),
+    onPassword: Boolean(payload?.onPassword),
+    targetElementId: Number.isSafeInteger(payload?.targetElementId)
