+    current = next;
+    pendingEvents.push(...validated);
+    resolveReady();
+    flushEvents();
+  },
+
+  registerNativeTab(nativeTab) {
+    const tabId = positiveInteger(nativeTab?.id, "native tab ID");
+    if (!isDirectWindow(nativeTab?.browser?.documentGlobal)) {
+      throw new TypeError("Only a direct Navis tab can enter the topology");
+    }
+    nativeTabs.set(tabId, nativeTab);
+    flushEvents();
+  },
+
+  unregisterNativeTab(nativeTab) {
+    if (nativeTabs.get(nativeTab?.id) === nativeTab) {
+      nativeTabs.delete(nativeTab.id);
+    }
+  },
+
+  isDirectWindow,
+
+  isDirectTab(nativeTab) {
+    return isDirectWindow(nativeTab?.browser?.documentGlobal);
+  },
+
+  entry(tabId) {
+    return entryById(current, tabId);
+  },
+
+  entries(includePrivate = true) {
+    return filteredEntries(current, includePrivate);
+  },
+
+  visibleIndex(tabId, includePrivate = true, snapshot = current) {
+    return filteredIndex(snapshot, tabId, includePrivate);
+  },
+
+  productCreateIndex(requestedIndex, includePrivate = true) {
+    if (requestedIndex === null || requestedIndex === undefined) {
+      return current.tabs.length;
+    }
+    return insertionIndex(
+      current.tabs,
+      filteredEntries(current, includePrivate),
+      requestedIndex
+    );
+  },
+
+  productMoveIndex(tabId, requestedIndex, includePrivate = true) {
+    const moving = entryById(current, tabId);
+    if (!moving || (!includePrivate && moving.privateMode)) {
+      throw new TypeError("The extension cannot move this tab");
+    }
+    const fullEntries = current.tabs.filter(entry => entry !== moving);
+    const visibleEntries = filteredEntries(current, includePrivate).filter(
+      entry => entry !== moving
+    );
+    return insertionIndex(fullEntries, visibleEntries, requestedIndex);
+  },
+
+  nativeTab(tabId) {
+    return entryById(current, tabId) ? nativeTabs.get(tabId) || null : null;
+  },
+
+  nativeTabs(includePrivate = true) {
+    return filteredEntries(current, includePrivate)
+      .map(entry => nativeTabs.get(entry.tabId))
+      .filter(Boolean);
+  },
+
+  activeNativeTab(includePrivate = true) {
+    const entry = entryById(current, current.activeTabId);
+    if (!entry || (!includePrivate && entry.privateMode)) {
+      return null;
+    }
+    return nativeTabs.get(entry.tabId) || null;
+  },
+
+  representativeWindow(includePrivate = true) {
+    const active = this.activeNativeTab(includePrivate);
+    if (active) {
+      return active.browser.documentGlobal;
+    }
+    return this.nativeTabs(includePrivate)[0]?.browser?.documentGlobal || null;
+  },
+
+  hasVisibleTabs(includePrivate = true) {
+    return filteredEntries(current, includePrivate).length > 0;
+  },
+
+  allVisibleTabsPrivate(includePrivate = true) {
+    const visible = filteredEntries(current, includePrivate);
+    return visible.length > 0 && visible.every(entry => entry.privateMode);
+  },
+
+  /** Projects an internal event without exposing private IDs or positions. */
+  projectEvent(event, includePrivate = true) {
+    if (!event || event.windowId !== current.windowId) {
+      return null;
+    }
+    const oldEntry = entryById(event.previous, event.tabId);
+    const newEntry = entryById(event.next, event.tabId);
+    const entry = newEntry || oldEntry;
+    if (!entry || (!includePrivate && entry.privateMode)) {
+      return null;
+    }
+    const projected = {
+      type: event.type,
+      tabId: event.tabId,
+      windowId: event.windowId,
+      isPrivate: entry.privateMode,
+    };
+    if (event.type === "CREATED" || event.type === "ACTIVATED") {
+      const nativeTab = nativeTabs.get(event.tabId);
+      if (!nativeTab) {
+        return null;
+      }
+      projected.nativeTab = nativeTab;
+    }
+    if (event.type === "ACTIVATED") {
+      const previous = entryById(event.next, event.previousTabId);
+      if (previous && (includePrivate || !previous.privateMode)) {
+        projected.previousTabId = previous.tabId;
+      }
+    }
+    if (event.type === "MOVED") {
+      const fromIndex = filteredIndex(
+        event.previous,
+        event.tabId,
+        includePrivate
+      );
+      const toIndex = filteredIndex(event.next, event.tabId, includePrivate);
+      // Moving a public tab only across hidden private tabs must be invisible
+      // to an extension which lacks private-browsing access.
+      if (fromIndex < 0 || toIndex < 0 || fromIndex === toIndex) {
+        return null;
+      }
+      projected.fromIndex = fromIndex;
+      projected.toIndex = toIndex;
+    }
+    return Object.freeze(projected);
+  },
+});
