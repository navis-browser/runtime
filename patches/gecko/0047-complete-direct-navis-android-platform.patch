diff --git a/mobile/android/components/geckoview/NavisBoundedInputStream.cpp b/mobile/android/components/geckoview/NavisBoundedInputStream.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4773ec539d42dc497a9e51ab7768fdb7abad574d
--- /dev/null
+++ b/mobile/android/components/geckoview/NavisBoundedInputStream.cpp
@@ -0,0 +1,172 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "NavisBoundedInputStream.h"
+
+#include <algorithm>
+
+namespace {
+
+struct SegmentWriterContext {
+  NavisBoundedInputStream* mStream;
+  nsWriteSegmentFun mWriter;
+  void* mClosure;
+};
+
+nsresult WriteBoundedSegment(nsIInputStream* aSource, void* aClosure,
+                             const char* aFromSegment, uint32_t aToOffset,
+                             uint32_t aCount, uint32_t* aWriteCount) {
+  auto* context = static_cast<SegmentWriterContext*>(aClosure);
+  uint64_t remaining = context->mStream->MaximumBytes() -
+                       context->mStream->BytesRead();
+  uint32_t boundedCount = static_cast<uint32_t>(std::min<uint64_t>(
+      remaining, static_cast<uint64_t>(aCount)));
+  if (!boundedCount) {
+    *aWriteCount = 0;
+    return NS_ERROR_FILE_TOO_BIG;
+  }
+
+  nsresult rv = context->mWriter(
+      context->mStream, context->mClosure, aFromSegment, aToOffset,
+      boundedCount, aWriteCount);
+  if (NS_SUCCEEDED(rv)) {
+    if (*aWriteCount > boundedCount) {
+      *aWriteCount = 0;
+      return NS_ERROR_UNEXPECTED;
+    }
+    context->mStream->AddBytesRead(*aWriteCount);
+  }
+  return rv;
+}
+
+}  // namespace
+
+NS_IMPL_ISUPPORTS(NavisBoundedInputStream, nsIInputStream,
+                  nsINavisBoundedInputStream)
+
+NS_IMETHODIMP
+NavisBoundedInputStream::Init(nsIInputStream* aSource,
+                              uint64_t aMaximumBytes) {
+  if (!aSource || !aMaximumBytes || mSource) {
+    return NS_ERROR_INVALID_ARG;
+  }
+  mSource = aSource;
+  mMaximumBytes = aMaximumBytes;
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+NavisBoundedInputStream::Close() {
+  if (!mClosed) {
+    mClosed = true;
+    if (mSource) {
+      mSource->Close();
+    }
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+NavisBoundedInputStream::Available(uint64_t* aCount) {
+  if (mClosed) {
+    return NS_BASE_STREAM_CLOSED;
+  }
+  if (!mSource) {
+    return NS_ERROR_NOT_INITIALIZED;
+  }
+  nsresult rv = mSource->Available(aCount);
+  if (NS_SUCCEEDED(rv)) {
+    *aCount = std::min(*aCount, mMaximumBytes - mBytesRead);
+  }
+  return rv;
+}
+
+NS_IMETHODIMP
+NavisBoundedInputStream::StreamStatus() {
+  if (mClosed) {
+    return NS_BASE_STREAM_CLOSED;
+  }
+  if (!mSource) {
+    return NS_ERROR_NOT_INITIALIZED;
+  }
+  return mSource->StreamStatus();
+}
+
+NS_IMETHODIMP
+NavisBoundedInputStream::Read(char* aBuffer, uint32_t aCount,
+                              uint32_t* aReadCount) {
+  if (!aReadCount) {
+    return NS_ERROR_INVALID_ARG;
+  }
+  *aReadCount = 0;
+  if (mClosed) {
+    return NS_BASE_STREAM_CLOSED;
+  }
+  if (!mSource) {
+    return NS_ERROR_NOT_INITIALIZED;
+  }
+  if (!aCount) {
+    return NS_OK;
+  }
+
+  if (mBytesRead >= mMaximumBytes) {
+    return CheckLimit();
+  }
+  uint32_t boundedCount = static_cast<uint32_t>(std::min<uint64_t>(
+      mMaximumBytes - mBytesRead, static_cast<uint64_t>(aCount)));
+  nsresult rv = mSource->Read(aBuffer, boundedCount, aReadCount);
+  if (NS_SUCCEEDED(rv)) {
+    mBytesRead += *aReadCount;
+  }
+  return rv;
+}
+
+NS_IMETHODIMP
+NavisBoundedInputStream::ReadSegments(nsWriteSegmentFun aWriter,
+                                      void* aClosure, uint32_t aCount,
+                                      uint32_t* aResult) {
+  if (!aResult) {
+    return NS_ERROR_INVALID_ARG;
+  }
+  *aResult = 0;
+  if (mClosed) {
+    return NS_BASE_STREAM_CLOSED;
+  }
+  if (!mSource) {
+    return NS_ERROR_NOT_INITIALIZED;
+  }
+  if (!aCount) {
+    return NS_OK;
+  }
+  if (mBytesRead >= mMaximumBytes) {
+    return CheckLimit();
+  }
+
+  uint32_t boundedCount = static_cast<uint32_t>(std::min<uint64_t>(
+      mMaximumBytes - mBytesRead, static_cast<uint64_t>(aCount)));
+  SegmentWriterContext context{this, aWriter, aClosure};
+  return mSource->ReadSegments(WriteBoundedSegment, &context, boundedCount,
+                               aResult);
+}
+
+NS_IMETHODIMP
+NavisBoundedInputStream::IsNonBlocking(bool* aNonBlocking) {
+  if (!aNonBlocking) {
+    return NS_ERROR_INVALID_ARG;
+  }
+  if (!mSource) {
+    return NS_ERROR_NOT_INITIALIZED;
+  }
+  return mSource->IsNonBlocking(aNonBlocking);
+}
+
+nsresult NavisBoundedInputStream::CheckLimit() {
+  char probe;
+  uint32_t readCount = 0;
+  nsresult rv = mSource->Read(&probe, 1, &readCount);
+  if (NS_FAILED(rv)) {
+    return rv;
+  }
+  return readCount ? NS_ERROR_FILE_TOO_BIG : NS_OK;
+}
