+  public static synchronized NavisAndroidExtensions install(
+      final Context context, final Delegate delegate) {
+    ThreadUtils.assertOnUiThread();
+    if (context == null) {
+      throw new NullPointerException("context");
+    }
+    if (delegate == null) {
+      throw new NullPointerException("delegate");
+    }
+    if (sInstance != null) {
+      throw new IllegalStateException("Only one Navis Android extension peer may be installed");
+    }
+    sInstance = new NavisAndroidExtensions(context, delegate);
+    return sInstance;
+  }
