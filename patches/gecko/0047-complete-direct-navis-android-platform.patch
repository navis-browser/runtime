+  const visit = parentId => {
+    for (const item of children.get(parentId) || []) {
+      ordered.push(item);
+      visit(item.id);
+    }
+  };
+  visit(null);
+  return { items: ordered, itemsById, extensions };
+}
+
+function nativeRequest(token, tab, contextData, items) {
+  return Object.freeze({
+    token,
+    tabId: tab?.id || 0,
+    pageUrl: contextData.pageUrl,
+    frameUrl: contextData.frameUrl,
+    frameId: contextData.frameId,
+    inFrame: contextData.inFrame,
+    onLink: contextData.onLink,
+    onImage: contextData.onImage,
+    onAudio: contextData.onAudio,
+    onVideo: contextData.onVideo,
+    isTextSelected: contextData.isTextSelected,
+    editable: contextData.editable,
+    linkUrl: contextData.linkUrl,
+    linkText: contextData.linkText,
+    srcUrl: contextData.srcUrl,
+    selectionText: contextData.selectionText,
+    mediaType: contextData.mediaType,
+    button: contextData.button,
