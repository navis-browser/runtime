+    const matches = [];
+    for (const entries of commandsByExtension.values()) {
+      const command = entries.get(key);
+      if (command && usableForHost(command.extension, tab)) {
+        matches.push(command);
+      }
+    }
+    // Conflicts are deliberately not guessed: native shortcut ownership must
+    // be unambiguous and fail closed.
+    if (matches.length !== 1) return false;
+    const { extension, name } = matches[0];
+    const privateMode = privateState(tab);
+    if (name === "_execute_action" || name === "_execute_browser_action" ||
+        name === "_execute_page_action") {
+      return Boolean(await host.invokeAction?.(
+        extension.id, tab.id, privateMode, name));
+    }
+    if (name === "_execute_sidebar_action") return false;
+    extension.emit("command", name);
+    return true;
+  },
+};
+
+export { NavisAndroidCommandRegistry };
