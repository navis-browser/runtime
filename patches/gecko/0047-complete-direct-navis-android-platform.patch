+"use strict";
+
+const MAX_COMMANDS = 256;
+const MAX_NAME = 128;
+const { PrivateBrowsingUtils } = ChromeUtils.importESModule(
+  "resource://gre/modules/PrivateBrowsingUtils.sys.mjs"
+);
+
+// Extension command definitions are global, but native ownership is per
+// Navis host. A second window/session must never replace the first peer.
+const commandsByExtension = new Map();
+const hosts = new Map();
+
+function normalized(shortcut) {
+  return typeof shortcut === "string" ? shortcut.replace(/\s+/g, "") : "";
+}
+
+function privateState(tab) {
+  const browser = tab?.linkedBrowser;
+  if (!browser) return null;
+  try {
+    return PrivateBrowsingUtils.isBrowserPrivate(browser);
+  } catch (error) {
+    return null;
+  }
+}
+
+function hostTab(host) {
+  try {
+    return host?.getTab?.() || null;
+  } catch (error) {
+    return null;
+  }
+}
+
+function usableForHost(extension, tab) {
+  if (!extension?.isActive || extension.hasShutdown) return false;
+  const privateMode = privateState(tab);
+  if (privateMode === null) return false;
+  return !privateMode || Boolean(extension.privateBrowsingAllowed);
+}
+
+function ownershipFor(host) {
+  const tab = hostTab(host);
+  if (!tab?.getActive?.() || privateState(tab) === null) return [];
+
+  const counts = new Map();
+  for (const entries of commandsByExtension.values()) {
+    for (const [shortcut, command] of entries) {
+      if (!usableForHost(command.extension, tab)) continue;
+      counts.set(shortcut, (counts.get(shortcut) || 0) + 1);
+    }
+  }
+  return Object.freeze([...counts]
+    .filter(([, count]) => count === 1)
+    .map(([shortcut]) => shortcut));
+}
+
+function publishHost(hostKey) {
+  const host = hosts.get(hostKey);
+  if (!host?.publish) return;
+  try {
+    host.publish(ownershipFor(host));
+  } catch (error) {
+    // A dead Android peer must not prevent other sessions from publishing.
+  }
+}
+
+function publishAll() {
+  for (const hostKey of hosts.keys()) publishHost(hostKey);
+}
+
+const NavisAndroidCommandRegistry = {
+  registerHost(hostKey, { publish, getTab, invokeAction } = {}) {
+    if (hostKey === null || hostKey === undefined ||
+        typeof publish !== "function" || typeof getTab !== "function") {
+      return false;
+    }
+    hosts.set(hostKey, {
+      publish,
+      getTab,
+      invokeAction: typeof invokeAction === "function" ? invokeAction : null,
+    });
+    publishHost(hostKey);
+    return true;
+  },
+
+  unregisterHost(hostKey) {
+    hosts.delete(hostKey);
+  },
+
+  refreshHost(hostKey) {
+    publishHost(hostKey);
+  },
