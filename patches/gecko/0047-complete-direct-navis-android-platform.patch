+    if (current.windowId && current.windowId !== windowId) {
+      if (validated.length) {
+        throw new TypeError("A replacement Android product window must reset topology");
+      }
+      pendingEvents.length = 0;
+      const nextIds = new Set(tabs.map(entry => entry.tabId));
+      for (const tabId of nativeTabs.keys()) {
+        if (!nextIds.has(tabId)) {
+          nativeTabs.delete(tabId);
+        }
+      }
+    }
+
+    // A tab may have been created and removed before its render host became
+    // observable. Do not let an undeliverable stale create block later events.
+    const removedIds = new Set(
+      validated
+        .filter(event => event.type === "REMOVED")
+        .map(event => event.tabId)
+    );
+    if (removedIds.size) {
+      for (let index = pendingEvents.length - 1; index >= 0; index--) {
+        if (removedIds.has(pendingEvents[index].tabId)) {
+          pendingEvents.splice(index, 1);
+        }
+      }
+    }
