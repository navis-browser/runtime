+    items: Object.freeze(items),
+  });
+}
+
+function finishPending() {
+  const current = pending;
+  pending = null;
+  if (!current) {
+    return;
+  }
+  try {
+    current.cancelNative?.();
+  } catch (error) {
+    Cu.reportError(error);
+  }
+  for (const extension of current.extensions) {
+    try {
