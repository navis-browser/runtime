@@ -0,0 +1,177 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.gecko.navis;
+
+import android.Manifest;
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.os.Build;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.mozilla.gecko.GeckoAppShell;
+import org.mozilla.geckoview.WebNotification;
+
+/** Product-owned Android system notification peer for direct extension alerts. */
+public final class NavisAndroidNotifications {
+  private static final String CHANNEL_ID = "navis-extension-notifications";
+  private static final String ACTION_CLICK = "org.navis.browser.NOTIFICATION_CLICK";
+  private static final String ACTION_CLOSE = "org.navis.browser.NOTIFICATION_CLOSE";
+  private static final String EXTRA_TAG = "tag";
+  private static final String EXTRA_ACTION = "action";
+  private static final int MAX_TEXT = 4096;
+  private static final AtomicInteger NEXT_ID = new AtomicInteger(1);
+  private static final Map<String, WebNotification> ACTIVE = new HashMap<>();
+  private static final Map<String, Integer> IDS = new HashMap<>();
+
+  private NavisAndroidNotifications() {}
+
+  public static void show(final WebNotification notification) {
+    if (notification == null) return;
+    if (Build.VERSION.SDK_INT >= 33 &&
+        GeckoAppShell.getApplicationContext().checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS)
+            != PackageManager.PERMISSION_GRANTED) {
+      notification.dismiss();
+      return;
+    }
+    if (notification.privateBrowsing) {
+      // Private notifications must never escape the private session.
+      notification.dismiss();
+      return;
+    }
+    if (notification.actions.length > 0) {
+      // The notifications API rejects buttons in the direct schema. Keep the
+      // native seam fail-closed for any other producer carrying actions.
+      notification.dismiss();
+      return;
+    }
+    final Context context = GeckoAppShell.getApplicationContext();
+    final NotificationManager manager = context.getSystemService(NotificationManager.class);
+    if (manager == null ||
+        (Build.VERSION.SDK_INT >= 24 && !manager.areNotificationsEnabled())) {
+      notification.dismiss();
+      return;
+    }
+    ensureChannel(manager);
+    final String tag = bounded(notification.tag);
+    final int id;
+    synchronized (ACTIVE) {
+      id = IDS.computeIfAbsent(tag, ignored -> NEXT_ID.getAndIncrement());
+      ACTIVE.put(tag, notification);
+    }
+    final Notification.Builder builder = Build.VERSION.SDK_INT >= 26
+        ? new Notification.Builder(context, CHANNEL_ID)
+        : new Notification.Builder(context);
+    builder.setSmallIcon(android.R.drawable.ic_dialog_info)
+        .setContentTitle(bounded(notification.title))
+        .setContentText(bounded(notification.text))
+        .setAutoCancel(true)
+        .setOnlyAlertOnce(true)
+        .setContentIntent(pendingIntent(context, tag, id))
+        .setDeleteIntent(closeIntent(context, tag, id));
+    try {
+      manager.notify(tag, id, builder.build());
+      notification.show();
+    } catch (final RuntimeException error) {
+      synchronized (ACTIVE) {
+        ACTIVE.remove(tag);
+        IDS.remove(tag);
+      }
+      notification.dismiss();
+    }
+  }
+
+  public static void close(final WebNotification notification) {
+    if (notification == null) return;
+    final String tag = bounded(notification.tag);
+    final Integer id;
+    synchronized (ACTIVE) {
+      ACTIVE.remove(tag);
+      id = IDS.remove(tag);
+    }
+    final NotificationManager manager =
+        GeckoAppShell.getApplicationContext().getSystemService(NotificationManager.class);
+    if (manager != null && id != null) manager.cancel(tag, id);
+    // AndroidAlerts has already delivered alertfinished when this callback is
+    // reached; calling dismiss again would re-enter the native alert path.
+  }
+
+  public static void shutdown() {
+    final NotificationManager manager =
+        GeckoAppShell.getApplicationContext().getSystemService(NotificationManager.class);
+    synchronized (ACTIVE) {
+      if (manager != null) {
+        for (Map.Entry<String, Integer> entry : IDS.entrySet()) {
+          manager.cancel(entry.getKey(), entry.getValue());
+        }
+      }
+      for (WebNotification notification : ACTIVE.values()) notification.dismiss();
+      ACTIVE.clear();
+      IDS.clear();
+    }
+  }
+
+  private static void ensureChannel(final NotificationManager manager) {
+    if (Build.VERSION.SDK_INT >= 26) {
+      manager.createNotificationChannel(new NotificationChannel(
+          CHANNEL_ID, "Extension notifications", NotificationManager.IMPORTANCE_DEFAULT));
+    }
+  }
+
+  private static PendingIntent pendingIntent(
+      final Context context, final String tag, final int id) {
+    final Intent intent = new Intent(context, NotificationReceiver.class)
+        .setAction(ACTION_CLICK)
+        .putExtra(EXTRA_TAG, tag);
+    final int requestCode = id;
+    final int flags = PendingIntent.FLAG_UPDATE_CURRENT |
+        (Build.VERSION.SDK_INT >= 23 ? PendingIntent.FLAG_IMMUTABLE : 0);
+    return PendingIntent.getBroadcast(context, requestCode, intent, flags);
+  }
+
+  private static PendingIntent closeIntent(final Context context, final String tag, final int id) {
+    final Intent intent = new Intent(context, NotificationReceiver.class)
+        .setAction(ACTION_CLOSE)
+        .putExtra(EXTRA_TAG, tag);
+    final int flags = PendingIntent.FLAG_UPDATE_CURRENT |
+        (Build.VERSION.SDK_INT >= 23 ? PendingIntent.FLAG_IMMUTABLE : 0);
+    return PendingIntent.getBroadcast(context, id, intent, flags);
+  }
+
+  private static String bounded(final String value) {
+    if (value == null) return "";
+    return value.length() <= MAX_TEXT ? value : value.substring(0, MAX_TEXT);
+  }
+
+  public static final class NotificationReceiver extends BroadcastReceiver {
+    @Override
+    public void onReceive(final Context context, final Intent intent) {
+      final String tag = intent.getStringExtra(EXTRA_TAG);
+      if (tag == null) return;
+      final WebNotification notification;
+      final Integer id;
+      synchronized (ACTIVE) {
+        notification = ACTIVE.remove(tag);
+        id = IDS.remove(tag);
+      }
+      if (notification == null) return;
+      if (ACTION_CLOSE.equals(intent.getAction())) {
+        notification.dismiss();
+        return;
+      }
+      final String action = intent.getStringExtra(EXTRA_ACTION);
+      notification.click(action);
+      final NotificationManager manager = context.getSystemService(NotificationManager.class);
+      if (manager != null && id != null) manager.cancel(tag, id);
+      notification.dismiss();
+    }
+  }
+}
