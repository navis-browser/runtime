+  private static NavisAndroidExtensions sInstance;
+
+  private final Delegate mDelegate;
+  private final EventDispatcher mDispatcher;
+  private final BundleEventListener mEventListener = this::handleMessage;
+  private final Handler mUiHandler = new Handler(Looper.getMainLooper());
+  private final ExecutorService mIoExecutor;
+  private final File mStagingRoot;
+  private final Map<String, File> mStagedPackages = new ConcurrentHashMap<>();
+  private final Set<InputStream> mOwnedStagingStreams = ConcurrentHashMap.newKeySet();
+  private final Set<CompletableFuture<InstallPreview>> mPendingInstallPreviews =
+      ConcurrentHashMap.newKeySet();
+  private final Set<CompletableFuture<GeckoBundle>> mPendingQueries =
+      ConcurrentHashMap.newKeySet();
+  // Incoming engine requests and their callbacks are confined to the UI thread.
+  private final Set<PendingEvent> mPendingEvents = new HashSet<>();
+
+  private volatile boolean mClosed;
+
+  private NavisAndroidExtensions(final Context context, final Delegate delegate) {
+    mDelegate = delegate;
+    mStagingRoot = resolvePrivateStagingRoot(context.getApplicationContext());
+    mIoExecutor =
+        Executors.newSingleThreadExecutor(
+            new ThreadFactory() {
+              private final AtomicInteger mSequence = new AtomicInteger();
+
+              @Override
+              public Thread newThread(final Runnable runnable) {
+                final Thread thread =
+                    new Thread(
+                        runnable,
+                        "NavisExtensionStaging-" + mSequence.incrementAndGet());
+                thread.setDaemon(true);
+                return thread;
+              }
+            });
+    mDispatcher = EventDispatcher.byName(DISPATCHER_NAME);
+    mDispatcher.registerUiThreadListener(
+        mEventListener,
+        EVENT_STATE_CHANGED,
+        EVENT_PROCESS_SPAWNING_DISABLED,
+        EVENT_POPUP_REQUESTED,
+        EVENT_TAB_COMMAND,
+        EVENT_OPTIONAL_PERMISSION_REQUESTED);
+    mIoExecutor.execute(this::cleanAbandonedStagingFiles);
+  }
