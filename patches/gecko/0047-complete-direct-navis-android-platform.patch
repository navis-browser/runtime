+  /** One lifecycle transition accompanying an authoritative topology snapshot. */
+  public static final class TabTopologyEvent {
+    public final TabTopologyEventType type;
+    public final long tabId;
+    public final Long previousTabId;
+
+    public TabTopologyEvent(
+        final TabTopologyEventType type, final long tabId, final Long previousTabId) {
+      if (type == null || tabId <= 0 || (previousTabId != null && previousTabId <= 0)) {
+        throw new IllegalArgumentException("Invalid extension tab topology event");
+      }
+      if (type != TabTopologyEventType.ACTIVATED && previousTabId != null) {
+        throw new IllegalArgumentException("Only activation may name a previous tab");
+      }
+      this.type = type;
+      this.tabId = tabId;
+      this.previousTabId = previousTabId;
+    }
+
+    private GeckoBundle toBundle() {
+      final GeckoBundle value = new GeckoBundle(previousTabId == null ? 2 : 3);
+      value.putString("type", type.name());
+      value.putLong("tabId", tabId);
+      if (previousTabId != null) {
+        value.putLong("previousTabId", previousTabId.longValue());
+      }
+      return value;
+    }
