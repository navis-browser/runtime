new file mode 100644
index 0000000000000000000000000000000000000000..deaad2e2aa94afb25ab784ede8d69b8a46f66361
--- /dev/null
+++ b/mobile/shared/components/extensions/ext-windows.js
@@ -0,0 +1,86 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+function unavailableMutation(name) {
+  return new ExtensionError(
+    `windows.${name} is unavailable: Navis Android owns one product window`
+  );
+}
+
+this.windows = class extends ExtensionAPI {
+  getAPI(context) {
+    const { windowManager } = context.extension;
+
+    function convert(window, getInfo) {
+      if (!window || !context.canAccessWindow(window)) {
+        throw new ExtensionError("The Navis product window is unavailable");
+      }
+      return windowManager.convert(window, getInfo);
+    }
+
+    return {
+      windows: {
+        onCreated: new EventManager({
+          context,
+          name: "windows.onCreated",
+          register: () => () => {},
+        }).api(),
+
+        onRemoved: new EventManager({
+          context,
+          name: "windows.onRemoved",
+          register: () => () => {},
+        }).api(),
+
+        onFocusChanged: new EventManager({
+          context,
+          name: "windows.onFocusChanged",
+          register: () => () => {},
+        }).api(),
+
+        get(windowId, getInfo) {
+          return Promise.resolve(
+            convert(windowTracker.getWindow(windowId, context), getInfo)
+          );
+        },
+
+        getCurrent(getInfo) {
+          return Promise.resolve(
+            convert(windowTracker.getCurrentWindow(context), getInfo)
+          );
+        },
+
+        getLastFocused(getInfo) {
+          return Promise.resolve(
+            convert(windowTracker.getTopWindow(context), getInfo)
+          );
+        },
+
+        getAll(getInfo) {
+          return Array.from(windowManager.getAll(context))
+            .filter(
+              window =>
+                !getInfo?.windowTypes ||
+                getInfo.windowTypes.includes(window.type)
+            )
+            .map(window => window.convert(getInfo));
+        },
+
+        create() {
+          return Promise.reject(unavailableMutation("create"));
+        },
+
+        update() {
+          return Promise.reject(unavailableMutation("update"));
+        },
+
+        remove() {
+          return Promise.reject(unavailableMutation("remove"));
+        },
+      },
+    };
+  }
+};
