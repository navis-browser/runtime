+  /** Immutable, product-owned single-window tab topology. */
+  public static final class TabTopology {
+    public final long revision;
+    public final long windowId;
+    public final Long activeTabId;
+    public final List<TabTopologyEntry> tabs;
+    public final List<TabTopologyEvent> events;
+
+    public TabTopology(
+        final long revision,
+        final long windowId,
+        final Long activeTabId,
+        final List<TabTopologyEntry> tabs,
+        final List<TabTopologyEvent> events) {
+      if (revision <= 0 || windowId <= 0 || tabs == null || events == null || tabs.size() > 2048
+          || events.size() > 4096) {
+        throw new IllegalArgumentException("Invalid extension tab topology");
+      }
+      final LinkedHashMap<Long, TabTopologyEntry> unique = new LinkedHashMap<>();
+      for (int index = 0; index < tabs.size(); index++) {
+        final TabTopologyEntry entry = tabs.get(index);
+        if (entry == null || entry.index != index || unique.put(entry.tabId, entry) != null) {
+          throw new IllegalArgumentException("Invalid extension tab topology order");
+        }
+      }
+      if (activeTabId != null && !unique.containsKey(activeTabId)) {
+        throw new IllegalArgumentException("Active extension tab is outside the product window");
+      }
+      for (final TabTopologyEvent event : events) {
+        if (event == null) {
+          throw new IllegalArgumentException("Invalid extension tab topology event");
+        }
+      }
+      this.revision = revision;
+      this.windowId = windowId;
+      this.activeTabId = activeTabId;
+      this.tabs = Collections.unmodifiableList(new ArrayList<>(tabs));
+      this.events = Collections.unmodifiableList(new ArrayList<>(events));
+    }
+
+    private GeckoBundle toBundle() {
+      final GeckoBundle value = new GeckoBundle(activeTabId == null ? 4 : 5);
+      value.putLong("revision", revision);
+      value.putLong("windowId", windowId);
+      if (activeTabId != null) {
+        value.putLong("activeTabId", activeTabId.longValue());
+      }
+      final List<GeckoBundle> tabValues = new ArrayList<>(tabs.size());
+      for (final TabTopologyEntry entry : tabs) {
+        tabValues.add(entry.toBundle());
+      }
+      value.putBundleArray("tabs", tabValues);
+      final List<GeckoBundle> eventValues = new ArrayList<>(events.size());
+      for (final TabTopologyEvent event : events) {
+        eventValues.add(event.toBundle());
+      }
+      value.putBundleArray("events", eventValues);
+      return value;
+    }
+  }
