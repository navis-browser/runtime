+      if (source == Source.BLOCKED_SIDELOAD && enabled) {
+        throw new IllegalArgumentException("A blocked side-load cannot be enabled");
+      }
+      if ((source == Source.APPLICATION_BUILT_IN)
+          != (signature == Signature.APPLICATION_VERIFIED)) {
+        throw new IllegalArgumentException("Invalid application verification provenance");
+      }
+      if (hasAction != !actionKind.isEmpty()) {
+        throw new IllegalArgumentException("Invalid extension action projection");
+      }
+      if (!actionKind.isEmpty()
+          && !"BROWSER".equals(actionKind)
+          && !"PAGE".equals(actionKind)) {
+        throw new IllegalArgumentException("Invalid extension action kind");
+      }
+      if (!hasAction && actionEnabled) {
+        throw new IllegalArgumentException("An unavailable extension action cannot be enabled");
+      }
+      if (!hasAction && actionIcon != null) {
+        throw new IllegalArgumentException("An unavailable extension action cannot expose an icon");
+      }
+    }
+  }
