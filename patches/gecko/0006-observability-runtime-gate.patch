+      const nsACString& = nsCString()) const {
+    return NoMetricValue<int32_t>();
+  }
+};
+
+class DualLabeledCounterMetric {
+ public:
+  constexpr explicit DualLabeledCounterMetric(uint32_t) {}
+  CounterMetric<CounterType::eDualLabeled> Get(const nsACString&,
+                                                const nsACString&) const {
+    return CounterMetric<CounterType::eDualLabeled>(0);
+  }
+};
+
+struct RecordedEvent {
+  uint64_t mTimestamp = 0;
+  nsCString mCategory;
+  nsCString mName;
+  nsTArray<std::tuple<nsCString, nsCString>> mExtra;
+};
