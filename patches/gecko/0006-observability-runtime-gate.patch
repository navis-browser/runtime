new file mode 100644
index 0000000000000000000000000000000000000000..0ec853d5e6409c7e28c26049163b88947ada642d
--- /dev/null
+++ b/toolkit/components/glean/bindings/GleanNoop.cpp
@@ -0,0 +1,87 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "mozilla/glean/bindings/GleanNoop.h"
+
+#include <cstring>
+
+#include "jsapi.h"
+#include "js/CompilationAndEvaluation.h"
+#include "js/CompileOptions.h"
+#include "js/PropertyAndElement.h"
+#include "js/RootingAPI.h"
+#include "js/SourceText.h"
+#include "js/Value.h"
+#include "mozilla/Utf8.h"
+
+namespace mozilla::glean {
+
+bool CreateNoopGleanProxy(JSContext* aCx,
+                          JS::MutableHandle<JSObject*> aResult) {
+  static const char source[] = R"JS(
+    (() => {
+      let proxy;
+      proxy = new Proxy(function() {}, {
+        get(_target, property) {
+          if (property === "then") {
+            return undefined;
+          }
+          if (property === "start" || property === "testGetNumRecordedErrors") {
+            return () => 0;
+          }
+          if (property === "testGetValue" ||
+              property === "testGetValueAsJSONString") {
+            return () => null;
+          }
+          if (property === "testSubmission") {
+            return callback => callback();
+          }
+          if (property === "get") {
+            return () => proxy;
+          }
+          if (property === Symbol.toPrimitive) {
+            return () => 0;
+          }
+          return proxy;
+        },
+        apply() {
+          return undefined;
+        },
+      });
+      return proxy;
+    })()
+  )JS";
+
+  JS::CompileOptions options(aCx);
+  options.setFileAndLine("resource://gre/modules/GleanNoop", 1);
+
+  JS::SourceText<mozilla::Utf8Unit> sourceText;
+  if (!sourceText.init(aCx, source, std::strlen(source),
+                       JS::SourceOwnership::Borrowed)) {
+    return false;
+  }
+
+  JS::Rooted<JS::Value> value(aCx);
+  if (!JS::Evaluate(aCx, options, sourceText, &value) || !value.isObject()) {
+    return false;
+  }
+
+  aResult.set(&value.toObject());
+  return true;
+}
+
+bool DefineNoopGleanGlobals(JSContext* aCx,
+                            JS::Handle<JSObject*> aGlobal) {
+  JS::Rooted<JSObject*> proxy(aCx);
+  if (!CreateNoopGleanProxy(aCx, &proxy)) {
+    return false;
+  }
+
+  JS::Rooted<JS::Value> value(aCx, JS::ObjectValue(*proxy));
+  return JS_DefineProperty(aCx, aGlobal, "Glean", value, JSPROP_ENUMERATE) &&
+         JS_DefineProperty(aCx, aGlobal, "GleanPings", value,
+                           JSPROP_ENUMERATE);
+}
+
+}  // namespace mozilla::glean
