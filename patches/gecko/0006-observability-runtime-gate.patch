+  void AccumulateSamplesSigned(const nsTArray<int64_t>&) const {}
+  Result<Maybe<DistributionData>, nsCString> TestGetValue(
+      const nsACString& = nsCString()) const {
+    return NoMetricValue<DistributionData>();
+  }
+};
+
+class DatetimeMetric {
+ public:
+  constexpr explicit DatetimeMetric(uint32_t) {}
+  void Set(const PRExplodedTime* = nullptr) const {}
