From a7c99d2e0f6b51babe361abc7d8569cfb518759a Mon Sep 17 00:00:00 2001
From: Desktop Embedder Project <desktop-embedder@example.invalid>
Date: Wed, 2 Sep 2026 09:02:00 +0800
Subject: [PATCH] Guard WindowRealm cleanup after navigation

---
 remote/shared/Realm.sys.mjs                        | 11 ++++++--
 .../messagehandler/test/browser/browser_realms.js  | 29 ++++++++++++++++++++++
 .../resources/modules/windowglobal/command.sys.mjs |  5 ++++
 3 files changed, 43 insertions(+), 2 deletions(-)

diff --git a/remote/shared/Realm.sys.mjs b/remote/shared/Realm.sys.mjs
index eac924fc02d4..e995354a4d47 100644
--- a/remote/shared/Realm.sys.mjs
+++ b/remote/shared/Realm.sys.mjs
@@ -145,6 +145,7 @@ export class Realm {
  * Wrapper for Window realms including sandbox objects.
  */
 export class WindowRealm extends Realm {
+  #innerWindowId;
   #realmAutomationFeaturesEnabled;
   #globalObject;
   #globalObjectReference;
@@ -171,6 +172,7 @@ export class WindowRealm extends Realm {
     this.#isSandbox = sandboxName !== null;
     this.#sandboxName = sandboxName;
     this.#window = window;
+    this.#innerWindowId = window.windowGlobalChild.innerWindowId;
     this.#globalObject = this.#isSandbox ? this.#createSandbox() : this.#window;
     this.#globalObjectReference = lazy.dbg.makeGlobalObjectReference(
       this.#globalObject
@@ -181,8 +183,13 @@ export class WindowRealm extends Realm {
 
   destroy() {
     if (this.#realmAutomationFeaturesEnabled) {
-      lazy.dbg.disableAsyncStack(this.#globalObject);
-      lazy.dbg.disableUnlimitedStacksCapturing(this.#globalObject);
+      if (
+        WindowGlobalChild.getByInnerWindowId(this.#innerWindowId)
+          ?.isCurrentGlobal
+      ) {
+        lazy.dbg.disableAsyncStack(this.#globalObject);
+        lazy.dbg.disableUnlimitedStacksCapturing(this.#globalObject);
+      }
       this.#realmAutomationFeaturesEnabled = false;
     }
 
diff --git a/remote/shared/messagehandler/test/browser/browser_realms.js b/remote/shared/messagehandler/test/browser/browser_realms.js
index 815bfbbe85af..6c0e4e32517e 100644
--- a/remote/shared/messagehandler/test/browser/browser_realms.js
+++ b/remote/shared/messagehandler/test/browser/browser_realms.js
@@ -7,6 +7,17 @@ const { RootMessageHandler } = ChromeUtils.importESModule(
   "chrome://remote/content/shared/messagehandler/RootMessageHandler.sys.mjs"
 );
 
+async function executeInDefaultRealm(rootMessageHandler, browsingContext) {
+  return rootMessageHandler.handleCommand({
+    moduleName: "command",
+    commandName: "testExecuteInDefaultRealm",
+    destination: {
+      type: WindowGlobalMessageHandler.type,
+      id: browsingContext.id,
+    },
+  });
+}
+
 add_task(async function test_tab_is_removed() {
   const tab = await addTab("https://example.com/document-builder.sjs?html=tab");
   const sessionId = "realms";
@@ -33,6 +44,12 @@ add_task(async function test_tab_is_removed() {
 
   is(rootMessageHandler.realms.size, 1, "Realm is added in the internal map");
 
+  is(
+    await executeInDefaultRealm(rootMessageHandler, browsingContext),
+    "normal",
+    "Executed in the realm before tab removal"
+  );
+
   const onRealmDestroyed = rootMessageHandler.once("realm-destroyed");
 
   gBrowser.removeTab(tab);
@@ -75,6 +92,12 @@ add_task(async function test_same_origin_navigation() {
 
   is(rootMessageHandler.realms.size, 1, "Realm is added in the internal map");
 
+  is(
+    await executeInDefaultRealm(rootMessageHandler, browsingContext),
+    "normal",
+    "Executed in the realm before same-origin navigation"
+  );
+
   const onRealmDestroyed = rootMessageHandler.once("realm-destroyed");
   const onNewRealmCreated = rootMessageHandler.once("realm-created");
 
@@ -126,6 +149,12 @@ add_task(async function test_cross_origin_navigation() {
 
   is(rootMessageHandler.realms.size, 1, "Realm is added in the internal map");
 
+  is(
+    await executeInDefaultRealm(rootMessageHandler, browsingContext),
+    "normal",
+    "Executed in the realm before cross-origin navigation"
+  );
+
   const onRealmDestroyed = rootMessageHandler.once("realm-destroyed");
   const onNewRealmCreated = rootMessageHandler.once("realm-created");
 
diff --git a/remote/shared/messagehandler/test/browser/resources/modules/windowglobal/command.sys.mjs b/remote/shared/messagehandler/test/browser/resources/modules/windowglobal/command.sys.mjs
index 99ee76a4b8c8..367f06854936 100644
--- a/remote/shared/messagehandler/test/browser/resources/modules/windowglobal/command.sys.mjs
+++ b/remote/shared/messagehandler/test/browser/resources/modules/windowglobal/command.sys.mjs
@@ -52,6 +52,11 @@ class CommandModule extends Module {
     return "windowglobal-value";
   }
 
+  testExecuteInDefaultRealm() {
+    const realm = this.messageHandler.realms.get("");
+    return realm.executeInRealm("1 + 1").evaluationStatus;
+  }
+
   testSetValue(params) {
     const { value } = params;
 
-- 
