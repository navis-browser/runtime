From 090f45ff5e67ab0fd10e78eaeac2d888a37869ed Mon Sep 17 00:00:00 2001
From: Desktop Embedder Project <desktop-embedder@example.invalid>
Date: Tue, 1 Sep 2026 12:08:00 +0800
Subject: [PATCH] Route active WebDriver virtual authenticators across native
 platforms

---
 dom/webauthn/WebAuthnService.cpp | 14 +++++++++++---
 dom/webauthn/WebAuthnService.h   |  5 ++++-
 2 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/dom/webauthn/WebAuthnService.cpp b/dom/webauthn/WebAuthnService.cpp
index fc4176892df9..bf71c5797ec0 100644
--- a/dom/webauthn/WebAuthnService.cpp
+++ b/dom/webauthn/WebAuthnService.cpp
@@ -474,16 +474,24 @@ WebAuthnService::AddVirtualAuthenticator(
     bool aHasResidentKey, bool aHasUserVerification, bool aIsUserConsenting,
     bool aIsUserVerified, nsACString& aRetval) {
   MOZ_ASSERT(NS_IsMainThread());
-  return AuthrsService()->AddVirtualAuthenticator(
+  nsresult rv = AuthrsService()->AddVirtualAuthenticator(
       aProtocol, aTransport, aHasResidentKey, aHasUserVerification,
       aIsUserConsenting, aIsUserVerified, aRetval);
+  if (NS_SUCCEEDED(rv) && !aRetval.IsEmpty()) {
+    mVirtualAuthenticatorIds.Insert(aRetval);
+  }
+  return rv;
 }
 
 NS_IMETHODIMP
 WebAuthnService::RemoveVirtualAuthenticator(
     const nsACString& aAuthenticatorId) {
   MOZ_ASSERT(NS_IsMainThread());
-  return AuthrsService()->RemoveVirtualAuthenticator(aAuthenticatorId);
+  nsresult rv = AuthrsService()->RemoveVirtualAuthenticator(aAuthenticatorId);
+  if (NS_SUCCEEDED(rv)) {
+    mVirtualAuthenticatorIds.Remove(aAuthenticatorId);
+  }
+  return rv;
 }
 
 NS_IMETHODIMP
diff --git a/dom/webauthn/WebAuthnService.h b/dom/webauthn/WebAuthnService.h
index 7f79a43da411..4d794796c7dc 100644
--- a/dom/webauthn/WebAuthnService.h
+++ b/dom/webauthn/WebAuthnService.h
@@ -10,6 +10,7 @@
 #include "mozilla/StaticPrefs_security.h"
 #include "mozilla/dom/WebAuthnPromiseHolder.h"
 #include "nsIWebAuthnService.h"
+#include "nsTHashSet.h"
 
 #ifdef MOZ_WIDGET_ANDROID
 #  include "AndroidWebAuthnService.h"
@@ -89,7 +90,8 @@ class WebAuthnService final : public nsIWebAuthnService {
                                            nsIWebAuthnSignArgs* aArgs);
 
   nsIWebAuthnService* DefaultService() {
-    if (StaticPrefs::security_webauth_webauthn_enable_softtoken()) {
+    if (!mVirtualAuthenticatorIds.IsEmpty() ||
+        StaticPrefs::security_webauth_webauthn_enable_softtoken()) {
       return mAuthrsService;
     }
     return mPlatformService;
@@ -111,6 +113,7 @@ class WebAuthnService final : public nsIWebAuthnService {
 
   nsCOMPtr<nsIWebAuthnService> mAuthrsService;
   nsCOMPtr<nsIWebAuthnService> mPlatformService;
+  nsTHashSet<nsCStringHashKey> mVirtualAuthenticatorIds;
 };
 
 }  // namespace mozilla::dom
-- 
2.51.0
