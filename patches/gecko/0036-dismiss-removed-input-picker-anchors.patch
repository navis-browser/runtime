From b4f91ad8606eb1a25707acb768f2275bca8a63a2 Mon Sep 17 00:00:00 2001
From: willvar <0@willvar.tw>
Date: Tue, 1 Sep 2026 15:35:00 +0800
Subject: [PATCH] Dismiss input pickers when their content anchor is removed

---
 toolkit/actors/InputPickerChildCommon.sys.mjs | 13 +++++++++++++
 toolkit/actors/SelectChild.sys.mjs            | 12 ++++++++++++
 2 files changed, 25 insertions(+)

diff --git a/toolkit/actors/InputPickerChildCommon.sys.mjs b/toolkit/actors/InputPickerChildCommon.sys.mjs
--- a/toolkit/actors/InputPickerChildCommon.sys.mjs
+++ b/toolkit/actors/InputPickerChildCommon.sys.mjs
@@ -11,6 +11,7 @@
   #inputElement = null;
   #inputType = "";
   #openingRect = null;
+  #anchorMutationObserver = null;
   #namespace;
   /** @type {AbortController} */
   #abortController;
@@ -33,6 +34,8 @@
    */
   close() {
     this.#abortController.abort();
+    this.#anchorMutationObserver?.disconnect();
+    this.#anchorMutationObserver = null;
     this.closeImpl(this.#inputElement);
     this.#inputElement = null;
     this.#inputType = "";
@@ -53,6 +56,16 @@
   addListeners(aElement) {
     this.#abortController = new AbortController();
     const win = aElement.documentGlobal;
+    this.#anchorMutationObserver = new win.MutationObserver(() => {
+      if (this.#inputElement && !this.#inputElement.isConnected) {
+        this.sendAsyncMessage(`InputPicker:Close`, {});
+        this.close();
+      }
+    });
+    this.#anchorMutationObserver.observe(aElement.ownerDocument, {
+      childList: true,
+      subtree: true,
+    });
     win.addEventListener("pagehide", this, {
       signal: this.#abortController.signal,
     });
diff --git a/toolkit/actors/SelectChild.sys.mjs b/toolkit/actors/SelectChild.sys.mjs
--- a/toolkit/actors/SelectChild.sys.mjs
+++ b/toolkit/actors/SelectChild.sys.mjs
@@ -82,6 +82,16 @@
       subtree: true,
       attributes: true,
     });
+    this.anchorMut = new win.MutationObserver(() => {
+      if (this.element && !this.element.isConnected) {
+        this.actor.sendAsyncMessage("Forms:HideDropDown", {});
+        this.uninit();
+      }
+    });
+    this.anchorMut.observe(this.element.ownerDocument, {
+      childList: true,
+      subtree: true,
+    });
 
     XPCOMUtils.defineLazyPreferenceGetter(
       this,
@@ -106,6 +116,8 @@
     this.element = null;
     this.actor = null;
     this.mut.disconnect();
+    this.anchorMut.disconnect();
+    this.anchorMut = null;
     this._updateTimer.disarm();
     this._updateTimer = null;
     this._openingRect = null;
-- 
2.55.0
