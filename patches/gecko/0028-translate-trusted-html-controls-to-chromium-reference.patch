Subject: [PATCH] Translate trusted HTML controls toward Chromium 152

---
 toolkit/modules/DateTimePickerPanel.sys.mjs       | 12 ++--
 toolkit/themes/shared/datetimeinputpickers.css     | 71 ++++++++++++++--------
 toolkit/themes/shared/media/videocontrols.css      | 51 +++++++++++-----
 3 files changed, 81 insertions(+), 53 deletions(-)

diff --git a/toolkit/modules/DateTimePickerPanel.sys.mjs b/toolkit/modules/DateTimePickerPanel.sys.mjs
--- a/toolkit/modules/DateTimePickerPanel.sys.mjs
+++ b/toolkit/modules/DateTimePickerPanel.sys.mjs
@@ -6,12 +6,12 @@ import { InputPickerPanelCommon } from "./InputPickerPanelCommon.sys.mjs";
 
 /** @import {OpenPickerInfo} from "./InputPickerPanelCommon.sys.mjs" */
 
-const TIME_PICKER_WIDTH = "12.8em";
-const TIME_PICKER_HEIGHT = "22.8em";
-const DATE_PICKER_WIDTH = "24em";
-const DATE_PICKER_HEIGHT = "26.9em";
-const DATETIME_PICKER_WIDTH = "39.8em";
-const DATETIME_PICKER_HEIGHT = "26.9em";
+const TIME_PICKER_WIDTH = "11em";
+const TIME_PICKER_HEIGHT = "25.7em";
+const DATE_PICKER_WIDTH = "19.2em";
+const DATE_PICKER_HEIGHT = "24.5em";
+const DATETIME_PICKER_WIDTH = "31.2em";
+const DATETIME_PICKER_HEIGHT = "25.7em";
 
 export class DateTimePickerPanel extends InputPickerPanelCommon {
   constructor(element) {
diff --git a/toolkit/themes/shared/datetimeinputpickers.css b/toolkit/themes/shared/datetimeinputpickers.css
--- a/toolkit/themes/shared/datetimeinputpickers.css
+++ b/toolkit/themes/shared/datetimeinputpickers.css
@@ -4,7 +4,7 @@
 
 :root {
   --border-style: 0.1rem solid;
-  --border-radius: 0.3rem;
+  --border-radius: 0.2rem;
   --border-color: ButtonBorder;
   --button-text-color: ButtonText;
   --button-text-color-hover: SelectedItemText;
@@ -14,8 +14,9 @@
   --button-background-active: SelectedItemText;
   --button-border-hover: SelectedItem;
   --button-border-active: SelectedItem;
-  --today-background: Mark;
-  --today-color: MarkText;
+  --today-background: transparent;
+  --today-color: inherit;
+  --today-border-color: color-mix(in srgb, FieldText 55%, transparent);
   --navigation-arrow-color-hover: SelectedItemText;
   --navigation-arrow-color-active: SelectedItem;
   --navigation-arrow-background-hover: SelectedItem;
@@ -25,18 +26,16 @@
   --navigation-arrow-fill-opacity: 1;
   --navigation-arrow-fill-opacity-hover: 1;
   --navigation-arrow-fill-opacity-active: 1;
-  --calendar-item-background-hover: color-mix(in srgb, FieldText 20%, transparent);
+  --calendar-item-background-hover: color-mix(in srgb, SelectedItem 18%, transparent);
 
-  /* Use -moz-activehyperlinktext to get a system color that
-     by default will be closest to Red */
-  --weekend-font-color: -moz-activehyperlinktext;
+  --weekend-font-color: inherit;
 
-  --disabled-background-color: ButtonShadow;
-  --disabled-opacity: 0.5;
+  --disabled-background-color: transparent;
+  --disabled-opacity: 0.38;
 
   /* TODO: these need to be in sync (ish) with DateTimePickerPanel.sys.mjs */
   font-size: 10px;
-  --font-size-default: 1.1rem;
+  --font-size-default: 1.2rem;
   --spinner-width: 3rem;
   --spinner-margin-block: 0.4rem;
   --spinner-item-height: 2.4rem;
@@ -45,7 +44,7 @@
   --colon-width: 2rem;
   --day-period-spacing-width: 1rem;
