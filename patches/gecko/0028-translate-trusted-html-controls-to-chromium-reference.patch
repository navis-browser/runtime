@@ -146,9 +146,20 @@
   justify-content: center;
   align-items: center;
   overflow: hidden;
-  height: 40px;
-  padding: 0 9px;
-  background-color: rgba(26, 26, 26, 0.8);
+  height: 48px;
+  padding: 8px 8px 0;
+  background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.92));
+}
+
+:host(audio) .controlsContainer {
+  color: CanvasText;
+}
+
+:host(audio) .controlBar {
+  height: 54px;
+  padding: 0 10px;
+  border-radius: 27px;
+  background: color-mix(in srgb, Canvas 94%, CanvasText 6%);
 }
 
 .touch .controlBar {
@@ -191,11 +202,15 @@
 }
 
 .controlBar > .button:enabled:hover {
