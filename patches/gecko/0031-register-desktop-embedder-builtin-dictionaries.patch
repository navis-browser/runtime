From 6cc7f677b4ef31578a34e22fc0bb0d07b37f1350 Mon Sep 17 00:00:00 2001
From: willvar <0@willvar.tw>
Date: Mon, 31 Aug 2026 00:50:00 +0800
Subject: [PATCH] Register Desktop Embedder built-in dictionaries

---
 .../extensions/internal/XPIProvider.sys.mjs   |  4 +++-
 toolkit/mozapps/extensions/moz.build          |  8 ++++++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/toolkit/mozapps/extensions/internal/XPIProvider.sys.mjs b/toolkit/mozapps/extensions/internal/XPIProvider.sys.mjs
index b51a27e705198add6d334a861f4b084fe7d0e54b..32dd5b9714964c1c9c389b55648bdccc69a69b15 100644
--- a/toolkit/mozapps/extensions/internal/XPIProvider.sys.mjs
+++ b/toolkit/mozapps/extensions/internal/XPIProvider.sys.mjs
@@ -85,7 +85,9 @@ const PREF_APPLICATION_BUILTIN_IDS =
   "extensions.applicationBuiltins.allowedIds";
 
 // Specify a list of valid built-in add-ons to load.
-const BUILT_IN_ADDONS_URI = "chrome://browser/content/built_in_addons.json";
+const BUILT_IN_ADDONS_URI = AppConstants.MOZ_DESKTOP_EMBEDDER
+  ? "resource://gre/modules/built_in_addons.json"
+  : "chrome://browser/content/built_in_addons.json";
 
 const DIR_EXTENSIONS = "extensions";
 const DIR_SYSTEM_ADDONS = "features";
diff --git a/toolkit/mozapps/extensions/moz.build b/toolkit/mozapps/extensions/moz.build
index 0913762ffaa6a10510c571b1debfd23eb3bfa9bb..054110775bb2d62f51e7fb558fd759b463ff268f 100644
--- a/toolkit/mozapps/extensions/moz.build
+++ b/toolkit/mozapps/extensions/moz.build
@@ -50,6 +50,14 @@ if CONFIG["MOZ_WEBEXTENSIONS_RUNTIME"]:
         FINAL_TARGET_FILES.chrome.browser.content += [
             "!%s" % built_in_addons,
         ]
+    elif CONFIG["MOZ_DESKTOP_EMBEDDER"]:
+        # Desktop embedders do not own Firefox's chrome://browser package.
+        # Keep the generated dictionary registry in the resource-visible
+        # modules directory so both unpacked builds and packaged OmniJars can
+        # resolve it through resource://gre.
+        FINAL_TARGET_FILES.modules += [
+            "!%s" % built_in_addons,
+        ]
 
 EXTRA_PP_COMPONENTS += [
     "extensions.manifest",
-- 
2.51.0
