From 58b26b58f1d6682ac3a74bd23da6e06ecbadce8c Mon Sep 17 00:00:00 2001
From: willvar <0@willvar.tw>
Date: Sat, 29 Aug 2026 23:45:00 +0800
Subject: [PATCH] Route certificate errors through the engine about module

---
 docshell/base/nsAboutRedirector.cpp | 6 ++++++
 docshell/build/components.conf      | 3 +++
 2 files changed, 9 insertions(+)

diff --git a/docshell/base/nsAboutRedirector.cpp b/docshell/base/nsAboutRedirector.cpp
--- a/docshell/base/nsAboutRedirector.cpp
+++ b/docshell/base/nsAboutRedirector.cpp
@@ -158,6 +158,12 @@ static const RedirEntry kRedirMap[] = {
 #if !defined(ANDROID) && !defined(XP_WIN)
     {"webauthn", "chrome://global/content/aboutWebauthn.html",
      nsIAboutModule::ALLOW_SCRIPT | nsIAboutModule::IS_SECURE_CHROME_UI},
+#endif
+#ifdef MOZ_DESKTOP_EMBEDDER
+    {"certerror", "chrome://global/content/aboutNetError.html",
+     nsIAboutModule::URI_SAFE_FOR_UNTRUSTED_CONTENT |
+         nsIAboutModule::URI_CAN_LOAD_IN_CHILD | nsIAboutModule::ALLOW_SCRIPT |
+         nsIAboutModule::HIDE_FROM_ABOUTABOUT},
 #endif
     {"neterror", "chrome://global/content/aboutNetError.html",
      nsIAboutModule::URI_SAFE_FOR_UNTRUSTED_CONTENT |
diff --git a/docshell/build/components.conf b/docshell/build/components.conf
--- a/docshell/build/components.conf
+++ b/docshell/build/components.conf
@@ -30,6 +30,9 @@ about_pages = [
     'webrtc',
 ]
 
+if defined('MOZ_DESKTOP_EMBEDDER'):
+    about_pages.append('certerror')
+
 if defined('MOZ_SAFE_BROWSING'):
     about_pages.append('url-classifier')
 
-- 
