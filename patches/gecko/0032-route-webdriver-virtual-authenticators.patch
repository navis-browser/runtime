From 2a657d8ae6d7203f5576494756732ee2aa1a1a32 Mon Sep 17 00:00:00 2001
From: willvar <0@willvar.tw>
Date: Mon, 31 Aug 2026 03:30:00 +0800
Subject: [PATCH] Route WebDriver virtual authenticators without product prefs

---
 dom/webauthn/authrs_bridge/src/lib.rs        | 52 ++++++++++++---------
 dom/webauthn/authrs_bridge/src/test_token.rs | 19 +++++++-
 2 files changed, 48 insertions(+), 23 deletions(-)

diff --git a/dom/webauthn/authrs_bridge/src/lib.rs b/dom/webauthn/authrs_bridge/src/lib.rs
index c06b1242e8ce..48b08f006321 100644
--- a/dom/webauthn/authrs_bridge/src/lib.rs
+++ b/dom/webauthn/authrs_bridge/src/lib.rs
@@ -748,12 +748,17 @@ impl AuthrsService {
 
     xpcom_method!(get_is_uvpaa => GetIsUVPAA() -> bool);
     fn get_is_uvpaa(&self) -> Result<bool, nsresult> {
-        if static_prefs::pref!("security.webauth.webauthn_enable_usbtoken") {
-            Ok(false)
-        } else if static_prefs::pref!("security.webauth.webauthn_enable_softtoken") {
+        // WebDriver virtual authenticators are a privileged automation
+        // surface. Prefer them while at least one is registered without
+        // changing the product's locked production USB-token policy.
+        if self.test_token_manager.has_virtual_authenticators()
+            || static_prefs::pref!("security.webauth.webauthn_enable_softtoken")
+        {
             Ok(self
                 .test_token_manager
                 .has_user_verifying_platform_authenticator())
+        } else if static_prefs::pref!("security.webauth.webauthn_enable_usbtoken") {
+            Ok(false)
         } else {
             Err(NS_ERROR_NOT_AVAILABLE)
         }
@@ -1010,7 +1015,10 @@ impl AuthrsService {
         // in parallel to any number of transports. We only support the USB transport in production
         // configurations, so we do not need the full generality of `AuthenticatorService` here.
         // We disable the USB transport in tests that use virtual devices.
-        if static_prefs::pref!("security.webauth.webauthn_enable_usbtoken") {
+        if self.test_token_manager.has_virtual_authenticators() {
+            self.test_token_manager
+                .register(timeout_ms.into(), info, status_tx, state_callback);
+        } else if static_prefs::pref!("security.webauth.webauthn_enable_usbtoken") {
             // TODO(Bug 1855290) Remove this presence prompt
             send_prompt(
                 BrowserPromptType::Presence,
@@ -1257,17 +1265,19 @@ impl AuthrsService {
             }),
         );
 
-        // TODO(Bug 1855290) Remove this presence prompt
-        send_prompt(
-            BrowserPromptType::Presence,
-            tid,
-            Some(&info.origin),
-            Some(browsing_context_id),
-        )
-        .inspect_err(|_| self.discard_transaction())?;
-
         // As in `register`, we are intentionally avoiding `AuthenticatorService` here.
-        if static_prefs::pref!("security.webauth.webauthn_enable_usbtoken") {
+        if self.test_token_manager.has_virtual_authenticators() {
+            self.test_token_manager
+                .sign(timeout_ms as u64, info, status_tx, state_callback);
+        } else if static_prefs::pref!("security.webauth.webauthn_enable_usbtoken") {
+            // TODO(Bug 1855290) Remove this presence prompt
+            send_prompt(
+                BrowserPromptType::Presence,
+                tid,
+                Some(&info.origin),
+                Some(browsing_context_id),
+            )
+            .inspect_err(|_| self.discard_transaction())?;
             self.usb_token_manager.lock().unwrap().sign(
                 timeout_ms as u64,
                 info,
@@ -1311,12 +1321,9 @@ impl AuthrsService {
         allow_list: &ThinVec<ThinVec<u8>>,
         callback: &nsIWebAuthnAutoFillEntriesCallback,
     ) -> Result<(), nsresult> {
-        if static_prefs::pref!("security.webauth.webauthn_enable_usbtoken") {
-            // We don't currently support silent discovery for credentials on USB tokens.
-            let empty: ThinVec<Option<RefPtr<nsIWebAuthnAutoFillEntry>>> = thin_vec![];
-            unsafe { callback.Resolve(&empty) };
-            return Ok(());
-        } else if static_prefs::pref!("security.webauth.webauthn_enable_softtoken") {
+        if self.test_token_manager.has_virtual_authenticators()
+            || static_prefs::pref!("security.webauth.webauthn_enable_softtoken")
+        {
             let rp_id_string = rp_id.to_string();
             let allow_list: Vec<PublicKeyCredentialDescriptor> = allow_list
                 .iter()
@@ -1333,6 +1340,11 @@ impl AuthrsService {
                 Err(err) => unsafe { callback.Reject(err) },
             };
             return Ok(());
+        } else if static_prefs::pref!("security.webauth.webauthn_enable_usbtoken") {
+            // We don't currently support silent discovery for credentials on USB tokens.
+            let empty: ThinVec<Option<RefPtr<nsIWebAuthnAutoFillEntry>>> = thin_vec![];
+            unsafe { callback.Resolve(&empty) };
+            return Ok(());
         } else {
             unsafe { callback.Reject(NS_ERROR_FAILURE) };
             return Ok(());
diff --git a/dom/webauthn/authrs_bridge/src/test_token.rs b/dom/webauthn/authrs_bridge/src/test_token.rs
index ec9dff562664..98347690591c 100644
--- a/dom/webauthn/authrs_bridge/src/test_token.rs
+++ b/dom/webauthn/authrs_bridge/src/test_token.rs
@@ -794,6 +794,13 @@ impl TestTokenManager {
         Default::default()
     }
 
+    pub fn has_virtual_authenticators(&self) -> bool {
+        self.state
+            .lock()
+            .map(|state| !state.is_empty())
+            .unwrap_or(false)
+    }
+
     pub fn add_virtual_authenticator(
         &self,
         protocol: AuthenticatorVersion,
@@ -934,7 +941,9 @@ impl TestTokenManager {
         status: Sender<StatusUpdate>,
         callback: StateCallback<Result<RegisterResult, AuthenticatorError>>,
     ) {
-        if !static_prefs::pref!("security.webauth.webauthn_enable_softtoken") {
+        if !static_prefs::pref!("security.webauth.webauthn_enable_softtoken")
+            && !self.has_virtual_authenticators()
+        {
             return;
         }
 
@@ -973,7 +982,9 @@ impl TestTokenManager {
         status: Sender<StatusUpdate>,
         callback: StateCallback<Result<SignResult, AuthenticatorError>>,
     ) {
-        if !static_prefs::pref!("security.webauth.webauthn_enable_softtoken") {
+        if !static_prefs::pref!("security.webauth.webauthn_enable_softtoken")
+            && !self.has_virtual_authenticators()
+        {
             return;
         }
 
@@ -1005,7 +1016,9 @@ impl TestTokenManager {
     }
 
     pub fn has_user_verifying_platform_authenticator(&self) -> bool {
-        if !static_prefs::pref!("security.webauth.webauthn_enable_softtoken") {
+        if !static_prefs::pref!("security.webauth.webauthn_enable_softtoken")
+            && !self.has_virtual_authenticators()
+        {
             return false;
         }
 
-- 
