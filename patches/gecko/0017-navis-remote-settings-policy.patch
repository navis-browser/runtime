+// SPDX-License-Identifier: CC0-1.0
+"use strict";
+
+const { Utils } = ChromeUtils.importESModule(
+  "resource://services-settings/Utils.sys.mjs");
+const { RemoteSettings } = ChromeUtils.importESModule(
+  "resource://services-settings/remote-settings.sys.mjs");
+const { SharedUtils } = ChromeUtils.importESModule(
+  "resource://services-settings/SharedUtils.sys.mjs");
+const { Downloader } = ChromeUtils.importESModule(
+  "resource://services-settings/Attachments.sys.mjs");
+
+add_setup(function () {
+  do_get_profile();
+  Services.prefs.setBoolPref("services.settings.navis_enforce_local_only_in_tests", true);
+  Services.prefs.setBoolPref("services.settings.navis_enforce_allowed_collections_in_tests", true);
+  Services.prefs.setStringPref("services.settings.navis_allowed_collections", "security-state/onecrl");
+  Services.prefs.setStringPref("services.settings.navis_sync_collections", "");
+  registerCleanupFunction(() => {
+    for (const name of ["navis_enforce_local_only_in_tests", "navis_enforce_allowed_collections_in_tests",
+                        "navis_allowed_collections", "navis_sync_collections"]) {
+      Services.prefs.clearUserPref(`services.settings.${name}`);
+    }
+  });
+});
+
+add_task(async function test_profile_data_and_forced_signature_fetch_cannot_override_package() {
+  const client = RemoteSettings("onecrl", { bucketName: "security-state" });
+  await client.db.clear();
+  await client.db.importChanges({ signature: { x5u: "https://should-not-connect.invalid/chain" } },
+    9999999999999, [{ id: "stale-profile-record", last_modified: 9999999999999 }]);
+  const { data, timestamp } = await SharedUtils.loadJSONDump("security-state", "onecrl");
+  Assert.deepEqual(await client.get({ forceSync: true, verifySignature: true }),
+    await client._filterEntries(data), "Only the application package supplies records");
+  Assert.equal(await client.getLastModified(), timestamp);
+  Assert.deepEqual(await RemoteSettings.pullStartupBundle(), []);
+  await RemoteSettings.pollChanges({ full: true });
+  await client.sync();
+  await client.maybeSync(9999999999999);
+  Assert.equal(await client.db.getLastModified(), 9999999999999,
+    "Offline operations do not mutate the old profile database");
+  await client.db.clear();
+});
+
+add_task(async function test_low_level_network_and_attachment_bundles_are_closed() {
+  Assert.ok(Utils.isLocalOnly);
+  Assert.ok(Utils.shouldSkipRemoteActivity);
+  await Assert.rejects(Utils.fetch("https://should-not-connect.invalid/"), /disabled/);
+  // Kinto stores this method as fetchFunc on its HTTP object. That receiver
+  // must not change application policy or allow transport construction.
+  const fetchCallback = Utils.fetch;
+  await Assert.rejects(fetchCallback("https://should-not-connect.invalid/"), /disabled/);
+  await Assert.rejects(fetchCallback.call({}, "https://should-not-connect.invalid/"), /disabled/);
+  await Assert.rejects(fetchCallback.call({ isLocalOnly: false },
+    "https://should-not-connect.invalid/"), /disabled/);
+  await Assert.rejects(Utils.baseAttachmentsURL(), /local only/);
+  const downloader = new Downloader("security-state", "onecrl");
+  Assert.equal(await downloader.cacheAll(true), null);
+  await Assert.rejects(downloader.downloadAsBytes({ id: "arbitrary" }), /disabled/);
+});
