+    return namespace(
+        enabled=True,
+        collections=tuple(collections),
+        bootstrap_collections=tuple(bootstrap_collections),
+        sync_collections=tuple(sync_collections),
+        collections_csv=",".join(collections),
+        sync_collections_csv=",".join(sync_collections),
+    )
