diff --git a/services/settings/test/unit/test_navis_collection_policy.js b/services/settings/test/unit/test_navis_collection_policy.js
new file mode 100644
index 0000000000000000000000000000000000000000..860df2419bf8805b02f0dccd2e44a58ac073823f
--- /dev/null
+++ b/services/settings/test/unit/test_navis_collection_policy.js
@@ -0,0 +1,161 @@
+/* Any copyright is dedicated to the Public Domain.
+   http://creativecommons.org/publicdomain/zero/1.0/ */
+
+"use strict";
+
+const PREF_ALLOWED_COLLECTIONS =
+  "services.settings.navis_allowed_collections";
+const PREF_SYNC_COLLECTIONS = "services.settings.navis_sync_collections";
+const PREF_ENFORCE_IN_TESTS =
+  "services.settings.navis_enforce_allowed_collections_in_tests";
+
+const TEST_ALLOWED_COLLECTIONS =
+  "main/embedder-test-allowed,main/embedder-test-local-only," +
+  "security-state/embedder-test-security";
+const TEST_SYNC_COLLECTIONS =
+  "main/embedder-test-allowed,security-state/embedder-test-security";
+
+add_setup(async function setup_navis_collection_policy() {
+  if (!AppConstants.MOZ_NAVIS_REMOTE_SETTINGS_POLICY) {
+    return;
+  }
+
+  Services.prefs.setStringPref(
+    PREF_ALLOWED_COLLECTIONS,
+    TEST_ALLOWED_COLLECTIONS
+  );
+  Services.prefs.setStringPref(PREF_SYNC_COLLECTIONS, TEST_SYNC_COLLECTIONS);
+  Services.prefs.setBoolPref(PREF_ENFORCE_IN_TESTS, true);
+
+  registerCleanupFunction(() => {
+    Services.prefs.clearUserPref(PREF_ALLOWED_COLLECTIONS);
+    Services.prefs.clearUserPref(PREF_SYNC_COLLECTIONS);
+    Services.prefs.clearUserPref(PREF_ENFORCE_IN_TESTS);
+  });
+});
+
+add_task(async function test_empty_policy_override_fails_closed() {
+  if (!AppConstants.MOZ_NAVIS_REMOTE_SETTINGS_POLICY) {
+    return;
+  }
+
+  Services.prefs.setStringPref(PREF_ALLOWED_COLLECTIONS, "");
+  const disallowed = RemoteSettings("navis-test-empty-policy");
+  await disallowed.db.clear();
+  await disallowed.db.importChanges({}, 40, [
+    { id: "stale-record", last_modified: 40 },
+  ]);
+
+  deepEqual(
+    await disallowed.get(),
+    [],
+    "An empty policy denies every collection"
+  );
+  equal(
+    await disallowed.getLastModified(),
+    -1,
+    "An empty policy exposes no profile timestamp"
+  );
+  await disallowed.db.clear();
+  Services.prefs.setStringPref(PREF_ALLOWED_COLLECTIONS, TEST_ALLOWED_COLLECTIONS);
+});
+
+add_task(async function test_policy_ignores_disallowed_profile_data_and_sync() {
+  if (!AppConstants.MOZ_NAVIS_REMOTE_SETTINGS_POLICY) {
+    return;
+  }
+
+  const allowed = RemoteSettings("embedder-test-allowed");
+  const disallowed = RemoteSettings("example");
+  await Promise.all([allowed.db.clear(), disallowed.db.clear()]);
+
+  await allowed.db.importChanges({}, 41, [
+    { id: "allowed-record", last_modified: 41 },
+  ]);
+  await disallowed.db.importChanges({}, 42, [
+    { id: "stale-disallowed-record", last_modified: 42 },
+  ]);
+
+  deepEqual(
+    await allowed.get(),
+    [{ id: "allowed-record", last_modified: 41 }],
+    "An allowed collection can read its profile database"
+  );
+  deepEqual(
+    await disallowed.get(),
+    [],
+    "A disallowed collection cannot read stale profile data"
+  );
+  equal(
+    await disallowed.getLastModified(),
+    -1,
+    "A disallowed collection does not expose its profile timestamp"
+  );
+
+  await disallowed.sync();
+  await disallowed.maybeSync(100);
+  equal(
+    await disallowed.db.getLastModified(),
+    42,
+    "Disabled synchronization does not mutate the stored database"
+  );
+
+  await Promise.all([allowed.db.clear(), disallowed.db.clear()]);
+});
+
+add_task(async function test_readable_offline_collection_never_synchronizes() {
+  if (!AppConstants.MOZ_NAVIS_REMOTE_SETTINGS_POLICY) {
+    return;
+  }
+
+  const localOnly = RemoteSettings("embedder-test-local-only");
+  await localOnly.db.clear();
+  await localOnly.db.importChanges({}, 44, [
+    { id: "offline-record", last_modified: 44 },
+  ]);
+
+  deepEqual(
+    await localOnly.get(),
+    [{ id: "offline-record", last_modified: 44 }],
+    "A packaged-only collection remains readable"
+  );
+  equal(
+    await localOnly.getLastModified(),
+    44,
+    "A packaged-only collection exposes its local timestamp"
+  );
+
+  await localOnly.sync();
+  await localOnly.maybeSync(100);
+  equal(
+    await localOnly.db.getLastModified(),
+    44,
+    "A packaged-only collection cannot synchronize or mutate local data"
+  );
+
+  await localOnly.db.clear();
+});
+
+add_task(async function test_policy_normalizes_preview_bucket_names() {
+  if (!AppConstants.MOZ_NAVIS_REMOTE_SETTINGS_POLICY) {
+    return;
+  }
+
+  RemoteSettings.enablePreviewMode(true);
+  const allowed = RemoteSettings("embedder-test-security", {
+    bucketName: "security-state",
+  });
+  await allowed.db.clear();
+  await allowed.db.importChanges({}, 43, [
+    { id: "preview-record", last_modified: 43 },
+  ]);
+
+  deepEqual(
+    await allowed.get(),
+    [{ id: "preview-record", last_modified: 43 }],
+    "A reviewed collection remains allowed in its preview bucket during tests"
+  );
+
+  await allowed.db.clear();
+  RemoteSettings.enablePreviewMode(false);
+});
