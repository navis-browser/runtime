From 6c3430da095313c177d67c9acbd23497bda695ed Mon Sep 17 00:00:00 2001
From: willvar <0@willvar.tw>
Date: Sat, 29 Aug 2026 19:03:49 +0800
Subject: [PATCH 18/20] Gate gtest observability dependencies with runtime
 selection

---
 testing/gtest/mozilla/GTestRunner.cpp         |  6 ++-
 .../tests/gtest/TelemetryTestHelpers.cpp      | 40 +++++++++++++++++--
 .../telemetry/tests/gtest/moz.build           |  2 +-
 toolkit/library/gtest/rust/Cargo.toml         |  7 +++-
 toolkit/library/gtest/rust/lib.rs             |  2 +
 toolkit/library/gtest/rust/moz.build          |  3 ++
 6 files changed, 52 insertions(+), 8 deletions(-)

diff --git a/testing/gtest/mozilla/GTestRunner.cpp b/testing/gtest/mozilla/GTestRunner.cpp
index da09e3de444b..684f4ef8ae71 100644
--- a/testing/gtest/mozilla/GTestRunner.cpp
+++ b/testing/gtest/mozilla/GTestRunner.cpp
@@ -5,8 +5,10 @@
 #include "GTestRunner.h"
 #include "gtest/gtest.h"
 #include "mozilla/Attributes.h"
-#include "mozilla/FOG.h"
 #include "mozilla/Preferences.h"
+#ifdef MOZ_OBSERVABILITY_RUNTIME
+#  include "mozilla/FOG.h"
+#endif
 #include "nsICrashReporter.h"
 #include "nsString.h"
 #include "testing/TestHarness.h"
@@ -245,6 +247,7 @@ int RunGTestFunc(int* argc, char** argv) {
     }
   }
 
+#ifdef MOZ_OBSERVABILITY_RUNTIME
   // FOG should init exactly once, as early into running as possible, to enable
   // instrumentation tests to work properly.
   // However, at init, Glean may decide to send a ping. So let's first tell FOG
@@ -260,6 +263,7 @@ int RunGTestFunc(int* argc, char** argv) {
                       int32_t(PR_Now() / PR_USEC_PER_SEC));
   const nsCString empty;
   RefPtr<FOG>(FOG::GetSingleton())->InitializeFOG(empty, empty, false);
+#endif
 
   return RUN_ALL_TESTS();
 }
diff --git a/toolkit/components/telemetry/tests/gtest/TelemetryTestHelpers.cpp b/toolkit/components/telemetry/tests/gtest/TelemetryTestHelpers.cpp
index a7b30219c564..ce61e3b9fc2c 100644
--- a/toolkit/components/telemetry/tests/gtest/TelemetryTestHelpers.cpp
+++ b/toolkit/components/telemetry/tests/gtest/TelemetryTestHelpers.cpp
@@ -20,6 +20,40 @@ using namespace mozilla;
 // Gtests.
 namespace TelemetryTestHelpers {
 
+namespace {
+
+const char* GetProcessName(ProcessID aProcessType) {
+#ifdef MOZ_OBSERVABILITY_RUNTIME
+  return Telemetry::Common::GetNameForProcessID(aProcessType);
+#else
+  // The observability-free runtime deliberately omits TelemetryCommon.cpp.
+  // Keep shared gtest fixtures linkable without restoring that product code.
+  switch (aProcessType) {
+    case ProcessID::Content:
+      return "content";
+    case ProcessID::Dynamic:
+      return "dynamic";
+    case ProcessID::Extension:
+      return "extension";
+    case ProcessID::Gpu:
+      return "gpu";
+    case ProcessID::Parent:
+      return "parent";
+    case ProcessID::Rdd:
+      return "rdd";
+    case ProcessID::Socket:
+      return "socket";
+    case ProcessID::Utility:
+      return "utility";
+    case ProcessID::Count:
+      break;
+  }
+  MOZ_CRASH("Invalid Telemetry process type");
+#endif
+}
+
+}  // namespace
+
 void CheckUintScalar(const char* aName, JSContext* aCx,
                      JS::Handle<JS::Value> aSnapshot, uint32_t expectedValue) {
   // Validate the value of the test scalar.
@@ -275,8 +309,7 @@ void GetEventSnapshot(JSContext* aCx, JS::MutableHandle<JS::Value> aResult,
 
   JS::Rooted<JS::Value> processEvents(aCx);
   JS::Rooted<JSObject*> eventObj(aCx, &eventSnapshot.toObject());
-  (void)JS_GetProperty(aCx, eventObj,
-                       Telemetry::Common::GetNameForProcessID(aProcessType),
+  (void)JS_GetProperty(aCx, eventObj, GetProcessName(aProcessType),
                        &processEvents);
 
   aResult.set(processEvents);
@@ -309,8 +342,7 @@ void GetScalarsSnapshot(bool aKeyed, JSContext* aCx,
   JS::Rooted<JSObject*> scalarObj(aCx, &scalarsSnapshot.toObject());
   // Don't complain if no scalars for the process can be found. Just
   // return an empty object.
-  (void)JS_GetProperty(aCx, scalarObj,
-                       Telemetry::Common::GetNameForProcessID(aProcessType),
+  (void)JS_GetProperty(aCx, scalarObj, GetProcessName(aProcessType),
                        &processScalars);
 
   aResult.set(processScalars);
diff --git a/toolkit/components/telemetry/tests/gtest/moz.build b/toolkit/components/telemetry/tests/gtest/moz.build
index 2af240d94fd9..7588bbf70029 100644
--- a/toolkit/components/telemetry/tests/gtest/moz.build
+++ b/toolkit/components/telemetry/tests/gtest/moz.build
@@ -13,7 +13,7 @@ UNIFIED_SOURCES = [
     "TelemetryTestHelpers.cpp",
 ]
 
-if CONFIG["OS_TARGET"] != "Android":
+if CONFIG["MOZ_OBSERVABILITY_RUNTIME"] and CONFIG["OS_TARGET"] != "Android":
     UNIFIED_SOURCES += [
         "TestCombinedStacks.cpp",
         "TestEvents.cpp",
diff --git a/toolkit/library/gtest/rust/Cargo.toml b/toolkit/library/gtest/rust/Cargo.toml
index ebea4bfbce26..a2aaa1dd80d6 100644
--- a/toolkit/library/gtest/rust/Cargo.toml
+++ b/toolkit/library/gtest/rust/Cargo.toml
@@ -16,14 +16,17 @@ nsstring-gtest = { path = "../../../../xpcom/rust/gtest/nsstring" }
 xpcom-gtest = { path = "../../../../xpcom/rust/gtest/xpcom" }
 gkrust-shared = { path = "../../rust/shared" }
 gecko-fuzz-targets = { path = "../../../../tools/fuzzing/rust", optional = true }
-fog-gtest = { path = "../../../components/glean/tests/gtest" }
-dap_ffi-gtest = { path = "../../../components/dap/ffi-gtest" }
+fog-gtest = { path = "../../../components/glean/tests/gtest", optional = true }
+dap_ffi-gtest = { path = "../../../components/dap/ffi-gtest", optional = true }
 kvstore-gtest = { path = "../../../components/kvstore/test/gtest" }
 
 # Workarounds for https://github.com/rust-lang/rust/issues/58393
 mozglue-static = { path = "../../../../mozglue/static/rust" }
 swgl = { path = "../../../../gfx/wr/swgl" }
 
+[features]
+observability_runtime_tests = ["dep:fog-gtest", "dep:dap_ffi-gtest"]
+
 [lib]
 path = "lib.rs"
 crate-type = ["staticlib"]
diff --git a/toolkit/library/gtest/rust/lib.rs b/toolkit/library/gtest/rust/lib.rs
index 4f26c86baa17..0b3f06bd259a 100644
--- a/toolkit/library/gtest/rust/lib.rs
+++ b/toolkit/library/gtest/rust/lib.rs
@@ -3,7 +3,9 @@
 // file, You can obtain one at http://mozilla.org/MPL/2.0/.
 
 extern crate bench_collections_gtest;
+#[cfg(feature = "observability_runtime_tests")]
 extern crate dap_ffi_gtest;
+#[cfg(feature = "observability_runtime_tests")]
 extern crate fog_gtest;
 #[cfg(feature = "gecko-fuzz-targets")]
 extern crate gecko_fuzz_targets;
diff --git a/toolkit/library/gtest/rust/moz.build b/toolkit/library/gtest/rust/moz.build
index 7e5b62a3cc31..f99724993337 100644
--- a/toolkit/library/gtest/rust/moz.build
+++ b/toolkit/library/gtest/rust/moz.build
@@ -7,6 +7,9 @@ include("../../rust/gkrust-features.mozbuild")
 if CONFIG["FUZZING_INTERFACES"]:
     gkrust_features += ["gecko-fuzz-targets"]
 
+if CONFIG["MOZ_OBSERVABILITY_RUNTIME"]:
+    gkrust_features += ["observability_runtime_tests"]
+
 RustLibrary(
     "gkrust-gtest",
     gkrust_features,
