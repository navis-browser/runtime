new file mode 100644
--- /dev/null
+++ b/mobile/shared/components/extensions/ext-history.js
@@ -0,0 +1,56 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+"use strict";
+{
+  const { NavisAndroidExtensionProfile: profile } = ChromeUtils.importESModule(
+    "resource://gre/modules/NavisAndroidExtensionProfile.sys.mjs");
+  const MAX_TIME = Number.MAX_SAFE_INTEGER;
+  function time(value, fallback) {
+    if (value == null) return fallback;
+    const millis = typeof value === "number" ? value : new Date(value).getTime();
+    if (!Number.isFinite(millis) || millis < 0 || millis > MAX_TIME) {
+      throw new ExtensionUtils.ExtensionError("Invalid history timestamp");
+    }
+    return Math.trunc(millis);
+  }
+  function range(start, end) {
+    if (start > end) throw new ExtensionUtils.ExtensionError("Invalid history range");
+    return { startTime: start, endTime: end };
+  }
+  function webURL(value) {
+    let uri;
+    try { uri = Services.io.newURI(value); } catch {
+      throw new ExtensionUtils.ExtensionError("Invalid history URL");
+    }
+    if (!uri.schemeIs("http") && !uri.schemeIs("https")) {
+      throw new ExtensionUtils.ExtensionError("Navis history accepts HTTP(S) addresses only");
+    }
+    return uri.spec;
+  }
+  this.history = class extends ExtensionAPIPersistent {
+    PERSISTENT_EVENTS = Object.fromEntries(["onVisited", "onVisitRemoved", "onTitleChanged"].map(
+      event => [event, ({ fire }) => profile.registerHistory(this.extension, event, fire)]));
+    getAPI(context) {
+      const call = (operation, args) => profile.request(this.extension, context, `history:${operation}`, args);
+      return { history: {
+        ...Object.fromEntries(Object.keys(this.PERSISTENT_EVENTS).map(event => [event,
+          new EventManager({ context, module: "history", event, extensionApi: this }).api()])),
+        async search(query) {
+          return call("search", { text: query.text,
+            ...range(time(query.startTime, Date.now() - 86400000), time(query.endTime, MAX_TIME)),
+            maxResults: Math.min(query.maxResults ?? 100, 500) });
+        },
+        async getVisits({ url }) { return call("visits", { url: webURL(url) }); },
+        async addUrl({ url, title = "", visitTime, transition = "link" }) {
+          await call("add", { url: webURL(url), title, visitTime: time(visitTime, Date.now()), transition });
+        },
+        async deleteUrl({ url }) { await call("deleteUrl", { url: webURL(url) }); },
+        async deleteRange({ startTime, endTime }) {
+          await call("deleteRange", range(time(startTime, 0), time(endTime, MAX_TIME)));
+        },
+        async deleteAll() { await call("deleteAll"); },
+      } };
+    }
+  };
+}
