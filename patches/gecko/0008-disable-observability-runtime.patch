+  template <typename U = T, typename V = E>
+  std::enable_if_t<std::is_same_v<U, TimingDistributionMetric> &&
+                       std::is_same_v<V, DynamicLabel>,
+                   T>
+  MaybeTruncateAndGet(const nsACString&) const {
+    return T(0);
+  }
+
+  T ProcessGet() const { return T(0); }
+};
