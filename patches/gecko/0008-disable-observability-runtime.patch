+    pub(crate) fn connection_cancelled(&mut self, _id: happy_eyeballs::Id) {}
+
+    pub(crate) fn connection_succeeded(&mut self, _id: happy_eyeballs::Id) {}
+
+    pub(crate) fn failed(&mut self) {}
+}
