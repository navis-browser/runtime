+ public:
+  constexpr explicit Labeled(uint32_t) {}
+  T Get(const nsACString&) const { return T(0); }
+
+  template <typename U = T>
+  std::enable_if_t<!std::is_same_v<U, DynamicLabel>, T> EnumGet(E) const {
