+    }
+    if (delegate == null) {
+      throw new NullPointerException("delegate");
+    }
+
+    mSessionId = sessionId;
+    mDelegate = delegate;
+    mDispatcher = EventDispatcher.byName("navis-android-session-" + sessionId);
+    mWindow = new NativeWindow(this);
+    mCompositor = new Compositor(this);
+    mInput =
+        new NavisAndroidInput(
+            new NavisAndroidInput.Host() {
+              @Override
+              public void getSurfaceBounds(final Rect bounds) {
+                bounds.set(mSurfaceBounds);
+              }
+
+              @Override
+              public void onScreenOriginChanged(final int left, final int top) {
+                if (mSurfaceBounds.left == left && mSurfaceBounds.top == top) {
+                  return;
+                }
+                mSurfaceBounds.offsetTo(left, top);
+                if (mOpenRequested && !mClosed && mCompositorAttached) {
+                  mCompositor.onBoundsChanged(
+                      left, top, mSurfaceBounds.width(), mSurfaceBounds.height());
