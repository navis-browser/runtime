+        EVENT_NEW_WINDOW,
+        EVENT_PROMPT,
+        EVENT_PROMPT_UPDATE,
+        EVENT_SITE_PERMISSION,
+        EVENT_MEDIA_PERMISSION,
+        EVENT_PLATFORM_PERMISSION,
+        EVENT_FILE_PICKER,
+        EVENT_CANCEL_TARGET,
+        EVENT_WEBAUTHN,
+        EVENT_CONTEXT_MENU,
+        EVENT_CONTEXT_MENU_CANCEL,
+        EVENT_SHORTCUT_SETTINGS,
+        EVENT_COMMAND_OWNERSHIP);
+    mDispatcher.shutdown();
+  }
+
+  private void ensureNotClosed() {
+    if (mClosed) {
+      throw new IllegalStateException("Navis Android session is closed");
+    }
+  }
+
+  private void ensureOpenRequested() {
+    ensureNotClosed();
+    if (!mOpenRequested) {
+      throw new IllegalStateException("Navis Android session is not open");
+    }
+  }
