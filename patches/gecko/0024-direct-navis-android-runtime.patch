+  private boolean isInTest() {
+    return mView != null && mView.getDisplay() == null;
+  }
+
+  private void requestViewFocus() {
+    if (!mView.isFocused() && !isInTest()) {
+      mViewFocusRequested = true;
+      mView.requestFocus();
+    }
+  }
