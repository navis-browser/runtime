+  private void handleNewWindowRequest(
+      final GeckoBundle message, final EventCallback callback) {
+    if (callback == null) {
+      return;
+    }
+    final String uri = message.getString("uri", "");
+    final String windowToken = message.getString("windowToken", "");
+    if (uri.length() > MAX_NEW_WINDOW_URI_CHARS || !isValidWindowToken(windowToken)) {
+      callback.sendError("Invalid new-window request");
+      return;
+    }
+    if (mPendingNewWindows.containsKey(windowToken)) {
+      callback.sendError("Duplicate new-window engine token");
+      return;
+    }
+
+    final PendingNewWindowRequest request = new PendingNewWindowRequest(callback);
+    request.timeout =
+        () -> completeNewWindowRequest(windowToken, request, false, null);
+    mPendingNewWindows.put(windowToken, request);
+    mUiHandler.postDelayed(request.timeout, NEW_WINDOW_TIMEOUT_MS);
