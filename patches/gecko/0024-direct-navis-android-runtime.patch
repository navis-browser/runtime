+
+  private final long mSessionId;
+  private final Delegate mDelegate;
+  private final EventDispatcher mDispatcher;
+  private final BundleEventListener mEventListener = this::handleMessage;
+  private final NativeWindow mWindow;
+  private final Compositor mCompositor;
+  private final NavisAndroidInput mInput;
+  private final NavisAndroidTextInput mTextInput;
+  private final NavisAndroidAccessibility mAccessibility;
+  private final Rect mSurfaceBounds = new Rect();
+  private final ArrayDeque<PendingCommand> mPendingCommands = new ArrayDeque<>();
+  private final Handler mUiHandler = new Handler(Looper.getMainLooper());
+  private final Map<String, PendingNewWindowRequest> mPendingNewWindows = new HashMap<>();
+  private final Map<Long, EventCallback> mPendingTargetRequests = new HashMap<>();
+  private final Map<Long, PendingLoginSave> mPendingLoginSaves = new HashMap<>();
+  private final java.util.HashSet<Long> mLoginPromptRequestIds = new java.util.HashSet<>();
+  private final Map<String, EventCallback> mPendingContextMenus = new HashMap<>();
+  private final java.util.HashSet<String> mOwnedShortcuts = new java.util.HashSet<>();
