+  /** An explicit product retry; the host accepts only an HTTP(S) GET navigation. */
+  public CompletionStage<Boolean> retryDownload(final String uri, final String referrer) {
+    ThreadUtils.assertOnUiThread();
+    ensureNotClosed();
+    final CompletableFuture<Boolean> result = new CompletableFuture<>();
+    if (!mHostReady || mDevToolsWindow || uri == null || uri.length() > 64 * 1024
+        || (referrer != null && referrer.length() > 64 * 1024)) {
+      result.completeExceptionally(new IllegalStateException("Download retry context is unavailable"));
+      return result;
+    }
+    final GeckoBundle request = new GeckoBundle(2);
+    request.putString("uri", uri);
+    request.putString("referrer", referrer);
+    final Runnable timeout = () -> result.completeExceptionally(
+        new IllegalStateException("Download retry timed out"));
+    mUiHandler.postDelayed(timeout, NEW_WINDOW_TIMEOUT_MS);
+    result.whenComplete((value, error) -> mUiHandler.removeCallbacks(timeout));
+    mDispatcher.queryBundle("NavisAndroid:RetryDownload", request).withHandler(mUiHandler).accept(
+        response -> result.complete(response.getBoolean("loaded", false)),
+        result::completeExceptionally);
+    return result;
+  }
