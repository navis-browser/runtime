+    ThreadUtils.assertOnUiThread();
+    ensureNotClosed();
+    if (!isValidWindowToken(popupTargetToken)) {
+      throw new IllegalArgumentException("Invalid extension popup target token");
+    }
+    return openTokenizedWindow(privateMode, "popup-" + popupTargetToken);
+  }
+
+  /** Opens an engine-owned chrome toolbox host, never an ordinary web-content tab. */
+  public CompletionStage<Boolean> openDevToolsWindow(
+      final boolean privateMode, final long targetSessionId, final String tool) {
+    ThreadUtils.assertOnUiThread();
+    ensureNotClosed();
+    if (targetSessionId <= 0 || targetSessionId == mSessionId
+        || tool == null || !tool.matches("[a-z][a-z-]{0,31}")) {
+      throw new IllegalArgumentException("Invalid developer tools target");
+    }
+    mDevToolsWindow = true;
+    final CompletionStage<Boolean> result =
+        openTokenizedWindow(privateMode, "tools-" + targetSessionId + "-" + tool);
+    final Runnable timeout = () -> failNewWindowOpen("Timed out opening developer tools");
+    mUiHandler.postDelayed(timeout, 45_000);
+    result.whenComplete((value, error) -> mUiHandler.removeCallbacks(timeout));
+    return result;
+  }
+
+  /** Bounded JSON transport for named product operations; no arbitrary script or pref access. */
+  public CompletionStage<String> querySession(final String operation, final String payload) {
+    ThreadUtils.assertOnUiThread();
+    ensureNotClosed();
+    final CompletableFuture<String> result = new CompletableFuture<>();
+    if (!mHostReady || operation == null || operation.length() > 64
+        || payload == null
+        || payload.length() > ("product:initialize".equals(operation) ? 512 * 1024 : 64 * 1024)) {
+      result.completeExceptionally(new IllegalStateException("Session query is unavailable or invalid"));
+      return result;
+    }
+    final GeckoBundle request = new GeckoBundle(2);
+    request.putString("operation", operation);
+    request.putString("payload", payload);
+    final Runnable timeout = () -> result.completeExceptionally(
+        new IllegalStateException("Session query timed out: " + operation));
+    mUiHandler.postDelayed(timeout, 30_000);
+    result.whenComplete((value, error) -> mUiHandler.removeCallbacks(timeout));
+    mDispatcher.queryBundle("NavisAndroid:Query", request).withHandler(mUiHandler).accept(
+        response -> result.complete(response.getString("payload", "null")),
+        result::completeExceptionally);
+    return result;
+  }
+
+  private CompletionStage<Boolean> openTokenizedWindow(
+      final boolean privateMode, final String engineWindowToken) {
+    if (mOpenRequested || mNewWindowOpenResult != null) {
+      throw new IllegalStateException("Navis Android session is already open");
+    }
+    final CompletableFuture<Boolean> result = new CompletableFuture<>();
+    mNewWindowOpenResult = result;
+    try {
+      openInternal(privateMode, null, engineWindowToken);
+    } catch (final RuntimeException | Error error) {
+      mNewWindowOpenResult = null;
+      result.completeExceptionally(error);
+      throw error;
+    }
+    return result;
+  }
+
+  private void openInternal(
+      final boolean privateMode,
+      final String restoredState,
+      final String engineWindowToken) {
+    ThreadUtils.assertOnUiThread();
+    ensureNotClosed();
+    if (mOpenRequested) {
+      throw new IllegalStateException("Navis Android session is already open");
+    }
+    if (restoredState != null && restoredState.length() > MAX_RESTORED_STATE_CHARS) {
+      throw new IllegalArgumentException("restoredState exceeds the 1 MiB character limit");
+    }
+    mOpenRequested = true;
+    mPrivateMode = privateMode;
+    mPopupTargetToken = engineWindowToken != null && engineWindowToken.startsWith("popup-")
+        ? engineWindowToken.substring("popup-".length()) : null;
+    NativeWindow.open(
+        mWindow,
+        mCompositor,
+        mInput.nativeProvider(),
+        mTextInput,
+        mAccessibility.nativeProvider(),
+        mDispatcher,
+        mSessionId,
+        privateMode,
+        engineWindowToken);
+    if (restoredState != null && !restoredState.isEmpty()) {
+      final GeckoBundle data = new GeckoBundle(1);
+      data.putString("state", restoredState);
+      dispatchOrQueue(COMMAND_RESTORE_STATE, data);
+    }
+  }
