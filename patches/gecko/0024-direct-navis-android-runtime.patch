+  /**
+   * Arms this private window as the one popup transaction issued by the extension host.
+   * The chrome host verifies the id/token/URI against its current action transaction before it
+   * sets the WebExtension popup view type, emits extension-browser-inserted, and loads the URI.
+   */
+  public CompletionStage<Boolean> loadExtensionPopup(
+      final String extensionId, final String targetToken, final String popupUri) {
+    ThreadUtils.assertOnUiThread();
+    if (extensionId == null || extensionId.isEmpty() || extensionId.length() > 256) {
+      throw new IllegalArgumentException("Invalid extension popup ID");
+    }
+    if (!isValidWindowToken(targetToken)) {
+      throw new IllegalArgumentException("Invalid extension popup target token");
+    }
+    if (popupUri == null
+        || popupUri.length() > 1024
+        || !popupUri.startsWith("moz-extension://")) {
+      throw new IllegalArgumentException("Invalid extension popup URI");
+    }
+    final GeckoBundle data = new GeckoBundle(3);
+    data.putString("extensionId", extensionId);
+    data.putString("targetToken", targetToken);
+    data.putString("popupUri", popupUri);
+    if (!mHostReady) {
+      return failedBooleanResult("Extension popup host is not ready");
+    }
+    final CompletableFuture<Boolean> result = new CompletableFuture<>();
+    final Runnable timeout =
+        () ->
+            result.completeExceptionally(
+                new IllegalStateException("Timed out binding the extension popup target"));
+    result.whenComplete((ignored, error) -> mUiHandler.removeCallbacks(timeout));
+    mUiHandler.postDelayed(timeout, NEW_WINDOW_TIMEOUT_MS);
+    try {
+      mDispatcher
+          .queryBundle(COMMAND_LOAD_EXTENSION_POPUP, data)
+          .withHandler(mUiHandler)
+          .accept(
+              response -> result.complete(response != null && response.getBoolean("loaded", false)),
+              result::completeExceptionally);
+    } catch (final Throwable error) {
+      result.completeExceptionally(error);
+    }
+    return result;
+  }
