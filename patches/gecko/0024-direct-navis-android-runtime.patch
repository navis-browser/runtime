+
+package org.mozilla.gecko.navis;
+
+import android.app.UiModeManager;
+import android.content.Context;
+import android.content.res.Configuration;
+import android.graphics.Rect;
+import android.os.SystemClock;
+import android.util.Log;
+import android.util.Pair;
+import android.view.DragEvent;
+import android.view.InputDevice;
+import android.view.MotionEvent;
+import android.view.View;
+import java.util.ArrayList;
+import org.mozilla.gecko.GeckoAppShell;
+import org.mozilla.gecko.GeckoDragAndDrop;
+import org.mozilla.gecko.annotation.WrapForJNI;
+import org.mozilla.gecko.mozglue.JNIObject;
+import org.mozilla.gecko.util.ThreadUtils;
+import org.mozilla.geckoview.GeckoResult;
+
+/**
+ * Private Android input peer for a direct Navis session.
+ *
+ * <p>The peer owns Android event decoding and the generated JNI provider used by Gecko's APZ
+ * input bridge. It deliberately has no GeckoSession, GeckoView, PanZoomController, or product UI
+ * dependency.
+ */
+final class NavisAndroidInput {
+  private static final String LOGTAG = "NavisAndroidInput";
+  private static final int EVENT_SOURCE_SCROLL = 0;
+  private static final int EVENT_SOURCE_MOTION = 1;
+  private static final int EVENT_SOURCE_MOUSE = 2;
+
+  @WrapForJNI static final int INPUT_RESULT_UNHANDLED = 0;
+  @WrapForJNI static final int INPUT_RESULT_HANDLED = 1;
+  @WrapForJNI static final int INPUT_RESULT_HANDLED_CONTENT = 2;
+  @WrapForJNI static final int INPUT_RESULT_IGNORED = 3;
+
+  @WrapForJNI static final int SCROLLABLE_FLAG_NONE = 0;
+  @WrapForJNI static final int SCROLLABLE_FLAG_TOP = 1 << 0;
+  @WrapForJNI static final int SCROLLABLE_FLAG_RIGHT = 1 << 1;
+  @WrapForJNI static final int SCROLLABLE_FLAG_BOTTOM = 1 << 2;
+  @WrapForJNI static final int SCROLLABLE_FLAG_LEFT = 1 << 3;
+
+  @WrapForJNI static final int OVERSCROLL_FLAG_NONE = 0;
+  @WrapForJNI static final int OVERSCROLL_FLAG_HORIZONTAL = 1 << 0;
+  @WrapForJNI static final int OVERSCROLL_FLAG_VERTICAL = 1 << 1;
+
+  interface Host {
+    void getSurfaceBounds(Rect bounds);
+
+    void onScreenOriginChanged(int left, int top);
+
+    void requestInputFocus();
+  }
+
+  @WrapForJNI
+  private static final class InputResultDetail {
+    private final int mHandledResult;
+    private final int mScrollableDirections;
+    private final int mOverscrollDirections;
+
+    @WrapForJNI
+    private InputResultDetail(
+        final int handledResult,
+        final int scrollableDirections,
+        final int overscrollDirections) {
+      mHandledResult = handledResult;
+      mScrollableDirections = scrollableDirections;
+      mOverscrollDirections = overscrollDirections;
+    }
+  }
+
+  @WrapForJNI
+  private static final class MotionEventData {
+    public final int action;
+    public final int actionIndex;
+    public final long time;
+    public final int metaState;
+    public final int toolType;
+    public final int[] pointerId;
+    public final int historySize;
+    public final long[] historicalTime;
+    public final float[] historicalX;
+    public final float[] historicalY;
+    public final float[] historicalOrientation;
+    public final float[] historicalPressure;
+    public final float[] historicalToolMajor;
+    public final float[] historicalToolMinor;
+    public final float[] x;
+    public final float[] y;
+    public final float[] orientation;
+    public final float[] pressure;
+    public final float[] tilt;
+    public final float[] toolMajor;
+    public final float[] toolMinor;
+
+    MotionEventData(final MotionEvent event) {
+      final int count = event.getPointerCount();
+      action = event.getActionMasked();
+      actionIndex = event.getActionIndex();
+      time = event.getEventTime();
+      metaState = event.getMetaState();
+      toolType = event.getToolType(0);
+      historySize = event.getHistorySize();
+      historicalTime = new long[historySize];
+      historicalX = new float[historySize * count];
+      historicalY = new float[historySize * count];
+      historicalOrientation = new float[historySize * count];
+      historicalPressure = new float[historySize * count];
+      historicalToolMajor = new float[historySize * count];
+      historicalToolMinor = new float[historySize * count];
+      pointerId = new int[count];
+      x = new float[count];
+      y = new float[count];
+      orientation = new float[count];
+      pressure = new float[count];
+      tilt = new float[count];
+      toolMajor = new float[count];
+      toolMinor = new float[count];
+
+      for (int historyIndex = 0; historyIndex < historySize; historyIndex++) {
+        historicalTime[historyIndex] = event.getHistoricalEventTime(historyIndex);
+      }
+
+      final MotionEvent.PointerCoords coords = new MotionEvent.PointerCoords();
+      for (int pointerIndex = 0; pointerIndex < count; pointerIndex++) {
+        pointerId[pointerIndex] = event.getPointerId(pointerIndex);
+        for (int historyIndex = 0; historyIndex < historySize; historyIndex++) {
+          event.getHistoricalPointerCoords(pointerIndex, historyIndex, coords);
+          final int index = historyIndex * count + pointerIndex;
+          historicalX[index] = coords.x;
+          historicalY[index] = coords.y;
+          historicalOrientation[index] = coords.orientation;
+          historicalPressure[index] = coords.pressure;
+          historicalToolMajor[index] = coords.toolMajor;
+          historicalToolMinor[index] = coords.toolMinor;
+        }
+        event.getPointerCoords(pointerIndex, coords);
+        x[pointerIndex] = coords.x;
+        y[pointerIndex] = coords.y;
+        orientation[pointerIndex] = coords.orientation;
+        pressure[pointerIndex] = coords.pressure;
+        tilt[pointerIndex] = coords.getAxisValue(MotionEvent.AXIS_TILT);
+        toolMajor[pointerIndex] = coords.toolMajor;
+        toolMinor[pointerIndex] = coords.toolMinor;
+      }
+    }
+  }
+
+  final class NativeProvider extends JNIObject {
+    @WrapForJNI(calledFrom = "ui")
+    private native void handleMotionEvent(
+        MotionEventData eventData,
+        float screenX,
+        float screenY,
+        GeckoResult<InputResultDetail> result);
+
+    @WrapForJNI(calledFrom = "ui")
+    private native int handleScrollEvent(
+        long time, int metaState, float x, float y, float hScroll, float vScroll);
+
+    @WrapForJNI(calledFrom = "ui")
+    private native int handleMouseEvent(
+        int action, long time, int metaState, float x, float y, int buttons);
+
+    @WrapForJNI(calledFrom = "ui")
+    private native void handleDragEvent(
+        int action, long time, float x, float y, GeckoDragAndDrop.DropData data);
+
+    @WrapForJNI(stubName = "SetIsLongpressEnabled")
+    private native void nativeSetIsLongpressEnabled(boolean enabled);
+
+    @WrapForJNI(calledFrom = "ui")
+    private void synthesizeNativeTouchPoint(
+        final int pointerId,
+        final int eventType,
+        final int clientX,
+        final int clientY,
+        final double pressure,
+        final int orientation) {
+      if (pointerId == PointerInfo.RESERVED_MOUSE_POINTER_ID) {
+        throw new IllegalArgumentException("Pointer ID reserved for mouse");
+      }
+      synthesizeNativePointer(
+          InputDevice.SOURCE_TOUCHSCREEN,
+          pointerId,
+          eventType,
+          clientX,
+          clientY,
+          pressure,
+          orientation,
+          0);
+    }
+
+    @WrapForJNI(calledFrom = "ui")
+    private void synthesizeNativeMouseEvent(
+        final int eventType, final int clientX, final int clientY, final int button) {
+      synthesizeNativePointer(
+          InputDevice.SOURCE_MOUSE,
+          PointerInfo.RESERVED_MOUSE_POINTER_ID,
+          eventType,
+          clientX,
+          clientY,
+          0,
+          0,
+          button);
+    }
+
+    @WrapForJNI(calledFrom = "ui")
+    private void setAttached(final boolean attached) {
+      if (attached) {
+        mAttached = true;
+        flushEventQueue();
+      } else if (mAttached) {
+        mAttached = false;
+        enableEventQueue();
+      }
+    }
+
+    @Override
+    protected void disposeNative() {
+      throw new UnsupportedOperationException("The native window owns this weak JNI binding");
+    }
+  }
+
+  private static final class PointerInfo {
+    static final int RESERVED_MOUSE_POINTER_ID = 100000;
+    int pointerId;
+    int source;
+    int surfaceX;
+    int surfaceY;
+    double pressure;
+    int orientation;
+    int buttonState;
+
+    MotionEvent.PointerCoords getCoords() {
+      final MotionEvent.PointerCoords coords = new MotionEvent.PointerCoords();
+      coords.orientation = orientation;
+      coords.pressure = (float) pressure;
+      coords.x = surfaceX;
+      coords.y = surfaceY;
+      return coords;
+    }
+  }
+
+  private static final class SynthesizedEventState {
+    final ArrayList<PointerInfo> pointers = new ArrayList<>();
+    long downTime;
+
+    int getPointerIndex(final int pointerId) {
+      for (int i = 0; i < pointers.size(); i++) {
+        if (pointers.get(i).pointerId == pointerId) {
+          return i;
+        }
+      }
+      return -1;
+    }
+
+    int addPointer(final int pointerId, final int source) {
+      final PointerInfo info = new PointerInfo();
+      info.pointerId = pointerId;
+      info.source = source;
+      pointers.add(info);
+      return pointers.size() - 1;
+    }
+
+    int count(final int source) {
+      int count = 0;
+      for (final PointerInfo pointer : pointers) {
+        if (pointer.source == source) {
+          count++;
+        }
+      }
+      return count;
+    }
+
+    int buttons(final int source) {
+      for (final PointerInfo pointer : pointers) {
+        if (pointer.source == source) {
+          return pointer.buttonState;
+        }
+      }
+      return 0;
+    }
+
+    MotionEvent.PointerProperties[] properties(final int source) {
+      final MotionEvent.PointerProperties[] properties =
+          new MotionEvent.PointerProperties[count(source)];
+      int index = 0;
+      for (final PointerInfo pointer : pointers) {
+        if (pointer.source != source) {
+          continue;
+        }
+        final MotionEvent.PointerProperties property = new MotionEvent.PointerProperties();
+        property.id = pointer.pointerId;
+        property.toolType =
+            source == InputDevice.SOURCE_MOUSE
+                ? MotionEvent.TOOL_TYPE_MOUSE
+                : MotionEvent.TOOL_TYPE_FINGER;
+        properties[index++] = property;
+      }
+      return properties;
+    }
+
+    MotionEvent.PointerCoords[] coordinates(final int source) {
+      final MotionEvent.PointerCoords[] coordinates = new MotionEvent.PointerCoords[count(source)];
+      int index = 0;
+      for (final PointerInfo pointer : pointers) {
+        if (pointer.source == source) {
+          coordinates[index++] = pointer.getCoords();
+        }
+      }
+      return coordinates;
+    }
+  }
+
+  private final Host mHost;
+  private final Rect mSurfaceBounds = new Rect();
+  private final NativeProvider mNative = new NativeProvider();
+  private ArrayList<Pair<Integer, MotionEvent>> mQueuedEvents;
+  private SynthesizedEventState mPointerState;
+  private boolean mAttached;
+  private boolean mSynthesizedEvent;
+  private float mPointerScrollFactor = 64.0f;
+  private long mLastDownTime;
+  private static Boolean sTreatMouseAsTouch;
+
+  NavisAndroidInput(final Host host) {
+    mHost = host;
+    enableEventQueue();
+  }
+
+  NativeProvider nativeProvider() {
+    return mNative;
+  }
+
+  void setScrollFactor(final float factor) {
+    ThreadUtils.assertOnUiThread();
+    if (factor <= 0) {
+      throw new IllegalArgumentException("scroll factor must be positive");
+    }
+    mPointerScrollFactor = factor;
+  }
+
+  void setLongPressEnabled(final boolean enabled) {
+    ThreadUtils.assertOnUiThread();
+    if (mAttached) {
+      mNative.nativeSetIsLongpressEnabled(enabled);
+    }
+  }
+
+  void scrollByViewportHeight(final float fraction) {
+    ThreadUtils.assertOnUiThread();
+    if (!mAttached || fraction == 0) {
+      return;
+    }
+    mHost.getSurfaceBounds(mSurfaceBounds);
+    mNative.handleScrollEvent(
+        SystemClock.uptimeMillis(),
+        0,
+        mSurfaceBounds.exactCenterX(),
+        mSurfaceBounds.exactCenterY(),
+        0,
+        fraction * mSurfaceBounds.height());
+  }
+
+  boolean onTouchEvent(final MotionEvent event) {
+    ThreadUtils.assertOnUiThread();
+    if (event == null || event.getPointerCount() == 0) {
+      return false;
+    }
+    if (!treatMouseAsTouch()
+        && event.getToolType(0) == MotionEvent.TOOL_TYPE_MOUSE
+        && !mayTouchpadScroll(event)) {
+      handleMouseEvent(event);
+    } else {
+      handleMotionEvent(event);
+    }
+    return true;
+  }
+
+  boolean onGenericMotionEvent(final MotionEvent event) {
+    ThreadUtils.assertOnUiThread();
+    if (event == null || event.getPointerCount() == 0) {
+      return false;
+    }
+    final int action = event.getActionMasked();
+    if (action == MotionEvent.ACTION_SCROLL) {
+      if (event.getDownTime() >= mLastDownTime) {
+        mLastDownTime = event.getDownTime();
+      } else {
+        final InputDevice device = InputDevice.getDevice(event.getDeviceId());
+        if (device != null
+            && (device.getSources() & InputDevice.SOURCE_TOUCHPAD)
+                == InputDevice.SOURCE_TOUCHPAD) {
+          return false;
+        }
+      }
+      handleScrollEvent(event);
+      return true;
+    }
+    if (action == MotionEvent.ACTION_HOVER_MOVE
+        || action == MotionEvent.ACTION_HOVER_ENTER
+        || action == MotionEvent.ACTION_HOVER_EXIT) {
+      handleMouseEvent(event);
+      return true;
+    }
+    return false;
+  }
+
+  boolean onDragEvent(final DragEvent event) {
+    ThreadUtils.assertOnUiThread();
+    if (!mAttached || event == null || !GeckoDragAndDrop.onDragEvent(event)) {
+      return false;
+    }
+    mNative.handleDragEvent(
+        event.getAction(),
+        SystemClock.uptimeMillis(),
+        GeckoDragAndDrop.getLocationX(),
+        GeckoDragAndDrop.getLocationY(),
+        GeckoDragAndDrop.createDropData(event));
+    return true;
+  }
+
+  private boolean treatMouseAsTouch() {
+    if (sTreatMouseAsTouch == null) {
+      final Context context = GeckoAppShell.getApplicationContext();
+      if (context == null) {
+        return false;
+      }
+      final UiModeManager manager =
+          (UiModeManager) context.getSystemService(Context.UI_MODE_SERVICE);
+      sTreatMouseAsTouch =
+          manager != null
+              && manager.getCurrentModeType() == Configuration.UI_MODE_TYPE_TELEVISION;
+    }
+    return sTreatMouseAsTouch;
+  }
+
+  private boolean mayTouchpadScroll(final MotionEvent event) {
+    final int action = event.getActionMasked();
+    return event.getButtonState() == 0
+        && (action == MotionEvent.ACTION_DOWN
+            || (mLastDownTime == event.getDownTime()
+                && (action == MotionEvent.ACTION_MOVE
+                    || action == MotionEvent.ACTION_UP
+                    || action == MotionEvent.ACTION_CANCEL)));
+  }
+
+  private void handleMotionEvent(final MotionEvent event) {
+    if (!mAttached) {
+      mQueuedEvents.add(Pair.create(EVENT_SOURCE_MOTION, MotionEvent.obtain(event)));
+      return;
+    }
+    final int action = event.getActionMasked();
+    if (action == MotionEvent.ACTION_DOWN) {
+      mLastDownTime = event.getDownTime();
+    } else if (mLastDownTime != event.getDownTime()) {
+      return;
+    }
+    final float screenX = event.getRawX() - event.getX();
+    final float screenY = event.getRawY() - event.getY();
+    if (!mSynthesizedEvent) {
+      mHost.onScreenOriginChanged((int) screenX, (int) screenY);
+    }
+    mNative.handleMotionEvent(new MotionEventData(event), screenX, screenY, null);
+  }
+
+  private int handleScrollEvent(final MotionEvent event) {
+    if (!mAttached) {
+      mQueuedEvents.add(Pair.create(EVENT_SOURCE_SCROLL, MotionEvent.obtain(event)));
+      return INPUT_RESULT_HANDLED;
+    }
+    final MotionEvent.PointerCoords coordinates = new MotionEvent.PointerCoords();
+    event.getPointerCoords(0, coordinates);
+    mHost.getSurfaceBounds(mSurfaceBounds);
+    return mNative.handleScrollEvent(
+        event.getEventTime(),
+        event.getMetaState(),
+        coordinates.x - mSurfaceBounds.left,
+        coordinates.y - mSurfaceBounds.top,
+        event.getAxisValue(MotionEvent.AXIS_HSCROLL) * mPointerScrollFactor,
+        event.getAxisValue(MotionEvent.AXIS_VSCROLL) * mPointerScrollFactor);
+  }
+
+  private int handleMouseEvent(final MotionEvent event) {
+    if (!mAttached) {
+      mQueuedEvents.add(Pair.create(EVENT_SOURCE_MOUSE, MotionEvent.obtain(event)));
+      return INPUT_RESULT_UNHANDLED;
+    }
+    final MotionEvent.PointerCoords coordinates = new MotionEvent.PointerCoords();
+    event.getPointerCoords(0, coordinates);
+    mHost.getSurfaceBounds(mSurfaceBounds);
+    return mNative.handleMouseEvent(
+        event.getActionMasked(),
+        event.getEventTime(),
+        event.getMetaState(),
+        coordinates.x - mSurfaceBounds.left,
+        coordinates.y - mSurfaceBounds.top,
+        event.getButtonState());
+  }
+
+  private void enableEventQueue() {
+    if (mQueuedEvents == null) {
+      mQueuedEvents = new ArrayList<>();
+    }
+  }
+
+  private void flushEventQueue() {
+    if (mQueuedEvents == null) {
+      return;
+    }
+    final ArrayList<Pair<Integer, MotionEvent>> events = mQueuedEvents;
+    mQueuedEvents = null;
+    for (final Pair<Integer, MotionEvent> queued : events) {
+      switch (queued.first) {
+        case EVENT_SOURCE_MOTION:
+          handleMotionEvent(queued.second);
+          break;
+        case EVENT_SOURCE_SCROLL:
+          handleScrollEvent(queued.second);
+          break;
+        case EVENT_SOURCE_MOUSE:
+          handleMouseEvent(queued.second);
+          break;
+        default:
+          throw new IllegalStateException("Unknown queued Android input source");
+      }
+      queued.second.recycle();
+    }
+  }
+
+  private void synthesizeNativePointer(
+      final int source,
+      final int pointerId,
+      final int originalEventType,
+      final int clientX,
+      final int clientY,
+      final double pressure,
+      final int orientation,
+      final int button) {
+    if (mPointerState == null) {
+      mPointerState = new SynthesizedEventState();
+    }
+    int pointerIndex = mPointerState.getPointerIndex(pointerId);
+    int eventType = originalEventType;
+    switch (originalEventType) {
+      case MotionEvent.ACTION_POINTER_UP:
+        if (pointerIndex < 0) {
+          Log.w(LOGTAG, "Pointer-up for invalid pointer");
+          return;
+        }
+        if (mPointerState.pointers.size() == 1) {
+          eventType = MotionEvent.ACTION_UP;
+        }
+        break;
+      case MotionEvent.ACTION_CANCEL:
+        if (pointerIndex < 0) {
+          Log.w(LOGTAG, "Pointer-cancel for invalid pointer");
+          return;
+        }
+        break;
+      case MotionEvent.ACTION_POINTER_DOWN:
+        mHost.requestInputFocus();
+        if (pointerIndex < 0) {
+          pointerIndex = mPointerState.addPointer(pointerId, source);
+          if (pointerIndex == 0) {
+            eventType = MotionEvent.ACTION_DOWN;
+            mPointerState.downTime = SystemClock.uptimeMillis();
+          }
+        } else {
+          eventType = MotionEvent.ACTION_MOVE;
+        }
+        break;
+      case MotionEvent.ACTION_HOVER_MOVE:
+        if (pointerIndex < 0) {
+          pointerIndex = mPointerState.addPointer(pointerId, source);
+        } else {
+          eventType = MotionEvent.ACTION_MOVE;
+        }
+        break;
+      default:
+        break;
+    }
+    if (pointerIndex < 0) {
+      return;
+    }
+
+    mHost.getSurfaceBounds(mSurfaceBounds);
+    final PointerInfo info = mPointerState.pointers.get(pointerIndex);
+    info.surfaceX = clientX + mSurfaceBounds.left;
+    info.surfaceY = clientY + mSurfaceBounds.top;
+    info.pressure = pressure;
+    info.orientation = orientation;
+    if (source == InputDevice.SOURCE_MOUSE) {
+      if (eventType == MotionEvent.ACTION_DOWN || eventType == MotionEvent.ACTION_MOVE) {
+        info.buttonState |= button;
+      } else if (eventType == MotionEvent.ACTION_UP) {
+        info.buttonState &= ~button;
+      }
+    }
+
+    int action = eventType & MotionEvent.ACTION_MASK;
+    if (eventType == MotionEvent.ACTION_POINTER_DOWN
+        || eventType == MotionEvent.ACTION_POINTER_UP) {
+      action |= pointerIndex << MotionEvent.ACTION_POINTER_INDEX_SHIFT;
+    }
+    final MotionEvent event =
+        MotionEvent.obtain(
+            mPointerState.downTime,
+            SystemClock.uptimeMillis(),
+            action,
+            mPointerState.count(source),
+            mPointerState.properties(source),
+            mPointerState.coordinates(source),
+            0,
+            mPointerState.buttons(source),
+            1,
+            1,
+            0,
+            0,
+            source,
+            0);
+    mSynthesizedEvent = true;
+    try {
+      onTouchEvent(event);
+    } finally {
+      mSynthesizedEvent = false;
+      event.recycle();
+    }
+
+    if (eventType == MotionEvent.ACTION_POINTER_UP
+        || eventType == MotionEvent.ACTION_UP
+        || eventType == MotionEvent.ACTION_CANCEL
+        || eventType == MotionEvent.ACTION_HOVER_MOVE) {
+      mPointerState.pointers.remove(pointerIndex);
+    }
+  }
+}
