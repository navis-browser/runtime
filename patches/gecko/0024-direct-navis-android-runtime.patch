+const RESTORE_SUPERSEDING_COMMANDS = new Set([
+  "NavisAndroid:Load", "NavisAndroid:LoadExtensionPopup", "NavisAndroid:RetryDownload",
+  "NavisAndroid:Reload", "NavisAndroid:Stop", "NavisAndroid:Back", "NavisAndroid:Forward",
+]);
