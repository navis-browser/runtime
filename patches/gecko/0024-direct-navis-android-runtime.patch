+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.geckoview;
+
+import android.graphics.Matrix;
+import android.view.MotionEvent;
+import android.view.View;
+import androidx.annotation.Nullable;
+import org.mozilla.gecko.util.ThreadUtils;
+
+/**
+ * Engine-private adapter that lets the direct Navis runtime reuse Gecko's Android accessibility
+ * implementation without exposing the historical SessionAccessibility owner.
+ */
+public final class NavisAndroidAccessibility {
+  /** Minimal coordinate/scroll operations needed by the accessibility implementation. */
+  public interface Host {
+    void scrollByViewportHeight(float fraction);
+
+    void getClientToScreenMatrix(Matrix matrix);
+  }
+
+  private final AndroidAccessibilityBridge mBridge;
+
+  public NavisAndroidAccessibility(final Host host) {
+    if (host == null) {
+      throw new NullPointerException("host");
+    }
+    mBridge =
+        new AndroidAccessibilityBridge(
+            new AndroidAccessibilityBridge.Delegate() {
+              @Override
+              public void scrollByViewportHeight(final float fraction) {
+                host.scrollByViewportHeight(fraction);
+              }
+
+              @Override
+              public void getClientToScreenMatrix(final Matrix matrix) {
+                host.getClientToScreenMatrix(matrix);
+              }
+            });
+  }
+
+  public void setView(final @Nullable View view) {
+    ThreadUtils.assertOnUiThread();
+    mBridge.setView(view);
+  }
+
+  /** Gives touch-exploration hover events first refusal before APZ handles pointer input. */
+  public boolean onMotionEvent(final MotionEvent event) {
+    ThreadUtils.assertOnUiThread();
+    return event != null && mBridge.onMotionEvent(event);
+  }
+
+  /** Returns the generated-JNI endpoint; the concrete bridge remains package-private. */
+  public Object nativeProvider() {
+    return mBridge.nativeProvider;
+  }
+}
