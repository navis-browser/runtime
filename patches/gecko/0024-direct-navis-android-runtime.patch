+
+  private boolean rememberTargetRequest(final GeckoBundle message, final EventCallback callback) {
+    if (callback == null) {
+      return false;
+    }
+    final long requestId = message.getLong("requestId", 0L);
+    if (requestId <= 0L || mPendingTargetRequests.containsKey(requestId)) {
+      callback.sendError("Invalid or duplicate Navis target request");
+      return false;
+    }
+    mPendingTargetRequests.put(requestId, callback);
+    return true;
+  }
+
+  private void handlePromptRequest(final GeckoBundle message, final EventCallback callback) {
+    if (!rememberTargetRequest(message, callback)) return;
+    final long requestId = message.getLong("requestId", 0L);
+    if ("save-login".equals(message.getString("kind")) || "select-login".equals(message.getString("kind"))) {
+      mLoginPromptRequestIds.add(requestId);
+    }
+    if ("save-login".equals(message.getString("kind"))) {
+      final GeckoBundle[] candidates = message.getBundleArray("loginCandidates");
+      // Only trusted engine-supplied candidates are writable. Never accept credentials
+      // or a success marker supplied as part of the UI response.
+      if (mClosed || !mOpenRequested || mPrivateMode || message.getBoolean("privateMode", true)
+          || candidates == null || candidates.length == 0 || candidates.length > 32 ||
+          message.getInt("loginIndex", -1) < 0 || message.getInt("loginIndex", -1) >= candidates.length ||
+          !message.getString("navisSourceToken", "").matches("[a-f0-9]{32}")) {
+        cancelTargetRequest(requestId);
+        return;
+      }
+      final NavisAndroidLogins.Login[] logins = new NavisAndroidLogins.Login[candidates.length];
+      for (int i = 0; i < candidates.length; i++) {
+        logins[i] = NavisAndroidLogins.Login.fromBundle(candidates[i]);
+        if (logins[i] == null) {
+          cancelTargetRequest(requestId);
+          return;
+        }
+      }
+      mPendingLoginSaves.put(requestId, new PendingLoginSave(message, logins, callback));
+    }
+    mDelegate.onPromptRequested(
+        mSessionId, message.getLong("requestId", 0L), message.getString("kind", "alert"),
+        message.getString("title", ""), message.getString("message", ""),
+        message.getBoolean("privateMode", false), message.getString("uri", ""),
+        message.getString("username", ""), message.getString("password", ""),
+        message.getBoolean("passwordOnly", false),
+        message.getBoolean("previousAttemptFailed", false), message.getBoolean("secure", false),
+        message.getString("defaultValue", ""), message.getString("loginOrigin", ""),
+        message.getString("loginUsername", ""), message.getInt("loginIndex", -1),
+        message.getString("loginOptions", "[]"));
+  }
+
+  /**
+   * Re-delivers a Gecko prompt update through the same target request id.
+   *
+   * <p>The original EventCallback remains in {@code mPendingTargetRequests}; an update must
+   * never create a second callback or resolve/cancel the prompt. The product target therefore
+   * replaces the same-id DTO in place.
+   */
+  private void handlePromptUpdate(GeckoBundle message) {
+    final long requestId = message.getLong("requestId", 0L);
+    if (requestId <= 0L || !mPendingTargetRequests.containsKey(requestId)) {
+      return;
+    }
+    final PendingLoginSave save = mPendingLoginSaves.get(requestId);
+    if (save != null && save.busy) return;
+    // A save retry presents the same immutable candidate, not new metadata from
