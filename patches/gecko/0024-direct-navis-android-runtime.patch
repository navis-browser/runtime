+    }
+  }
+
+  private void completeNewWindowOpen(final boolean opened) {
+    if (mNewWindowOpenResult == null) {
+      return;
+    }
+    final CompletableFuture<Boolean> result = mNewWindowOpenResult;
+    mNewWindowOpenResult = null;
+    result.complete(opened);
+  }
+
+  private void failNewWindowOpen(final String message) {
+    if (mNewWindowOpenResult == null) {
+      return;
+    }
+    final CompletableFuture<Boolean> result = mNewWindowOpenResult;
+    mNewWindowOpenResult = null;
+    result.completeExceptionally(new IllegalStateException(message));
+  }
+
+  private static boolean isValidWindowToken(final String token) {
+    if (token == null || token.length() != 32) {
+      return false;
+    }
+    for (int index = 0; index < token.length(); index++) {
+      final char value = token.charAt(index);
+      if (!((value >= '0' && value <= '9') || (value >= 'a' && value <= 'f'))) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  private static CompletionStage<Boolean> failedBooleanResult(final String message) {
+    final CompletableFuture<Boolean> result = new CompletableFuture<>();
+    result.completeExceptionally(new IllegalStateException(message));
+    return result;
+  }
+
+  private void releaseDispatcher() {
