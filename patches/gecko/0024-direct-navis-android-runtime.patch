diff --git a/mobile/shared/modules/navis/NavisAndroidGeckoProducer.sys.mjs b/mobile/shared/modules/navis/NavisAndroidGeckoProducer.sys.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..328fde71ccaddf606614cab0c63fcd28b97ef860
--- /dev/null
+++ b/mobile/shared/modules/navis/NavisAndroidGeckoProducer.sys.mjs
@@ -0,0 +1,410 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+const { ActorManagerParent } = ChromeUtils.importESModule(
+  "resource://gre/modules/ActorManagerParent.sys.mjs"
+);
+
+// This is the direct-runtime equivalent of GeckoView's event dispatcher.  It
+// deliberately sits between Gecko's parent actors and the Navis target bridge:
+// Web APIs enter through the actors, and only the resulting request is sent to
+// Java.  In particular, this module never re-issues a network request and does
+// not manufacture download or WebAuthn results.
+
+const SITE_PERMISSIONS = Object.freeze({
+  geolocation: "GEOLOCATION",
+  "desktop-notification": "NOTIFICATIONS",
+  "persistent-storage": "PERSISTENT_STORAGE",
+  "storage-access": "STORAGE_ACCESS",
+  xr: "XR",
+});
+
+const PLATFORM_PERMISSIONS = Object.freeze({
+  "android.permission.CAMERA": "CAMERA",
+  "android.permission.RECORD_AUDIO": "MICROPHONE",
+  "android.permission.ACCESS_FINE_LOCATION": "FINE_LOCATION",
+  "android.permission.ACCESS_COARSE_LOCATION": "COARSE_LOCATION",
+  "android.permission.BLUETOOTH_CONNECT": "BLUETOOTH_CONNECT",
+  "android.permission.BLUETOOTH_SCAN": "BLUETOOTH_SCAN",
+});
+
+let processActorsRegistered = false;
+
+// Every direct Session owns a chrome host, but JS process actors are registered
+// once per Gecko parent process. Keep that lifetime here in the cached product
+// module instead of letting each host repeat a global registration.
+export function ensureNavisAndroidProcessActors() {
+  if (processActorsRegistered) {
+    return;
+  }
+
+  // getUserMedia asks the process actor for the Android app permission before
+  // it asks the window actor for the origin-specific device selection.
+  ActorManagerParent.addJSProcessActors({
+    GeckoViewPermissionProcess: {
+      parent: {
+        esModuleURI:
+          "resource:///actors/GeckoViewPermissionProcessParent.sys.mjs",
+      },
+      child: {
+        esModuleURI:
+          "resource:///actors/GeckoViewPermissionProcessChild.sys.mjs",
+        observers: [
+          "getUserMedia:ask-device-permission",
+          "getUserMedia:request",
+          "recording-device-events",
+          "PeerConnection:request",
+        ],
+      },
+    },
+  });
+  processActorsRegistered = true;
+}
+
+function privateMode(browser) {
+  return browser?.browsingContext?.originAttributes?.privateBrowsingId > 0;
+}
+
+function captureKind(value) {
+  // nsIFilePicker.CaptureTarget is an integer in Gecko's XPCOM API while the
+  // Navis product contract intentionally uses stable strings.
+  if (typeof value === "string") {
+    return value.toLowerCase();
+  }
+  return ["none", "user", "environment"][value] ?? "none";
+}
+
+function promptKind(prompt) {
+  switch (prompt?.type) {
+    case "button":
+      return "confirm";
+    case "auth":
+      return "authentication";
+    case "Autocomplete:Save:Login":
+      return "save-login";
+    case "Autocomplete:Select:Login":
+      return "select-login";
+    case "text":
+      return "text";
+    case "alert":
+      return "alert";
+    case "choice":
+      return "choice";
+    case "datetime":
+      return "datetime";
+    case "color":
+      return "color";
+    default:
+      return null;
+  }
+}
+
+function promptPayload(prompt, browser) {
+  const kind = promptKind(prompt);
+  if (!kind) {
+    return null;
+  }
+
+  const options = prompt.options ?? {};
+  const logins = Array.isArray(prompt.logins)
+    ? prompt.logins
+    : Array.isArray(prompt.options)
+      ? prompt.options.map(option => option?.value ?? option)
+      : [];
+  const loginIndex = Number.isInteger(prompt.loginIndex) ? prompt.loginIndex : 0;
+  const login = logins[loginIndex] ?? {};
+  const structuredOptions =
+    kind === "choice"
+      ? {
+          mode: prompt.mode ?? "single",
+          choices: Array.isArray(prompt.choices) ? prompt.choices : [],
+        }
+      : kind === "datetime"
+        ? {
+            mode: prompt.mode ?? "datetime-local",
+            value: prompt.value ?? "",
+            min: prompt.min ?? "",
+            max: prompt.max ?? "",
+            step: prompt.step ?? "",
+          }
+        : kind === "color"
+          ? {
+              value: prompt.value ?? "",
+              predefinedValues: Array.isArray(prompt.predefinedValues)
+                ? prompt.predefinedValues
+                : [],
+            }
+          : null;
+  return {
+    kind,
+    title: prompt.title ?? "",
+    message: prompt.msg ?? prompt.message ?? "",
+    privateMode: privateMode(browser),
+    uri: options.uri ?? browser?.currentURI?.spec ?? "",
+    username: options.username ?? "",
+    password: kind === "authentication" ? options.password ?? "" : "",
+    passwordOnly: options.mode === "password",
+    previousAttemptFailed: Boolean(options.previousAttemptFailed),
+    secure: Boolean(options.secure),
+    defaultValue: prompt.value ?? "",
+    loginOrigin: login.origin ?? "",
+    loginUsername: login.username ?? "",
+    loginIndex,
+    // Credentials cross only the private Java persistence seam. Product/UI
+    // receives metadata, never a password hidden inside a DTO or JSON field.
+    loginCandidates: kind === "save-login" ? logins : [],
+    navisSourceToken: kind === "save-login" ? prompt.navisSourceToken ?? "" : "",
+    loginOptions: JSON.stringify(structuredOptions ?? logins.map((entry, index) => ({
+      index, origin: entry.origin ?? "", username: entry.username ?? "",
+    }))),
+    promptId: prompt.id ?? null,
+  };
+}
+
+function promptResult(result, prompt, payload) {
+  if (!result) {
+    return null;
+  }
+  // TargetDialogs represents an alert's positive button as Dismiss because an
+  // alert has no boolean choice.  Treat only that one case as acceptance;
+  // Reject/Dismiss for all other prompts remains cancellation.
+  if (!result.accepted && !(payload.kind === "alert" && result.type === "Dismiss")) {
+    return null;
+  }
+  switch (payload.kind) {
+    case "alert":
+      return {};
+    case "confirm":
+      return { button: 0 };
+    case "text":
+      return { text: result.text ?? "" };
+    case "authentication":
+      return {
+        username: result.username ?? "",
+        password: result.password ?? "",
+      };
+    case "save-login":
+    case "select-login": {
+      const entries = Array.isArray(prompt.logins)
+        ? prompt.logins
+        : Array.isArray(prompt.options)
+          ? prompt.options.map(option => option?.value ?? option)
+          : [];
+      const index = Number.isInteger(result.index)
+        ? result.index
+        : payload.loginIndex;
+      const selected = entries[index];
+      if (!selected) {
+        return null;
+      }
+      // Login autocomplete stores the save/matching hint on the selected
+      // option. It is not reliably present on the outer prompt (especially
+      // for Select:Login), so preserve the engine-provided per-entry value.
+      const selectedOption = Array.isArray(prompt.options)
+        ? prompt.options[index]
+        : null;
+      return {
+        // Only the private native save transaction may mint this acknowledgement.
+        navisSaved: payload.kind === "save-login" && result.navisSaved === true,
+        selection: {
+          value: selected,
+          hint: selected?.hint ?? selectedOption?.hint ?? prompt.hint ?? 0,
+        },
+      };
+    }
+    case "choice": {
+      const ids = Array.isArray(result.ids) ? result.ids : null;
+      return ids ? { choices: ids } : null;
+    }
+    case "datetime":
+      return result.value === undefined ? null : { datetime: result.value };
+    case "color":
+      return result.value === undefined ? null : { color: result.value };
+    default:
+      return null;
+  }
+}
+
+function requestId(data) {
+  const value = data?.requestId ?? data?.id;
+  return typeof value === "string" || typeof value === "number" ? value : null;
+}
+
+export function createNavisGeckoEventDispatcher({
+  targetBridge,
+  rawDispatcher,
+  getBrowser,
+  isLive,
+}) {
+  const promptRequests = new Map();
+
+  function rejectClosed() {
+    return Promise.reject(new Error("Navis Android host is closed"));
+  }
+
+  function sendRequestForResult(event, data = {}) {
+    if (!isLive()) {
+      return rejectClosed();
+    }
+
+    const browser = getBrowser();
+    switch (event) {
+      case "GeckoView:Prompt": {
+        const prompt = data.prompt ?? data;
+        if (prompt.type === "file") {
+          const request = targetBridge.filePicker({
+            title: prompt.title ?? "",
+            mode: prompt.mode ?? "single",
+            capture: captureKind(prompt.capture),
+            mimeTypes: Array.isArray(prompt.mimeTypes)
+              ? prompt.mimeTypes
+              : [],
+            privateMode: privateMode(browser),
+            promptId: prompt.id ?? null,
+          });
+          const id = requestId(prompt);
+          if (id !== null) {
+            promptRequests.set(id, request);
+          }
+          return request
+            .then(result => {
+              const uris = Array.isArray(result?.uris) ? result.uris : [];
+              return uris.length ? { files: uris } : null;
+            })
+            .finally(() => {
+              if (id !== null) {
+                promptRequests.delete(id);
+              }
+            });
+        }
+        const payload = promptPayload(prompt, browser);
+        if (!payload) {
+          // Unsupported prompt kinds must complete as a dismissal.  This is
+          // fail-closed and avoids pretending that a target accepted a prompt
+          // it could not represent.
+          return Promise.resolve(null);
+        }
+        if (payload.kind === "save-login" && privateMode(browser)) {
+          return Promise.resolve(null);
+        }
+        const request = targetBridge.prompt(payload);
+        const id = requestId(prompt);
+        if (id !== null) {
+          promptRequests.set(id, request);
+        }
+        return request
+          .then(result => promptResult(result, prompt, payload))
+          .finally(() => {
+            if (id !== null) {
+              promptRequests.delete(id);
+            }
+          });
+      }
+      case "GeckoView:ContentPermission": {
+        const kind = SITE_PERMISSIONS[data.perm];
+        if (!kind || typeof data.uri !== "string") {
+          return Promise.resolve(Services.perms.DENY_ACTION);
+        }
+        return targetBridge
+          .sitePermission({
+            uri: data.uri,
+            privateMode: Boolean(data.privateMode),
+            kind,
+            thirdPartyOrigin: data.thirdPartyOrigin ?? "",
+          })
+          .then(result => {
+            const navisDecision = ["allow-session", "allow-always", "block", "dismiss"].includes(result?.decision)
+              ? result.decision : "dismiss";
+            return {
+              navisDecision,
+              action: navisDecision === "allow-session" || navisDecision === "allow-always"
+                ? Services.perms.ALLOW_ACTION : Services.perms.DENY_ACTION,
+            };
+          });
+      }
+      case "GeckoView:AndroidPermission": {
+        const permissions = Array.isArray(data.perms)
+          ? data.perms.map(permission => PLATFORM_PERMISSIONS[permission])
+          : [];
+        if (!permissions.length || permissions.some(permission => !permission)) {
+          return Promise.resolve(false);
+        }
+        return targetBridge
+          .platformPermission({
+            permissions: [...new Set(permissions)],
+            privateMode: privateMode(browser),
+          })
+          .then(result => Boolean(result?.allow));
+      }
+      case "GeckoView:MediaPermission": {
+        const video = Array.isArray(data.video) ? data.video : [];
+        const audio = Array.isArray(data.audio) ? data.audio : [];
+        if (!video.length && !audio.length) {
+          return Promise.resolve(null);
+        }
+        return targetBridge
+          .mediaPermission({
+            uri: data.uri ?? browser?.currentURI?.spec ?? "",
+            privateMode: privateMode(browser),
+            // NavisAndroidSession transports these as JSON strings so no
+            // Gecko Java object graph crosses the direct seam.
+            videoSources: JSON.stringify(video),
+            audioSources: JSON.stringify(audio),
+          })
+          .then(result => {
+            if (!result?.allow) {
+              return null;
+            }
+            // The current product target accepts/denies the complete request.
+            // Select the first engine-provided source, never an invented ID.
+            return {
+              video: video[0]?.rawId ?? video[0]?.id,
+              audio: audio[0]?.rawId ?? audio[0]?.id,
+            };
+          });
+      }
+      case "GeckoView:Prompt:Dismiss":
+      case "GeckoView:Prompt:Update":
+        return Promise.resolve(null);
+      default:
+        // Downloads and WebAuthn are intentionally not projected here.  A
+        // download must carry the original nsIChannel body, and WebAuthn must
+        // carry a verified assertion/attestation; neither may be reduced to a
+        // boolean or a second JS fetch.
+        return rawDispatcher.sendRequestForResult(event, data);
+    }
+  }
+
+  function sendRequest(event, data = {}) {
+    if (!isLive()) {
+      return rejectClosed();
+    }
+    if (event === "GeckoView:Prompt:Dismiss") {
+      const id = requestId(data);
+      if (id !== null) {
+        promptRequests.delete(id);
+        targetBridge.cancelByKey(id);
+      }
+      return Promise.resolve();
+    }
+    if (event === "GeckoView:Prompt:Update") {
+      const prompt = data.prompt ?? data;
+      if (!prompt?.id || prompt.type === "file") {
+        return Promise.resolve();
+      }
+      const payload = promptPayload(prompt, getBrowser());
+      if (!payload) {
+        return Promise.resolve();
+      }
+      return Promise.resolve(
+        targetBridge.promptUpdate({ ...payload, promptId: prompt.id })
+      );
+    }
+    return rawDispatcher.sendRequest(event, data);
+  }
+
+  return Object.freeze({ sendRequestForResult, sendRequest });
+}
diff --git a/mobile/shared/modules/navis/NavisAndroidTargetBridge.sys.mjs b/mobile/shared/modules/navis/NavisAndroidTargetBridge.sys.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4ee668df63601b95cbf4de5e0e8050302c5c3864
--- /dev/null
+++ b/mobile/shared/modules/navis/NavisAndroidTargetBridge.sys.mjs
@@ -0,0 +1,117 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+// This module is intentionally independent of GeckoView.  The direct host uses
+// it as the one request/cancellation gate for Android target projections.
+const MAX_TARGET_REQUESTS = 128;
+let nextRequestId = 1;
+
+export function createNavisTargetBridge(dispatcher, isLive) {
+  const pending = new Map();
+
+  function cancel(requestId, reason = "Navis target request cancelled") {
+    const request = pending.get(requestId);
+    if (!request) return false;
+    pending.delete(requestId);
+    try {
+      Promise.resolve(
+        dispatcher.sendRequest("NavisAndroid:CancelTarget", { requestId })
+      ).catch(() => {});
+    } catch (error) {
+      // The Java peer may already be gone during shutdown.  The local
+      // rejection below is still required to release the Gecko actor.
+    }
+    request.reject(new Error(reason));
+    return true;
+  }
+
+  function cancelByKey(key, reason = "Navis target request cancelled") {
+    let cancelled = false;
+    for (const [requestId, request] of pending) {
+      if (request.key !== key) {
+        continue;
+      }
+      pending.delete(requestId);
+      // Tell the Java session to release its EventCallback too.  The local
+      // promise rejection alone would leave an Android target request alive
+      // until a UI response arrived.
+      try {
+        Promise.resolve(
+          dispatcher.sendRequest("NavisAndroid:CancelTarget", { requestId })
+        ).catch(() => {});
+      } catch (error) {
+        // The Java peer may already be gone during shutdown.
+      }
+      request.reject(new Error(reason));
+      cancelled = true;
+    }
+    return cancelled;
+  }
+
+  function cancelAll() {
+    for (const requestId of [...pending.keys()]) cancel(requestId, "Navis host closed");
+  }
+
+  function request(event, payload) {
+    if (!isLive() || pending.size >= MAX_TARGET_REQUESTS) {
+      return Promise.reject(new Error("Navis target request capacity exhausted"));
+    }
+    const requestId = nextRequestId++;
+    const wrapped = { ...payload, requestId };
+    let resolveRequest;
+    let rejectRequest;
+    const result = new Promise((resolve, reject) => {
+      resolveRequest = resolve;
+      rejectRequest = reject;
+    });
+    pending.set(requestId, {
+      resolve: resolveRequest,
+      reject: rejectRequest,
+      key: payload?.promptId ?? null,
+      requestId,
+    });
+    dispatcher
+      .sendRequestForResult(event, wrapped)
+      .then(value => {
+        const request = pending.get(requestId);
+        if (!request) return;
+        pending.delete(requestId);
+        request.resolve(value);
+      })
+      .catch(error => cancel(requestId, error?.message));
+    return result;
+  }
+
+  return Object.freeze({
+    request,
+    cancel,
+    cancelByKey,
+    cancelAll,
+    prompt: payload => request("NavisAndroid:Prompt", payload),
+    sitePermission: payload => request("NavisAndroid:SitePermission", payload),
+    mediaPermission: payload => request("NavisAndroid:MediaPermission", payload),
+    platformPermission: payload => request("NavisAndroid:PlatformPermission", payload),
+    filePicker: payload => request("NavisAndroid:FilePicker", payload),
+    // Prompt updates are state changes, not a second request.  They retain
+    // the Gecko prompt id so the product can mutate the existing dialog.
+    promptUpdate: payload => {
+      // Prompt updates are only meaningful while the original target request
+      // is live.  Include the private numeric request id so the Java peer can
+      // mutate the existing callback/UI entry without guessing from Gecko's
+      // opaque prompt id.
+      for (const request of pending.values()) {
+        if (request.key === payload?.promptId) {
+          return dispatcher.dispatch("NavisAndroid:PromptUpdate", {
+            ...payload,
+            requestId: request.requestId,
+          });
+        }
+      }
+      return Promise.resolve();
+    },
+    webAuthn: payload => request("NavisAndroid:WebAuthn", payload),
+  });
+}
