+package org.mozilla.geckoview.internal;
+
+import org.mozilla.gecko.annotation.WrapForJNI;
+
+/** Immutable Java copy of a borrowed Navis Core navigation snapshot. */
+public final class NavisCoreSnapshot {
+  public final long revision;
+  public final long navigationId;
+  public final String url;
+  public final String title;
+  public final int activity;
+  public final int security;
+  public final int identity;
+  public final String identityKey;
+  public final boolean canGoBack;
+  public final boolean canGoForward;
+  public final boolean hasFailure;
+  public final int failureCode;
+
+  @WrapForJNI(calledFrom = "ui")
+  public NavisCoreSnapshot(
+      long revision,
+      long navigationId,
+      String url,
+      String title,
+      int activity,
+      int security,
+      int identity,
+      String identityKey,
+      boolean canGoBack,
+      boolean canGoForward,
+      boolean hasFailure,
+      int failureCode) {
+    this.revision = revision;
+    this.navigationId = navigationId;
+    this.url = url;
+    this.title = title;
+    this.activity = activity;
+    this.security = security;
+    this.identity = identity;
+    this.identityKey = identityKey;
+    this.canGoBack = canGoBack;
+    this.canGoForward = canGoForward;
+    this.hasFailure = hasFailure;
+    this.failureCode = failureCode;
+  }
+}
