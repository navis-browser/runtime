+  private void handleMessage(
+      final String event, final GeckoBundle message, final EventCallback callback) {
+    ThreadUtils.assertOnUiThread();
+    if (mClosed) {
+      if (EVENT_NEW_WINDOW.equals(event) && callback != null) {
+        callback.sendSuccess(false);
+      }
+      return;
+    }
+
+    switch (event) {
+      case EVENT_POPUP_CLOSE:
+        handlePopupCloseRequest(message);
+        break;
+      case EVENT_HOST_READY:
+        if (mDevToolsWindow && message.getString("error") != null) {
+          failNewWindowOpen(message.getString("error"));
+          mDelegate.onSessionError(mSessionId, message.getString("error"));
+          break;
+        }
+        mHostReady = true;
+        if (!mDevToolsWindow && message.getBoolean("contentSession", false)) {
+          mWebAuthnContextId = message.getLong("browsingContextId", 0);
+          NavisAndroidWebAuthn.registerSession(
+              mSessionId, mWebAuthnContextId, mProductActive);
+        }
+        if (mDevToolsWindow) completeNewWindowOpen(true);
+        // A HostReady consumer may immediately query a restored Session. Hand
+        // off its queued RestoreState first; the query awaits Gecko's actual
+        // restore transaction, not merely this chrome-window lifecycle event.
+        while (!mPendingCommands.isEmpty()) {
+          final PendingCommand command = mPendingCommands.removeFirst();
+          mDispatcher.dispatch(command.event, command.data);
+        }
+        mDelegate.onHostReady(mSessionId);
+        break;
+      case EVENT_LOCATION:
+        final long webAuthnContextId = message.getLong("browsingContextId", 0);
+        if (mWebAuthnContextId != 0 && webAuthnContextId > 0
+            && mWebAuthnContextId != webAuthnContextId) {
+          // COOP/remoteness replacement may create a new top-level context.
+          mWebAuthnContextId = webAuthnContextId;
+          NavisAndroidWebAuthn.registerSession(mSessionId, webAuthnContextId, mProductActive);
+        }
+        if (!message.getBoolean("sameDocument", false)) {
+          NavisAndroidWebAuthn.invalidateSession(mSessionId);
+        }
+        mDelegate.onLocationChanged(
+            mSessionId, message.getString("uri", ""), message.getLong("generation", 0),
+            message.getBoolean("sameDocument", false), message.getBoolean("errorPage", false));
+        break;
+      case EVENT_TITLE:
+        final String title = message.getString("title", "");
+        final String titleUri = message.getString("uri", "");
+        final long titleGeneration = message.getLong("generation", 0);
+        if (title.length() <= 65536 && !titleUri.isEmpty() && titleUri.length() <= 65536
+            && titleGeneration > 0) {
+          mDelegate.onTitleChanged(mSessionId, title, titleUri, titleGeneration);
+        }
+        break;
+      case EVENT_FAVICON:
+        final String pageUri = message.getString("pageURL", "");
+        final String png = message.getString("png", "");
+        if (pageUri.length() <= 65536 && png.length() <= 65536
+            && (png.isEmpty() || png.startsWith("data:image/png;base64,"))) {
+          mDelegate.onFaviconChanged(mSessionId, pageUri, png);
+        }
+        break;
+      case EVENT_LOADING:
+        if (message.getBoolean("loading", false)) {
+          NavisAndroidWebAuthn.invalidateSession(mSessionId);
+          mDelegate.onLoadStarted(
+              mSessionId, message.getLong("generation", 0), message.getString("uri", ""));
+        }
+        break;
+      case EVENT_LOAD_COMPLETE:
+        mDelegate.onLoadCompleted(
+            mSessionId, message.getLong("generation", 0), message.getInt("status", 0),
+            message.getBoolean("statusKnown", false), message.getBoolean("cancelled", false),
+            message.getBoolean("errorPage", false), message.getString("uri", ""));
+        break;
+      case EVENT_SESSION_STATE:
+        final String serializedState = message.getString("state", "");
+        if (!serializedState.isEmpty()
+            && serializedState.length() <= MAX_RESTORED_STATE_CHARS) {
+          mDelegate.onSessionStateChanged(mSessionId, serializedState);
+        }
+        break;
+      case EVENT_HISTORY:
+        mDelegate.onHistoryChanged(
+            mSessionId,
+            message.getBoolean("canGoBack", false),
+            message.getBoolean("canGoForward", false));
+        break;
+      case EVENT_SECURITY:
+        mDelegate.onSecurityChanged(
+            mSessionId, message.getInt("state", SECURITY_UNKNOWN));
+        break;
+      case EVENT_FULLSCREEN:
+        final boolean fullscreen = message.getBoolean("enabled", false);
+        if (mFullscreen != fullscreen) {
+          mFullscreen = fullscreen;
+          mDelegate.onFullscreenChanged(mSessionId, fullscreen);
+        }
+        break;
+      case EVENT_CONTENT_PROCESS_GONE:
+        final boolean crashed = message.getBoolean("crashed", false);
+        transitionToClosed();
+        if (mOpenRequested) {
+          mWindow.close();
+        } else {
+          releaseDispatcher();
+          notifySessionClosed();
+        }
+        mDelegate.onContentProcessGone(mSessionId, crashed);
+        break;
+      case EVENT_NEW_WINDOW:
+        handleNewWindowRequest(message, callback);
+        break;
+      case EVENT_PROMPT:
+        handlePromptRequest(message, callback);
+        break;
+      case EVENT_PROMPT_UPDATE:
+        handlePromptUpdate(message);
+        break;
+      case EVENT_SITE_PERMISSION:
+        handleSitePermissionRequest(message, callback);
+        break;
+      case EVENT_MEDIA_PERMISSION:
+        handleMediaPermissionRequest(message, callback);
+        break;
+      case EVENT_PLATFORM_PERMISSION:
+        handlePlatformPermissionRequest(message, callback);
+        break;
+      case EVENT_FILE_PICKER:
+        handleFilePickerRequest(message, callback);
+        break;
+      case EVENT_CANCEL_TARGET:
+        cancelTargetRequest(message.getLong("requestId", 0L));
+        if (callback != null) {
+          callback.sendSuccess(null);
+        }
+        break;
+      case EVENT_WEBAUTHN:
+        // A boolean target response is not a WebAuthn assertion.  Keep this
+        // unavailable until the direct seam carries verified authenticator
+        // data and cancellation/lifetime state.
+        if (callback != null) {
+          callback.sendError("Navis WebAuthn projection is unavailable");
+        }
+        break;
+      case EVENT_CONTEXT_MENU:
+        handleContextMenuRequest(message, callback);
+        break;
+      case EVENT_CONTEXT_MENU_UPDATE:
+        handleContextMenuUpdate(message);
+        break;
+      case EVENT_CONTEXT_MENU_CANCEL:
+        cancelContextMenu(message.getString("token", ""));
+        break;
+      case EVENT_SHORTCUT_SETTINGS:
+        mDelegate.onShortcutSettingsRequested(
+            mSessionId, message.getString("extensionId", ""));
+        if (callback != null) callback.sendSuccess(null);
+        break;
+      case EVENT_COMMAND_OWNERSHIP:
+        final String[] shortcuts = message.getStringArray("shortcuts");
+        mOwnedShortcuts.clear();
+        if (shortcuts != null) {
+          for (final String shortcut : shortcuts) {
+            if (shortcut != null && shortcut.length() <= 128) mOwnedShortcuts.add(shortcut);
+          }
+        }
+        mDelegate.onCommandOwnershipChanged(
+            mSessionId, mOwnedShortcuts.toArray(new String[0]));
+        break;
+      default:
+        throw new IllegalArgumentException("Unknown Navis engine event: " + event);
+    }
+  }
+
+  private void handleContextMenuRequest(
+      final GeckoBundle message, final EventCallback callback) {
+    final String token = message.getString("token", "");
+    if (callback == null) {
+      return;
+    }
+    if (token.length() != 32 || mPendingContextMenus.containsKey(token)) {
+      callback.sendError("Invalid or duplicate Navis context-menu request");
+      return;
+    }
+    final NavisAndroidContextMenu request;
+    try {
+      request = NavisAndroidContextMenu.fromBundle(message);
+    } catch (final RuntimeException error) {
+      callback.sendError("Invalid Navis context-menu request");
+      return;
+    }
+    mPendingContextMenus.put(token, callback);
+    mDelegate.onContextMenuRequested(mSessionId, request);
+  }
+
+  private void handleContextMenuUpdate(final GeckoBundle message) {
+    final String token = message.getString("token", "");
+    if (token.length() != 32 || !mPendingContextMenus.containsKey(token)) return;
+    final NavisAndroidContextMenu request;
+    try {
+      request = NavisAndroidContextMenu.fromBundle(message);
+    } catch (final RuntimeException error) {
+      cancelContextMenu(token);
+      return;
+    }
+    if (!token.equals(request.token)) return;
+    mDelegate.onContextMenuUpdated(mSessionId, request);
+  }
+
+  /** Completes one native context-menu request exactly once. */
+  public boolean respondToContextMenu(final String token, final String itemId) {
+    ThreadUtils.assertOnUiThread();
+    final EventCallback callback = mPendingContextMenus.remove(token);
+    if (callback == null || mClosed || itemId == null || itemId.length() > 256) return false;
+    final GeckoBundle result = new GeckoBundle(1);
+    result.putString("itemId", itemId);
+    callback.sendSuccess(result);
+    return true;
+  }
+
+  public boolean cancelContextMenu(final String token) {
+    ThreadUtils.assertOnUiThread();
+    final EventCallback callback = mPendingContextMenus.remove(token);
+    if (callback == null) return false;
+    callback.sendSuccess(null);
+    return true;
+  }
