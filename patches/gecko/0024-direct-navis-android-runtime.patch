+
+int64_t NavisCoreSupport::BeginNavigation(int64_t aHandle, int64_t aSessionId,
+                                          int32_t aCommand,
+                                          jni::String::Param aRequestedUri) {
+  NavisCoreRuntime* runtime = Runtime(aHandle);
+  uint64_t session = 0;
+  uint64_t output = 0;
+  nsCString uri;
+  const bool hasUri = static_cast<bool>(aRequestedUri);
+  if (hasUri) {
+    uri = aRequestedUri->ToCString();
+  }
+  return runtime && Id(aSessionId, &session) &&
+                 Status(navis_core_runtime_begin_navigation(
+                     runtime, session, static_cast<uint32_t>(aCommand),
+                     Bytes(uri), uri.Length(), hasUri, &output))
+             ? JavaId(output)
+             : 0;
+}
+
+int64_t NavisCoreSupport::ObserveNavigationStart(
+    int64_t aHandle, int64_t aSessionId, jni::String::Param aRequestedUri,
