+let navigationDiagnosticPending = null;
+let navigationDiagnosticWriting = null;
+
+function persistNavigationDiagnostic(record) {
+  if (!Services.prefs.getBoolPref("navis.diagnostics.navigation", false)) return;
+  // Coalesce while a write is outstanding; retain no navigation history.
+  navigationDiagnosticPending = record;
+  if (navigationDiagnosticWriting) return;
+  navigationDiagnosticWriting = Promise.resolve().then(async () => {
+    try {
+      const path = PathUtils.join(PathUtils.profileDir, "navis-navigation-diagnostic.json");
+      while (navigationDiagnosticPending &&
+          Services.prefs.getBoolPref("navis.diagnostics.navigation", false)) {
+        const latest = navigationDiagnosticPending;
+        navigationDiagnosticPending = null;
+        await IOUtils.writeJSON(path, latest);
+      }
+    } catch {
+      // A diagnostic write failure must not affect the load.
+    }
+  }).finally(() => {
+    navigationDiagnosticPending = null;
+    navigationDiagnosticWriting = null;
+  });
+}
+
+// Never retain URLs, query strings, exception messages or arbitrary names.
+// The opt-in profile file contains only the latest anonymous phase record.
+function reportNavigationDiagnostic(phase, { uri, request, error, status: loadStatus } = {}) {
+  try {
+    const session = /^navis-android-session-([1-9][0-9]{0,15})(?::|$)/u
+      .exec(window.name)?.[1] ?? "unknown";
+    let rawScheme;
+    if (typeof uri === "string") {
+      rawScheme = /^([a-z][a-z0-9+.-]*):/iu.exec(uri)?.[1]?.toLowerCase();
+    } else {
+      try { rawScheme = request?.QueryInterface(Ci.nsIChannel)?.URI?.scheme; } catch {}
+    }
+    const scheme = ["http", "https", "about", "file", "data", "blob",
+      "moz-extension", "navis"].includes(rawScheme) ? rawScheme : "other";
+    const result = error?.result ?? loadStatus;
+    const status = Number.isInteger(result)
+      ? `0x${(result >>> 0).toString(16).padStart(8, "0")}` : "unavailable";
+    const name = typeof error?.name === "string" &&
+      /^(?:Error|TypeError|RangeError|SyntaxError|SecurityError|AbortError|NetworkError|NS_ERROR_[A-Z0-9_]+)$/u.test(error.name)
+      ? error.name : "unknown";
+    const record = { phase, session, scheme, status, name };
+    if (phase === "load-error" || phase === "restore-error" ||
+        (phase === "stop" && Number.isInteger(result) && !Components.isSuccessCode(result))) {
+      try {
+        Services.console.logStringMessage(
+          `NavisAndroid NavigationFailure phase=${phase} session=${session} scheme=${scheme} status=${status} name=${name}`
+        );
+      } catch {}
+    }
+    persistNavigationDiagnostic(record);
+  } catch {
+    // A missing channel/console must not replace the original failure.
+  }
+}
+
+const commandListener = {
+  onEvent(event, data, callback) {
+    if (RESTORE_SUPERSEDING_COMMANDS.has(event)) sessionRestoreGeneration++;
+    switch (event) {
+      case "NavisAndroid:RetryDownload": {
+        try {
+          const httpURI = value => {
+            if (typeof value !== "string" || value.length > 65536) {
+              throw new TypeError("Invalid download retry URI");
+            }
+            const uri = Services.io.newURI(value);
+            if ((!uri.schemeIs("http") && !uri.schemeIs("https")) || uri.userPass) {
+              throw new TypeError("Download retry requires a credential-free HTTP(S) URI");
+            }
+            return uri;
+          };
+          const uri = httpURI(data?.uri);
+          const referrer = data?.referrer ? httpURI(data.referrer) : null;
+          const ReferrerInfo = Components.Constructor(
+            "@mozilla.org/referrer-info;1", "nsIReferrerInfo", "init"
+          );
+          browser.loadURI(uri, {
+            triggeringPrincipal: Services.scriptSecurityManager.createNullPrincipal(
+              browser.contentPrincipal.originAttributes
+            ),
+            referrerInfo: referrer ? new ReferrerInfo(
+              Ci.nsIReferrerInfo.STRICT_ORIGIN_WHEN_CROSS_ORIGIN, true, referrer
+            ) : null,
+            loadFlags: Ci.nsIWebNavigation.LOAD_FLAGS_IS_LINK,
+          });
+          callback?.onSuccess({ loaded: true });
+        } catch (error) {
+          callback?.onError(error?.message || "Download retry failed");
+        }
+        break;
+      }
+      case "NavisAndroid:Query": {
+        Promise.resolve().then(async () => {
+          if (devToolsHost) {
+            if (typeof data?.payload !== "string" || data.payload.length > 1024) {
+              throw new TypeError("Invalid developer-tools query payload");
+            }
+            return devToolsHost.query(data.operation, JSON.parse(data.payload));
+          }
+          if (!PRODUCT_QUERIES.has(data?.operation) ||
+              typeof data?.payload !== "string" ||
+              data.payload.length > (data.operation === "product:initialize" ? 512 * 1024 : 65536)) {
+            throw new TypeError("Unknown or invalid Navis product query");
+          }
+          if (data.operation === "product:initialize") {
+            const { ensureNavisAndroidLocales } = ChromeUtils.importESModule(
+              "resource://gre/modules/NavisAndroidLocales.sys.mjs"
+            );
+            await ensureNavisAndroidLocales();
+          }
+          if (NavisAndroidPresentation.handles(data.operation)) {
+            const result = NavisAndroidPresentation.query(window, data.operation, JSON.parse(data.payload));
+            if (data.operation === "session:presentation") NavisAndroidLoginLifecycle.reconcile(browser);
+            return result;
+          }
+          if (data.operation === "session:capture-closed") {
+            const { NavisAndroidClosedTabs } = ChromeUtils.importESModule(
+              "resource://gre/modules/NavisAndroidClosedTabs.sys.mjs");
+            return NavisAndroidClosedTabs.capture(window);
+          }
+          if (data.operation === "session:restore-result") return readSessionRestoreResult();
+          if (data.operation === "login:authorize-save") {
+            return NavisAndroidLoginLifecycle.authorizeSave(browser, JSON.parse(data.payload)?.token);
+          }
+          const product = ChromeUtils.importESModule(
+            "resource://gre/modules/navis/NavisAndroidProduct.sys.mjs"
+          );
+          const result = await product.query(window, data.operation, JSON.parse(data.payload));
+          if (data.operation === "product:initialize") {
+            await NavisAndroidStartup.completeProductInitialization(window);
+          }
+          return result;
+        }).then(result => callback?.onSuccess({ payload: JSON.stringify(result ?? null) }))
+          .catch(error => callback?.onError(error?.message || "Product query failed"));
+        break;
+      }
+      case "NavisAndroid:Load": {
+        const uri = data?.uri;
+        try {
+          if (typeof uri !== "string" || !uri) {
+            throw new TypeError("NavisAndroid:Load requires a non-empty URI");
+          }
+          NavisAndroidPresentation.cancelTraversal(browser);
+          browser.loadURI(Services.io.newURI(uri), {
+            triggeringPrincipal:
+              Services.scriptSecurityManager.getSystemPrincipal(),
+          });
+          browser.navisNativePresentation = false;
+          reportNavigationDiagnostic("load-request", { uri });
+        } catch (error) {
+          reportNavigationDiagnostic("load-error", { uri, error });
+          throw error;
+        }
+        break;
+      }
+      case "NavisAndroid:LoadExtensionPopup": {
+        try {
+          const loaded = NavisAndroidWebExtensionHost.loadPopupTarget(
+            browser,
+            data?.extensionId,
+            data?.targetToken,
+            data?.popupUri
+          );
+          callback?.onSuccess({ loaded: Boolean(loaded) });
+        } catch (error) {
+          if (callback) {
+            callback.onError({
+              code: error?.code || "popup-bind-failed",
+              message: "Could not bind the extension popup",
+            });
+          } else {
+            throw error;
+          }
+        }
+        break;
+      }
+      case "NavisAndroid:SetActive":
+        window.tab?.setActive(Boolean(data?.active));
+        if (!data?.active) NavisAndroidContextMenus.close();
+        break;
+      case "NavisAndroid:Reload":
+        browser.reload();
+        break;
+      case "NavisAndroid:Stop":
+        browser.stop();
+        break;
+      case "NavisAndroid:Back":
+        if (browser.canGoBack) {
+          browser.goBack();
+        }
+        break;
+      case "NavisAndroid:Forward":
+        if (browser.canGoForward) {
+          browser.goForward();
+        }
+        break;
+      case "NavisAndroid:RestoreState":
+        beginSessionRestore(data?.state);
+        break;
+      case "NavisAndroid:FlushSessionState":
+        dispatchSessionState();
+        break;
+      case "NavisAndroid:ExitFullscreen":
+        document.exitFullscreen();
+        break;
+      case "NavisAndroid:Command":
+        NavisAndroidCommandRegistry.handleShortcut(data?.shortcut, window.tab, window)
+          .then(value => callback?.onSuccess(Boolean(value)))
+          .catch(error => callback?.onError(error?.message || "Command failed"));
+        break;
+    }
+  },
+};
+
+const contentProcessObserver = {
+  observe(subject, topic) {
+    if (!browser || !dispatcher || shuttingDown) {
+      return;
+    }
+
+    if (topic === "oop-frameloader-crashed") {
+      const crashedBrowser = subject?.ownerElement;
+      if (crashedBrowser !== browser) {
+        return;
+      }
+      const pending = {
+        childId: browser.frameLoader?.childID,
+        crashed: false,
+      };
+      contentCrashPending = pending;
+      pending.timer = window.setTimeout(() => {
+        if (contentCrashPending !== pending || !dispatcher || shuttingDown) {
+          return;
+        }
+        contentCrashPending = null;
+        dispatcher.dispatch("NavisAndroid:ContentProcessGone", {
+          crashed: pending.crashed,
+        });
+      }, 250);
+      return;
+    }
+
+    if (topic !== "ipc:content-shutdown" || !contentCrashPending) {
+      return;
+    }
+    subject.QueryInterface(Ci.nsIPropertyBag2);
+    if (
+      subject.get("dumpID") &&
+      contentCrashPending.childId !== undefined &&
+      subject.get("childID") === contentCrashPending.childId
+    ) {
+      contentCrashPending.crashed = true;
+    }
+  },
+};
+
+function registerFullscreenActors() {
+  GeckoViewActorManager.addJSWindowActors({
+    GeckoViewContent: {
+      parent: {
+        esModuleURI: "resource:///actors/GeckoViewContentParent.sys.mjs",
+      },
+      child: {
+        esModuleURI: "resource:///actors/GeckoViewContentChild.sys.mjs",
+      },
+      allFrames: true,
+      messageManagerGroups: ["browsers"],
+    },
+    ContentDelegate: {
+      parent: {
+        esModuleURI: "resource:///actors/ContentDelegateParent.sys.mjs",
+      },
+      child: {
+        esModuleURI: "resource:///actors/ContentDelegateChild.sys.mjs",
+        events: {
+          "MozDOMFullscreen:Entered": {},
+          "MozDOMFullscreen:Exit": {},
+          "MozDOMFullscreen:Exited": {},
+          "MozDOMFullscreen:Request": {},
+          contextmenu: { capture: false, mozSystemGroup: true },
+        },
+      },
+      allFrames: true,
+      messageManagerGroups: ["browsers"],
+    },
+  });
+}
+
+// These are the Gecko producers.  Their XPCOM entry points are reached by
+// real web APIs (window.prompt/alert, content permissions, getUserMedia and
+// <input type=file>); they are not synthetic host events.  We register only
+// the actor definitions needed by the direct runtime, while leaving the
+// GeckoView Java Runtime/Session/View out of the product.
+function registerTargetActors() {
+  GeckoViewActorManager.addJSWindowActors({
+    GeckoViewPermission: {
+      parent: {
+        esModuleURI: "resource:///actors/GeckoViewPermissionParent.sys.mjs",
+      },
+      child: {
+        esModuleURI: "resource:///actors/GeckoViewPermissionChild.sys.mjs",
+      },
+      allFrames: true,
+      includeChrome: true,
+    },
+    GeckoViewPrompter: {
+      parent: {
+        esModuleURI: "resource:///actors/GeckoViewPrompterParent.sys.mjs",
+      },
+      child: {
+        esModuleURI: "resource:///actors/GeckoViewPrompterChild.sys.mjs",
+      },
+      allFrames: true,
+      includeChrome: true,
+    },
+    GeckoViewPrompt: {
+      parent: {
+        esModuleURI: "resource:///actors/GeckoViewPromptParent.sys.mjs",
+      },
+      child: {
+        esModuleURI: "resource:///actors/GeckoViewPromptChild.sys.mjs",
+        events: {
+          click: { capture: false, mozSystemGroup: true },
+          mozshowdropdown: {},
+          "mozshowdropdown-sourcetouch": {},
+          MozOpenDateTimePicker: {},
+          DOMPopupBlocked: { capture: false, mozSystemGroup: true },
+          DOMRedirectBlocked: { capture: false, mozSystemGroup: true },
+        },
+      },
+      allFrames: true,
+      messageManagerGroups: ["browsers"],
+    },
+  });
+
+  ensureNavisAndroidProcessActors();
+}
+
+function dispatchFullscreenState(enabled) {
+  if (fullscreenActive === enabled || !dispatcher || shuttingDown) {
+    return;
+  }
+  fullscreenActive = enabled;
+  dispatcher.dispatch("NavisAndroid:Fullscreen", { enabled });
+}
+
+function sendEnterDOMFullscreenEvent(requestOrigin) {
+  const actors = [];
+  let currentContext = requestOrigin.browsingContext;
+  let currentPid = currentContext.currentWindowGlobal.osPid;
+  let parentContext = currentContext.parent;
+
+  while (parentContext?.currentWindowGlobal) {
+    const parentPid = parentContext.currentWindowGlobal.osPid;
+    if (currentPid !== parentPid) {
+      const actor =
+        parentContext.currentWindowGlobal.getActor("GeckoViewContent");
+      actor.sendAsyncMessage("GeckoView:DOMFullscreenEntered", {
+        remoteFrameBC: currentContext,
+      });
+      actors.push(actor);
+      currentPid = parentPid;
+    }
+    currentContext = parentContext;
+    parentContext = parentContext.parent;
+  }
+
+  const actor =
+    requestOrigin.browsingContext.currentWindowGlobal.getActor(
+      "GeckoViewContent"
+    );
+  actor.sendAsyncMessage("GeckoView:DOMFullscreenEntered", {});
+  actors.push(actor);
+  fullscreenRequest = { actors };
+}
+
+function sendExitDOMFullscreenEvent() {
+  if (!fullscreenRequest) {
+    return;
+  }
+  for (const actor of fullscreenRequest.actors) {
+    if (
+      !actor.hasBeenDestroyed() &&
+      actor.windowContext &&
+      !actor.windowContext.isInBFCache
+    ) {
+      actor.sendAsyncMessage("GeckoView:DOMFullscreenExited", {});
+    }
+  }
+  fullscreenRequest = null;
+}
+
+const fullscreenListener = {
+  handleEvent(event) {
+    if (event.type === "MozDOMFullscreen:Exited") {
+      sendExitDOMFullscreenEvent();
+      dispatchFullscreenState(false);
+      return;
+    }
+    if (event.type !== "MozDOMFullscreen:Entered" || event.target !== browser) {
+      return;
+    }
+    const requestOrigin =
+      browser.documentGlobal.browsingContext?.fullscreenRequestOrigin?.get();
+    if (!requestOrigin) {
+      document.exitFullscreen();
+      return;
+    }
+    try {
+      sendEnterDOMFullscreenEvent(requestOrigin);
+      dispatchFullscreenState(true);
+    } catch (error) {
+      console.error("Navis Android failed to enter DOM fullscreen", error);
+      sendExitDOMFullscreenEvent();
+      document.exitFullscreen();
+    }
+  },
+};
+
+function cancelOpenWindowInfo(openWindowInfo) {
+  try {
+    openWindowInfo?.cancel();
+  } catch (error) {
+    console.error("Navis Android failed to cancel a new content window", error);
+  }
+}
+
+function waitAndSetupWindow(windowToken, openWindowInfo, name) {
+  let settled = false;
+  let timeout;
+  let resolveSetup;
+  let rejectSetup;
+  const promise = new Promise((resolve, reject) => {
+    resolveSetup = resolve;
+    rejectSetup = reject;
+  });
+  promise.catch(() => {});
+
+  const finish = (error, targetBrowser = null) => {
+    if (settled) {
+      return;
+    }
+    settled = true;
+    Services.obs.removeObserver(observer, "navis-android-window-created");
+    window.clearTimeout(timeout);
+    pendingWindowSetups.delete(waiter);
+    if (error) {
+      rejectSetup(error);
+    } else {
+      resolveSetup(targetBrowser);
+    }
+  };
+  const observer = {
+    observe(subject, topic) {
+      if (
+        topic !== "navis-android-window-created" ||
+        !new RegExp(`^navis-android-session-[1-9][0-9]*:${windowToken}$`).test(
+          subject?.name || ""
+        ) ||
+        !subject.browser
+      ) {
+        return;
+      }
+      const targetBrowser = subject.browser;
+      if (openWindowInfo) {
+        targetBrowser.openWindowInfo = openWindowInfo;
+        if (!openWindowInfo.isRemote && targetBrowser.hasAttribute("remote")) {
+          targetBrowser.removeAttribute("remote");
+          targetBrowser.removeAttribute("remoteType");
+        }
+      }
+      if (name) {
+        targetBrowser.setAttribute("name", name);
+      }
+      finish(null, targetBrowser);
+    },
+  };
+  const waiter = {
+    promise,
+    cancel(error) {
+      finish(error ?? new Error("New content window request cancelled"));
+    },
+  };
+  pendingWindowSetups.add(waiter);
+  Services.obs.addObserver(observer, "navis-android-window-created");
+  timeout = window.setTimeout(
+    () => waiter.cancel(new Error("Timed out creating a new content window")),
+    NEW_WINDOW_TIMEOUT_MS
+  );
+  return waiter;
+}
+
+async function requestNewSession(uri, openWindowInfo, name) {
+  const windowToken = Services.uuid
+    .generateUUID()
+    .toString()
+    .slice(1, -1)
+    .replace(/-/g, "");
+  const waiter = waitAndSetupWindow(windowToken, openWindowInfo, name);
+  try {
+    const accepted = await dispatcher.sendRequestForResult(
+      "NavisAndroid:NewWindow",
+      {
+        uri: uri?.displaySpec ?? "",
+        windowToken,
+        privateMode:
+          browser.browsingContext.originAttributes.privateBrowsingId > 0,
+      }
+    );
+    if (!accepted) {
+      throw new Error("New content window request rejected");
+    }
+    return await waiter.promise;
+  } catch (error) {
+    waiter.cancel(error);
+    cancelOpenWindowInfo(openWindowInfo);
+    throw error;
+  }
+}
+
+function waitSynchronously(label, promise) {
+  let result;
+  promise.then(
+    value => {
+      result = value;
+    },
+    () => {
+      result = null;
+    }
+  );
+  Services.tm.spinEventLoopUntil(
+    `Navis Android ${label}`,
+    () => window.closed || result !== undefined
+  );
+  return result || null;
+}
+
+const browserDOMWindow = {
+  QueryInterface: ChromeUtils.generateQI(["nsIBrowserDOMWindow"]),
+
+  get tabCount() {
+    return 1;
+  },
+
+  createContentWindow(uri, openWindowInfo, where) {
+    const promise = requestNewSession(uri, openWindowInfo, null);
+    const isNewTab = [
+      Ci.nsIBrowserDOMWindow.OPEN_NEWTAB,
+      Ci.nsIBrowserDOMWindow.OPEN_NEWTAB_BACKGROUND,
+    ].includes(where);
+    if (openWindowInfo && !isNewTab) {
+      promise.catch(() => {});
+      return null;
+    }
+    const targetBrowser = waitSynchronously("createContentWindow", promise);
+    if (!targetBrowser) {
+      Components.returnCode = Cr.NS_ERROR_ABORT;
