+      mFullscreen = false;
+      mDelegate.onFullscreenChanged(mSessionId, false);
+    }
+  }
+
+  private void clearInputView() {
+    mInputView = null;
+    mTextInput.setView(null);
+    mAccessibility.setView(null);
+  }
+
+  private void notifySessionClosed() {
+    if (mSessionClosedNotified) {
+      return;
+    }
+    mSessionClosedNotified = true;
+    mDelegate.onSessionClosed(mSessionId);
+  }
+
+  private void handlePopupCloseRequest(final GeckoBundle message) {
+    // This dispatcher belongs to one Session. A stale or ordinary content host
+    // cannot close a different popup, even after the platform selects a new tab.
+    if (mPopupTargetToken != null
