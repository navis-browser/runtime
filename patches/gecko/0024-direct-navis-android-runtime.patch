+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.gecko.navis;
+
+import android.app.Activity;
+import java.util.concurrent.CompletionStage;
+import org.mozilla.gecko.annotation.WrapForJNI;
+import org.mozilla.gecko.util.ThreadUtils;
+import org.mozilla.geckoview.GeckoResult;
+import org.mozilla.geckoview.WebNotification;
+import org.mozilla.geckoview.WebResponse;
+
+/** Process-wide JNI peer owned and installed by the Navis Android Runtime. */
+public final class NavisAndroidRuntime {
+  public interface Delegate {
+    float textScaleFactor();
+
+    boolean usesDarkTheme();
+
+    CompletionStage<Boolean> onOrientationLock(int orientation);
+
+    void onOrientationUnlock();
+
+    /**
+     * Receives the original Gecko channel response body for a direct download.
+     * Implementations take ownership of {@link WebResponse#body}; the default
+     * closes it so an unavailable product cannot leak a suspended channel.
+     */
+    default void onExternalResponse(
+        final long sessionId, final boolean privateMode, final WebResponse response) {
+      if (response != null && response.body != null) {
+        try {
+          response.body.close();
+        } catch (final java.io.IOException ignored) {
+          // The channel is already being torn down.
+        }
+      }
+    }
+  }
+
+  private static NavisAndroidRuntime sInstance;
+
+  private final Delegate mDelegate;
+
+  private NavisAndroidRuntime(final Delegate delegate) {
+    mDelegate = delegate;
+  }
+
+  public static synchronized NavisAndroidRuntime install(final Delegate delegate) {
+    if (delegate == null) {
+      throw new NullPointerException("delegate");
+    }
+    if (sInstance != null) {
+      throw new IllegalStateException("Only one Navis Android Runtime may be installed");
+    }
+    sInstance = new NavisAndroidRuntime(delegate);
+    return sInstance;
+  }
+
+  public synchronized void uninstall() {
+    if (sInstance != this) {
+      throw new IllegalStateException("This Navis Android Runtime is not installed");
+    }
+    sInstance = null;
+    ThreadUtils.runOnUiThread(NavisAndroidNotifications::shutdown);
+    ThreadUtils.runOnUiThread(NavisAndroidWebAuthn::shutdown);
+  }
+
+  public void bindWebAuthnActivity(final Activity activity, final long windowId, final long generation) {
+    NavisAndroidWebAuthn.bindActivity(activity, windowId, generation);
+  }
+
+  public void unbindWebAuthnActivity(final long windowId, final long generation) {
+    NavisAndroidWebAuthn.unbindActivity(windowId, generation);
+  }
+
+  public void setWebAuthnSessionWindow(final long sessionId, final long windowId) {
+    NavisAndroidWebAuthn.setSessionWindow(sessionId, windowId);
+  }
+
+  public String webAuthnAvailability(final long windowId) {
+    return NavisAndroidWebAuthn.availability(windowId);
+  }
+
+  @WrapForJNI
+  private static synchronized NavisAndroidRuntime getInstance() {
+    return sInstance;
+  }
+
+  @WrapForJNI
+  private float textScaleFactor() {
+    return mDelegate.textScaleFactor();
+  }
+
+  @WrapForJNI
+  private boolean usesDarkTheme() {
+    return mDelegate.usesDarkTheme();
+  }
+
+  @WrapForJNI
+  private void notifyOnShow(final WebNotification notification) {
+    ThreadUtils.runOnUiThread(() -> NavisAndroidNotifications.show(notification));
+  }
+
+  @WrapForJNI
+  private void notifyOnClose(final WebNotification notification) {
+    ThreadUtils.runOnUiThread(() -> NavisAndroidNotifications.close(notification));
+  }
+
+  @WrapForJNI(calledFrom = "gecko")
+  private GeckoResult<Boolean> lockScreenOrientation(final int orientation) {
+    final GeckoResult<Boolean> result = new GeckoResult<>();
+    ThreadUtils.runOnUiThread(
+        () -> {
+          try {
+            final CompletionStage<Boolean> delegated =
+                mDelegate.onOrientationLock(orientation);
+            if (delegated == null) {
+              result.completeExceptionally(new UnsupportedOperationException("Orientation lock"));
+            } else {
+              delegated.whenComplete(
+                  (allowed, error) -> {
+                    if (error != null) {
+                      result.completeExceptionally(error);
+                    } else {
+                      result.complete(Boolean.TRUE.equals(allowed));
+                    }
+                  });
+            }
+          } catch (final Throwable error) {
+            result.completeExceptionally(error);
+          }
+        });
+    return result;
+  }
+
+  @WrapForJNI(calledFrom = "gecko")
+  private void unlockScreenOrientation() {
+    ThreadUtils.runOnUiThread(mDelegate::onOrientationUnlock);
+  }
+
+  /** Called by the direct native window when Gecko hands us an external response. */
+  @WrapForJNI(calledFrom = "gecko")
+  private void passExternalResponse(
+      final long sessionId, final boolean privateMode, final WebResponse response) {
+    ThreadUtils.runOnUiThread(
+        () -> {
+          try {
+            mDelegate.onExternalResponse(sessionId, privateMode, response);
+          } catch (final Throwable error) {
+            // Ownership belongs to the receiver only after this callback
+            // returns successfully.  Close on a rejected handoff.
+            if (response != null && response.body != null) {
+              try {
+                response.body.close();
+              } catch (final java.io.IOException ignored) {
+                // The channel is already being torn down.
+              }
+            }
+            android.util.Log.w("NavisAndroidRuntime", "External response handoff failed", error);
+          }
+        });
+  }
+}
