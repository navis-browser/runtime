+  /** Product adapter supplies an opaque response; GeckoBundle remains private transport. */
+  public boolean respondToTarget(final long requestId, final Object response) {
+    ThreadUtils.assertOnUiThread();
+    final PendingLoginSave save = mPendingLoginSaves.get(requestId);
+    if (save != null && response instanceof GeckoBundle) {
+      final GeckoBundle choice = (GeckoBundle) response;
+      if (choice.getBoolean("accepted", false)) {
+        if (!"SelectOption".equals(choice.getString("type"))) return false;
+        return saveLoginCandidate(requestId, save, choice.getInt("index", -1));
+      }
+    }
+    mPendingLoginSaves.remove(requestId);
+    mLoginPromptRequestIds.remove(requestId);
+    final EventCallback callback = mPendingTargetRequests.remove(requestId);
+    if (callback == null || mClosed) return false;
+    callback.sendSuccess((GeckoBundle) response);
+    return true;
+  }
+
+  public boolean cancelTargetRequest(final long requestId) {
+    ThreadUtils.assertOnUiThread();
+    mPendingLoginSaves.remove(requestId);
+    final boolean loginPrompt = mLoginPromptRequestIds.remove(requestId);
+    final EventCallback callback = mPendingTargetRequests.remove(requestId);
+    if (callback == null) return false;
+    callback.sendError("Navis target request cancelled");
+    if (loginPrompt) mDelegate.onLoginPromptCancelled(mSessionId, requestId);
+    return true;
+  }
+
+  private boolean saveLoginCandidate(final long requestId, final PendingLoginSave save, final int index) {
+    if (mClosed || !mOpenRequested || mPrivateMode || save.busy ||
+        mPendingLoginSaves.get(requestId) != save ||
+        mPendingTargetRequests.get(requestId) != save.callback ||
+        index < 0 || index >= save.logins.length) return false;
+    save.busy = true;
+    final long attempt = ++save.attempt;
+    // Source authority is checked in Gecko *before* touching Keystore/SQLite.
+    // A native prompt's chrome owner alone does not prove the remote document
+    // that offered these credentials is still current or a valid POST landing.
+    final CompletionStage<String> authorized;
+    try {
+      authorized = querySession("login:authorize-save", "{\"token\":\"" +
+          save.message.getString("navisSourceToken") + "\"}");
+    } catch (final RuntimeException error) {
+      cancelTargetRequest(requestId);
+      return true;
+    }
+    authorized.whenComplete((answer, authorizationError) -> ThreadUtils.runOnUiThread(() -> {
+      if (mClosed || mPrivateMode || mPendingLoginSaves.get(requestId) != save ||
+          mPendingTargetRequests.get(requestId) != save.callback || save.attempt != attempt) return;
+      if (authorizationError != null || !"true".equals(answer)) {
+        cancelTargetRequest(requestId);
+        return;
+      }
+      NavisAndroidLogins.save(save.logins[index]).whenComplete((ignored, error) ->
+        ThreadUtils.runOnUiThread(() -> {
+          // Closing/replacing a prompt withdraws UI ownership, not a promise to undo
+          // a storage commit already accepted by the user.
+          if (mClosed || mPendingLoginSaves.get(requestId) != save ||
+              mPendingTargetRequests.get(requestId) != save.callback || save.attempt != attempt) return;
+          save.busy = false;
+          if (error != null) {
+            save.message.putBoolean("previousAttemptFailed", true);
+            handlePromptUpdate(save.message);
+            return; // Keep the original Gecko callback live for an explicit retry.
+          }
+          mPendingLoginSaves.remove(requestId);
+          mLoginPromptRequestIds.remove(requestId);
+          mPendingTargetRequests.remove(requestId);
+          final GeckoBundle result = new GeckoBundle(4);
+          result.putString("type", "SelectOption");
+          result.putBoolean("accepted", true);
+          result.putInt("index", index);
+          result.putBoolean("navisSaved", true);
+          save.callback.sendSuccess(result);
+          mDelegate.onLoginSaveCompleted(mSessionId, requestId);
+        }));
+    }));
+    return true;
+  }
