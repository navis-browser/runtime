index 0000000000000000000000000000000000000000..c1a6590118c67f13cbe8acca8b5f03a5d393149d
--- /dev/null
+++ b/mobile/shared/components/extensions/ext-topSites.js
@@ -0,0 +1,29 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+"use strict";
+{
+  const { NavisAndroidExtensionProfile: profile } = ChromeUtils.importESModule(
+    "resource://gre/modules/NavisAndroidExtensionProfile.sys.mjs");
+  function domain(url) {
+    try { return Services.eTLD.getBaseDomain(Services.io.newURI(url)); }
+    catch { try { return Services.io.newURI(url).host; } catch { return url; } }
+  }
+  this.topSites = class extends ExtensionAPI {
+    getAPI(context) {
+      return { topSites: { get: async (options = {}) => {
+        const entries = await profile.request(this.extension, context, "topSites:list");
+        const seen = new Set();
+        const results = [];
+        for (const entry of entries) {
+          const key = domain(entry.url);
+          if (options.onePerDomain !== false && seen.has(key)) continue;
+          seen.add(key);
+          results.push({ url: entry.url, title: entry.title, type: "url" });
+          if (results.length >= Math.min(options.limit ?? 12, 100)) break;
+        }
+        return results;
+      } } };
+    }
+  };
+}
