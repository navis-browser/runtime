+
+/** Product-owned Android system notification peer for direct extension alerts. */
+public final class NavisAndroidNotifications {
+  private static final String CHANNEL_ID = "navis-extension-notifications";
+  private static final String ACTION_CLICK = "org.navis.browser.NOTIFICATION_CLICK";
+  private static final String ACTION_CLOSE = "org.navis.browser.NOTIFICATION_CLOSE";
+  private static final String EXTRA_TAG = "tag";
+  private static final String EXTRA_ACTION = "action";
+  private static final int MAX_TEXT = 4096;
+  private static final AtomicInteger NEXT_ID = new AtomicInteger(1);
+  private static final Map<String, WebNotification> ACTIVE = new HashMap<>();
+  private static final Map<String, Integer> IDS = new HashMap<>();
+  private static String sReceiverClass = NotificationReceiver.class.getName();
+  private static String sNamespace = "";
+
+  private NavisAndroidNotifications() {}
+
+  public static void configureProcess(final String receiverClass, final String namespace) {
+    synchronized (ACTIVE) {
+      if (!ACTIVE.isEmpty() || !sNamespace.isEmpty()) {
+        throw new IllegalStateException("Notification process namespace is already selected");
+      }
+      sReceiverClass = receiverClass;
+      sNamespace = namespace;
+    }
+  }
+
+  private static String notificationTag(final WebNotification notification) {
+    return sNamespace + ":" + bounded(notification.tag);
+  }
+
+  public static void show(final WebNotification notification) {
+    if (notification == null) return;
+    if (Build.VERSION.SDK_INT >= 33 &&
+        GeckoAppShell.getApplicationContext().checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS)
+            != PackageManager.PERMISSION_GRANTED) {
+      notification.dismiss();
+      return;
+    }
+    if (notification.privateBrowsing) {
+      // Private notifications must never escape the private session.
+      notification.dismiss();
+      return;
+    }
+    if (notification.actions.length > 0) {
+      // The notifications API rejects buttons in the direct schema. Keep the
+      // native seam fail-closed for any other producer carrying actions.
+      notification.dismiss();
+      return;
+    }
+    final Context context = GeckoAppShell.getApplicationContext();
+    final NotificationManager manager = context.getSystemService(NotificationManager.class);
+    if (manager == null ||
+        (Build.VERSION.SDK_INT >= 24 && !manager.areNotificationsEnabled())) {
+      notification.dismiss();
+      return;
+    }
+    ensureChannel(manager);
+    final String tag = notificationTag(notification);
+    final int id;
+    synchronized (ACTIVE) {
+      id = IDS.computeIfAbsent(tag, ignored -> NEXT_ID.getAndIncrement());
+      ACTIVE.put(tag, notification);
+    }
+    final Notification.Builder builder = Build.VERSION.SDK_INT >= 26
+        ? new Notification.Builder(context, CHANNEL_ID)
+        : new Notification.Builder(context);
+    builder.setSmallIcon(android.R.drawable.ic_dialog_info)
+        .setContentTitle(bounded(notification.title))
+        .setContentText(bounded(notification.text))
+        .setAutoCancel(true)
+        .setOnlyAlertOnce(true)
+        .setContentIntent(pendingIntent(context, tag, id))
+        .setDeleteIntent(closeIntent(context, tag, id));
+    try {
+      manager.notify(tag, id, builder.build());
+      notification.show();
+    } catch (final RuntimeException error) {
+      synchronized (ACTIVE) {
+        ACTIVE.remove(tag);
+        IDS.remove(tag);
+      }
+      notification.dismiss();
+    }
+  }
+
+  public static void close(final WebNotification notification) {
+    if (notification == null) return;
+    final String tag = notificationTag(notification);
+    final Integer id;
+    synchronized (ACTIVE) {
+      ACTIVE.remove(tag);
+      id = IDS.remove(tag);
+    }
+    final NotificationManager manager =
