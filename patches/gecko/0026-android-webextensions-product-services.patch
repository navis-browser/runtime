+        },
+        onClosed: new EventManager({ context, module: "notifications", event: "onClosed", extensionApi: this }).api(),
+        onClicked: new EventManager({ context, module: "notifications", event: "onClicked", extensionApi: this }).api(),
+        onShown: new EventManager({ context, module: "notifications", event: "onShown", extensionApi: this }).api(),
+        onButtonClicked: ignoreEvent(context, "notifications.onButtonClicked"),
+      },
+    };
+  }
+};
