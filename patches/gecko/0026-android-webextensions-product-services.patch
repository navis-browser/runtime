+  public static final class ExtensionRecord {
+    public final String id;
+    public final String name;
+    public final String description;
+    public final String version;
+    public final Source source;
+    public final Signature signature;
+    public final boolean enabled;
+    public final boolean privateBrowsingAllowed;
+    public final boolean privateBrowsingAvailable;
+    public final boolean pinnedToToolbar;
+    public final boolean canChangeEnabled;
+    public final boolean canUninstall;
+    public final boolean canUpdate;
+    public final boolean hasAction;
+    public final String actionKind;
+    public final boolean actionEnabled;
+    public final boolean hasOptions;
+    public final Icon icon;
+    public final Icon actionIcon;
+    public final List<String> requiredPermissions;
+    public final List<String> requiredOrigins;
+    public final String actionTitle;
+    public final String actionBadgeText;
+    public final Integer actionBadgeTextColor;
+    public final Integer actionBadgeBackgroundColor;
+    public final long actionSourceTabId;
+
+    private ExtensionRecord(final GeckoBundle value) {
+      id = boundedRequiredString(value, "id", 256);
+      name = boundedString(value, "name", 256);
+      description = boundedString(value, "description", 1024);
+      version = boundedRequiredString(value, "version", 128);
+      source = parseEnum(Source.class, boundedRequiredString(value, "source", 40));
+      signature =
+          parseEnum(Signature.class, boundedRequiredString(value, "signature", 40));
+      enabled = value.getBoolean("enabled", false);
+      privateBrowsingAllowed = value.getBoolean("privateBrowsingAllowed", false);
+      privateBrowsingAvailable = value.getBoolean("privateBrowsingAvailable", false);
+      pinnedToToolbar = value.getBoolean("pinnedToToolbar", false);
+      canChangeEnabled = value.getBoolean("canChangeEnabled", false);
+      canUninstall = value.getBoolean("canUninstall", false);
+      canUpdate = value.getBoolean("canUpdate", false);
+      hasAction = value.getBoolean("hasAction", false);
+      actionKind = boundedString(value, "actionKind", 16);
+      actionEnabled = value.getBoolean("actionEnabled", false);
+      hasOptions = value.getBoolean("hasOptions", false);
+      icon = Icon.optional(value, "extensionIcon");
+      actionIcon = Icon.optional(value, "actionIcon");
+      requiredPermissions = boundedStrings(value, "requiredPermissions");
+      requiredOrigins = boundedStrings(value, "requiredOrigins");
+      actionTitle = boundedString(value, "actionTitle", 512);
+      actionBadgeText = boundedString(value, "actionBadgeText", 64);
+      actionBadgeTextColor = optionalInt(value, "actionBadgeTextColor");
+      actionBadgeBackgroundColor = optionalInt(value, "actionBadgeBackgroundColor");
+      actionSourceTabId = value.getLong("actionSourceTabId", 0);
+      if (actionSourceTabId < 0 || actionSourceTabId > 9007199254740991L) {
+        throw new IllegalArgumentException("Invalid action source tab");
+      }
+
+      if (source == Source.BLOCKED_SIDELOAD && enabled) {
+        throw new IllegalArgumentException("A blocked side-load cannot be enabled");
+      }
+      if ((source == Source.APPLICATION_BUILT_IN)
+          != (signature == Signature.APPLICATION_VERIFIED)) {
+        throw new IllegalArgumentException("Invalid application verification provenance");
+      }
+      if (hasAction != !actionKind.isEmpty()) {
+        throw new IllegalArgumentException("Invalid extension action projection");
+      }
+      if (!actionKind.isEmpty()
+          && !"BROWSER".equals(actionKind)
+          && !"PAGE".equals(actionKind)) {
+        throw new IllegalArgumentException("Invalid extension action kind");
+      }
+      if (!hasAction && actionEnabled) {
+        throw new IllegalArgumentException("An unavailable extension action cannot be enabled");
+      }
+      if (!hasAction && actionIcon != null) {
+        throw new IllegalArgumentException("An unavailable extension action cannot expose an icon");
+      }
+    }
+  }
