--- /dev/null
+++ b/mobile/shared/modules/navis/NavisAndroidExtensionTabTopology.sys.mjs
@@ -0,0 +1,488 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const DIRECT_WINDOW_TYPE = "navigator:navis-android";
+const MAX_TABS = 2048;
+const EVENT_TYPES = new Set(["CREATED", "REMOVED", "ACTIVATED", "MOVED"]);
+
+export const NAVIS_ANDROID_TAB_TOPOLOGY_EVENT =
+  "navis-android-extension-tab-topology-event";
+
+let current = Object.freeze({
+  revision: 0,
+  windowId: 0,
+  activeTabId: null,
+  tabs: Object.freeze([]),
+  windows: Object.freeze([]),
+  focusedWindowId: null,
+  lastFocusedWindowId: null,
+  focusOrder: Object.freeze([]),
+});
+let resolveReady;
+const ready = new Promise(resolve => {
+  resolveReady = resolve;
+});
+const nativeTabs = new Map();
+const pendingEvents = [];
+const windowListeners = new Set();
+const removedWindowListeners = new Set();
+const pendingWindowEvents = [];
+
+function positiveInteger(value, label) {
+  if (!Number.isSafeInteger(value) || value <= 0) {
+    throw new TypeError(`Invalid ${label}`);
+  }
+  return value;
+}
+
+function nullableTabId(value, label) {
+  if (value === null || value === undefined || value === 0) {
+    return null;
+  }
+  return positiveInteger(value, label);
+}
+
+function snapshotEntries(snapshot) {
+  if (!Array.isArray(snapshot?.tabs) || snapshot.tabs.length > MAX_TABS) {
+    throw new TypeError("Invalid Android extension tab topology");
+  }
+  const ids = new Set();
+  const indexes = new Map();
+  return Object.freeze(
+    snapshot.tabs.map(candidate => {
+      const tabId = positiveInteger(candidate?.tabId, "topology tab ID");
+      const windowId = positiveInteger(candidate?.windowId ?? snapshot.windowId, "tab owner window");
+      const index = indexes.get(windowId) || 0;
+      if (ids.has(tabId) || candidate?.index !== index) {
+        throw new TypeError("Invalid Android extension tab order");
+      }
+      ids.add(tabId);
+      indexes.set(windowId, index + 1);
+      return Object.freeze({
+        tabId,
+        index,
+        privateMode: candidate?.privateMode === true,
+        windowId,
+      });
+    })
+  );
+}
+
+function windowById(snapshot, windowId) {
+  return snapshot.windows.find(window => window.windowId === windowId) || null;
+}
+
+function snapshotWindows(snapshot, tabs) {
+  const values = snapshot.windows ?? [{ windowId: snapshot.windowId, activeTabId: snapshot.activeTabId }];
+  if (!Array.isArray(values) || values.length > 64) throw new TypeError("Invalid Android window topology");
+  const ids = new Set();
+  let focused = null;
+  const windows = values.map(value => {
+    const windowId = positiveInteger(value?.windowId, "product window ID");
+    const activeTabId = nullableTabId(value.activeTabId, "selected tab ID");
+    if (ids.has(windowId) || (activeTabId !== null &&
+        !tabs.some(tab => tab.tabId === activeTabId && tab.windowId === windowId))) {
+      throw new TypeError("Invalid Android window selection");
+    }
+    ids.add(windowId);
+    if (value.focused === true) {
+      if (focused !== null) throw new TypeError("Multiple Android windows have input focus");
+      focused = windowId;
+    }
+    const bounds = {};
+    for (const name of ["left", "top", "width", "height"]) {
+      const number = value[name] ?? 0;
+      if (!Number.isSafeInteger(number) || ((name === "width" || name === "height") && number < 0)) {
+        throw new TypeError("Invalid Android window bounds");
+      }
+      bounds[name] = number;
+    }
+    const state = value.state ?? "normal";
+    if (!["normal", "minimized", "maximized", "fullscreen"].includes(state) ||
+        (state === "minimized" && value.focused === true)) {
+      throw new TypeError("Invalid Android window state");
+    }
+    return Object.freeze({ windowId, activeTabId, privateMode: value.privateMode === true,
+      focused: value.focused === true, state, ...bounds });
+  });
+  if (tabs.some(tab => !ids.has(tab.windowId)) ||
+      nullableTabId(snapshot.focusedWindowId, "focused window ID") !== focused ||
+      (snapshot.lastFocusedWindowId && !ids.has(snapshot.lastFocusedWindowId))) {
+    throw new TypeError("Android window topology has an unknown owner");
+  }
+  return Object.freeze(windows);
+}
+
+function entryById(snapshot, tabId) {
+  return snapshot.tabs.find(entry => entry.tabId === tabId) || null;
+}
+
+function validateEvent(candidate, previous, next) {
+  if (!EVENT_TYPES.has(candidate?.type)) {
+    throw new TypeError("Invalid Android extension tab topology event");
+  }
+  const type = candidate.type;
+  const tabId = positiveInteger(candidate.tabId, "topology event tab ID");
+  const oldEntry = entryById(previous, tabId);
+  const newEntry = entryById(next, tabId);
+  if (
+    (type === "CREATED" && (oldEntry || !newEntry)) ||
+    (type === "REMOVED" && (!oldEntry || newEntry)) ||
+    (type === "ACTIVATED" && (!newEntry || windowById(next, newEntry.windowId)?.activeTabId !== tabId)) ||
+    (type === "MOVED" && (!oldEntry || !newEntry))
+  ) {
+    throw new TypeError("Android extension tab event disagrees with topology");
+  }
+  if (type === "MOVED" && oldEntry.index === newEntry.index) {
+    throw new TypeError("Android extension move event did not move its tab");
+  }
+  const previousTabId = nullableTabId(
+    candidate.previousTabId,
+    "previous topology tab ID"
+  );
+  if (
+    type === "ACTIVATED" &&
+    previousTabId !== null &&
+    windowById(previous, newEntry.windowId)?.activeTabId !== previousTabId
+  ) {
+    throw new TypeError("Android extension activation predecessor is invalid");
+  }
+  return Object.freeze({
+    type,
+    tabId,
+    previousTabId,
+    revision: next.revision,
+    windowId: (newEntry || oldEntry).windowId,
+    isWindowClosing: type === "REMOVED" && candidate.isWindowClosing === true,
+    previous,
+    next,
+  });
+}
+
+function isNativeReady(event) {
+  return event.type === "REMOVED" || nativeTabs.has(event.tabId);
+}
+
+function notify(event) {
+  Services.obs.notifyObservers(
+    { wrappedJSObject: event },
+    NAVIS_ANDROID_TAB_TOPOLOGY_EVENT
+  );
+}
+
+function flushEvents() {
+  while (pendingEvents.length && isNativeReady(pendingEvents[0])) {
+    notify(pendingEvents.shift());
+  }
+  for (let index = 0; index < pendingWindowEvents.length;) {
+    const event = pendingWindowEvents[index];
+    if (event.type === "CREATED" && current.windows.some(window => window.windowId === event.windowId) &&
+        !current.tabs.some(tab => tab.windowId === event.windowId && nativeTabs.has(tab.tabId))) {
+      index++;
+      continue;
+    }
+    pendingWindowEvents.splice(index, 1);
+    if (event.type === "CREATED" && !windowById(current, event.windowId)) continue;
+    for (const listener of windowListeners) listener(event);
+  }
+}
+
+function filteredEntries(snapshot, includePrivate, windowId = null) {
+  return snapshot.tabs.filter(entry => (includePrivate || !entry.privateMode) &&
+    (windowId === null || entry.windowId === windowId));
+}
+
+function filteredIndex(snapshot, tabId, includePrivate) {
+  const owner = entryById(snapshot, tabId)?.windowId;
+  return filteredEntries(snapshot, includePrivate, owner).findIndex(
+    entry => entry.tabId === tabId
+  );
+}
+
+function insertionIndex(fullEntries, visibleEntries, requestedIndex) {
+  if (!Number.isSafeInteger(requestedIndex) || requestedIndex < -1) {
+    throw new TypeError("Invalid extension tab insertion index");
+  }
+  const visibleIndex =
+    requestedIndex === -1
+      ? visibleEntries.length
+      : Math.min(requestedIndex, visibleEntries.length);
+  if (visibleIndex < visibleEntries.length) {
+    return fullEntries.indexOf(visibleEntries[visibleIndex]);
+  }
+  if (visibleEntries.length) {
+    return fullEntries.indexOf(visibleEntries[visibleEntries.length - 1]) + 1;
+  }
+  return fullEntries.length;
+}
+
+function isDirectWindow(window) {
+  return (
+    window?.document?.documentElement?.getAttribute("windowtype") ===
+      DIRECT_WINDOW_TYPE && !
+    window.tab?.isPopup
+  );
+}
+
+/**
+ * Process-wide product tab registry for the direct Android Runtime.
+ *
+ * Gecko chrome windows remain private render hosts. They are deliberately not
+ * the WebExtensions windows model: the product publishes one stable window ID
+ * and its insertion-ordered Session list here.
+ */
+export const NavisAndroidExtensionTabTopology = Object.freeze({
+  whenReady() {
+    return current.revision > 0 ? Promise.resolve() : ready;
+  },
+
+  get ready() {
+    return current.revision > 0;
+  },
+
+  get revision() {
+    return current.revision;
+  },
+
+  get windowId() {
+    return current.windowId;
+  },
+
+  get activeTabId() {
+    return current.activeTabId;
+  },
+
+  get focusedWindowId() { return current.focusedWindowId; },
+  get lastFocusedWindowId() { return current.lastFocusedWindowId; },
+  lastFocusedWindow(includePrivate = true) {
+    return current.focusOrder.map(id => windowById(current, id)).find(window =>
+      window && (includePrivate || !window.privateMode)) || null;
+  },
+  window(windowId) { return windowById(current, windowId); },
+  windows(includePrivate = true) {
+    return current.windows.filter(window => includePrivate || !window.privateMode);
+  },
