+
+#ifndef NavisBoundedInputStream_h_
+#define NavisBoundedInputStream_h_
+
+#include "nsIInputStream.h"
+#include "nsINavisBoundedInputStream.h"
+#include "nsCOMPtr.h"
+
+class NavisBoundedInputStream final : public nsINavisBoundedInputStream {
+ public:
+  NS_DECL_ISUPPORTS
+  NS_DECL_NSIINPUTSTREAM
+  NS_DECL_NSINAVISBOUNDEDINPUTSTREAM
+
+  uint64_t MaximumBytes() const { return mMaximumBytes; }
+  uint64_t BytesRead() const { return mBytesRead; }
+  void AddBytesRead(uint64_t aBytes) { mBytesRead += aBytes; }
+
+ private:
+  ~NavisBoundedInputStream() = default;
+
+  nsresult CheckLimit();
+
+  nsCOMPtr<nsIInputStream> mSource;
+  uint64_t mMaximumBytes{0};
+  uint64_t mBytesRead{0};
+  bool mClosed{false};
+};
+
+#endif  // NavisBoundedInputStream_h_
