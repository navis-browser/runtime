+  if (options?.buttons?.length) {
+    throw new ExtensionError(
+      "notifications.buttons is unavailable in Navis direct Android runtime"
+    );
+  }
+  if (options?.type && options.type !== "basic") {
+    throw new ExtensionError(
+      "Only basic notifications are supported in Navis direct Android runtime"
+    );
+  }
