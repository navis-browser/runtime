+  public static final class Inventory {
+    public final long revision;
+    public final boolean developerModeEnabled;
+    public final boolean processSpawningDisabled;
+    public final List<ExtensionRecord> extensions;
+
+    private Inventory(final GeckoBundle value) {
+      revision = value.getLong("revision", -1);
+      developerModeEnabled = value.getBoolean("developerModeEnabled", false);
+      processSpawningDisabled = value.getBoolean("processSpawningDisabled", false);
+      if (revision < 0) {
+        throw new IllegalArgumentException("Invalid extension inventory revision");
+      }
+      final GeckoBundle[] records = value.getBundleArray("extensions");
+      if (records == null || records.length > MAX_EXTENSIONS) {
+        throw new IllegalArgumentException("Invalid extension inventory size");
+      }
+      final ArrayList<ExtensionRecord> parsed = new ArrayList<>(records.length);
+      final java.util.HashSet<String> ids = new java.util.HashSet<>();
+      for (final GeckoBundle record : records) {
+        if (record == null) {
+          throw new IllegalArgumentException("Null extension inventory record");
+        }
+        final ExtensionRecord extension = new ExtensionRecord(record);
+        if (!ids.add(extension.id)) {
+          throw new IllegalArgumentException("Duplicate extension ID in inventory");
+        }
+        if (!developerModeEnabled && extension.source == Source.TEMPORARY) {
+          throw new IllegalArgumentException("Temporary extension escaped developer mode");
+        }
+        parsed.add(extension);
+      }
+      extensions = Collections.unmodifiableList(parsed);
+    }
+  }
