+  /** Immutable process-wide topology; engine chrome hosts are not product windows. */
+  public static final class TabTopology {
+    public final long revision;
+    public final long windowId;
+    public final Long activeTabId;
+    public final List<TabTopologyEntry> tabs;
+    public final List<TabTopologyEvent> events;
+    public final List<WindowTopologyEntry> windows;
+    public final Long focusedWindowId;
+    public final Long lastFocusedWindowId;
+    public final long[] focusOrder;
+
+    public TabTopology(
+        final long revision,
+        final long windowId,
+        final Long activeTabId,
+        final List<TabTopologyEntry> tabs,
+        final List<TabTopologyEvent> events) {
+      this(revision, windowId, activeTabId, tabs, events,
+          Collections.singletonList(new WindowTopologyEntry(windowId, activeTabId, false, false, 0, 0, 0, 0)), null, null);
+    }
+
+    public TabTopology(final long revision, final long windowId, final Long activeTabId,
+        final List<TabTopologyEntry> tabs, final List<TabTopologyEvent> events,
+        final List<WindowTopologyEntry> windows, final Long focusedWindowId, final Long lastFocusedWindowId) {
+      this(revision, windowId, activeTabId, tabs, events, windows, focusedWindowId, lastFocusedWindowId,
+          lastFocusedWindowId == null ? new long[0] : new long[] {lastFocusedWindowId});
+    }
+
+    public TabTopology(final long revision, final long windowId, final Long activeTabId,
+        final List<TabTopologyEntry> tabs, final List<TabTopologyEvent> events,
+        final List<WindowTopologyEntry> windows, final Long focusedWindowId, final Long lastFocusedWindowId,
+        final long[] focusOrder) {
+      if (revision <= 0 || windowId < 0 || windows == null || windows.size() > 64 || tabs == null || events == null || tabs.size() > 2048
+          || events.size() > 4096) {
+        throw new IllegalArgumentException("Invalid extension tab topology");
+      }
+      final LinkedHashMap<Long, WindowTopologyEntry> owners = new LinkedHashMap<>();
+      Long focused = null;
+      for (final WindowTopologyEntry window : windows) {
+        if (window == null || owners.put(window.windowId, window) != null || (window.focused && focused != null)) {
+          throw new IllegalArgumentException("Invalid extension window topology");
+        }
+        if (window.focused) focused = window.windowId;
+      }
+      if (!java.util.Objects.equals(focused, focusedWindowId)
+          || (lastFocusedWindowId != null && !owners.containsKey(lastFocusedWindowId))
+          || (windowId != 0 && !owners.containsKey(windowId)) || (windowId == 0 && !owners.isEmpty())) {
+        throw new IllegalArgumentException("Invalid Android focused window");
+      }
+      final LinkedHashMap<Long, TabTopologyEntry> unique = new LinkedHashMap<>();
+      final LinkedHashMap<Long, Integer> indexes = new LinkedHashMap<>();
+      for (int index = 0; index < tabs.size(); index++) {
+        final TabTopologyEntry entry = tabs.get(index);
+        final long owner = entry == null ? 0 : (entry.windowId == 0 ? windowId : entry.windowId);
+        final int expected = indexes.containsKey(owner) ? indexes.get(owner) : 0;
+        if (entry == null || !owners.containsKey(owner) || entry.index != expected || unique.put(entry.tabId, entry) != null) {
+          throw new IllegalArgumentException("Invalid extension tab topology order");
+        }
+        indexes.put(owner, expected + 1);
+      }
+      for (final WindowTopologyEntry window : windows) {
+        final TabTopologyEntry selected = window.activeTabId == null ? null : unique.get(window.activeTabId);
+        if (window.activeTabId != null && (selected == null ||
+            (selected.windowId == 0 ? windowId : selected.windowId) != window.windowId)) {
+          throw new IllegalArgumentException("Selected tab belongs to another Android window");
+        }
+      }
+      if (activeTabId != null && !unique.containsKey(activeTabId)) {
+        throw new IllegalArgumentException("Active extension tab is outside the product window");
+      }
+      for (final TabTopologyEvent event : events) {
+        if (event == null) {
+          throw new IllegalArgumentException("Invalid extension tab topology event");
+        }
