+  public static final class Icon {
+    public final Map<Integer, String> sources;
+
+    private Icon(final GeckoBundle value) {
+      if (value == null || value.keys().length > MAX_ICON_SOURCES) {
+        throw new IllegalArgumentException("Invalid extension icon source count");
+      }
+      final LinkedHashMap<Integer, String> parsed = new LinkedHashMap<>();
+      int totalLength = 0;
+      for (final String key : value.keys()) {
+        final int size;
+        try {
+          size = Integer.parseInt(key);
+        } catch (final NumberFormatException error) {
+          throw new IllegalArgumentException("Invalid extension icon size", error);
+        }
+        final String source = value.getString(key, "");
+        totalLength += source.length();
+        if (
+            size < 1
+                || size > 1024
+                || source.isEmpty()
+                || source.length() > MAX_ICON_URI_LENGTH
+                || totalLength > MAX_ICON_TOTAL_LENGTH
+                || !isAllowedIconUri(source)) {
+          throw new IllegalArgumentException("Invalid extension icon source");
+        }
+        parsed.put(size, source);
+      }
+      sources = Collections.unmodifiableMap(parsed);
+    }
+
+    private static Icon optional(final GeckoBundle parent, final String key) {
+      if (!parent.containsKey(key)) {
+        return null;
+      }
+      final Icon icon = new Icon(parent.getBundle(key));
+      return icon.sources.isEmpty() ? null : icon;
+    }
+  }
