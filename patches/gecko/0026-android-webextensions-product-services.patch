diff --git a/mobile/shared/components/extensions/ext-bookmarks.js b/mobile/shared/components/extensions/ext-bookmarks.js
new file mode 100644
index 0000000000000000000000000000000000000000..4aded9bdbb5d43bf77435bbc48423ed1abdcf595
--- /dev/null
+++ b/mobile/shared/components/extensions/ext-bookmarks.js
@@ -0,0 +1,43 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+"use strict";
+{
+  const { NavisAndroidExtensionProfile: profile } = ChromeUtils.importESModule(
+    "resource://gre/modules/NavisAndroidExtensionProfile.sys.mjs");
+  this.bookmarks = class extends ExtensionAPIPersistent {
+    PERSISTENT_EVENTS = Object.fromEntries(["onCreated", "onChanged", "onMoved", "onRemoved"].map(
+      event => [event, ({ fire }) => profile.register(this.extension, event, fire)]));
+    getAPI(context) {
+      const call = (operation, args) => profile.request(this.extension, context, `bookmarks:${operation}`, args);
+      const list = () => call("list");
+      const requireNode = (entries, id) => {
+        if (id === "root") return profile.root();
+        const node = entries.find(entry => entry.id === id);
+        if (!node) throw new ExtensionUtils.ExtensionError("Bookmark does not exist");
+        return node;
+      };
+      return { bookmarks: {
+        ...Object.fromEntries(Object.keys(this.PERSISTENT_EVENTS).map(event => [event,
+          new EventManager({ context, module: "bookmarks", event, extensionApi: this }).api()])),
+        async get(ids) { const entries = await list(); return (Array.isArray(ids) ? ids : [ids]).map(id => requireNode(entries, id)); },
+        async getChildren(id) { const entries = await list(); requireNode(entries, id); return entries.filter(node => node.parentId === id).sort((a, b) => a.index - b.index); },
+        async getTree() { return [profile.tree(await list())]; },
+        async getSubTree(id) { return [profile.tree(await list(), id)]; },
+        async getRecent(count) { return (await list()).filter(node => node.type === "bookmark").sort((a, b) => b.dateAdded - a.dateAdded).slice(0, count); },
+        async search(query) {
+          const options = typeof query === "string" ? { query } : query;
+          const needle = (options.query || "").toLocaleLowerCase();
+          return (await list()).filter(node => (options.url === undefined || node.url === options.url) &&
+            (options.title === undefined || node.title === options.title) &&
+            (!needle || node.title.toLocaleLowerCase().includes(needle) || node.url?.toLocaleLowerCase().includes(needle)));
+        },
+        create(details) { return call("create", details); },
+        update(id, details) { return call("update", { ...details, id }); },
+        move(id, details) { return call("move", { ...details, id }); },
+        async remove(id) { await call("remove", { id }); },
+        async removeTree(id) { await call("removeTree", { id }); },
+      } };
+    }
+  };
+}
