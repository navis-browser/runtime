+      this.notificationsMap.on("closed", listener);
+      return { unregister: () => this.notificationsMap.off("closed", listener), convert(_fire) { fire = _fire; } };
+    },
+    onClicked({ fire }) {
+      const listener = (event, id) => fire.async(id);
+      this.notificationsMap.on("clicked", listener);
+      return { unregister: () => this.notificationsMap.off("clicked", listener), convert(_fire) { fire = _fire; } };
+    },
+    onShown({ fire }) {
+      const listener = (event, id) => fire.async(id);
+      this.notificationsMap.on("shown", listener);
+      return { unregister: () => this.notificationsMap.off("shown", listener), convert(_fire) { fire = _fire; } };
+    },
+  };
