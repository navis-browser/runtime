+// Install Gecko's startup observers before our first readiness notification.
+// A lazy import after notifyObservers would permanently lose that signal.
+ChromeUtils.importESModule("resource://gre/modules/ExtensionParent.sys.mjs");
+const { NavisAndroidExtensionTabTopology: topology } = ChromeUtils.importESModule(
+  "resource://gre/modules/NavisAndroidExtensionTabTopology.sys.mjs"
+);
+
+const chromeReady = new WeakSet();
+let completion;
+let chromeNotified = false;
+let extensionsNotified = false;
+
+function assertReady(window) {
+  if (!window || window.closed || !chromeReady.has(window) ||
+      !topology.isDirectWindow(window) || !window.browser?.isConnected ||
+      topology.nativeTab(window.tab?.id) !== window.tab || !topology.revision ||
+      !topology.activeNativeTab() || topology.entries().some(entry => {
+        const host = topology.nativeTab(entry.tabId)?.browser?.documentGlobal;
+        return !host || host.closed || !chromeReady.has(host);
+      })) {
+    throw new Error("Navis product hosts and tab topology are not ready");
+  }
+}
+
+function nextMainThreadTask(action) {
+  return new Promise((resolve, reject) => {
+    Services.tm.dispatchToMainThread(() => {
+      try {
+        action();
+        resolve();
+      } catch (error) {
+        reject(error);
+      }
+    });
+  });
+}
+
+/** Process startup belongs to Navis, not GeckoView's ModuleManager lifecycle. */
+export const NavisAndroidStartup = {
+  markChromeReady(window) {
+    if (topology.isDirectWindow(window) && window.browser?.isConnected) {
+      chromeReady.add(window);
+    }
+  },
+
+  // Called only after product:initialize succeeds. Runtime publishes all initial
+  // native hosts + product topology before this query, then initializes its
+  // extension inventory afterwards. Do not wait for that inventory here: primed
+  // backgrounds/network listeners themselves depend on these notifications.
+  completeProductInitialization(window) {
+    assertReady(window);
+    if (completion) return completion;
+    completion = (async () => {
+      await nextMainThreadTask(() => {
+        assertReady(window);
+        if (!chromeNotified) {
+          chromeNotified = true;
+          // This is chrome initialization readiness, as in Gecko's Android
+          // embedder, not an actual surface-paint assertion. Native newtab has
+          // no Gecko display; waiting for one would deadlock initial requests.
+          Services.obs.notifyObservers(window, "browser-delayed-startup-finished");
+        }
+      });
+      await nextMainThreadTask(() => {
+        assertReady(window);
+        if (!extensionsNotified) {
+          extensionsNotified = true;
+          Services.obs.notifyObservers(window, "extensions-late-startup");
+        }
+      });
+    })().catch(error => {
+      completion = null;
+      throw error;
+    });
+    return completion;
+  },
+};
