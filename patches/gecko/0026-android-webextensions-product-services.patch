+++ b/mobile/shared/modules/navis/NavisAndroidCommandRegistry.sys.mjs
@@ -0,0 +1,163 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+const MAX_COMMANDS = 256;
+const MAX_NAME = 128;
+const { PrivateBrowsingUtils } = ChromeUtils.importESModule(
+  "resource://gre/modules/PrivateBrowsingUtils.sys.mjs"
+);
+
+// Extension command definitions are global, but native ownership is per
+// Navis host. A second window/session must never replace the first peer.
+const commandsByExtension = new Map();
+const hosts = new Map();
+
+function normalized(shortcut) {
+  return typeof shortcut === "string" ? shortcut.replace(/\s+/g, "") : "";
+}
+
+function privateState(tab) {
+  const browser = tab?.linkedBrowser;
+  if (!browser) return null;
+  try {
+    return PrivateBrowsingUtils.isBrowserPrivate(browser);
+  } catch (error) {
+    return null;
+  }
+}
+
+function hostTab(host) {
+  try {
+    return host?.getTab?.() || null;
+  } catch (error) {
+    return null;
+  }
+}
+
+function usableForHost(extension, tab) {
+  if (!extension?.isActive || extension.hasShutdown) return false;
+  const privateMode = privateState(tab);
+  if (privateMode === null) return false;
+  return !privateMode || Boolean(extension.privateBrowsingAllowed);
+}
+
+function ownershipFor(host) {
+  const tab = hostTab(host);
+  if (!tab?.getActive?.() || privateState(tab) === null) return [];
+
+  const counts = new Map();
+  for (const entries of commandsByExtension.values()) {
+    for (const [shortcut, command] of entries) {
+      if (!usableForHost(command.extension, tab)) continue;
+      counts.set(shortcut, (counts.get(shortcut) || 0) + 1);
+    }
+  }
+  return Object.freeze([...counts]
+    .filter(([, count]) => count === 1)
+    .map(([shortcut]) => shortcut));
+}
+
+function publishHost(hostKey) {
+  const host = hosts.get(hostKey);
+  if (!host?.publish) return;
+  try {
+    host.publish(ownershipFor(host));
+  } catch (error) {
+    // A dead Android peer must not prevent other sessions from publishing.
+  }
+}
+
+function publishAll() {
+  for (const hostKey of hosts.keys()) publishHost(hostKey);
+}
+
+const NavisAndroidCommandRegistry = {
+  registerHost(hostKey, { publish, getTab, invokeAction } = {}) {
+    if (hostKey === null || hostKey === undefined ||
+        typeof publish !== "function" || typeof getTab !== "function") {
+      return false;
+    }
+    hosts.set(hostKey, {
+      publish,
+      getTab,
+      invokeAction: typeof invokeAction === "function" ? invokeAction : null,
+    });
+    publishHost(hostKey);
+    return true;
+  },
+
+  unregisterHost(hostKey) {
+    hosts.delete(hostKey);
+  },
+
+  refreshHost(hostKey) {
+    publishHost(hostKey);
+  },
+
+  async registerExtension(extension, shortcuts) {
+    const commands = await shortcuts.allCommands();
+    if (!Array.isArray(commands) || commands.length > MAX_COMMANDS) return;
+    const entries = new Map();
+    for (const command of commands) {
+      const name = typeof command?.name === "string" ? command.name : "";
+      const shortcut = normalized(command?.shortcut);
+      if (name && name.length <= MAX_NAME && shortcut) {
+        entries.set(shortcut, { extension, name });
+      }
+    }
+    commandsByExtension.set(extension, entries);
+    publishAll();
+  },
+
+  updateExtension(extension, commands) {
+    const entries = new Map();
+    for (const [name, command] of commands || []) {
+      const shortcut = normalized(command?.shortcut);
+      if (typeof name === "string" && name.length <= MAX_NAME && shortcut) {
+        entries.set(shortcut, { extension, name });
+      }
+    }
+    commandsByExtension.set(extension, entries);
+    publishAll();
+  },
+
+  unregisterExtension(extension) {
+    commandsByExtension.delete(extension);
+    publishAll();
+  },
+
+  async handleShortcut(shortcut, tab, hostKey) {
+    const host = hosts.get(hostKey);
+    const key = normalized(shortcut);
+    const currentTab = hostTab(host);
+    // Do not dispatch a key from a stale/other tab or an inactive surface.
+    if (!host || !key || !tab || currentTab !== tab || !tab.getActive?.() ||
+        privateState(tab) === null) return false;
+
+    const matches = [];
+    for (const entries of commandsByExtension.values()) {
+      const command = entries.get(key);
+      if (command && usableForHost(command.extension, tab)) {
+        matches.push(command);
+      }
+    }
+    // Conflicts are deliberately not guessed: native shortcut ownership must
+    // be unambiguous and fail closed.
+    if (matches.length !== 1) return false;
+    const { extension, name } = matches[0];
+    const privateMode = privateState(tab);
+    if (name === "_execute_action" || name === "_execute_browser_action" ||
+        name === "_execute_page_action") {
+      return Boolean(await host.invokeAction?.(
+        extension.id, tab.id, privateMode, name));
+    }
+    if (name === "_execute_sidebar_action") return false;
+    extension.emit("command", name);
+    return true;
+  },
+};
+
+export { NavisAndroidCommandRegistry };
