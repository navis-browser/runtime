diff --git a/mobile/shared/components/extensions/ext-find.js b/mobile/shared/components/extensions/ext-find.js
new file mode 100644
index 0000000000000000000000000000000000000000..bffc15fa191e66dcce8b399ee1463b348866c7c0
--- /dev/null
+++ b/mobile/shared/components/extensions/ext-find.js
@@ -0,0 +1,70 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+"use strict";
+
+// Keep Gecko's frame traversal, range/rect calculation and highlighting intact.
+Services.scriptloader.loadSubScript("chrome://geckoview/content/ext-find-gecko.js", this);
+
+{
+  const GeckoFind = this.find;
+  const { ExtensionError } = ExtensionUtils;
+  const queues = new WeakMap();
+
+  function capture(context, tabId) {
+    const tab = tabId == null ? tabTracker.activeTab : tabTracker.getTab(tabId);
+    const browser = tab?.linkedBrowser;
+    const global = browser?.browsingContext?.currentWindowGlobal;
+    function check() {
+      if (context.unloaded || context.extension.hasShutdown ||
+          !context.extension.hasPermission("find") || !tab || !browser || !global ||
+          (context.incognito && !context.privateBrowsingAllowed) ||
+          tabTracker.getTab(tab.id, null) !== tab ||
+          !context.extension.tabManager.canAccessTab(tab) ||
+          browser.navisNativePresentation !== false ||
+          browser.browsingContext?.currentWindowGlobal !== global) {
+        throw new ExtensionError("The find target is not an accessible web document");
+      }
+    }
+    check();
+    return { browser, tabId: tab.id, check };
+  }
+
+  // Gecko caches result ranges per top-level actor. Serialize calls on the same
+  // browser so a late old-document result cannot overwrite a newer search cache.
+  function enqueue(target, operation) {
+    const previous = queues.get(target.browser) || Promise.resolve();
+    const next = previous.catch(() => {}).then(async () => {
+      target.check();
+      const result = await operation();
+      target.check();
+      return result;
+    });
+    queues.set(target.browser, next);
+    const release = () => {
+      if (queues.get(target.browser) === next) queues.delete(target.browser);
+    };
+    next.then(release, release);
+    return next;
+  }
+
+  this.find = class extends GeckoFind {
+    getAPI(context) {
+      const upstream = super.getAPI(context).find;
+      return { find: {
+        async find(queryphrase, params = {}) {
+          const target = capture(context, params?.tabId);
+          return enqueue(target, () => upstream.find(queryphrase, { ...params, tabId: target.tabId }));
+        },
+        async highlightResults(params = {}) {
+          const target = capture(context, params?.tabId);
+          return enqueue(target, () => upstream.highlightResults({ ...params, tabId: target.tabId }));
+        },
+        async removeHighlighting(tabId) {
+          const target = capture(context, tabId);
+          return enqueue(target, () => upstream.removeHighlighting(target.tabId));
+        },
+      } };
+    }
+  };
+}
diff --git a/mobile/shared/components/extensions/ext-history.js b/mobile/shared/components/extensions/ext-history.js
new file mode 100644
index 0000000000000000000000000000000000000000..dfe6827e5920300c614c58b44b81b239ddbf2c8b
