+    final GeckoBundle request = new GeckoBundle(1);
+    request.putLong("tabId", previousTabId);
+    return queryBundle(COMMAND_ACTIVE_TAB_CHANGED, request).thenApply(ignored -> null);
+  }
+
+  public CompletionStage<Void> notifyTabClosed(final long tabId) {
+    if (tabId <= 0) {
+      return failedFuture(new IllegalArgumentException("Invalid closed extension tab ID"));
+    }
+    final GeckoBundle request = new GeckoBundle(1);
+    request.putLong("tabId", tabId);
+    return queryBundle(COMMAND_TAB_CLOSED, request).thenApply(ignored -> null);
+  }
+
+  /** Publishes the product's ordered Session model before exposing its lifecycle events. */
+  public CompletionStage<Void> updateTabTopology(final TabTopology topology) {
+    if (topology == null) {
+      return failedFuture(new NullPointerException("topology"));
+    }
+    try {
+      ensureOpen();
+      return queryBundle(COMMAND_UPDATE_TAB_TOPOLOGY, topology.toBundle())
+          .thenApply(ignored -> null);
+    } catch (final Throwable error) {
+      return failedFuture(error);
+    }
+  }
+
+  /** Completes only after debugger ingress and temporary-extension policy have committed. */
+  public CompletionStage<Inventory> setDeveloperMode(final boolean enabled) {
+    final GeckoBundle request = new GeckoBundle(1);
+    request.putBoolean("enabled", enabled);
+    return inventoryQuery(COMMAND_SET_DEVELOPER_MODE, request);
+  }
+
+  @Override
+  public void close() {
+    ThreadUtils.assertOnUiThread();
+    final CompletableFuture<GeckoBundle> shutdown;
+    synchronized (NavisAndroidExtensions.class) {
+      if (mClosed) {
+        return;
+      }
+      shutdown = queryBundle(COMMAND_SHUTDOWN, null);
+      mClosed = true;
+      if (sInstance == this) {
+        sInstance = null;
+      }
+    }
+    for (final CompletableFuture<GeckoBundle> pending :
+        new ArrayList<>(mPendingQueries)) {
+      if (pending != shutdown) {
+        pending.completeExceptionally(new IllegalStateException("Extension peer is closed"));
+      }
+    }
+    for (final PendingEvent pending : new ArrayList<>(mPendingEvents)) {
+      pending.fail(new IllegalStateException("Extension peer is closed"));
+    }
+    for (final CompletableFuture<InstallPreview> pending :
+        new ArrayList<>(mPendingInstallPreviews)) {
+      pending.completeExceptionally(new IllegalStateException("Extension peer is closed"));
+    }
+    final List<InputStream> ownedStreams = new ArrayList<>(mOwnedStagingStreams);
+    mOwnedStagingStreams.clear();
+    for (final InputStream source : ownedStreams) {
+      closeQuietly(source);
+    }
+    // queryBundle dispatches synchronously while close is on the UI thread. The shutdown command
+    // is therefore handed to Gecko before this named dispatcher is retired; waiting for its reply
+    // would let a newly installed Runtime reuse and then lose the old dispatcher.
+    shutdown.complete(null);
+    mDispatcher.unregisterUiThreadListener(
+        mEventListener,
+        EVENT_STATE_CHANGED,
+        EVENT_PROCESS_SPAWNING_DISABLED,
+        EVENT_POPUP_REQUESTED,
+        EVENT_TAB_COMMAND,
+        EVENT_WINDOW_COMMAND,
+        EVENT_OPTIONAL_PERMISSION_REQUESTED);
+    mDispatcher.shutdown();
+    for (final File file : mStagedPackages.values()) {
+      deleteStagedFile(file);
+    }
+    mStagedPackages.clear();
+    mIoExecutor.shutdownNow();
+  }
+
+  private CompletionStage<Inventory> inventoryQuery(
+      final String command, final GeckoBundle request) {
+    try {
+      ensureOpen();
+    } catch (final Throwable error) {
+      return failedFuture(error);
+    }
+    final CompletableFuture<Inventory> result = new CompletableFuture<>();
+    queryBundle(command, request)
+        .whenComplete(
+            (response, error) -> {
+              if (error != null) {
+                result.completeExceptionally(unwrap(error));
+                return;
+              }
+              try {
+                result.complete(inventoryFromResponse(response));
+              } catch (final Throwable parseError) {
+                result.completeExceptionally(parseError);
+              }
+            });
+    return result;
+  }
+
+  private CompletableFuture<GeckoBundle> queryBundle(
+      final String command, final GeckoBundle request) {
+    final CompletableFuture<GeckoBundle> result = new CompletableFuture<>();
+    mPendingQueries.add(result);
+    final Runnable timeout =
+        () ->
+            result.completeExceptionally(
+                new IllegalStateException("Timed out waiting for extension backend: " + command));
+    result.whenComplete(
+        (ignored, error) -> {
+          mUiHandler.removeCallbacks(timeout);
+          mPendingQueries.remove(result);
+        });
+    mUiHandler.postDelayed(timeout, QUERY_TIMEOUT_MS);
+    final Runnable dispatch =
+        () -> {
+          if (mClosed) {
+            result.completeExceptionally(new IllegalStateException("Extension peer is closed"));
+            return;
+          }
+          try {
+            final GeckoResult<GeckoBundle> query = mDispatcher.queryBundle(command, request);
+            query.withHandler(mUiHandler).accept(result::complete, result::completeExceptionally);
+          } catch (final Throwable error) {
+            result.completeExceptionally(error);
+          }
+        };
+    if (Looper.myLooper() == Looper.getMainLooper()) {
+      dispatch.run();
+    } else {
+      mUiHandler.post(dispatch);
+    }
+    return result;
+  }
+
+  private void handleMessage(
+      final String event, final GeckoBundle message, final EventCallback callback) {
+    ThreadUtils.assertOnUiThread();
+    if (mClosed) {
+      if (callback != null) {
+        callback.sendError("Extension peer is closed");
+      }
+      return;
+    }
+    try {
+      if (EVENT_STATE_CHANGED.equals(event)) {
+        mDelegate.onInventoryChanged(inventoryFromResponse(message));
+      } else if (EVENT_PROCESS_SPAWNING_DISABLED.equals(event)) {
+        mDelegate.onExtensionProcessSpawningDisabled();
+      } else if (EVENT_POPUP_REQUESTED.equals(event)) {
+        mDelegate.onPopupRequested(new Popup(requiredBundle(message, "popup")));
+      } else if (EVENT_TAB_COMMAND.equals(event)) {
+        if (callback == null) {
+          throw new IllegalArgumentException("Extension tab command requires a response");
+        }
+        final TabCommand command = new TabCommand(message);
+        final PendingEvent pending = new PendingEvent(callback);
+        mPendingEvents.add(pending);
+        try {
+          final CompletionStage<TabResult> operation = mDelegate.onTabCommand(command);
+          if (operation == null) {
+            throw new IllegalStateException("Extension tab command returned no stage");
+          }
+          operation.whenComplete(
+              (result, error) ->
+                  mUiHandler.post(
+                      () -> {
+                        if (error == null && result != null) {
+                          pending.succeed(result.toBundle());
+                        } else {
+                          final Throwable cause =
+                              error == null
+                                  ? new IllegalStateException(
+                                      "Extension tab command returned no result")
+                                  : unwrap(error);
+                          pending.fail(cause);
+                        }
+                      }));
+        } catch (final Throwable error) {
+          pending.fail(error);
+        }
+        return;
+      } else if (EVENT_WINDOW_COMMAND.equals(event)) {
+        if (callback == null) throw new IllegalArgumentException("Window command requires a response");
+        final WindowCommand command = new WindowCommand(message);
+        final PendingEvent pending = new PendingEvent(callback);
+        mPendingEvents.add(pending);
+        try {
+          final CompletionStage<WindowResult> operation = mDelegate.onWindowCommand(command);
+          if (operation == null) throw new IllegalStateException("Window command returned no stage");
+          operation.whenComplete((result, error) -> mUiHandler.post(() -> {
+            if (error == null && result != null) pending.succeed(result.toBundle());
+            else pending.fail(error == null ? new IllegalStateException("Window command returned no result") : unwrap(error));
+          }));
+        } catch (final Throwable error) { pending.fail(error); }
+        return;
+      } else if (EVENT_OPTIONAL_PERMISSION_REQUESTED.equals(event)) {
+        if (callback == null) {
+          throw new IllegalArgumentException(
+              "Optional-permission request requires a response");
+        }
+        final OptionalPermissionRequest request = new OptionalPermissionRequest(message);
+        final PendingEvent pending = new PendingEvent(callback);
+        mPendingEvents.add(pending);
+        try {
+          final CompletionStage<Boolean> operation =
+              mDelegate.onOptionalPermissionRequested(request);
+          if (operation == null) {
+            throw new IllegalStateException(
+                "Optional-permission request returned no stage");
+          }
+          operation.whenComplete(
+              (allowed, error) ->
+                  mUiHandler.post(
+                      () -> {
+                        if (error == null && allowed != null) {
+                          final GeckoBundle response = new GeckoBundle(1);
+                          response.putBoolean("allow", allowed.booleanValue());
+                          pending.succeed(response);
+                        } else {
+                          final Throwable cause =
+                              error == null
+                                  ? new IllegalStateException(
+                                      "Optional-permission request returned no result")
+                                  : unwrap(error);
+                          pending.fail(cause);
+                        }
+                      }));
+        } catch (final Throwable error) {
+          pending.fail(error);
+        }
+        return;
+      } else {
+        throw new IllegalArgumentException("Unknown Navis extension event: " + event);
+      }
+      if (callback != null) {
+        callback.sendSuccess(null);
+      }
+    } catch (final Throwable error) {
+      if (callback != null) {
+        callback.sendError(error.getMessage());
+      }
+    }
+  }
+
+  private File stageOwnedStream(final InputStream source, final long declaredBytes)
+      throws IOException {
+    File part = null;
+    File complete = null;
+    try (InputStream input = source) {
+      ensurePrivateStagingRoot();
+      final String stem = UUID.randomUUID().toString().replace("-", "");
+      part = privateChild(stem + ".part");
+      complete = privateChild(stem + ".xpi");
+      long copied = 0;
+      final byte[] buffer = new byte[32 * 1024];
+      try (FileOutputStream output = new FileOutputStream(part)) {
+        while (true) {
+          if (Thread.currentThread().isInterrupted() || mClosed) {
+            throw new IOException("Extension staging was cancelled");
+          }
+          final int count = input.read(buffer);
+          if (count < 0) {
+            break;
+          }
+          if (count == 0) {
+            continue;
+          }
+          copied += count;
+          if (copied > MAX_PACKAGE_BYTES) {
+            throw new IOException("package-size:Extension package exceeds the 200 MiB limit");
+          }
+          output.write(buffer, 0, count);
+        }
+        output.flush();
+        output.getFD().sync();
+      }
+      if (copied == 0 || (declaredBytes >= 0 && copied != declaredBytes)) {
+        throw new IOException("Extension package length did not match its content provider");
+      }
+      if (!part.renameTo(complete)) {
+        throw new IOException("Could not atomically publish the staged extension package");
+      }
+      return complete;
+    } finally {
+      if (part != null && part.exists()) {
+        part.delete();
+      }
+      if (complete != null && complete.exists() && complete.length() == 0) {
+        complete.delete();
+      }
+    }
+  }
+
+  private static File resolvePrivateStagingRoot(final Context context) {
+    try {
+      final File parent = context.getNoBackupFilesDir().getCanonicalFile();
+      final File root = new File(parent, STAGING_DIRECTORY).getCanonicalFile();
+      if (!parent.equals(root.getParentFile())) {
+        throw new IllegalStateException("Extension staging escaped the application directory");
+      }
+      return root;
+    } catch (final IOException error) {
+      throw new IllegalStateException("Could not resolve private extension staging", error);
+    }
+  }
+
+  private void ensurePrivateStagingRoot() throws IOException {
+    if (!mStagingRoot.exists() && !mStagingRoot.mkdir()) {
+      throw new IOException("Could not create private extension staging directory");
+    }
+    if (!mStagingRoot.isDirectory()) {
+      throw new IOException("Private extension staging path is not a directory");
+    }
+  }
+
+  private File privateChild(final String leafName) throws IOException {
+    final File child = new File(mStagingRoot, leafName).getCanonicalFile();
+    if (!mStagingRoot.equals(child.getParentFile())) {
+      throw new IOException("Extension staging path escaped its private directory");
+    }
+    return child;
+  }
+
+  private void cleanAbandonedStagingFiles() {
+    try {
+      ensurePrivateStagingRoot();
+      final File[] files = mStagingRoot.listFiles();
+      if (files == null) {
+        return;
+      }
+      for (final File file : files) {
+        final String name = file.getName();
+        if (file.isFile()
+            && (name.matches("[0-9a-f]{32}\\.part")
+                || name.matches("[0-9a-f]{32}\\.xpi"))) {
+          deleteStagedFile(file);
+        }
+      }
+    } catch (final IOException ignored) {
+      // The first explicit staging request reports the same directory failure.
+    }
+  }
+
+  private void cancelPreparedInstall(final String token) {
+    final GeckoBundle request = new GeckoBundle(1);
+    request.putString("token", token);
+    queryBundle(COMMAND_CANCEL_LOCAL_INSTALL, request);
+  }
+
+  private void deletePreparedPackage(final String token) {
+    deleteStagedFile(mStagedPackages.remove(token));
+  }
+
+  private static void deleteStagedFile(final File file) {
+    if (file != null && file.isFile()) {
+      file.delete();
+    }
+  }
+
+  private GeckoBundle idRequest(final String id) {
+    ensureOpen();
+    if (id == null || id.isEmpty() || id.length() > 256) {
+      throw new IllegalArgumentException("Invalid extension ID");
+    }
+    final GeckoBundle request = new GeckoBundle(2);
+    request.putString("id", id);
+    return request;
+  }
+
+  private void ensureOpen() {
+    if (mClosed) {
+      throw new IllegalStateException("Extension peer is closed");
+    }
+  }
+
+  private static String validateSourceName(final String sourceName) {
+    if (sourceName == null || sourceName.isEmpty() || sourceName.length() > 256) {
+      throw new IllegalArgumentException("Invalid extension package name");
+    }
+    for (int index = 0; index < sourceName.length(); index++) {
+      if (Character.isISOControl(sourceName.charAt(index))) {
+        throw new IllegalArgumentException("Invalid extension package name");
+      }
+    }
+    final String leafName = new File(sourceName).getName();
+    if (!leafName.toLowerCase(Locale.ROOT).endsWith(".xpi")) {
+      throw new IllegalArgumentException("Only local XPI packages are accepted");
+    }
+    return leafName;
+  }
+
+  private static String validateToken(final String token) {
+    if (!isToken(token)) {
+      throw new IllegalArgumentException("Invalid extension install token");
+    }
+    return token;
+  }
+
+  private static boolean isToken(final String token) {
+    return token != null && token.matches("[0-9a-f]{32}");
+  }
+
+  private static Inventory inventoryFromResponse(final GeckoBundle response) {
+    return new Inventory(requiredBundle(response, "inventory"));
+  }
+
+  private static GeckoBundle requiredBundle(final GeckoBundle parent, final String key) {
+    if (parent == null) {
+      throw new IllegalArgumentException("Missing extension backend response");
+    }
+    final GeckoBundle value = parent.getBundle(key);
+    if (value == null) {
+      throw new IllegalArgumentException("Missing extension backend field: " + key);
+    }
+    return value;
+  }
+
+  private static String boundedRequiredString(
+      final GeckoBundle value, final String key, final int maximum) {
+    final String result = boundedString(value, key, maximum);
+    if (result.isEmpty()) {
+      throw new IllegalArgumentException("Missing extension backend field: " + key);
+    }
+    return result;
+  }
+
+  private static String boundedString(
+      final GeckoBundle value, final String key, final int maximum) {
+    if (value == null) {
+      throw new IllegalArgumentException("Missing extension backend value");
+    }
+    final String result = value.getString(key, "");
+    if (result == null || result.length() > maximum) {
+      throw new IllegalArgumentException("Invalid extension backend field: " + key);
+    }
+    return result;
+  }
+
+  private static boolean isAllowedIconUri(final String source) {
+    final String scheme = Uri.parse(source).getScheme();
+    if (scheme == null) {
+      return false;
+    }
+    switch (scheme.toLowerCase(Locale.ROOT)) {
+      case "moz-extension":
+      case "jar":
+      case "file":
+      case "resource":
+      case "chrome":
+        return true;
+      case "data":
+        return source.startsWith("data:image/");
+      default:
+        return false;
+    }
+  }
+
+  private static List<String> boundedStrings(final GeckoBundle value, final String key) {
+    final String[] strings = value.getStringArray(key);
+    if (strings == null || strings.length > MAX_PERMISSION_COUNT) {
+      throw new IllegalArgumentException("Invalid extension backend list: " + key);
+    }
+    final ArrayList<String> result = new ArrayList<>(strings.length);
+    for (final String item : strings) {
+      if (item == null || item.isEmpty() || item.length() > MAX_PERMISSION_LENGTH) {
+        throw new IllegalArgumentException("Invalid extension backend list item: " + key);
+      }
+      result.add(item);
+    }
+    return Collections.unmodifiableList(result);
+  }
+
+  private static Integer optionalInt(final GeckoBundle value, final String key) {
+    return value.containsKey(key) ? Integer.valueOf(value.getInt(key, 0)) : null;
+  }
+
+  private static <T extends Enum<T>> T parseEnum(
+      final Class<T> type, final String value) {
+    try {
+      return Enum.valueOf(type, value);
+    } catch (final IllegalArgumentException error) {
+      throw new IllegalArgumentException("Invalid extension backend enum: " + value, error);
+    }
+  }
+
+  private static Throwable unwrap(final Throwable error) {
+    final Throwable cause =
+        error instanceof java.util.concurrent.CompletionException && error.getCause() != null
+            ? error.getCause()
+            : error;
+    if (cause instanceof EventDispatcher.QueryException) {
+      final Object data = ((EventDispatcher.QueryException) cause).data;
+      if (data instanceof GeckoBundle) {
+        try {
+          final GeckoBundle value = (GeckoBundle) data;
+          final String code = boundedString(value, "code", 80);
+          final String message = boundedString(value, "message", 512);
+          if (!code.isEmpty()) {
+            return new IllegalStateException(
+                code
+                    + ":"
+                    + (message.isEmpty()
+                        ? "Extension backend rejected the request"
+                        : message),
+                cause);
+          }
+        } catch (final IllegalArgumentException ignored) {
+          // Malformed error metadata must not prevent the original failure from completing.
+        }
+      }
+    }
+    return cause;
+  }
+
+  /** Exact-once terminal callback for one engine-initiated product request. */
+  private final class PendingEvent {
+    private final EventCallback mCallback;
+    private boolean mFinished;
+
+    PendingEvent(final EventCallback callback) {
+      mCallback = callback;
+    }
+
+    void succeed(final Object value) {
+      if (finish()) {
+        mCallback.sendSuccess(value);
+      }
+    }
+
+    void fail(final Throwable error) {
+      if (!finish()) {
+        return;
+      }
+      final Throwable cause = unwrap(error);
+      final String message = cause.getMessage();
+      mCallback.sendError(
+          message == null || message.isEmpty() ? "Extension request failed" : message);
+    }
+
+    private boolean finish() {
+      if (mFinished) {
+        return false;
+      }
+      mFinished = true;
+      mPendingEvents.remove(this);
+      return true;
+    }
+  }
+
+  private static <T> CompletionStage<T> failedFuture(final Throwable error) {
+    final CompletableFuture<T> result = new CompletableFuture<>();
+    result.completeExceptionally(error);
+    return result;
+  }
+
+  private static void closeQuietly(final InputStream source) {
+    try {
+      source.close();
+    } catch (final Throwable ignored) {
+    }
+  }
+}
