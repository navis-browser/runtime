+  /**
+   * Takes ownership of {@code source} immediately and closes it on every terminal path.
+   *
+   * <p>{@code declaredBytes} may be {@code -1} when the content provider has no length. A known
+   * value above the hard limit is rejected before scheduling I/O; the byte loop enforces the same
+   * limit independently.
+   */
+  public CompletionStage<InstallPreview> prepareLocalInstall(
+      final InputStream source, final String sourceName, final long declaredBytes) {
+    if (source == null) {
+      return failedFuture(new NullPointerException("source"));
+    }
+    final String safeName;
+    try {
+      ensureOpen();
+      safeName = validateSourceName(sourceName);
+      if (declaredBytes < -1 || declaredBytes > MAX_PACKAGE_BYTES) {
+        throw new IllegalArgumentException(
+            "package-size:Extension package is outside the accepted size range");
+      }
+    } catch (final Throwable error) {
+      closeQuietly(source);
+      return failedFuture(error);
+    }
+
+    final CompletableFuture<InstallPreview> result = new CompletableFuture<>();
+    final CompletableFuture<File> staging;
+    mOwnedStagingStreams.add(source);
+    try {
+      staging =
+          CompletableFuture.supplyAsync(
+              () -> {
+                try {
+                  return stageOwnedStream(source, declaredBytes);
+                } catch (final Throwable error) {
+                  throw new java.util.concurrent.CompletionException(error);
+                } finally {
+                  mOwnedStagingStreams.remove(source);
+                }
+              },
+              mIoExecutor);
+    } catch (final Throwable error) {
+      mOwnedStagingStreams.remove(source);
+      closeQuietly(source);
+      result.completeExceptionally(error);
+      return result;
+    }
+    mPendingInstallPreviews.add(result);
+    result.whenComplete(
+        (ignored, error) -> {
+          mPendingInstallPreviews.remove(result);
+          if (result.isCancelled()) {
+            staging.cancel(true);
+            closeQuietly(source);
+          }
+        });
+    if (mClosed) {
+      result.completeExceptionally(new IllegalStateException("Extension peer is closed"));
+      closeQuietly(source);
+    }
+    staging.whenComplete(
+        (file, stagingError) -> {
+          if (stagingError != null) {
+            result.completeExceptionally(unwrap(stagingError));
+            return;
+          }
+          if (result.isCancelled() || mClosed) {
+            deleteStagedFile(file);
+            result.completeExceptionally(new IllegalStateException("Extension peer is closed"));
+            return;
+          }
+          final GeckoBundle request = new GeckoBundle(3);
+          request.putString("filePath", file.getAbsolutePath());
+          request.putString("sourceName", safeName);
+          request.putLong("packageBytes", file.length());
+          queryBundle(COMMAND_PREPARE_LOCAL_INSTALL, request)
+              .whenComplete(
+                  (response, queryError) -> {
+                    if (queryError != null) {
+                      deleteStagedFile(file);
+                      result.completeExceptionally(unwrap(queryError));
+                      return;
+                    }
+                    String token = null;
+                    try {
+                      final GeckoBundle previewValue = requiredBundle(response, "preview");
+                      final InstallPreview preview = new InstallPreview(previewValue);
+                      token = preview.token;
+                      final File replaced = mStagedPackages.putIfAbsent(token, file);
+                      if (replaced != null) {
+                        throw new IllegalStateException("Duplicate staged install token");
+                      }
+                      if (result.isCancelled()) {
+                        mStagedPackages.remove(token, file);
+                        cancelPreparedInstall(token);
+                        deleteStagedFile(file);
+                        return;
+                      }
+                      result.complete(preview);
+                    } catch (final Throwable error) {
+                      if (token != null) {
+                        cancelPreparedInstall(token);
+                      }
+                      deleteStagedFile(file);
+                      result.completeExceptionally(error);
+                    }
+                  });
+        });
+    return result;
+  }
