+    const state = JSON.stringify({ version: 1, history: data });
+    if (state.length > 1024 * 1024) throw new RangeError("Closed-tab snapshot exceeds its capture limit");
+    return { restorable: true, state, uri: uri.spec,
+      title: (context.currentWindowGlobal?.documentTitle ?? "").slice(0, 4096) };
+  },
+});
