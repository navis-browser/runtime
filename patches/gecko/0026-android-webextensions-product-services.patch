+  public CompletionStage<InstallResult> confirmLocalInstall(final String token) {
+    final String safeToken;
+    try {
+      ensureOpen();
+      safeToken = validateToken(token);
+      if (!mStagedPackages.containsKey(safeToken)) {
+        throw new IllegalArgumentException("Unknown local extension install token");
+      }
+    } catch (final Throwable error) {
+      return failedFuture(error);
+    }
+    final GeckoBundle request = new GeckoBundle(1);
+    request.putString("token", safeToken);
+    final CompletableFuture<InstallResult> result = new CompletableFuture<>();
+    queryBundle(COMMAND_CONFIRM_LOCAL_INSTALL, request)
+        .whenComplete(
+            (response, error) -> {
+              deletePreparedPackage(safeToken);
+              if (error != null) {
+                result.completeExceptionally(unwrap(error));
+                return;
+              }
+              try {
+                result.complete(new InstallResult(response));
+              } catch (final Throwable parseError) {
+                result.completeExceptionally(parseError);
+              }
+            });
+    return result;
+  }
