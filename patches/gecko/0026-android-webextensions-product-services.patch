+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+const { EventDispatcher } = ChromeUtils.importESModule("resource://gre/modules/Messaging.sys.mjs");
+const { ExtensionError } = ChromeUtils.importESModule("resource://gre/modules/ExtensionUtils.sys.mjs");
+const dispatcher = EventDispatcher.byName("navis-android-extension-profile");
+const CHANGED = "NavisAndroid:ExtensionProfile:BookmarksChanged";
+const HISTORY_CHANGED = "NavisAndroid:ExtensionProfile:HistoryChanged";
+const SESSIONS_CHANGED = "NavisAndroid:ExtensionProfile:SessionsChanged";
+const OPERATIONS = new Map([
+  ...["list", "create", "update", "move", "remove", "removeTree"].map(name => [`bookmarks:${name}`, "bookmarks"]),
+  ["topSites:list", "topSites"],
+  ...["search", "visits", "add", "deleteUrl", "deleteRange", "deleteAll"].map(name => [`history:${name}`, "history"]),
+  ...["list", "forget", "restore"].map(name => [`sessions:${name}`, "sessions"]),
+]);
+function checkAccess(extension, permission, context = null) {
+  if (!extension || extension.hasShutdown || context?.unloaded ||
+      !extension.hasPermission(permission) || (context?.incognito && !extension.privateBrowsingAllowed)) {
+    throw new ExtensionError("Extension profile access is not allowed");
+  }
+}
+function root(children) {
+  return { id: "root", title: "", type: "folder", ...(children ? { children } : {}) };
+}
+function tree(entries, id = "root") {
+  const nodes = new Map(entries.map(entry => [entry.id, { ...entry }]));
+  nodes.set("root", root());
+  for (const node of nodes.values()) if (node.type === "folder") node.children = [];
+  for (const node of entries) {
+    const parent = nodes.get(node.parentId);
+    if (!parent?.children) throw new ExtensionError("Invalid bookmark tree");
+    parent.children.push(nodes.get(node.id));
+  }
+  for (const node of nodes.values()) node.children?.sort((a, b) => a.index - b.index);
+  const selected = nodes.get(id);
+  if (!selected) throw new ExtensionError("Bookmark does not exist");
+  return selected;
+}
+/** Sibling index shifts are not explicit moves; subtree removal is one event. */
+function changes({ before, after, movedId }) {
+  const old = new Map(before.map(node => [node.id, node]));
+  const current = new Map(after.map(node => [node.id, node]));
+  const result = [];
+  for (const node of before) {
+    if (!current.has(node.id) && (node.parentId === "root" || current.has(node.parentId))) {
+      result.push(["onRemoved", node.id, { parentId: node.parentId, index: node.index, node: tree(before, node.id) }]);
+    }
+  }
+  for (const node of after) {
+    const previous = old.get(node.id);
+    if (!previous) { result.push(["onCreated", node.id, node]); continue; }
+    const changed = {};
+    if (previous.title !== node.title) changed.title = node.title;
+    if (previous.url !== node.url) changed.url = node.url;
+    if (Object.keys(changed).length) result.push(["onChanged", node.id, changed]);
+    if (previous.parentId !== node.parentId || (node.id === movedId && previous.index !== node.index)) {
+      result.push(["onMoved", node.id, { parentId: node.parentId, index: node.index,
+        oldParentId: previous.parentId, oldIndex: previous.index }]);
+    }
+  }
+  return result;
+}
+export const NavisAndroidExtensionProfile = Object.freeze({
+  root, tree, changes,
+  async request(extension, context, operation, args = {}) {
+    const permission = OPERATIONS.get(operation);
+    if (!permission) throw new ExtensionError("Unsupported extension profile operation");
+    checkAccess(extension, permission, context);
+    let response;
+    try {
+      response = await dispatcher.sendRequestForResult("NavisAndroid:ExtensionProfile:Request", {
+        extensionId: extension.id, operation, arguments: JSON.stringify(args),
+        privateMode: !!context?.incognito, privateBrowsingAllowed: !!extension.privateBrowsingAllowed,
+      });
+    } catch { throw new ExtensionError("Extension profile operation failed"); }
+    // Drop data after revoke/uninstall or context destruction, even if the database operation completed.
+    checkAccess(extension, permission, context);
+    return JSON.parse(response);
+  },
+  register(extension, event, fire) {
+    checkAccess(extension, "bookmarks");
+    const listener = { onEvent(_name, data) {
+      try { checkAccess(extension, "bookmarks"); } catch { return; }
+      for (const [name, ...args] of changes(JSON.parse(data.json))) if (name === event) fire.async(...args);
+    } };
+    dispatcher.registerListener(listener, [CHANGED]);
+    return {
+      unregister() { dispatcher.unregisterListener(listener, [CHANGED]); },
+      convert(newFire) { fire = newFire; },
+    };
+  },
+  registerHistory(extension, event, fire) {
+    checkAccess(extension, "history");
+    const listener = { onEvent(_name, data) {
+      try { checkAccess(extension, "history"); } catch { return; }
+      const message = JSON.parse(data.json);
+      if (message.event === event) fire.async(message.detail);
+    } };
+    dispatcher.registerListener(listener, [HISTORY_CHANGED]);
+    return {
+      unregister() { dispatcher.unregisterListener(listener, [HISTORY_CHANGED]); },
+      convert(newFire) { fire = newFire; },
+    };
+  },
+  registerSessions(extension, fire) {
+    checkAccess(extension, "sessions");
+    const listener = { onEvent() {
+      try { checkAccess(extension, "sessions"); } catch { return; }
+      fire.async();
+    } };
+    dispatcher.registerListener(listener, [SESSIONS_CHANGED]);
+    return {
+      unregister() { dispatcher.unregisterListener(listener, [SESSIONS_CHANGED]); },
+      convert(newFire) { fire = newFire; },
+    };
+  },
+});
