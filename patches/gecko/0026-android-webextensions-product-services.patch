diff --git a/mobile/android/geckoview/src/main/java/org/mozilla/gecko/navis/NavisAndroidExtensionProfile.java b/mobile/android/geckoview/src/main/java/org/mozilla/gecko/navis/NavisAndroidExtensionProfile.java
new file mode 100644
index 0000000000000000000000000000000000000000..38043d112749da39c0146a55c71e86addc449799
--- /dev/null
+++ b/mobile/android/geckoview/src/main/java/org/mozilla/gecko/navis/NavisAndroidExtensionProfile.java
@@ -0,0 +1,108 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+package org.mozilla.gecko.navis;
+
+import android.os.Handler;
+import android.os.Looper;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.Set;
+import java.util.concurrent.CompletionStage;
+import org.mozilla.gecko.EventDispatcher;
+import org.mozilla.gecko.util.BundleEventListener;
+import org.mozilla.gecko.util.EventCallback;
+import org.mozilla.gecko.util.GeckoBundle;
+import org.mozilla.gecko.util.ThreadUtils;
+
+/** Private Runtime peer, without a web-content actor or arbitrary Session lookup. */
+public final class NavisAndroidExtensionProfile implements AutoCloseable {
+  private static final String COMMAND = "NavisAndroid:ExtensionProfile:Request";
+  private static final String CHANGED = "NavisAndroid:ExtensionProfile:BookmarksChanged";
+  private static final String HISTORY_CHANGED = "NavisAndroid:ExtensionProfile:HistoryChanged";
+  private static final String SESSIONS_CHANGED = "NavisAndroid:ExtensionProfile:SessionsChanged";
+  private static final Set<String> OPERATIONS = new HashSet<>(Arrays.asList(
+      "bookmarks:list", "bookmarks:create", "bookmarks:update", "bookmarks:move",
+      "bookmarks:remove", "bookmarks:removeTree", "topSites:list",
+      "history:search", "history:visits", "history:add", "history:deleteUrl",
+      "history:deleteRange", "history:deleteAll",
+      "sessions:list", "sessions:forget", "sessions:restore"));
+  public static final class Request {
+    public final String extensionId, operation, arguments;
+    public final boolean privateMode, privateBrowsingAllowed;
+    Request(final GeckoBundle message) {
+      if (message == null) throw new IllegalArgumentException("Missing profile request");
+      extensionId = message.getString("extensionId", "");
+      operation = message.getString("operation", "");
+      arguments = message.getString("arguments", "{}");
+      privateMode = message.getBoolean("privateMode", false);
+      privateBrowsingAllowed = message.getBoolean("privateBrowsingAllowed", false);
+      if (extensionId.isEmpty() || extensionId.length() > 256 || !OPERATIONS.contains(operation)
+          || arguments.length() > 128 * 1024 || (privateMode && !privateBrowsingAllowed)) {
+        throw new IllegalArgumentException("Invalid extension profile request");
+      }
+    }
+  }
+  public interface Delegate { CompletionStage<String> request(Request request); }
+  private static NavisAndroidExtensionProfile sInstance;
+  private final EventDispatcher mDispatcher = EventDispatcher.byName("navis-android-extension-profile");
+  private final Handler mHandler = new Handler(Looper.getMainLooper());
+  private final Delegate mDelegate;
+  private final Set<EventCallback> mPending = new HashSet<>();
+  private final BundleEventListener mListener = this::onMessage;
+  private boolean mClosed;
+  private NavisAndroidExtensionProfile(final Delegate delegate) {
+    mDelegate = delegate;
+    mDispatcher.registerUiThreadListener(mListener, COMMAND);
+  }
+  public static synchronized NavisAndroidExtensionProfile install(final Delegate delegate) {
+    ThreadUtils.assertOnUiThread();
+    if (sInstance != null || delegate == null) throw new IllegalStateException("Profile peer is already installed");
+    sInstance = new NavisAndroidExtensionProfile(delegate);
+    return sInstance;
+  }
+  private void onMessage(final String event, final GeckoBundle message, final EventCallback callback) {
+    ThreadUtils.assertOnUiThread();
+    if (callback == null) return;
+    if (mClosed || !COMMAND.equals(event)) { callback.sendError("Extension profile peer is unavailable"); return; }
+    try {
+      final CompletionStage<String> stage = mDelegate.request(new Request(message));
+      if (stage == null) throw new IllegalStateException("Missing profile result");
+      mPending.add(callback);
+      stage.whenComplete((value, error) -> mHandler.post(() -> {
+        if (!mPending.remove(callback)) return;
+        if (error != null || value == null) callback.sendError("Extension profile operation failed");
+        else callback.sendSuccess(value);
+      }));
+    } catch (final RuntimeException error) { callback.sendError("Extension profile request was rejected"); }
+  }
+  public void publishBookmarkChange(final String json) {
+    ThreadUtils.assertOnUiThread();
+    if (mClosed) return;
+    final GeckoBundle data = new GeckoBundle(1);
+    data.putString("json", json);
+    mDispatcher.dispatch(CHANGED, data);
+  }
+  public void publishHistoryChange(final String json) {
+    ThreadUtils.assertOnUiThread();
+    if (mClosed) return;
+    final GeckoBundle data = new GeckoBundle(1);
+    data.putString("json", json);
+    mDispatcher.dispatch(HISTORY_CHANGED, data);
+  }
+  public void publishSessionsChange() {
+    ThreadUtils.assertOnUiThread();
+    if (!mClosed) mDispatcher.dispatch(SESSIONS_CHANGED, new GeckoBundle(0));
+  }
+  @Override public void close() {
+    ThreadUtils.assertOnUiThread();
+    if (mClosed) return;
+    mClosed = true;
+    synchronized (NavisAndroidExtensionProfile.class) { if (sInstance == this) sInstance = null; }
+    mDispatcher.unregisterUiThreadListener(mListener, COMMAND);
+    for (final EventCallback callback : new ArrayList<>(mPending)) callback.sendError("Extension profile peer is closed");
+    mPending.clear();
+    mDispatcher.shutdown();
+  }
+}
