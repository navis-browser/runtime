+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+const { SessionHistory } = ChromeUtils.importESModule(
+  "resource://gre/modules/sessionstore/SessionHistory.sys.mjs");
+const { PrivateBrowsingUtils } = ChromeUtils.importESModule(
+  "resource://gre/modules/PrivateBrowsingUtils.sys.mjs");
+
+function hasPostData(entry, budget, depth = 0) {
+  if (!entry) return false;
+  if (depth > 32 || --budget.left < 0) throw new RangeError("Session history tree exceeds its capture limit");
+  if (entry.postData) return true;
+  for (let index = 0; index < entry.childCount; index++) {
+    if (hasPostData(entry.GetChildAt(index), budget, depth + 1)) return true;
+  }
+  return false;
+}
+
+/** Only the owning Runtime can capture a closed tab; content has no access to this query. */
+export const NavisAndroidClosedTabs = Object.freeze({
+  capture(window) {
+    const browser = window.tab?.linkedBrowser;
+    if (window.closed || !browser) throw new TypeError("No live closed-tab owner");
+    const unavailable = reason => ({ restorable: false, reason });
+    if (PrivateBrowsingUtils.isBrowserPrivate(browser)) return unavailable("private");
+    if (browser.navisNativePresentation !== false) return unavailable("native");
+    const context = browser.browsingContext;
+    const uri = context?.currentURI;
+    if (!uri || (!uri.schemeIs("http") && !uri.schemeIs("https")) || uri.spec.length > 8192) {
+      return unavailable("unsupported-uri");
+    }
+    const history = context.sessionHistory;
+    if (!history || history.count < 1 || history.count > 512 || history.index < 0 || history.index >= history.count) {
+      return unavailable("missing-history");
+    }
+    // The pinned serializer does not persist POST bodies. Check all frames and
+    // history entries, not only the current page, so Back cannot replay one as GET.
+    const budget = { left: 4096 };
