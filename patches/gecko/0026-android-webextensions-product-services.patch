+NativeNotification.prototype = {
+  clear() {
+    try {
+      Cc["@mozilla.org/alerts-service;1"].getService(Ci.nsIAlertsService)
+        .closeAlert(this.nativeId);
+    } catch (error) {
+      this.observe(null, "alertfinished");
+    }
+  },
+
+  async showAlert() {
+    if (this.context.incognito) {
+      // The direct Android peer never places private notifications in the
+      // system shade, and this also completes Gecko's alert request.
+      this.observe(null, "alertfinished");
+      return;
+    }
+    try {
+      const service = Cc["@mozilla.org/alerts-service;1"]
+        .getService(Ci.nsIAlertsService);
+      let imageURL;
+      if (this.options.iconUrl) {
+        imageURL = this.context.extension.baseURI.resolve(this.options.iconUrl);
+      }
+      service.showAlert(new AlertNotification({
+        name: this.nativeId,
+        title: bounded(this.options.title),
+        text: bounded(this.options.message),
+        imageURL,
+        textClickable: this.options.isClickable !== false,
+        inPrivateBrowsing: false,
