+TEST(TestURLStripOnShare, RegistrableDomainRule)
+{
+  Preferences::SetBool(kPrefQueryStrippingOnShareEnabled, true);
+
+  nsresult rv;
+  nsCOMPtr<nsIURLQueryStringStripper> queryStripper =
+      components::URLQueryStringStripper::Service(&rv);
+  ASSERT_TRUE(NS_SUCCEEDED(rv));
+  nsCOMPtr<nsIURLQueryStrippingListObserver> listObserver =
+      do_QueryInterface(queryStripper);
+  ASSERT_TRUE(listObserver);
+
+  nsTArray<nsString> rules;
+  rules.AppendElement(
+      u"{\"domains\":[\"aliyun.com\"],\"queryParams\":[\"spm\"]}"_ns);
+  ASSERT_TRUE(NS_SUCCEEDED(listObserver->OnStripOnShareUpdate(rules, nullptr)));
+
+  nsCOMPtr<nsIURI> productURI;
+  NS_NewURI(getter_AddRefs(productURI),
+            "https://help.aliyun.com/topic?spm=tracking&kept=yes"_ns);
+  ASSERT_TRUE(productURI);
+  nsCOMPtr<nsIURI> strippedURI;
+  ASSERT_TRUE(NS_SUCCEEDED(queryStripper->StripForCopyOrShare(
+      productURI, getter_AddRefs(strippedURI))));
+  ASSERT_TRUE(strippedURI);
+  EXPECT_TRUE(strippedURI->GetSpecOrDefault().Equals(
+      "https://help.aliyun.com/topic?kept=yes"_ns));
+
+  nsCOMPtr<nsIURI> unrelatedURI;
+  NS_NewURI(getter_AddRefs(unrelatedURI),
+            "https://example.com/topic?spm=ordinary"_ns);
+  ASSERT_TRUE(unrelatedURI);
+  strippedURI = nullptr;
+  ASSERT_TRUE(NS_SUCCEEDED(queryStripper->StripForCopyOrShare(
+      unrelatedURI, getter_AddRefs(strippedURI))));
+  EXPECT_FALSE(strippedURI);
+}
+
+TEST(TestURLStripOnShare, UnifiedNavigationUsesDomainRules)
+{
+  Preferences::SetBool(kPrefQueryStrippingEnabled, true);
+  Preferences::SetBool(kPrefQueryStrippingOnShareEnabled, true);
+  Preferences::SetBool(kPrefQueryStrippingUseUnifiedRules, true);
+
+  nsresult rv;
+  nsCOMPtr<nsIURLQueryStringStripper> queryStripper =
+      components::URLQueryStringStripper::Service(&rv);
+  ASSERT_TRUE(NS_SUCCEEDED(rv));
+  nsCOMPtr<nsIURLQueryStrippingListObserver> listObserver =
+      do_QueryInterface(queryStripper);
+  ASSERT_TRUE(listObserver);
+
+  nsTArray<nsString> rules;
+  rules.AppendElement(
+      u"{\"domains\":[\"aliyun.com\"],\"queryParams\":[\"spm\"]}"_ns);
+  ASSERT_TRUE(NS_SUCCEEDED(listObserver->OnStripOnShareUpdate(rules, nullptr)));
+
+  nsCOMPtr<nsIURI> inputURI;
+  NS_NewURI(getter_AddRefs(inputURI),
+            "https://www.aliyun.com/exp/llm?spm=tracking&kept=yes"_ns);
+  ASSERT_TRUE(inputURI);
+
+  nsCOMPtr<nsIURI> navigatedURI;
+  uint32_t stripCount = 0;
+  ASSERT_TRUE(NS_SUCCEEDED(queryStripper->Strip(
+      inputURI, false, getter_AddRefs(navigatedURI), &stripCount)));
+  ASSERT_EQ(stripCount, 1U);
+  ASSERT_TRUE(navigatedURI);
+
+  nsCOMPtr<nsIURI> copiedURI;
+  ASSERT_TRUE(NS_SUCCEEDED(
+      queryStripper->StripForCopyOrShare(inputURI, getter_AddRefs(copiedURI))));
+  ASSERT_TRUE(copiedURI);
+  EXPECT_TRUE(
+      copiedURI->GetSpecOrDefault().Equals(navigatedURI->GetSpecOrDefault()));
+
+  Preferences::SetBool(kPrefQueryStrippingUseUnifiedRules, false);
+}
