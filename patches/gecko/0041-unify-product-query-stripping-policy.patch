+function normalizedStrings(values, name, { domain = false } = {}) {
+  if (!Array.isArray(values)) {
+    throw new TypeError(`${name} must be an array`);
+  }
+  let result = [];
+  for (let value of values) {
+    if (typeof value !== "string") {
+      throw new TypeError(`${name} entries must be strings`);
+    }
+    value = value.toLowerCase();
+    const valid = domain
+      ? value.length <= 253 &&
+        /^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/.test(
+          value
+        )
+      : value.length <= 128 && !/[\s&=#?]/.test(value);
+    if (!value || !valid) {
+      throw new TypeError(`Invalid ${name} entry`);
+    }
+    result.push(value);
+  }
+  return [...new Set(result)];
+}
+
+function parseProductPolicy(policy) {
+  if (
+    !policy ||
+    typeof policy !== "object" ||
+    policy.schemaVersion !== 1 ||
+    typeof policy.revision !== "string" ||
+    !policy.revision ||
+    !Array.isArray(policy.rules)
+  ) {
+    throw new TypeError("Invalid product query-stripping policy envelope");
+  }
+
+  const allowList = normalizedStrings(
+    policy.allowDomains ?? [],
+    "allowDomains",
+    { domain: true }
+  );
+  const rules = {};
+  const stripList = new Set();
+  const ids = new Set();
+
+  for (const entry of policy.rules) {
+    if (
+      !entry ||
+      typeof entry !== "object" ||
+      typeof entry.id !== "string" ||
+      !/^[a-z0-9][a-z0-9._-]{0,79}$/.test(entry.id) ||
+      ids.has(entry.id)
+    ) {
+      throw new TypeError("Invalid or duplicate product policy rule id");
+    }
+    ids.add(entry.id);
+    const queryParams = normalizedStrings(
+      entry.queryParameters,
+      `${entry.id}.queryParameters`
+    );
+    if (!queryParams.length) {
+      throw new TypeError(`${entry.id} has no query parameters`);
+    }
+
+    if (entry.scope === "global") {
+      const globalRule = (rules.global ??= {
+        isGlobal: true,
+        queryParams: [],
+        origins: [],
+        domains: [],
+      });
+      globalRule.queryParams.push(...queryParams);
+      for (const param of queryParams) {
+        stripList.add(param);
+      }
+      continue;
+    }
 
-  if (!stripOnShareList || !stripOnShareLGPLParams) {
+    if (entry.scope !== "exact-host" && entry.scope !== "registrable-domain") {
+      throw new TypeError(`${entry.id} has an unsupported scope`);
+    }
+    const domains = normalizedStrings(entry.domains, `${entry.id}.domains`, {
+      domain: true,
+    });
+    if (!domains.length) {
+      throw new TypeError(`${entry.id} has no scoped domains`);
+    }
+    rules[`product-${entry.id}`] = {
+      isGlobal: false,
+      queryParams,
+      origins: entry.scope === "exact-host" ? domains : [],
+      domains: entry.scope === "registrable-domain" ? domains : [],
+    };
+  }
+
+  return { allowList, rules, stripList: [...stripList] };
+}
+
+async function fetchProductPolicy() {
+  const policyURI = Services.prefs.getStringPref(PREF_PRODUCT_POLICY_URI, "");
+  if (!policyURI) {
+    return { allowList: [], rules: {}, stripList: [] };
+  }
+  const uri = Services.io.newURI(policyURI);
+  if (!uri.schemeIs("chrome") && !uri.schemeIs("resource")) {
+    throw new TypeError("Product query-stripping policy must be local");
+  }
+  const response = await fetch(policyURI);
+  if (!response.ok) {
+    throw new Error(
+      `Error fetching product query-stripping policy ${response.status}`
+    );
+  }
+  return parseProductPolicy(await response.json());
+}
+
+// All packaged and optional provider data is normalized into one immutable
+// runtime policy before either the navigation or copy/share consumers see it.
+ChromeUtils.defineLazyGetter(lazy, "CleanLinksPolicy", async () => {
