-        additionalList[key].origins ??= [];
-
-        mainList[key].origins.push(...additionalList[key].origins);
-      } else {
-        mainList[key] = additionalList[key];
+  const combined = {};
+  for (const list of [mainList, ...arrOfLists]) {
+    for (const [key, sourceRule] of Object.entries(list ?? {})) {
+      const rule = (combined[key] ??= {
+        isGlobal: Boolean(sourceRule.isGlobal),
+        queryParams: [],
+        origins: [],
+        domains: [],
+      });
+      if (rule.isGlobal !== Boolean(sourceRule.isGlobal)) {
+        throw new TypeError(`Conflicting query-stripping rule ${key}`);
       }
+      rule.queryParams.push(...(sourceRule.queryParams ?? []));
+      rule.origins.push(...(sourceRule.origins ?? []));
+      rule.domains.push(...(sourceRule.domains ?? []));
     }
-  });
+  }
 
-  for (let key in mainList) {
-    mainList[key].queryParams = (mainList[key].queryParams ?? []).map(param =>
+  for (let key in combined) {
+    combined[key].queryParams = combined[key].queryParams.map(param =>
       param.toLowerCase()
     );
 
     // Origins can be missing for global rules (isGlobal: true) and for any bad input.
-    mainList[key].origins = (mainList[key].origins ?? []).map(origin =>
+    combined[key].origins = combined[key].origins.map(origin =>
       origin.toLowerCase()
     );
+    combined[key].domains = combined[key].domains.map(domain =>
+      domain.toLowerCase()
+    );
 
     // Removes duplicate origins
-    mainList[key].origins = [...new Set(mainList[key].origins)];
+    combined[key].origins = [...new Set(combined[key].origins)];
+    combined[key].domains = [...new Set(combined[key].domains)];
 
     // Removes duplicate queryParams
-    mainList[key].queryParams = [...new Set(mainList[key].queryParams)];
+    combined[key].queryParams = [...new Set(combined[key].queryParams)];
   }
 
-  return mainList;
+  return combined;
 }
 
