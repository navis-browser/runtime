+// NETWORK events have one START/STOP pair per document, including redirects.
+// RemoteWebProgressRequest is reconstructed for every IPC event, so neither
+// object identity nor URL is a reliable request key. Overlapping pairs are
+// deliberately uncorrelated (generation 0), not attributed to the newest load.
+class AndroidNavigationProgress {
+  generation = 0;
+  pending = 0;
+  overlapping = false;
+  errorPage = false;
+
+  start() {
+    this.pending++;
+    this.overlapping ||= this.pending > 1;
+    this.errorPage = false;
+    return ++this.generation;
+  }
+
+  uri(request) {
+    try {
+      return request.QueryInterface(Ci.nsIChannel).URI.spec.slice(0, 65536);
+    } catch (_) {
+      return "";
+    }
+  }
+
+  location(sameDocument, errorPage) {
+    if (!sameDocument) this.errorPage = errorPage;
+    return { generation: this.generation, sameDocument, errorPage: this.errorPage };
+  }
+
+  complete(request, status) {
+    const generation = !this.pending || this.overlapping ? 0 : this.generation;
+    if (this.pending && !--this.pending) this.overlapping = false;
+    const statusKnown = Number.isInteger(status);
+    const actualStatus = statusKnown ? status | 0 : 0;
+    const cancelled = [
+      Cr.NS_BINDING_ABORTED,
+      Cr.NS_BINDING_REDIRECTED,
+      Cr.NS_BINDING_RETARGETED,
+      Cr.NS_ERROR_ABORT,
+    ].some(value => (value | 0) === actualStatus);
+    return {
+      generation,
+      status: actualStatus,
+      statusKnown,
+      cancelled,
+      errorPage: this.errorPage,
+      uri: this.uri(request),
+    };
+  }
+}
