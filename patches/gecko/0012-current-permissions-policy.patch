+    return true;
+  }
+
+  int32_t uriPort = -1;
+  if (NS_FAILED(uri->GetPort(&uriPort))) {
+    return false;
+  }
+  if (uriPort == -1) {
+    uriPort = NS_GetDefaultPort(scheme.get());
+  }
+
+  if (port.IsEmpty()) {
+    return uriPort == NS_GetDefaultPort(scheme.get());
+  }
+
+  nsresult rv = NS_OK;
+  return uriPort == port.ToInteger(&rv) && NS_SUCCEEDED(rv);
+}
