+bool AppendPermissionsPolicySource(Feature& aFeature, const nsACString& aValue,
+                                   Document* aDocument,
+                                   nsIPrincipal* aSelfOrigin) {
+  if (aValue.EqualsLiteral("*")) {
+    aFeature.SetAllowsAll();
+    return true;
+  }
+
+  if (aValue.LowerCaseEqualsLiteral("self")) {
+    aFeature.AppendToAllowList(aSelfOrigin);
+    return true;
+  }
+
+  const nsString value = NS_ConvertUTF8toUTF16(aValue);
+
+  // Scheme and wildcard-host sources cannot be represented by a principal.
+  if ((!aValue.IsEmpty() && aValue.Last() == ':' &&
+       aValue.Find("://") == kNotFound) ||
+      aValue.FindChar('*') != kNotFound) {
+    if (aFeature.AppendToAllowListExpression(value)) {
+      return true;
+    }
+    ReportToConsoleInvalidAllowValue(aDocument, value);
+    return false;
+  }
+
+  nsCOMPtr<nsIURI> uri;
+  nsresult rv = NS_NewURI(getter_AddRefs(uri), aValue);
+  if (NS_FAILED(rv)) {
+    ReportToConsoleInvalidAllowValue(aDocument, value);
+    return false;
+  }
+
+  nsCOMPtr<nsIPrincipal> origin = BasePrincipal::CreateContentPrincipal(
+      uri, BasePrincipal::Cast(aSelfOrigin)->OriginAttributesRef());
+  if (!origin) {
+    ReportToConsoleInvalidAllowValue(aDocument, value);
+    return false;
+  }
+
+  aFeature.AppendToAllowList(origin);
+  return true;
+}
+
+bool ParsePermissionsPolicyItem(const net::SFV::ItemResult& aItem,
+                                Feature& aFeature, Document* aDocument,
+                                nsIPrincipal* aSelfOrigin) {
+  nsAutoCString value;
+  if (NS_SUCCEEDED(aItem.GetValue<net::SFV::Token>(value))) {
+    return AppendPermissionsPolicySource(aFeature, value, aDocument,
+                                         aSelfOrigin);
+  }
+  if (NS_SUCCEEDED(aItem.GetValue<net::SFV::SFVString>(value))) {
+    return AppendPermissionsPolicySource(aFeature, value, aDocument,
+                                         aSelfOrigin);
+  }
+  return false;
+}
+
 }  // namespace
 
 /* static */
@@ -152,4 +212,71 @@ bool FeaturePolicyParser::ParseString(const nsAString& aPolicy,
   return true;
 }
 
+/* static */
+bool FeaturePolicyParser::ParsePermissionsPolicyHeader(
+    const nsACString& aPolicy, Document* aDocument, nsIPrincipal* aSelfOrigin,
+    nsTArray<Feature>& aParsedFeatures) {
+  MOZ_ASSERT(aSelfOrigin);
+
+  auto dictionary = net::SFV::ParseDict(aPolicy);
+  if (!dictionary.IsValid()) {
+    aParsedFeatures.Clear();
+    return false;
+  }
+
+  nsTArray<nsCString> keys;
+  if (NS_FAILED(dictionary.GetKeys(keys))) {
+    aParsedFeatures.Clear();
+    return false;
+  }
+
+  nsTArray<Feature> parsedFeatures;
+  for (const nsCString& key : keys) {
+    const nsString featureName = NS_ConvertUTF8toUTF16(key);
+    if (!FeaturePolicyUtils::IsSupportedFeature(featureName)) {
+      ReportToConsoleUnsupportedFeature(aDocument, featureName);
+      continue;
+    }
+
+    Feature feature(featureName);
+    nsAutoCString value;
+    bool validMember = false;
+
+    if (NS_SUCCEEDED(dictionary.GetItem<net::SFV::Token>(key, value)) ||
+        NS_SUCCEEDED(dictionary.GetItem<net::SFV::SFVString>(key, value))) {
+      validMember =
+          AppendPermissionsPolicySource(feature, value, aDocument, aSelfOrigin);
+    } else {
+      auto innerList = dictionary.GetInnerList(key);
+      if (innerList.IsValid()) {
+        validMember = true;
+        if (innerList.Length() == 0) {
+          feature.SetAllowsNone();
+        } else {
+          for (size_t index = 0; index < innerList.Length(); ++index) {
+            auto item = innerList.GetItemAt(index);
+            if (!item.IsValid()) {
+              continue;
+            }
+            ParsePermissionsPolicyItem(item, feature, aDocument, aSelfOrigin);
+            if (feature.AllowsAll()) {
+              break;
+            }
+          }
+        }
+      }
+    }
+
+    // Unsupported member types and invalid direct values are ignored. An
+    // inner list whose individual members are invalid remains an empty
+    // allowlist, as required by the Permissions Policy processing model.
+    if (validMember) {
+      parsedFeatures.AppendElement(std::move(feature));
+    }
+  }
+
+  aParsedFeatures = std::move(parsedFeatures);
+  return true;
+}
+
 }  // namespace mozilla::dom
