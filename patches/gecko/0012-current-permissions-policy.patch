+bool IsValidScheme(const nsACString& aScheme) {
+  if (aScheme.IsEmpty() || !mozilla::IsAsciiAlpha(aScheme.First())) {
+    return false;
+  }
+
+  for (const char* cursor = aScheme.BeginReading();
+       cursor != aScheme.EndReading(); ++cursor) {
+    const char character = *cursor;
+    if (!mozilla::IsAsciiAlphanumeric(character) && character != '+' &&
+        character != '-' && character != '.') {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool ParseWildcardExpression(const nsACString& aExpression, nsACString& aScheme,
+                             nsACString& aHost, nsACString& aPort) {
+  const int32_t separator = aExpression.Find("://");
+  if (separator <= 0) {
+    return false;
+  }
+
+  aScheme.Assign(Substring(aExpression, 0, separator));
+  ToLowerCase(aScheme);
+  if (!IsValidScheme(aScheme) || aScheme.EqualsLiteral("*")) {
+    return false;
+  }
+
+  nsAutoCString authority(Substring(aExpression, separator + 3));
+  if (authority.IsEmpty() || authority.FindCharInSet("/?#@") != kNotFound) {
+    return false;
+  }
+
+  const int32_t colon = authority.RFindChar(':');
+  if (colon != kNotFound) {
+    if (authority.FindChar(':') != colon) {
+      return false;
+    }
+    aPort.Assign(Substring(authority, colon + 1));
+    authority.Truncate(colon);
+    if (aPort.IsEmpty()) {
+      return false;
+    }
+    if (!aPort.EqualsLiteral("*")) {
+      for (const char* cursor = aPort.BeginReading();
+           cursor != aPort.EndReading(); ++cursor) {
+        const char character = *cursor;
+        if (!mozilla::IsAsciiDigit(character)) {
+          return false;
+        }
+      }
+      nsresult rv = NS_OK;
+      const int32_t port = aPort.ToInteger(&rv);
+      if (NS_FAILED(rv) || port < 1 || port > 65535) {
+        return false;
+      }
+    }
+  } else {
+    aPort.Truncate();
+  }
+
+  ToLowerCase(authority);
+  if (authority.EqualsLiteral("*")) {
+    aHost.Assign(authority);
+    return true;
+  }
+  const bool isSubdomainWildcard = StringBeginsWith(authority, "*."_ns);
+  if ((isSubdomainWildcard &&
+       (authority.Length() <= 2 ||
+        Substring(authority, 2).FindChar('*') != kNotFound)) ||
+      (!isSubdomainWildcard && authority.FindChar('*') != kNotFound)) {
+    return false;
+  }
+
+  // Validate the host, or the non-wildcard suffix, with Gecko's URL
+  // implementation.
+  nsCOMPtr<nsIURI> validationURI;
+  nsAutoCString validationSpec(aScheme);
+  validationSpec.AppendLiteral("://");
+  validationSpec.Append(isSubdomainWildcard ? Substring(authority, 2)
+                                            : nsDependentCSubstring(authority));
+  nsresult rv = NS_NewURI(getter_AddRefs(validationURI), validationSpec);
+  if (NS_FAILED(rv)) {
+    return false;
+  }
+  nsAutoCString validationHost;
+  rv = validationURI->GetAsciiHost(validationHost);
+  if (NS_FAILED(rv) || validationHost.IsEmpty()) {
+    return false;
+  }
+
+  if (isSubdomainWildcard) {
+    aHost.AssignLiteral("*.");
+    aHost.Append(validationHost);
+  } else {
+    aHost.Assign(validationHost);
+  }
+  return true;
+}
+
+bool MatchesAllowListExpression(const nsAString& aExpression,
+                                nsIPrincipal* aPrincipal) {
+  nsCOMPtr<nsIURI> uri;
+  if (NS_FAILED(aPrincipal->GetURI(getter_AddRefs(uri))) || !uri) {
+    return false;
+  }
+
+  nsAutoCString expression = NS_ConvertUTF16toUTF8(aExpression);
+  if (!expression.IsEmpty() && expression.Last() == ':' &&
+      expression.Find("://") == kNotFound) {
+    expression.Truncate(expression.Length() - 1);
+    return IsValidScheme(expression) &&
+           uri->SchemeIs(PromiseFlatCString(expression).get());
+  }
+
+  nsAutoCString scheme;
+  nsAutoCString host;
+  nsAutoCString port;
+  if (!ParseWildcardExpression(expression, scheme, host, port) ||
+      !uri->SchemeIs(PromiseFlatCString(scheme).get())) {
+    return false;
+  }
+
+  nsAutoCString uriHost;
+  if (NS_FAILED(uri->GetAsciiHost(uriHost)) || uriHost.IsEmpty()) {
+    return false;
+  }
+  ToLowerCase(uriHost);
+  if (StringBeginsWith(host, "*."_ns)) {
+    const nsDependentCSubstring suffix = Substring(host, 2);
+    if (!(uriHost.Length() > suffix.Length() &&
+          StringEndsWith(uriHost, suffix) &&
+          uriHost.CharAt(uriHost.Length() - suffix.Length() - 1) == '.')) {
+      return false;
+    }
+  } else if (!host.EqualsLiteral("*") && !uriHost.Equals(host)) {
+    return false;
