 TEST(FeaturePolicyParser, Basic)
 {
   nsCOMPtr<nsIPrincipal> selfPrincipal =
@@ -158,3 +175,66 @@ TEST(FeaturePolicyParser, Basic)
   ASSERT_TRUE(parsedFeatures[0].Name().Equals(u"camera"_ns));
   ASSERT_TRUE(parsedFeatures[0].AllowsAll());
 }
+
+TEST(FeaturePolicyParser, PermissionsPolicyStructuredHeader)
+{
+  nsCOMPtr<nsIPrincipal> selfPrincipal =
+      mozilla::BasePrincipal::CreateContentPrincipal(URL_SELF);
+  nsCOMPtr<nsIPrincipal> exampleComPrincipal =
+      mozilla::BasePrincipal::CreateContentPrincipal(URL_EXAMPLE_COM_HTTPS);
+  nsCOMPtr<nsIPrincipal> wwwExampleComPrincipal =
+      mozilla::BasePrincipal::CreateContentPrincipal(URL_WWW_EXAMPLE_COM_HTTPS);
+  nsCOMPtr<nsIPrincipal> exampleNetPrincipal =
+      mozilla::BasePrincipal::CreateContentPrincipal(URL_EXAMPLE_NET);
+
+  nsTArray<Feature> parsedFeatures;
+
+  CheckPermissionsPolicyParser("fullscreen=()"_ns, true, 1, parsedFeatures);
+  EXPECT_TRUE(parsedFeatures[0].AllowsNone());
+
+  CheckPermissionsPolicyParser("fullscreen=self"_ns, true, 1, parsedFeatures);
+  EXPECT_TRUE(parsedFeatures[0].AllowListContains(selfPrincipal));
+
+  CheckPermissionsPolicyParser("fullscreen=*"_ns, true, 1, parsedFeatures);
+  EXPECT_TRUE(parsedFeatures[0].AllowsAll());
+
+  CheckPermissionsPolicyParser("camera=(), microphone=self"_ns, true, 2,
+                               parsedFeatures);
+  EXPECT_TRUE(parsedFeatures[0].AllowsNone());
+  EXPECT_TRUE(parsedFeatures[1].AllowListContains(selfPrincipal));
+
+  CheckPermissionsPolicyParser("fullscreen=(self \"https://example.com\")"_ns,
+                               true, 1, parsedFeatures);
+  EXPECT_TRUE(parsedFeatures[0].AllowListContains(selfPrincipal));
+  EXPECT_TRUE(parsedFeatures[0].AllowListContains(exampleComPrincipal));
+  EXPECT_FALSE(parsedFeatures[0].AllowListContains(exampleNetPrincipal));
+
+  // Items of unsupported Structured Fields types are ignored while valid
+  // members in the same inner list continue to apply.
+  CheckPermissionsPolicyParser("fullscreen=(42 self)"_ns, true, 1,
+                               parsedFeatures);
+  EXPECT_TRUE(parsedFeatures[0].AllowListContains(selfPrincipal));
+  CheckPermissionsPolicyParser("fullscreen=?1"_ns, true, 0, parsedFeatures);
+
+  CheckPermissionsPolicyParser("fullscreen=(\"https://*.example.com\")"_ns,
+                               true, 1, parsedFeatures);
+  EXPECT_FALSE(parsedFeatures[0].AllowListContains(exampleComPrincipal));
+  EXPECT_TRUE(parsedFeatures[0].AllowListContains(wwwExampleComPrincipal));
+  EXPECT_FALSE(parsedFeatures[0].AllowListContains(exampleNetPrincipal));
+  nsTArray<nsString> wildcardExpressions;
+  parsedFeatures[0].GetAllowListExpressions(wildcardExpressions);
+  EXPECT_EQ(wildcardExpressions.Length(), 1U);
+  EXPECT_TRUE(wildcardExpressions.Contains(u"https://*.example.com"_ns));
+
+  CheckPermissionsPolicyParser("fullscreen=(\"https:\")"_ns, true, 1,
+                               parsedFeatures);
+  EXPECT_TRUE(parsedFeatures[0].AllowListContains(exampleComPrincipal));
+  EXPECT_FALSE(parsedFeatures[0].AllowListContains(exampleNetPrincipal));
+
+  CheckPermissionsPolicyParser("fullscreen=(\"*://example.net\" self)"_ns, true,
+                               1, parsedFeatures);
+  EXPECT_TRUE(parsedFeatures[0].AllowListContains(selfPrincipal));
+  EXPECT_FALSE(parsedFeatures[0].AllowListContains(exampleNetPrincipal));
+
+  CheckPermissionsPolicyParser("fullscreen=("_ns, false, 0, parsedFeatures);
+}
