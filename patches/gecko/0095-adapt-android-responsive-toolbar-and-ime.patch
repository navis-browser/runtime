diff --git a/mobile/shared/modules/navis/NavisAndroidResponsiveUI.sys.mjs b/mobile/shared/modules/navis/NavisAndroidResponsiveUI.sys.mjs
new file mode 100644
--- /dev/null
+++ b/mobile/shared/modules/navis/NavisAndroidResponsiveUI.sys.mjs
@@ -0,0 +1,136 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/** Adapt only layout/overlay ownership; original RDM controls and events remain. */
+export async function bindNavisAndroidResponsiveUI(window, ui) {
+  const frame = ui.rdmFrame;
+  const document = frame.contentDocument;
+  const container = ui.browserContainerEl;
+  const toolbar = document.getElementById("toolbar");
+  if (!toolbar || !document.nodePrincipal.isSystemPrincipal || frame.documentGlobal !== window) {
+    throw new Error("Responsive toolbar does not belong to this chrome host");
+  }
+  const stylesheet = document.createElement("link");
+  stylesheet.rel = "stylesheet";
+  stylesheet.href = "chrome://navis-android/content/responsive.css";
+  let discard;
+  const loaded = new Promise((resolve, reject) => {
+    discard = () => reject(new Error("Responsive toolbar closed while styling"));
+    document.defaultView.addEventListener("unload", discard, { once: true });
+    stylesheet.addEventListener("load", resolve, { once: true });
+    stylesheet.addEventListener("error", () => reject(new Error("Responsive layout stylesheet failed")), { once: true });
+  });
+  document.head.append(stylesheet);
+  try { await loaded; }
+  catch (error) { stylesheet.remove(); throw error; }
+  finally { document.defaultView.removeEventListener("unload", discard); }
+  if (!frame.isConnected || ui.destroying) { stylesheet.remove(); throw new Error("Responsive toolbar closed"); }
+  let closed = false;
+  let height = 0;
+  const leases = new Set();
+  const measure = () => {
+    if (closed || !frame.isConnected) return;
+    const next = Math.ceil(toolbar.getBoundingClientRect().height);
+    if (next > 0 && next !== height) {
+      height = next;
+      container.style.setProperty("--navis-rdm-toolbar-height", `${height}px`);
+    }
+  };
+  const popupHost = Object.freeze({
+    acquire(ownerDocument) {
+      if (closed || ownerDocument !== document || frame.contentDocument !== document || !frame.isConnected) {
+        throw new Error("Responsive popup belongs to an obsolete document");
+      }
+      const lease = {};
+      leases.add(lease);
+      frame.classList.add("navis-responsive-popup-open");
+      // Expand before HTMLTooltip measures; its original dismissal still owns
+      // outside-click, keyboard and focus behavior.
+      return () => {
+        if (!leases.delete(lease) || closed) return;
+        if (!leases.size) frame.classList.remove("navis-responsive-popup-open");
+      };
+    },
+  });
+  frame.navisResponsivePopupHost = popupHost;
+  frame.classList.add("navis-android-responsive-ui");
+  const observer = new window.ResizeObserver(measure);
+  observer.observe(toolbar);
+  measure();
+  return () => {
+    if (closed) return;
+    closed = true;
+    observer.disconnect();
+    leases.clear();
+    if (frame.navisResponsivePopupHost === popupHost) delete frame.navisResponsivePopupHost;
+    frame.classList.remove("navis-responsive-popup-open", "navis-android-responsive-ui");
+    container.style.removeProperty("--navis-rdm-toolbar-height");
+    stylesheet.remove();
+  };
+}
+
+/** Real NotificationBox, with explicit reload and document-scoped lifetime. */
+export function createNavisResponsiveNotifications(window, browser, container) {
+  let closed = false;
+  let documentEpoch = 0;
+  let noticeHeight = 0;
+  const resize = new window.ResizeObserver(entries => {
+    if (closed) return;
+    for (const entry of entries) {
+      const next = Math.ceil(entry.target.getBoundingClientRect().height);
+      if (next !== noticeHeight) {
+        noticeHeight = next;
+        container.style.setProperty("--navis-notice-height", `${next}px`);
+      }
+    }
+  });
+  const box = new window.MozElements.NotificationBox(element => {
+    if (closed) return;
+    container.prepend(element);
+    resize.observe(element);
+  });
+  const append = box.appendNotification.bind(box);
+  box.appendNotification = async (value, options, ...args) => {
+    if (closed) throw new Error("Responsive notification host is closed");
+    const epoch = documentEpoch;
+    const notification = await append(value, options, ...args);
+    if (closed || epoch !== documentEpoch) { box.removeNotification(notification, true); return notification; }
+    if (value !== "devtools-responsive") return notification;
+    // Upstream first-use explanation, not proof this document needs a reload.
+    // Preserve its text and offer a deliberate action without discarding edits.
+    const button = window.document.createElement("button");
+    button.type = "button";
+    button.className = "navis-responsive-reload";
+    button.setAttribute("slot", "actions");
+    button.textContent = Services.strings.createBundle("chrome://devtools/locale/toolbox.properties")
+      .GetStringFromName("toolbox.debugTargetInfo.reload");
+    button.addEventListener("click", () => {
+      if (closed || epoch !== documentEpoch || !browser.browsingContext || browser.navisNativePresentation !== false) return;
+      // Keep Gecko's beforeunload / request / container behavior. Clear only
+      // when a new document commits, not merely because this button was pressed.
+      browser.reload();
+    });
+    notification.append(button);
+    return notification;
+  };
+  const progress = {
+    QueryInterface: ChromeUtils.generateQI(["nsIWebProgressListener", "nsISupportsWeakReference"]),
+    onLocationChange(webProgress, _request, _location, flags) {
+      if (closed || !webProgress.isTopLevel || flags & Ci.nsIWebProgressListener.LOCATION_CHANGE_SAME_DOCUMENT) return;
+      documentEpoch++;
+      const notice = box.getNotificationWithValue("devtools-responsive");
+      if (notice) box.removeNotification(notice, true);
+    },
+  };
+  browser.addProgressListener(progress, Ci.nsIWebProgress.NOTIFY_LOCATION);
+  return Object.freeze({ box, destroy() {
+    if (closed) return;
+    closed = true;
+    documentEpoch++;
+    resize.disconnect();
+    container.style.removeProperty("--navis-notice-height");
+    try { browser.removeProgressListener(progress); }
+    finally { box.removeAllNotifications(true); }
+  } });
+}
