@@ -0,0 +1,29 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Owned Navis Android iframe only: same controls, fonts, colors and handlers. */
+@media (max-width: 520px) {
+  #toolbar, #toolbar:not(.left-aligned) {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: start;
+    gap: 2px;
+    padding: 2px;
+    background-image: none;
+  }
+  #toolbar-center-controls, #toolbar-end-controls { display: contents; }
+  #toolbar .devtools-separator { display: none; }
+  #toolbar::before { content: ""; order: 3; flex-basis: 100%; height: 0; }
+  #toolbar #device-selector { order: 0; flex: 1; min-width: 100px; max-width: none; margin-inline-start: 0; }
+  #toolbar .viewport-dimension { order: 1; flex: none; }
+  #toolbar #rotate-button { order: 2; flex: none; }
+  #toolbar #device-pixel-ratio-menu { order: 4; flex: none; }
+  #toolbar #network-throttling { order: 5; flex: 1; min-width: 70px; }
+  #toolbar #touch-simulation-button { order: 6; flex: none; }
+  #toolbar #screenshot-button { order: 7; flex: none; }
+  #toolbar #settings-button { order: 8; flex: none; }
+  #toolbar #exit-button { order: 9; flex: none; }
+  #toolbar #user-agent-label { order: 10; flex: 1 0 100%; margin: 0; }
+}
