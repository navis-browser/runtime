diff --git a/mobile/shared/modules/navis/NavisAndroidDevTools.sys.mjs b/mobile/shared/modules/navis/NavisAndroidDevTools.sys.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..011052960cd691199d9f9af377ea3bbff27645f8
--- /dev/null
+++ b/mobile/shared/modules/navis/NavisAndroidDevTools.sys.mjs
@@ -0,0 +1,172 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const TOOLS = new Set([
+  "inspector", "webconsole", "jsdebugger", "styleeditor", "netmonitor",
+  "storage", "memory", "performance", "accessibility", "application", "options",
+]);
+
+/** The shared Gecko toolbox, hosted by a Navis native window and local pipe. */
+export function createNavisAndroidDevTools(window) {
+  let frame;
+  let toolbox;
+  let client;
+  let commands;
+  let closed = false;
+  let target;
+  let targetHost;
+  let originalZoom;
+  let viewportOperation = null;
+  let closing;
+
+  async function restoreViewport() {
+    await targetHost?.restore();
+    if (target?.browsingContext && !target.documentGlobal?.closed && originalZoom !== undefined) {
+      target.fullZoom = originalZoom;
+    }
+  }
+
+  return {
+    async open(targetSessionId, tool) {
+      if (!Number.isSafeInteger(targetSessionId) || targetSessionId <= 0 ||
+          (tool !== "default" && !TOOLS.has(tool))) {
+        throw new TypeError("Invalid developer tools target");
+      }
+      const targetWindow = [...Services.wm.getEnumerator("navigator:navis-android")]
+        .find(candidate => candidate.tab?.id === targetSessionId && !candidate.tab.isPopup);
+      target = targetWindow?.browser;
+      if (!target?.browsingContext || targetWindow.closed) {
+        throw new Error("The inspected tab has closed");
+      }
+      const { PrivateBrowsingUtils } = ChromeUtils.importESModule(
+        "resource://gre/modules/PrivateBrowsingUtils.sys.mjs"
+      );
+      if (PrivateBrowsingUtils.isBrowserPrivate(target) !== PrivateBrowsingUtils.isWindowPrivate(window)) {
+        throw new Error("Developer tools privacy context must match the inspected tab");
+      }
+      targetHost = targetWindow.navisResponsiveTarget;
+      if (!targetHost || targetHost.tab !== targetWindow.tab) {
+        throw new Error("The inspected Session has no owned viewport container");
+      }
+      // A previous Activity may still be finishing its tool host. Do not take
+      // an emulated zoom as this replacement host's baseline.
+      await targetHost.restore();
+      originalZoom = target.fullZoom;
+      const { ensureNavisAndroidLocales } = ChromeUtils.importESModule(
+        "resource://gre/modules/NavisAndroidLocales.sys.mjs"
+      );
+      await ensureNavisAndroidLocales();
+      if (closed) throw new Error("Developer tools host closed");
+
+      // This non-remote chrome frame is created only in a dedicated native host.
+      // Ordinary content never navigates to a privileged toolbox URL.
+      frame = window.document.createXULElement("browser");
+      frame.setAttribute("type", "content");
+      frame.setAttribute("flex", "1");
+      frame.setAttribute("disablehistory", "true");
+      frame.setAttribute("manualactiveness", "true");
+      frame.style.minWidth = "0";
+      frame.style.minHeight = "0";
+      window.document.documentElement.appendChild(frame);
+      const loaded = new Promise((resolve, reject) => {
+        const timer = window.setTimeout(() => reject(new Error("Toolbox document timed out")), 20_000);
+        frame.addEventListener("DOMContentLoaded", event => {
+          if (event.target.documentURI !== "about:devtools-toolbox") return;
+          window.clearTimeout(timer);
+          resolve();
+        }, { capture: true });
+      });
+      frame.loadURI(Services.io.newURI("about:devtools-toolbox"), {
+        triggeringPrincipal: Services.scriptSecurityManager.getSystemPrincipal(),
+      });
+      frame.docShellIsActive = true;
+      await loaded;
+      if (closed) throw new Error("Developer tools host closed");
+
+      const { require } = ChromeUtils.importESModule(
+        "resource://devtools/shared/loader/Loader.sys.mjs"
+      );
+      const { DevToolsServer } = require("devtools/server/devtools-server");
+      const { DevToolsClient } = require("devtools/client/devtools-client");
+      const { CommandsFactory } = require("devtools/shared/commands/commands-factory");
+      const { gDevTools } = require("devtools/client/framework/devtools");
+      const { Toolbox } = require("devtools/client/framework/toolbox");
+      DevToolsServer.init();
+      DevToolsServer.registerAllActors();
+      DevToolsServer.chromeWindowType = "navigator:navis-android";
+      DevToolsServer.setRootActor(require("resource://gre/modules/dbg-browser-actors.js").createRootActor);
+      client = new DevToolsClient(DevToolsServer.connectPipe());
+      await client.connect();
+      commands = await CommandsFactory.forRemoteTab(target.browserId, { client });
+      if (closed) {
+        await commands.destroy();
+        throw new Error("Developer tools host closed");
+      }
+      toolbox = await gDevTools.showToolbox(commands, {
+        // The private window-name token cannot carry null. An ordinary menu
+        // opening leaves selection to Gecko's persisted LAST_TOOL preference;
+        // explicit Inspect still supplies "inspector".
+        toolId: tool === "default" ? undefined : tool,
+        hostType: Toolbox.HostType.PAGE,
+        hostOptions: { customIframe: frame },
+      });
+      if (closed) {
+        await toolbox.destroy();
+        throw new Error("Developer tools host closed");
+      }
+      window.document.title = "Developer tools";
+      console.info("NavisAndroid DevTools ready", { targetSessionId, tool, transport: "pipe" });
+    },
+    async query(operation, data) {
+      if (!data || typeof data !== "object" || Array.isArray(data) || Object.keys(data).length > 1) {
+        throw new TypeError("Invalid developer-tools operation");
+      }
+      if (operation === "devtools:close") {
+        await this.close();
+        return { restored: true };
+      }
+      if (operation !== "devtools:viewport" || closed || !toolbox ||
+          !target?.browsingContext || target.documentGlobal?.closed) {
+        throw new Error("Developer-tools viewport is unavailable");
+      }
+      if (viewportOperation) throw new Error("A viewport operation is already pending");
+      const action = data.command;
+      if (!["responsive-toggle", "zoom-in", "zoom-out", "reset-zoom"].includes(action)) {
+        throw new TypeError("Unknown viewport command");
+      }
+      const pending = Promise.resolve().then(() => action === "responsive-toggle"
+        ? targetHost.toggle() : targetHost.zoom(action));
+      viewportOperation = pending;
+      try { return await pending; }
+      finally { if (viewportOperation === pending) viewportOperation = null; }
+    },
+    close() {
+      if (closing) return closing;
+      closed = true;
+      closing = (async () => {
+        try {
+          // A toolbar close must not race an in-flight RDM initialize. Keep the
+          // actual target view alive until Gecko has removed all emulation.
+          await viewportOperation?.catch(() => {});
+          await restoreViewport();
+        } catch (error) {
+          closed = false;
+          closing = null;
+          throw error;
+        }
+        try {
+          // Toolbox destruction releases its own commands/client, not the
+          // unrelated browser Session or a global active tab.
+          const cleanup = toolbox ? toolbox.destroy() : commands ? commands.destroy() : client?.close();
+          await cleanup;
+        } finally {
+          frame?.remove();
+          frame = null;
+        }
+      })();
+      closing.catch(Cu.reportError);
+      return closing;
+    },
+  };
+}
diff --git a/mobile/shared/modules/navis/NavisAndroidLocales.sys.mjs b/mobile/shared/modules/navis/NavisAndroidLocales.sys.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..8ba6faa5a75926316a5682b84330b7f032baaee6
--- /dev/null
+++ b/mobile/shared/modules/navis/NavisAndroidLocales.sys.mjs
@@ -0,0 +1,40 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { AddonManager } from "resource://gre/modules/AddonManager.sys.mjs";
+
+const ID = "langpack-zh-CN@firefox.mozilla.org";
+const BASE = "resource://android/assets/navis_locales/zh-CN/";
+let readiness;
+
+/** Installs only the immutable, build-verified copy of the shared desktop locale. */
+export function ensureNavisAndroidLocales() {
+  if (!readiness) {
+    readiness = (async () => {
+      await AddonManager.readyPromise;
+      const metadata = await (await fetch(BASE + "metadata.json")).json();
+      if (metadata.id !== ID || metadata.locale !== "zh-CN" || typeof metadata.version !== "string") {
+        throw new Error("The packaged Navis language metadata is invalid");
+      }
+      let addon = await AddonManager.getAddonByID(ID);
+      if (addon && addon.scope !== AddonManager.SCOPE_APPLICATION) {
+        throw new Error("The application locale ID belongs to another install scope");
+      }
+      if (!addon || addon.version !== metadata.version || addon.getResourceURI("").spec !== BASE) {
+        addon = await AddonManager.installBuiltinAddon(BASE);
+      }
+      if (addon.id !== ID || addon.type !== "locale" || addon.version !== metadata.version ||
+          addon.scope !== AddonManager.SCOPE_APPLICATION) {
+        throw new Error("The built-in Navis language pack is invalid");
+      }
+      if (addon.userDisabled) await addon.enable();
+      await addon.startupPromise;
+      if (!addon.isActive) throw new Error("The built-in Navis language pack did not start");
+    })().catch(error => {
+      readiness = undefined;
+      throw error;
+    });
+  }
+  return readiness;
+}
diff --git a/mobile/shared/modules/navis/NavisAndroidResponsive.sys.mjs b/mobile/shared/modules/navis/NavisAndroidResponsive.sys.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..5bd3c701a94590de26872414fe9e93c75dca0370
--- /dev/null
+++ b/mobile/shared/modules/navis/NavisAndroidResponsive.sys.mjs
@@ -0,0 +1,258 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+let browserLifecycleDetached = false;
+
+function manager() {
+  const { require } = ChromeUtils.importESModule(
+    "resource://devtools/shared/loader/Loader.sys.mjs");
+  const { gDevToolsBrowser } = require("devtools/client/framework/devtools-browser");
+  if (!browserLifecycleDetached) {
+    // As on desktop, use the shared stylesheet service, not Firefox's window
+    // startup/shutdown ownership. Navis closes its own toolbox and RDM clients.
+    for (const topic of ["browser-delayed-startup-finished", "quit-application", "devtools:loader:destroy"]) {
+      try { Services.obs.removeObserver(gDevToolsBrowser, topic); } catch {}
+    }
+    browserLifecycleDetached = true;
+  }
+  return require("devtools/client/responsive/manager");
+}
+
+/** Events identify the actual Navis tab, including its remoteness/close owner. */
+class TabEvents {
+  listeners = new Map();
+  addEventListener(type, listener, options = {}) {
+    if (!listener || options?.signal?.aborted) return;
+    if (!this.listeners.has(type)) this.listeners.set(type, new Map());
+    const entries = this.listeners.get(type);
+    if (entries.has(listener)) return;
+    const entry = { once: Boolean(options?.once), signal: options?.signal };
+    entry.abort = () => this.removeEventListener(type, listener);
+    entries.set(listener, entry);
+    entry.signal?.addEventListener("abort", entry.abort, { once: true });
+  }
+  removeEventListener(type, listener) {
+    const entry = this.listeners.get(type)?.get(listener);
+    entry?.signal?.removeEventListener("abort", entry.abort);
+    this.listeners.get(type)?.delete(listener);
+  }
+  emit(type, tab) {
+    const event = Object.freeze({ type, target: tab, currentTarget: tab });
+    for (const [listener, entry] of [...(this.listeners.get(type) || [])]) {
+      if (entry.once) this.removeEventListener(type, listener);
+      try {
+        if (typeof listener === "function") listener.call(tab, event);
+        else listener.handleEvent(event);
+      } catch (error) { Cu.reportError(error); }
+    }
+  }
+  clear() {
+    for (const [type, entries] of this.listeners) {
+      for (const listener of [...entries.keys()]) this.removeEventListener(type, listener);
+    }
+    this.listeners.clear();
+  }
+}
+
+/**
+ * Real target-side host contract. Construct before the browser's FIRST DOM
+ * insertion: moving a live remote browser would discard its page/session state.
+ * The container owns the existing browser, never a screenshot or second tab.
+ */
+export function createNavisAndroidResponsiveTarget(window, browser, tab) {
+  if (window.document.documentURI !== "chrome://navis-android/content/host.xhtml" ||
+      browser.documentGlobal !== window || tab.browser !== browser || tab.isPopup ||
+      browser.isConnected || window.gBrowser) {
+    throw new Error("Responsive target requires an uninserted owned Navis browser");
+  }
+  const document = window.document;
+  const container = document.createXULElement("vbox");
+  container.className = "navis-android-browser-container browserContainer";
+  const stack = document.createXULElement("stack");
+  stack.className = "navis-android-browser-stack browserStack";
+  browser.classList.add("navis-android-content-browser");
+  stack.append(browser);
+  container.append(stack);
+  const events = new TabEvents();
+  const selections = new TabEvents();
+  let closed = false;
+  let ready = false;
+  let notificationBox;
+  let notificationOwner;
+  let responsiveManager;
+  let responsiveUICleanup;
+  let zoomBeforeResponsive;
+
+  Object.defineProperties(tab, {
+    tagName: { value: "tab" },
+    ownerDocument: { get: () => document },
+    documentGlobal: { get: () => window },
+    selected: { get: () => tab.getActive() },
+    addEventListener: { value: events.addEventListener.bind(events) },
+    removeEventListener: { value: events.removeEventListener.bind(events) },
+  });
+  const checkBrowser = candidate => {
+    if (closed || candidate !== browser || browser.documentGlobal !== window) {
+      throw new Error("The responsive target no longer belongs to this host");
+    }
+    return browser;
+  };
+  window.gBrowser = Object.freeze({
+    get selectedTab() { return closed ? null : tab; },
+    set selectedTab(candidate) {
+      if (candidate !== tab || closed) throw new Error("Cannot select another Session through this render host");
+      browser.focus();
+    },
+    get selectedBrowser() { return closed ? null : browser; },
+    get tabs() { return closed ? [] : [tab]; },
+    get browsers() { return closed ? [] : [browser]; },
+    tabContainer: selections,
+    getBrowserForTab(candidate) {
+      if (candidate !== tab) throw new Error("The tab belongs to another Session");
+      return checkBrowser(browser);
+    },
+    getTabForBrowser(candidate) { checkBrowser(candidate); return tab; },
+    getBrowserContainer(candidate) { checkBrowser(candidate); return container; },
+    getNotificationBox(candidate) {
+      checkBrowser(candidate);
+      // Use Gecko's actual visible notification widget, not a no-op facade.
+      if (!notificationBox) {
+        const { createNavisResponsiveNotifications } = ChromeUtils.importESModule(
+          "resource://gre/modules/NavisAndroidResponsiveUI.sys.mjs");
+        notificationOwner = createNavisResponsiveNotifications(window, browser, container);
+        notificationBox = notificationOwner.box;
+      }
+      return notificationBox;
+    },
+  });
+  window.gFissionBrowser = true;
+  window.gBrowserInit = Object.freeze({
+    get delayedStartupFinished() { return ready && !closed; },
+    isAdoptingTab: () => false,
+  });
+  const media = window.matchMedia("(prefers-color-scheme: dark)");
+  const updateTheme = () => {
+    const pref = Services.prefs.getStringPref("devtools.theme", "auto");
+    document.documentElement.setAttribute("devtoolstheme",
+      pref === "dark" || (pref === "auto" && media.matches) ? "dark" : "light");
+  };
+  media.addEventListener("change", updateTheme);
+  Services.prefs.addObserver("devtools.theme", updateTheme);
+  updateTheme();
+  const remotenessChanged = () => events.emit("TabRemotenessChange", tab);
+  browser.addEventListener("XULFrameLoaderCreated", remotenessChanged);
+  const restoreResponsiveZoom = ({ tab: changedTab }) => {
+    if (changedTab !== tab) return;
+    responsiveUICleanup?.();
+    responsiveUICleanup = null;
+    if (zoomBeforeResponsive === undefined) return;
+    if (!closed && browser.browsingContext) browser.fullZoom = zoomBeforeResponsive;
+    zoomBeforeResponsive = undefined;
+  };
+
+  async function closeResponsive() {
+    if (!responsiveManager?.isActiveForTab(tab)) return;
+    let finished;
+    const completion = new Promise(resolve => { finished = resolve; });
+    const onClosed = ({ tab: changedTab }) => { if (changedTab === tab) finished(); };
+    responsiveManager.on("off", onClosed);
+    try {
+      await responsiveManager.closeIfNeeded(window, tab, { trigger: "toolbox" });
+      // The upstream toolbar may already be destroying this UI. In that case
+      // closeIfNeeded returns early: only its actual "off" confirms cleanup.
+      if (responsiveManager.isActiveForTab(tab)) await completion;
+    } finally { responsiveManager.off("off", onClosed); }
+  }
+
+  async function rollbackFailedOpen() {
+    const ui = responsiveManager?.getResponsiveUIForTab(tab);
+    if (!ui) return;
+    // Upstream initialized is resolved only after success. Calling its normal
+    // destroy after initialize rejects would wait forever. Undo only resources
+    // this failed transaction actually acquired, including the real actor
+    // clients (which own UA/DPR/touch overrides); do not report a tab discard.
+    if (ui.networkFront) await ui.updateNetworkThrottling();
+    await ui.commands?.destroy();
+    events.removeEventListener("TabBrowserDiscarded", ui);
+    events.removeEventListener("TabClose", ui);
+    window.removeEventListener("unload", ui);
+    window.removeEventListener("FullZoomChange", ui);
+    for (const type of ["mousedown", "mousemove", "mouseup"]) browser.removeEventListener(type, ui);
+    ui.resizeToolbarObserver?.disconnect();
+    ui.rdmFrame?.contentWindow?.removeEventListener("message", ui);
+    ui.rdmFrame?.contentWindow?.destroy?.();
+    ui.rdmFrame?.remove();
+    ui.screenBox?.remove();
+    if (browser.browsingContext) {
+      browser.leaveResponsiveMode();
+      window.InspectorUtils.setVerticalClipping(browser.browsingContext, 0);
+      window.InspectorUtils.setDynamicToolbarMaxHeight(browser.browsingContext, 0);
+    }
+    container.classList.remove("responsive-mode");
+    for (const name of ["--rdm-width", "--rdm-height", "--rdm-zoom"]) stack.style.removeProperty(name);
+    for (const name of ["top", "visibility"]) browser.style.removeProperty(name);
+    responsiveManager.activeTabs.delete(tab);
+    responsiveManager.removeMenuCheckListenerFor(window);
+    responsiveManager.emit("off", { tab });
+  }
+
+  return Object.freeze({
+    container,
+    tab,
+    markReady() { ready = true; },
+    selectionChanged() { if (!closed) selections.emit("TabSelect", tab); },
+    async toggle() {
+      checkBrowser(browser);
+      if (!ready || browser.navisNativePresentation !== false || !browser.browsingContext) {
+        throw new Error("Responsive Design needs a live web document");
+      }
+      if (!responsiveManager) {
+        responsiveManager = manager();
+        responsiveManager.on("off", restoreResponsiveZoom);
+      }
+      if (responsiveManager.isActiveForTab(tab)) await closeResponsive();
+      else {
+        zoomBeforeResponsive = browser.fullZoom;
+        try {
+          const ui = await responsiveManager.openIfNeeded(window, tab, { trigger: "toolbox" });
+          const { bindNavisAndroidResponsiveUI } = ChromeUtils.importESModule(
+            "resource://gre/modules/NavisAndroidResponsiveUI.sys.mjs");
+          responsiveUICleanup = await bindNavisAndroidResponsiveUI(window, ui);
+        }
+        catch (error) { await rollbackFailedOpen(); throw error; }
+      }
+      return { responsive: responsiveManager.isActiveForTab(tab), zoom: browser.fullZoom };
+    },
+    zoom(command) {
+      checkBrowser(browser);
+      if (!ready || browser.navisNativePresentation !== false) throw new Error("The target has no web viewport");
+      const current = browser.fullZoom;
+      const next = command === "zoom-in" ? current + 0.1 : command === "zoom-out" ? current - 0.1 :
+        command === "reset-zoom" ? 1 : NaN;
+      if (!Number.isFinite(next)) throw new TypeError("Unknown viewport zoom command");
+      browser.fullZoom = Math.min(2, Math.max(0.25, Math.round(next * 100) / 100));
+      return { zoom: browser.fullZoom };
+    },
+    async restore() {
+      await closeResponsive();
+    },
+    destroy() {
+      if (closed) return;
+      responsiveUICleanup?.();
+      responsiveUICleanup = null;
+      notificationOwner?.destroy();
+      events.emit("TabClose", tab);
+      responsiveManager?.off("off", restoreResponsiveZoom);
+      if (responsiveManager?.isActiveForTab(tab)) {
+        responsiveManager.closeIfNeeded(window, tab, { reason: "unload" }).catch(Cu.reportError);
+      }
+      closed = true;
+      events.clear();
+      selections.clear();
+      browser.removeEventListener("XULFrameLoaderCreated", remotenessChanged);
+      media.removeEventListener("change", updateTheme);
+      Services.prefs.removeObserver("devtools.theme", updateTheme);
+    },
+  });
+}
diff --git a/mobile/shared/modules/navis/NavisAndroidResponsiveUI.sys.mjs b/mobile/shared/modules/navis/NavisAndroidResponsiveUI.sys.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a708bda8186be103b72dfdf67d5f6c0bbd9bb8cc
--- /dev/null
+++ b/mobile/shared/modules/navis/NavisAndroidResponsiveUI.sys.mjs
@@ -0,0 +1,136 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/** Adapt only layout/overlay ownership; original RDM controls and events remain. */
+export async function bindNavisAndroidResponsiveUI(window, ui) {
+  const frame = ui.rdmFrame;
+  const document = frame.contentDocument;
+  const container = ui.browserContainerEl;
+  const toolbar = document.getElementById("toolbar");
+  if (!toolbar || !document.nodePrincipal.isSystemPrincipal || frame.documentGlobal !== window) {
+    throw new Error("Responsive toolbar does not belong to this chrome host");
+  }
+  const stylesheet = document.createElement("link");
+  stylesheet.rel = "stylesheet";
+  stylesheet.href = "chrome://navis-android/content/responsive.css";
+  let discard;
+  const loaded = new Promise((resolve, reject) => {
+    discard = () => reject(new Error("Responsive toolbar closed while styling"));
+    document.defaultView.addEventListener("unload", discard, { once: true });
+    stylesheet.addEventListener("load", resolve, { once: true });
+    stylesheet.addEventListener("error", () => reject(new Error("Responsive layout stylesheet failed")), { once: true });
+  });
+  document.head.append(stylesheet);
+  try { await loaded; }
+  catch (error) { stylesheet.remove(); throw error; }
+  finally { document.defaultView.removeEventListener("unload", discard); }
+  if (!frame.isConnected || ui.destroying) { stylesheet.remove(); throw new Error("Responsive toolbar closed"); }
+  let closed = false;
+  let height = 0;
+  const leases = new Set();
+  const measure = () => {
+    if (closed || !frame.isConnected) return;
+    const next = Math.ceil(toolbar.getBoundingClientRect().height);
+    if (next > 0 && next !== height) {
+      height = next;
+      container.style.setProperty("--navis-rdm-toolbar-height", `${height}px`);
+    }
+  };
+  const popupHost = Object.freeze({
+    acquire(ownerDocument) {
+      if (closed || ownerDocument !== document || frame.contentDocument !== document || !frame.isConnected) {
+        throw new Error("Responsive popup belongs to an obsolete document");
+      }
+      const lease = {};
+      leases.add(lease);
+      frame.classList.add("navis-responsive-popup-open");
+      // Expand before HTMLTooltip measures; its original dismissal still owns
+      // outside-click, keyboard and focus behavior.
+      return () => {
+        if (!leases.delete(lease) || closed) return;
+        if (!leases.size) frame.classList.remove("navis-responsive-popup-open");
+      };
+    },
+  });
+  frame.navisResponsivePopupHost = popupHost;
+  frame.classList.add("navis-android-responsive-ui");
+  const observer = new window.ResizeObserver(measure);
+  observer.observe(toolbar);
+  measure();
+  return () => {
+    if (closed) return;
+    closed = true;
+    observer.disconnect();
+    leases.clear();
+    if (frame.navisResponsivePopupHost === popupHost) delete frame.navisResponsivePopupHost;
+    frame.classList.remove("navis-responsive-popup-open", "navis-android-responsive-ui");
+    container.style.removeProperty("--navis-rdm-toolbar-height");
+    stylesheet.remove();
+  };
+}
+
+/** Real NotificationBox, with explicit reload and document-scoped lifetime. */
+export function createNavisResponsiveNotifications(window, browser, container) {
+  let closed = false;
+  let documentEpoch = 0;
+  let noticeHeight = 0;
+  const resize = new window.ResizeObserver(entries => {
+    if (closed) return;
+    for (const entry of entries) {
+      const next = Math.ceil(entry.target.getBoundingClientRect().height);
+      if (next !== noticeHeight) {
+        noticeHeight = next;
+        container.style.setProperty("--navis-notice-height", `${next}px`);
+      }
+    }
+  });
+  const box = new window.MozElements.NotificationBox(element => {
+    if (closed) return;
+    container.prepend(element);
+    resize.observe(element);
+  });
+  const append = box.appendNotification.bind(box);
+  box.appendNotification = async (value, options, ...args) => {
+    if (closed) throw new Error("Responsive notification host is closed");
+    const epoch = documentEpoch;
+    const notification = await append(value, options, ...args);
+    if (closed || epoch !== documentEpoch) { box.removeNotification(notification, true); return notification; }
+    if (value !== "devtools-responsive") return notification;
+    // Upstream first-use explanation, not proof this document needs a reload.
+    // Preserve its text and offer a deliberate action without discarding edits.
+    const button = window.document.createElement("button");
+    button.type = "button";
+    button.className = "navis-responsive-reload";
+    button.setAttribute("slot", "actions");
+    button.textContent = Services.strings.createBundle("chrome://devtools/locale/toolbox.properties")
+      .GetStringFromName("toolbox.debugTargetInfo.reload");
+    button.addEventListener("click", () => {
+      if (closed || epoch !== documentEpoch || !browser.browsingContext || browser.navisNativePresentation !== false) return;
+      // Keep Gecko's beforeunload / request / container behavior. Clear only
+      // when a new document commits, not merely because this button was pressed.
+      browser.reload();
+    });
+    notification.append(button);
+    return notification;
+  };
+  const progress = {
+    QueryInterface: ChromeUtils.generateQI(["nsIWebProgressListener", "nsISupportsWeakReference"]),
+    onLocationChange(webProgress, _request, _location, flags) {
+      if (closed || !webProgress.isTopLevel || flags & Ci.nsIWebProgressListener.LOCATION_CHANGE_SAME_DOCUMENT) return;
+      documentEpoch++;
+      const notice = box.getNotificationWithValue("devtools-responsive");
+      if (notice) box.removeNotification(notice, true);
+    },
+  };
+  browser.addProgressListener(progress, Ci.nsIWebProgress.NOTIFY_LOCATION);
+  return Object.freeze({ box, destroy() {
+    if (closed) return;
+    closed = true;
+    documentEpoch++;
+    resize.disconnect();
+    container.style.removeProperty("--navis-notice-height");
+    try { browser.removeProgressListener(progress); }
+    finally { box.removeAllNotifications(true); }
+  } });
+}
