+
+@import url("chrome://global/skin/design-system/tokens-platform.css");
+
+.navis-android-browser-container {
+  display: flex;
+  flex: 1;
+  min-width: 0;
+  min-height: 0;
+  flex-direction: column;
+  position: relative;
+  --browser-stack-z-index-rdm-toolbar: 3;
+}
+
+.navis-android-browser-stack {
+  display: grid;
+  flex: 1;
+  min-width: 0;
+  min-height: 0;
+}
+
+.navis-android-content-browser {
+  grid-area: 1 / 1;
+  width: 100%;
+  min-width: 0;
+  min-height: 0;
+}
+
+/* Same host constraint as Navis Desktop. Gecko's original RDM stylesheet
+ * controls grid/scale and handles; normal browser flex must not override it. */
+.browserContainer.responsive-mode > .browserStack > :is(browser, .rdm-screen-box) {
+  width: var(--rdm-width) !important;
+  height: var(--rdm-height) !important;
+  min-width: 0 !important;
+  min-height: 0 !important;
+  max-width: none !important;
+  max-height: none !important;
+  flex: none !important;
+}
+
+:root .browserContainer.responsive-mode > .rdm-toolbar.navis-android-responsive-ui {
+  top: var(--navis-notice-height, 0px);
+  height: var(--navis-rdm-toolbar-height) !important;
+}
+:root .browserContainer.responsive-mode > .rdm-toolbar.navis-android-responsive-ui:is(.navis-responsive-popup-open, .device-modal-opened) {
+  height: calc(100% - var(--navis-notice-height, 0px)) !important;
+}
+.browserContainer.responsive-mode:has(> .navis-android-responsive-ui) > .browserStack {
+  grid-template-rows: calc(var(--navis-rdm-toolbar-height) + 5px) [margin-top-offset] var(--rdm-height) [below-browser] 1fr;
+}
+.notificationbox-stack {
+  flex: none;
+  width: 100%;
+  min-width: 0;
+  font: 14px/1.5 sans-serif;
+  color: CanvasText;
+  color-scheme: light dark;
+}
+.navis-responsive-reload {
+  min-height: 36px;
+  padding: 4px 12px;
+  font: inherit;
+  border: 1px solid var(--border-color);
+  border-radius: var(--border-radius-small);
+  color: var(--button-text-color);
+  background: var(--button-background-color);
+  cursor: pointer;
+}
+.navis-responsive-reload:hover { background: var(--button-background-color-hover); }
+.navis-responsive-reload:focus-visible { outline: 2px solid var(--focus-outline-color); }
