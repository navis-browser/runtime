index 0000000000000000000000000000000000000000..b0d04762fb92a7b9ffcac366125b349e16e79380
--- /dev/null
+++ b/devtools/client/preferences/generate-navis-prefs.py
@@ -0,0 +1,23 @@
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+"""Reuse the desktop toolbox defaults without packaging Firefox product prefs."""
+
+import io
+
+import buildconfig
+from mozbuild.preprocessor import Preprocessor
+
+
+def generate(output, source):
+    with open(source, encoding="utf-8") as stream:
+        desktop = stream.read()
+    start = desktop.index("// Toolbox preferences\n")
+    end = desktop.index("// FirstStartup service", start)
+    toolbox = io.StringIO(desktop[start:end])
+    toolbox.name = source
+    preprocessor = Preprocessor()
+    preprocessor.context.update(buildconfig.defines["ALLDEFINES"])
+    preprocessor.out = output
+    preprocessor.do_include(toolbox)
