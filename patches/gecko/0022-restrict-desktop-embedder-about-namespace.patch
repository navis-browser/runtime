From cf70fa173783b7963a9321aaad38491104fa8c8f Mon Sep 17 00:00:00 2001
From: willvar <0@willvar.tw>
Date: Sat, 29 Aug 2026 22:44:00 +0800
Subject: [PATCH] Restrict the desktop embedder about namespace

---
 netwerk/protocol/about/nsAboutProtocolHandler.cpp | 25 +++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/netwerk/protocol/about/nsAboutProtocolHandler.cpp b/netwerk/protocol/about/nsAboutProtocolHandler.cpp
index a5478ab5e2f3..8337daae876a 100644
--- a/netwerk/protocol/about/nsAboutProtocolHandler.cpp
+++ b/netwerk/protocol/about/nsAboutProtocolHandler.cpp
@@ -27,6 +27,19 @@ namespace net {
 
 static NS_DEFINE_CID(kNestedAboutURICID, NS_NESTEDABOUTURI_CID);
 
+#ifdef MOZ_DESKTOP_EMBEDDER
+static bool IsDesktopEmbedderEngineAboutURI(nsIURI* aURI) {
+  nsAutoCString name;
+  if (NS_FAILED(NS_GetAboutModuleName(aURI, name))) {
+    return false;
+  }
+  return name.EqualsLiteral("blank") || name.EqualsLiteral("srcdoc") ||
+         name.EqualsLiteral("neterror") || name.EqualsLiteral("certerror") ||
+         name.EqualsLiteral("httpsonlyerror") ||
+         name.EqualsLiteral("framecrashed");
+}
+#endif
+
 ////////////////////////////////////////////////////////////////////////////////
 
 NS_IMPL_ISUPPORTS(nsAboutProtocolHandler, nsIProtocolHandler,
@@ -47,6 +60,12 @@ nsAboutProtocolHandler::GetFlagsForURI(nsIURI* aURI, uint32_t* aFlags) {
   *aFlags = URI_NORELATIVE | URI_NOAUTH | URI_DANGEROUS_TO_LOAD |
             URI_SCHEME_NOT_SELF_LINKABLE;
 
+#ifdef MOZ_DESKTOP_EMBEDDER
+  if (!IsDesktopEmbedderEngineAboutURI(aURI)) {
+    return NS_OK;
+  }
+#endif
+
   // Now try to see if this URI overrides the default:
   nsCOMPtr<nsIAboutModule> aboutMod;
   nsresult rv = NS_GetAboutModule(aURI, getter_AddRefs(aboutMod));
@@ -119,6 +138,12 @@ nsAboutProtocolHandler::NewChannel(nsIURI* uri, nsILoadInfo* aLoadInfo,
                                    nsIChannel** result) {
   NS_ENSURE_ARG_POINTER(uri);
 
+#ifdef MOZ_DESKTOP_EMBEDDER
+  if (!IsDesktopEmbedderEngineAboutURI(uri)) {
+    return NS_ERROR_MALFORMED_URI;
+  }
+#endif
+
   // about:what you ask?
   nsCOMPtr<nsIAboutModule> aboutMod;
   nsresult rv = NS_GetAboutModule(uri, getter_AddRefs(aboutMod));
-- 
2.55.0

