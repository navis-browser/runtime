+function onPopupWindowClose(event) {
+  // BrowserElementParent forwards top-level remote window.close() as a chrome
+  // CustomEvent on this exact embedder. It is not isTrusted: checking that flag
+  // would drop Gecko's own forwarding. Content cannot dispatch on this element.
+  if (shuttingDown || !dispatcher || !browser ||
+      event.type !== "DOMWindowClose" || event.target !== browser ||
+      !window.tab?.isPopup) return;
+  const match = /^navis-android-session-([1-9][0-9]*):popup-([0-9a-f]{32})$/.exec(window.name);
+  if (!match || !Number.isSafeInteger(Number(match[1])) ||
+      Number(match[1]) !== window.tab.id) return;
+  event.preventDefault();
+  event.stopPropagation();
+  // Close the owning native Session, which delivers onSessionClosed to its
+  // surface. Never close a globally active tab/popup or a chrome window directly.
+  dispatcher.dispatch("NavisAndroid:PopupClose", { targetToken: match[2] });
+}
