diff --git a/layout/generic/nsTextPaintStyle.cpp b/layout/generic/nsTextPaintStyle.cpp
--- a/layout/generic/nsTextPaintStyle.cpp
+++ b/layout/generic/nsTextPaintStyle.cpp
@@ -14,9 +14,46 @@
 #include "nsStyleConsts.h"
 #include "nsTextFrame.h"
 
+#ifdef MOZ_NAVIS_CORE
+#  include "mozilla/PreferenceSheet.h"
+#  include "mozilla/Preferences.h"
+#  include "mozilla/StaticPrefs_widget.h"
+#endif
+
 using namespace mozilla;
 using namespace mozilla::dom;
 
+#ifdef MOZ_NAVIS_CORE
+static void GetNavisSelectionColors(nsTextFrame* aFrame, nscolor& aForeground,
+                                   nscolor& aBackground) {
+  const auto* doc = aFrame->PresContext()->Document();
+  const auto& prefs = PreferenceSheet::PrefsFor(*doc);
+  if (!prefs.mUseDocumentColors || prefs.mUseAccessibilityTheme ||
+      StaticPrefs::widget_non_native_theme_always_high_contrast() ||
+      LookAndFeel::ShouldUseStandins(*doc, LookAndFeel::ColorID::Highlight) ==
+          LookAndFeel::UseStandins::Yes) {
+    return;
+  }
+
+  nscolor accent = NS_RGB(0x0b, 0x57, 0xd0);
+  nsAutoCString value;
+  if (NS_SUCCEEDED(Preferences::GetCString("navis.appearance.accent", value)) &&
+      value.Length() == 7 && value[0] == '#') {
+    nscolor parsed;
+    if (NS_HexToRGBA(NS_ConvertUTF8toUTF16(Substring(value, 1)),
+                     nsHexColorType::NoAlpha, &parsed)) {
+      accent = parsed;
+    }
+  }
+  const bool dark =
+      LookAndFeel::ColorSchemeForFrame(aFrame) == ColorScheme::Dark;
+  aForeground = dark ? NS_RGB(0xe3, 0xe3, 0xe3) : NS_RGB(0x1f, 0x1f, 0x1f);
+  aBackground = NS_ComposeColors(
+      dark ? NS_RGB(0x29, 0x2c, 0x30) : NS_RGB(0xff, 0xff, 0xff),
+      NS_RGBA(NS_GET_R(accent), NS_GET_G(accent), NS_GET_B(accent), 51));
+}
+#endif
