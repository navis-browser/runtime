diff --git a/mobile/android/app/geckoview-prefs.js b/mobile/android/app/geckoview-prefs.js
index 2f5b02eed2ff..7e298f9555b3 100644
--- a/mobile/android/app/geckoview-prefs.js
+++ b/mobile/android/app/geckoview-prefs.js
@@ -384,6 +384,13 @@ pref("xpinstall.signatures.required", true);
 pref("xpinstall.whitelist.add", "https://addons.mozilla.org");
 pref("xpinstall.whitelist.fileRequest", false);
 
+#ifdef MOZ_NAVIS_REMOTE_SETTINGS_POLICY
+// Navis's compiled collection policy remains provider-signed and excludes
+// preview buckets on Android just as it does on desktop.
+pref("services.settings.server", "https://firefox.settings.services.mozilla.com/v1", locked);
+pref("services.settings.preview_enabled", false, locked);
+#endif
+
 // Pref to enable the IP protection feature
 pref("browser.ipProtection.enabled", true);
 pref("browser.ipProtection.guardian.endpoint", "https://vpn.mozilla.org/");
