+option(
+    "--with-navis-remote-settings-policy",
+    nargs=1,
+    help=(
+        "Read the explicit Navis Remote Settings collection and bootstrap "
+        "policy from a source-tree-relative JSON file"
+    ),
+)
+
+
+@depends(
+    "--with-navis-remote-settings-policy",
+    build_environment,
+)
+@imports(_from="__builtin__", _import="open")
+@imports("json")
+@imports("os")
+@imports("re")
+def navis_remote_settings_policy(path, build_env):
+    if not path:
+        return namespace(
+            enabled=False,
+            collections=(),
+            bootstrap_collections=(),
+            sync_collections=(),
+            collections_csv="",
+            sync_collections_csv="",
+        )
+    relative_path = os.path.normpath(path[0])
+    if (
+        os.path.isabs(relative_path)
+        or relative_path == ".."
+        or relative_path.startswith(".." + os.sep)
+    ):
+        die("Navis Remote Settings policy must be source-tree-relative")
+    policy_path = os.path.join(build_env.topsrcdir, relative_path)
+    try:
+        with open(policy_path, "r") as policy_file:
+            policy = json.load(policy_file)
+    except (OSError, ValueError) as error:
+        die(
+            "Cannot read Navis Remote Settings policy {}: {}".format(
+                policy_path, error
+            )
+        )
+
+    if policy.get("schema_version") != 2:
+        die(
+            "Unsupported Navis Remote Settings policy schema in {}".format(
+                policy_path
+            )
+        )
+    entries = policy.get("allowed_collections")
+    if not isinstance(entries, list) or not entries:
+        die(
+            "Navis Remote Settings policy must have a nonempty "
+            "allowed_collections list"
+        )
+
+    identifier_pattern = re.compile(r"^[a-z0-9_-]+/[a-z0-9_-]+$")
+    collections = []
+    bootstrap_collections = []
+    sync_collections = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            die("Invalid Navis Remote Settings policy entry")
+        identifier = entry.get("identifier")
+        packaged_bootstrap = entry.get("packaged_bootstrap")
+        remote_sync = entry.get("remote_sync")
+        if not isinstance(identifier, str) or not identifier_pattern.fullmatch(
+            identifier
+        ):
+            die(
+                "Invalid Navis Remote Settings collection identifier: {!r}".format(
+                    identifier
+                )
+            )
+        if not isinstance(packaged_bootstrap, bool):
+            die(
+                "Navis Remote Settings packaged_bootstrap must be boolean for {}".format(
+                    identifier
+                )
+            )
+        if not isinstance(remote_sync, bool):
+            die(
+                "Navis Remote Settings remote_sync must be boolean for {}".format(
+                    identifier
+                )
+            )
+        collections.append(identifier)
+        if packaged_bootstrap:
+            bootstrap_collections.append(identifier)
+        if remote_sync:
+            sync_collections.append(identifier)
+
+    if tuple(collections) != tuple(sorted(set(collections))):
+        die("Navis Remote Settings collections must be sorted and unique")
+    if not bootstrap_collections:
+        die("Navis Remote Settings policy must package at least one bootstrap")
+    return namespace(
+        enabled=True,
+        collections=tuple(collections),
+        bootstrap_collections=tuple(bootstrap_collections),
+        sync_collections=tuple(sync_collections),
+        collections_csv=",".join(collections),
+        sync_collections_csv=",".join(sync_collections),
+    )
+
+
+set_config("MOZ_NAVIS_REMOTE_SETTINGS_POLICY", navis_remote_settings_policy.enabled)
+set_define(
+    "MOZ_NAVIS_REMOTE_SETTINGS_POLICY",
+    True,
+    when=navis_remote_settings_policy.enabled,
+)
+set_config(
+    "MOZ_NAVIS_REMOTE_SETTINGS_COLLECTIONS",
+    navis_remote_settings_policy.collections,
+)
+set_config(
+    "MOZ_NAVIS_REMOTE_SETTINGS_BOOTSTRAP_COLLECTIONS",
+    navis_remote_settings_policy.bootstrap_collections,
+)
+set_config(
+    "MOZ_NAVIS_REMOTE_SETTINGS_COLLECTIONS_CSV",
+    navis_remote_settings_policy.collections_csv,
+)
+set_config(
+    "MOZ_NAVIS_REMOTE_SETTINGS_SYNC_COLLECTIONS",
+    navis_remote_settings_policy.sync_collections,
+)
+set_config(
+    "MOZ_NAVIS_REMOTE_SETTINGS_SYNC_COLLECTIONS_CSV",
+    navis_remote_settings_policy.sync_collections_csv,
+)
+
 
