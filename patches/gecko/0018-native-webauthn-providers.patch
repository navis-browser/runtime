+
+package org.mozilla.gecko.navis;
+
+import android.app.Activity;
+import android.os.CancellationSignal;
+import java.lang.ref.WeakReference;
+import java.util.HashMap;
+import java.util.ArrayList;
+import java.util.Map;
+import org.mozilla.gecko.annotation.WrapForJNI;
+import org.mozilla.gecko.util.ThreadUtils;
+import org.mozilla.gecko.util.WebAuthnUtils;
+import org.mozilla.geckoview.GeckoResult;
+
+/**
+ * Navis-owned JNI transport for the OS credential provider, not an authenticator/store.
+ * Gecko has already validated the requesting origin and RP. Only a registered, active
+ * native content session may present credentials in the current foreground Activity.
+ * All mutable transaction/session state is confined to Android's UI thread.
+ */
+public final class NavisAndroidWebAuthn {
+  private static final Map<Long, Scope> SCOPES = new HashMap<>();
+  private static final Map<Long, Long> SESSION_WINDOWS = new HashMap<>();
+  private static final Map<Long, Binding> ACTIVITIES = new HashMap<>();
+  private static final Map<Long, Pending<?>> PENDING = new HashMap<>();
+
+  private NavisAndroidWebAuthn() {}
+
+  private static final class Scope {
+    final long sessionId;
+    final long browsingContextId;
+    long generation;
+    boolean active;
+
+    Scope(final long sessionId, final long browsingContextId, final boolean active) {
+      this.sessionId = sessionId;
+      this.browsingContextId = browsingContextId;
+      this.active = active;
+    }
+  }
+
+  private static final class Binding {
+    final long windowId;
+    final long generation;
+    final WeakReference<Activity> activity;
+
+    Binding(final Activity activity, final long windowId, final long generation) {
+      this.windowId = windowId;
+      this.generation = generation;
+      this.activity = new WeakReference<>(activity);
+    }
+  }
+
+  public static void bindActivity(final Activity activity, final long windowId, final long generation) {
+    ThreadUtils.assertOnUiThread();
+    if (activity == null || windowId <= 0 || generation <= 0) throw new IllegalArgumentException("Invalid Activity lease");
+    final Binding previous = ACTIVITIES.get(windowId);
+    if (previous != null) {
+      if (previous.generation > generation) return;
+      if (previous.generation == generation && previous.activity.get() == activity) return;
+      if (previous.generation == generation) throw new IllegalStateException("Activity lease already owned");
+      cancelPending(windowId, "ABORT_ERR");
+    }
+    ACTIVITIES.put(windowId, new Binding(activity, windowId, generation));
+  }
+
+  public static void unbindActivity(final long windowId, final long generation) {
+    ThreadUtils.assertOnUiThread();
+    final Binding binding = ACTIVITIES.get(windowId);
+    if (binding == null || binding.generation != generation) return;
+    ACTIVITIES.remove(windowId);
+    cancelPending(windowId, "ABORT_ERR");
+  }
+
+  public static void setSessionWindow(final long sessionId, final long windowId) {
+    ThreadUtils.assertOnUiThread();
+    final Long previous = SESSION_WINDOWS.get(sessionId);
+    if (previous != null && previous == windowId) return;
+    invalidateSession(sessionId);
+    if (windowId > 0) SESSION_WINDOWS.put(sessionId, windowId);
+    else SESSION_WINDOWS.remove(sessionId);
+  }
+
+  public static void shutdown() {
+    ThreadUtils.assertOnUiThread();
+    cancelPendingAll("ABORT_ERR");
+    ACTIVITIES.clear();
+    SESSION_WINDOWS.clear();
+    SCOPES.clear();
+  }
+
+  public static String availability(final long windowId) {
+    ThreadUtils.assertOnUiThread();
+    final Binding binding = ACTIVITIES.get(windowId);
+    final Activity activity = binding == null ? null : binding.activity.get();
+    if (activity == null || activity.isFinishing() || activity.isDestroyed()) {
+      return "NO_FOREGROUND_ACTIVITY";
+    }
+    return NavisAndroidCredentialProvider.availability(activity);
+  }
+
+  static void registerSession(
+      final long sessionId, final long browsingContextId, final boolean active) {
+    ThreadUtils.assertOnUiThread();
+    unregisterSession(sessionId);
+    if (browsingContextId > 0) {
+      SCOPES.put(browsingContextId, new Scope(sessionId, browsingContextId, active));
+    }
+  }
+
+  static void setSessionActive(final long sessionId, final boolean active) {
+    ThreadUtils.assertOnUiThread();
+    for (final Scope scope : SCOPES.values()) {
+      if (scope.sessionId == sessionId) scope.active = active;
+    }
+    if (!active) invalidateSession(sessionId);
+  }
+
+  static void invalidateSession(final long sessionId) {
+    ThreadUtils.assertOnUiThread();
+    for (final Scope scope : SCOPES.values()) {
+      if (scope.sessionId == sessionId) scope.generation++;
+    }
+    for (final Pending<?> pending : new ArrayList<>(PENDING.values())) {
+      if (pending.scope.sessionId == sessionId) pending.cancel("ABORT_ERR");
+    }
+  }
+
+  static void unregisterSession(final long sessionId) {
+    ThreadUtils.assertOnUiThread();
+    invalidateSession(sessionId);
+    SCOPES.values().removeIf(scope -> scope.sessionId == sessionId);
+  }
+
+  @WrapForJNI(calledFrom = "gecko")
+  private static boolean isAvailable() {
+    // Public Android APIs cannot tell a browser whether a third-party provider is
+    // enabled and supports user-verifying public-key credentials. Candidate presence
+    // or a secure lock screen is not UVPAA. Requests still use real create/get APIs;
+    // this optional web capability probe stays conservative until OS proof exists.
+    return false;
+  }
+
+  @WrapForJNI(calledFrom = "gecko")
+  private static GeckoResult<WebAuthnUtils.MakeCredentialResponse> makeCredential(
+      final long transactionId, final long browsingContextId, final String origin,
+      final byte[] clientDataHash, final String requestJson, final long timeoutMs) {
+    return request(transactionId, browsingContextId, origin, clientDataHash, requestJson,
+        timeoutMs, NavisAndroidCredentialProvider::create);
+  }
+
+  @WrapForJNI(calledFrom = "gecko")
+  private static GeckoResult<WebAuthnUtils.GetAssertionResponse> getAssertion(
+      final long transactionId, final long browsingContextId, final String origin,
+      final byte[] clientDataHash, final String requestJson, final long timeoutMs) {
+    return request(transactionId, browsingContextId, origin, clientDataHash, requestJson,
+        timeoutMs, NavisAndroidCredentialProvider::get);
+  }
+
+  @WrapForJNI(calledFrom = "gecko")
+  private static void cancelTransaction(final long transactionId) {
+    ThreadUtils.runOnUiThread(() -> {
+      for (final Pending<?> pending : new ArrayList<>(PENDING.values())) {
+        if (pending.transactionId == transactionId) pending.cancel("ABORT_ERR");
+      }
+    });
+  }
+
+  @WrapForJNI(calledFrom = "gecko")
+  private static void cancelAll() {
+    ThreadUtils.runOnUiThread(() -> cancelPendingAll("ABORT_ERR"));
+  }
+
+  private interface Provider<T> {
+    GeckoResult<T> request(Activity activity, CancellationSignal cancellation,
+        String origin, byte[] hash, String requestJson);
+  }
+
+  private static <T> GeckoResult<T> request(
+      final long transactionId, final long browsingContextId, final String origin,
+      final byte[] clientDataHash, final String requestJson, final long timeoutMs,
+      final Provider<T> provider) {
+    final GeckoResult<T> result = new GeckoResult<>();
+    // Native-owned arguments are copied before the JNI call returns. No page-supplied
+    // request/event can directly select a browsing context or substitute the origin.
+    final byte[] hash = clientDataHash == null ? null : clientDataHash.clone();
+    ThreadUtils.runOnUiThread(() -> {
+      if (transactionId == 0 || origin == null || origin.length() > 8192
+          || hash == null || hash.length != 32 || requestJson == null
+          || requestJson.length() > 1024 * 1024) {
+        result.completeExceptionally(new WebAuthnUtils.Exception("DATA_ERR"));
+        return;
+      }
+      final Scope scope = SCOPES.get(browsingContextId);
+      final Long windowId = scope == null ? null : SESSION_WINDOWS.get(scope.sessionId);
+      final Binding binding = windowId == null ? null : ACTIVITIES.get(windowId);
+      final Activity activity = binding == null ? null : binding.activity.get();
+      if (scope == null || !scope.active || activity == null
+          || activity.isFinishing() || activity.isDestroyed()) {
+        result.completeExceptionally(new WebAuthnUtils.Exception("ABORT_ERR"));
+        return;
+      }
+      final String capability = availability(windowId);
+      if (!"AVAILABLE".equals(capability)) {
+        result.completeExceptionally(new WebAuthnUtils.Exception(
+            "ORIGIN_PERMISSION_MISSING".equals(capability) ? "SECURITY_ERR" : "NOT_SUPPORTED_ERR"));
+        return;
+      }
+      cancelPending(windowId, "ABORT_ERR");
+      final Pending<T> pending = new Pending<>(transactionId, scope, binding, activity, result);
+      PENDING.put(windowId, pending);
+      ThreadUtils.getUiHandler().postDelayed(pending.timeout,
+          Math.max(1000L, Math.min(timeoutMs > 0 ? timeoutMs : 120000L, 120000L)));
+      try {
+        provider.request(activity, pending.cancellation, origin, hash, requestJson)
+            .withHandler(ThreadUtils.getUiHandler()).accept(pending::succeed, pending::fail);
+      } catch (final RuntimeException error) {
+        pending.fail(error);
+      }
+    });
+    return result;
+  }
+
+  private static final class Pending<T> {
+    final long transactionId;
+    final Scope scope;
+    final long generation;
+    final Binding binding;
+    final Activity activity;
+    final GeckoResult<T> result;
+    final CancellationSignal cancellation = new CancellationSignal();
+    final Runnable timeout = () -> cancel("TIMEOUT_ERR");
+    boolean completed;
+
+    Pending(final long transactionId, final Scope scope, final Binding binding, final Activity activity,
+        final GeckoResult<T> result) {
+      this.transactionId = transactionId;
+      this.scope = scope;
+      this.generation = scope.generation;
+      this.binding = binding;
+      this.activity = activity;
+      this.result = result;
+    }
+
+    void succeed(final T value) {
+      ThreadUtils.assertOnUiThread();
+      if (completed) return;
+      if (ACTIVITIES.get(binding.windowId) != binding || binding.activity.get() != activity
+          || !Long.valueOf(binding.windowId).equals(SESSION_WINDOWS.get(scope.sessionId))
+          || activity.isFinishing() || activity.isDestroyed()
+          || SCOPES.get(scope.browsingContextId) != scope || !scope.active
+          || generation != scope.generation) {
+        cancel("ABORT_ERR");
+        return;
+      }
+      if (value == null) {
+        fail(new WebAuthnUtils.Exception("DATA_ERR"));
+        return;
+      }
+      finish();
+      result.complete(value);
+    }
+
+    void fail(final Throwable error) {
+      ThreadUtils.assertOnUiThread();
+      if (completed) return;
+      finish();
+      result.completeExceptionally(error instanceof WebAuthnUtils.Exception ? error
+          : new WebAuthnUtils.Exception(error instanceof SecurityException
+              ? "SECURITY_ERR" : "UNKNOWN_ERR"));
+    }
+
+    void cancel(final String reason) {
+      if (completed) return;
+      finish();
+      try {
+        cancellation.cancel();
+      } catch (final RuntimeException ignored) {
+        // Provider/OEM cancellation failure cannot escape into the Activity lifecycle.
+      } finally {
+        // Some OEM providers never reply to cancellation (or throw here). Gecko's
+        // promise must still settle, and late provider replies must remain ignored.
+        result.completeExceptionally(new WebAuthnUtils.Exception(reason));
+      }
+    }
+
+    void finish() {
+      completed = true;
+      ThreadUtils.getUiHandler().removeCallbacks(timeout);
+      if (PENDING.get(binding.windowId) == this) PENDING.remove(binding.windowId);
+    }
+  }
+
+  private static void cancelPending(final long windowId, final String reason) {
+    final Pending<?> pending = PENDING.get(windowId);
+    if (pending != null) pending.cancel(reason);
+  }
+
+  private static void cancelPendingAll(final String reason) {
+    for (final Pending<?> pending : new ArrayList<>(PENDING.values())) pending.cancel(reason);
+  }
+}
