+/** The OS owns credential selection, signing and storage. No GMS or private key-store fallback. */
+public final class NavisAndroidCredentialProvider {
+  private static final int MAX_REQUEST_JSON_BYTES = 1024 * 1024;
+
+  private NavisAndroidCredentialProvider() {}
+
+  /**
+   * AVAILABLE means the browser can ask a discovered system provider. It does not assert that a
+   * provider is selected, has credentials, or trusts this browser's signing certificate. Android's
+   * provider-enablement query is restricted to the caller's own package, so only the actual request
+   * can determine those conditions; no hidden Settings or invented permission check is used.
+   */
+  public static String availability(final Context context) {
+    if (Build.VERSION.SDK_INT < 34) {
+      return "UNSUPPORTED_OS";
+    }
+    if (context == null) {
+      return "SYSTEM_UNAVAILABLE";
+    }
+    try {
+      return Api34.availability(context);
+    } catch (final RuntimeException exception) {
+      return "SYSTEM_UNAVAILABLE";
+    }
+  }
+
+  @UiThread
+  public static GeckoResult<WebAuthnUtils.MakeCredentialResponse> create(final Activity activity,
+      final CancellationSignal cancellation, final String origin, final byte[] clientDataHash,
+      final String requestJSON) {
+    ThreadUtils.assertOnUiThread();
+    final String error = preflight(activity, cancellation, origin, clientDataHash, requestJSON);
+    if (error != null) {
+      return failure(error);
+    }
+    return Api34.create(activity, cancellation, origin, clientDataHash.clone(), requestJSON);
+  }
+
+  @UiThread
+  public static GeckoResult<WebAuthnUtils.GetAssertionResponse> get(final Activity activity,
+      final CancellationSignal cancellation, final String origin, final byte[] clientDataHash,
+      final String requestJSON) {
+    ThreadUtils.assertOnUiThread();
+    final String error = preflight(activity, cancellation, origin, clientDataHash, requestJSON);
+    if (error != null) {
+      return failure(error);
+    }
+    return Api34.get(activity, cancellation, origin, clientDataHash.clone(), requestJSON);
+  }
+
+  private static String preflight(final Activity activity, final CancellationSignal cancellation,
+      final String origin, final byte[] hash, final String json) {
+    if (activity == null || activity.isFinishing() || activity.isDestroyed()) {
+      return "NOT_ALLOWED_ERR";
+    }
+    if (cancellation == null) {
+      return "DATA_ERR";
+    }
+    if (cancellation.isCanceled()) {
+      return "ABORT_ERR";
+    }
+    if (hash == null || hash.length != 32 || json == null || json.isEmpty()
+        || json.length() > MAX_REQUEST_JSON_BYTES
+        || json.getBytes(StandardCharsets.UTF_8).length > MAX_REQUEST_JSON_BYTES) {
+      return "DATA_ERR";
+    }
+    if (!isSerializedWebOrigin(origin)) {
+      return "SECURITY_ERR";
+    }
+    final String available = availability(activity);
+    if ("ORIGIN_PERMISSION_MISSING".equals(available)) {
+      return "SECURITY_ERR";
+    }
+    if (!"AVAILABLE".equals(available)) {
+      return "NOT_SUPPORTED_ERR";
+    }
+    return null;
+  }
+
+  private static boolean isSerializedWebOrigin(final String origin) {
+    if (origin == null || origin.isEmpty() || origin.length() > 16 * 1024) {
+      return false;
+    }
+    try {
+      final URI uri = new URI(origin);
+      return ("https".equals(uri.getScheme()) || "http".equals(uri.getScheme()))
+          && uri.getHost() != null && !uri.getHost().isEmpty() && uri.getRawUserInfo() == null
+          && uri.getRawQuery() == null && uri.getRawFragment() == null
+          && (uri.getRawPath() == null || uri.getRawPath().isEmpty()) && uri.getPort() >= -1
+          && uri.getPort() <= 65535;
+    } catch (final URISyntaxException exception) {
+      return false;
+    }
+  }
+
+  private static <T> GeckoResult<T> failure(final String code) {
+    return GeckoResult.fromException(new WebAuthnUtils.Exception(code));
+  }
+
+  /** Keep references to API-34-only Android classes out of the pre-34 availability path. */
+  private static final class Api34 {
+    static String availability(final Context context) {
+      final PackageManager packages = context.getPackageManager();
+      if (!packages.hasSystemFeature(PackageManager.FEATURE_CREDENTIALS)
+          || context.getSystemService(CredentialManager.class) == null) {
+        return "SYSTEM_UNAVAILABLE";
+      }
+      if (context.checkSelfPermission(Manifest.permission.CREDENTIAL_MANAGER_SET_ORIGIN)
+          != PackageManager.PERMISSION_GRANTED) {
+        return "ORIGIN_PERMISSION_MISSING";
+      }
+      for (final ResolveInfo resolved :
+          packages.queryIntentServices(new Intent(CredentialProviderService.SERVICE_INTERFACE),
+              PackageManager.ResolveInfoFlags.of(0))) {
+        final ServiceInfo service = resolved.serviceInfo;
+        if (service != null && service.enabled && service.exported
+            && service.applicationInfo != null && service.applicationInfo.enabled
+            && Manifest.permission.BIND_CREDENTIAL_PROVIDER_SERVICE.equals(service.permission)) {
+          return "AVAILABLE";
+        }
+      }
+      return "PROVIDER_UNAVAILABLE";
+    }
+
+    @SuppressLint("MissingPermission")
+    static GeckoResult<WebAuthnUtils.MakeCredentialResponse> create(final Activity activity,
+        final CancellationSignal cancellation, final String origin, final byte[] hash,
+        final String json) {
+      final Completion<WebAuthnUtils.MakeCredentialResponse> completion =
+          new Completion<>(cancellation);
+      try {
+        final CredentialManager manager = activity.getSystemService(CredentialManager.class);
+        if (manager == null) {
+          return failure("NOT_SUPPORTED_ERR");
+        }
+        manager.createCredential(activity,
+            WebAuthnCredentialManager.buildCreateCredentialRequest(origin, hash, json),
+            cancellation, activity.getMainExecutor(),
+            new OutcomeReceiver<CreateCredentialResponse, CreateCredentialException>() {
+              @Override
+              public void onResult(final CreateCredentialResponse response) {
+                if (!completion.begin()) {
+                  return;
+                }
+                try {
+                  completion.result.complete(
+                      WebAuthnCredentialManager.parseCreateCredentialResponse(response));
+                } catch (final java.lang.Exception invalid) {
+                  completion.result.completeExceptionally(new WebAuthnUtils.Exception("DATA_ERR"));
+                }
+              }
+              @Override
+              public void onError(final CreateCredentialException error) {
+                completion.reject(providerError(error.getType(), true));
+              }
+            });
+      } catch (final RuntimeException error) {
+        completion.reject(runtimeError(error));
+      }
+      return completion.result;
+    }
+
+    @SuppressLint("MissingPermission")
+    static GeckoResult<WebAuthnUtils.GetAssertionResponse> get(final Activity activity,
+        final CancellationSignal cancellation, final String origin, final byte[] hash,
+        final String json) {
+      final Completion<WebAuthnUtils.GetAssertionResponse> completion =
+          new Completion<>(cancellation);
+      try {
+        final CredentialManager manager = activity.getSystemService(CredentialManager.class);
+        if (manager == null) {
+          return failure("NOT_SUPPORTED_ERR");
+        }
+        manager.getCredential(activity,
+            WebAuthnCredentialManager.buildGetCredentialRequest(origin, hash, json), cancellation,
+            activity.getMainExecutor(),
+            new OutcomeReceiver<GetCredentialResponse, GetCredentialException>() {
+              @Override
+              public void onResult(final GetCredentialResponse response) {
+                if (!completion.begin()) {
+                  return;
+                }
+                try {
+                  completion.result.complete(
+                      WebAuthnCredentialManager.parseGetCredentialResponse(response));
+                } catch (final java.lang.Exception invalid) {
+                  completion.result.completeExceptionally(new WebAuthnUtils.Exception("DATA_ERR"));
+                }
+              }
+              @Override
+              public void onError(final GetCredentialException error) {
+                completion.reject(providerError(error.getType(), false));
+              }
+            });
+      } catch (final RuntimeException error) {
+        completion.reject(runtimeError(error));
+      }
+      return completion.result;
+    }
+
+    private static String providerError(final String type, final boolean creating) {
+      if (CreateCredentialException.TYPE_USER_CANCELED.equals(type)
+          || GetCredentialException.TYPE_USER_CANCELED.equals(type)
+          || CreateCredentialException.TYPE_INTERRUPTED.equals(type)
+          || GetCredentialException.TYPE_INTERRUPTED.equals(type)) {
+        return "ABORT_ERR";
+      }
+      if (CreateCredentialException.TYPE_NO_CREATE_OPTIONS.equals(type)) {
+        return "NOT_SUPPORTED_ERR";
+      }
+      if (GetCredentialException.TYPE_NO_CREDENTIAL.equals(type)) {
+        return "NOT_ALLOWED_ERR";
+      }
+      final String prefix = "androidx.credentials.TYPE_" + (creating ? "CREATE" : "GET")
+          + "_PUBLIC_KEY_CREDENTIAL_DOM_EXCEPTION/androidx.credentials.TYPE_";
+      if ((prefix + "SECURITY_ERROR").equals(type)) {
+        return "SECURITY_ERR";
+      }
+      if ((prefix + "NOT_ALLOWED_ERROR").equals(type)) {
+        return "NOT_ALLOWED_ERR";
+      }
+      if ((prefix + "ABORT_ERROR").equals(type)) {
+        return "ABORT_ERR";
+      }
+      if ((prefix + "DATA_ERROR").equals(type)) {
+        return "DATA_ERR";
+      }
+      if ((prefix + "INVALID_STATE_ERROR").equals(type)) {
+        return "INVALID_STATE_ERR";
+      }
+      if ((prefix + "NOT_SUPPORTED_ERROR").equals(type)) {
+        return "NOT_SUPPORTED_ERR";
+      }
+      return "UNKNOWN_ERR";
+    }
+  }
+
+  private static String runtimeError(final RuntimeException error) {
+    if (error instanceof SecurityException) {
+      return "SECURITY_ERR";
+    }
+    if (error instanceof OperationCanceledException) {
+      return "ABORT_ERR";
+    }
+    if (error instanceof IllegalArgumentException) {
+      return "DATA_ERR";
+    }
+    return "UNKNOWN_ERR";
+  }
+
+  private static final class Completion<T> {
+    final GeckoResult<T> result = new GeckoResult<>();
+    private final AtomicBoolean settled = new AtomicBoolean();
+    private final CancellationSignal cancellation;
+    Completion(final CancellationSignal cancellation) {
+      this.cancellation = cancellation;
+    }
+    boolean begin() {
+      if (!settled.compareAndSet(false, true)) {
+        return false;
+      }
+      if (!cancellation.isCanceled()) {
+        return true;
+      }
+      result.completeExceptionally(new WebAuthnUtils.Exception("ABORT_ERR"));
+      return false;
+    }
+    void reject(final String code) {
+      if (begin()) {
+        result.completeExceptionally(new WebAuthnUtils.Exception(code));
+      }
+    }
+  }
+}
