From 7af2f5f548502b5b6fc97d0f779eeb97256d24b3 Mon Sep 17 00:00:00 2001
From: willvar <0@willvar.tw>
Date: Sun, 30 Aug 2026 18:30:00 +0800
Subject: [PATCH] Dismiss anchored input pickers on content motion

---
 toolkit/actors/InputPickerChildCommon.sys.mjs | 53 ++++++++++++++++++-
 toolkit/actors/SelectChild.sys.mjs            | 28 ++++++++++++++
 2 files changed, 79 insertions(+), 2 deletions(-)

diff --git a/toolkit/actors/InputPickerChildCommon.sys.mjs b/toolkit/actors/InputPickerChildCommon.sys.mjs
--- a/toolkit/actors/InputPickerChildCommon.sys.mjs
+++ b/toolkit/actors/InputPickerChildCommon.sys.mjs
@@ -10,6 +10,7 @@ export class InputPickerChildCommon extends JSWindowActorChild {
   /** @type {HTMLInputElement} */
   #inputElement = null;
   #inputType = "";
+  #openingRect = null;
   #namespace;
   /** @type {AbortController} */
   #abortController;
@@ -35,6 +36,7 @@ export class InputPickerChildCommon extends JSWindowActorChild {
     this.closeImpl(this.#inputElement);
     this.#inputElement = null;
     this.#inputType = "";
+    this.#openingRect = null;
   }
 
   /**
@@ -50,7 +52,19 @@ export class InputPickerChildCommon extends JSWindowActorChild {
    */
   addListeners(aElement) {
     this.#abortController = new AbortController();
-    aElement.documentGlobal.addEventListener("pagehide", this, {
+    const win = aElement.documentGlobal;
+    win.addEventListener("pagehide", this, {
+      signal: this.#abortController.signal,
+    });
+    win.addEventListener("scroll", this, {
+      capture: true,
+      signal: this.#abortController.signal,
+    });
+    win.addEventListener("pointerdown", this, {
+      capture: true,
+      signal: this.#abortController.signal,
+    });
+    win.addEventListener("resize", this, {
       signal: this.#abortController.signal,
     });
   }
@@ -133,12 +147,14 @@ export class InputPickerChildCommon extends JSWindowActorChild {
           return;
         }
 
+        const rect = this.getBoundingContentRect(inputElement);
         this.#inputElement = inputElement;
         this.#inputType = inputElement.type;
+        this.#openingRect = { left: rect.left, top: rect.top };
         this.addListeners(inputElement);
 
         this.sendAsyncMessage(`InputPicker:Open`, {
-          rect: this.getBoundingContentRect(inputElement),
+          rect,
           dir: this.getComputedDirection(inputElement),
           type: inputElement.type,
           detail: openPickerDetail,
@@ -157,6 +173,39 @@ export class InputPickerChildCommon extends JSWindowActorChild {
         }
         break;
       }
+      case "scroll": {
+        if (this.#inputElement) {
+          const rect = this.getBoundingContentRect(this.#inputElement);
+          if (
+            this.#openingRect &&
+            rect.left === this.#openingRect.left &&
+            rect.top === this.#openingRect.top
+          ) {
+            break;
+          }
+          this.sendAsyncMessage(`InputPicker:Close`, {});
+          this.close();
+        }
+        break;
+      }
+      case "resize": {
+        if (this.#inputElement) {
+          this.sendAsyncMessage(`InputPicker:Close`, {});
+          this.close();
+        }
+        break;
+      }
+      case "pointerdown": {
+        if (
+          this.#inputElement &&
+          aEvent.target !== this.#inputElement &&
+          !this.#inputElement.contains(aEvent.target)
+        ) {
+          this.sendAsyncMessage(`InputPicker:Close`, {});
+          this.close();
+        }
+        break;
+      }
       default:
         break;
     }
diff --git a/toolkit/actors/SelectChild.sys.mjs b/toolkit/actors/SelectChild.sys.mjs
--- a/toolkit/actors/SelectChild.sys.mjs
+++ b/toolkit/actors/SelectChild.sys.mjs
@@ -46,6 +46,7 @@ export var SelectContentHelper = function (aElement, aOptions, aActor) {
   this.closedWithClickOn = false;
   this.isOpenedViaTouch = aOptions.isOpenedViaTouch;
   this._closeAfterBlur = true;
+  this._openingRect = null;
   this._pseudoStylesSetup = false;
   this.init();
   this.showDropDown();
@@ -62,6 +63,10 @@ SelectContentHelper.prototype = {
   init() {
     let win = this.element.documentGlobal;
     win.addEventListener("pagehide", this, { mozSystemGroup: true });
+    win.addEventListener("scroll", this, {
+      capture: true,
+    });
+    win.addEventListener("resize", this);
     this.element.addEventListener("blur", this, { mozSystemGroup: true });
     this.element.addEventListener("transitionend", this, {
       mozSystemGroup: true,
@@ -90,6 +95,10 @@ SelectContentHelper.prototype = {
     this.element.openInParentProcess = false;
     let win = this.element.documentGlobal;
     win.removeEventListener("pagehide", this, { mozSystemGroup: true });
+    win.removeEventListener("scroll", this, {
+      capture: true,
+    });
+    win.removeEventListener("resize", this);
     this.element.removeEventListener("blur", this, { mozSystemGroup: true });
     this.element.removeEventListener("transitionend", this, {
       mozSystemGroup: true,
@@ -99,6 +108,7 @@ SelectContentHelper.prototype = {
     this.mut.disconnect();
     this._updateTimer.disarm();
     this._updateTimer = null;
+    this._openingRect = null;
     gOpen = false;
   },
 
@@ -106,6 +116,7 @@ SelectContentHelper.prototype = {
     this.element.openInParentProcess = true;
     this._setupPseudoClassStyles();
     let rect = this._getBoundingContentRect();
+    this._openingRect = { left: rect.left, top: rect.top };
     let computedStyles = getComputedStyles(this.element);
     let options = this._buildOptionList();
     let defaultStyles = this.element.documentGlobal.getDefaultComputedStyle(
@@ -329,6 +340,23 @@ SelectContentHelper.prototype = {
           this.uninit();
         }
         break;
+      case "scroll": {
+        const rect = this._getBoundingContentRect();
+        if (
+          this._openingRect &&
+          rect.left === this._openingRect.left &&
+          rect.top === this._openingRect.top
+        ) {
+          break;
+        }
+        this.actor.sendAsyncMessage("Forms:HideDropDown", {});
+        this.uninit();
+        break;
+      }
+      case "resize":
+        this.actor.sendAsyncMessage("Forms:HideDropDown", {});
+        this.uninit();
+        break;
       case "transitionend":
         if (
           this.element === event.target &&
