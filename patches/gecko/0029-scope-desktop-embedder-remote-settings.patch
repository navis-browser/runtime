diff --git a/toolkit/moz.configure b/toolkit/moz.configure
--- a/toolkit/moz.configure
+++ b/toolkit/moz.configure
@@ -56,6 +56,59 @@ imply_option(
     "MOZ_DESKTOP_EMBEDDER_HISTORY", True, when="--enable-desktop-embedder"
 )
 
+option(
+    "--with-desktop-embedder-remote-settings-collections",
+    nargs=1,
+    help=(
+        "Comma-separated, sorted bucket/collection allowlist for a Desktop "
+        "Embedder's packaged and synchronized Remote Settings data"
+    ),
+)
+
+
+@depends(
+    "--with-desktop-embedder-remote-settings-collections",
+    "--enable-desktop-embedder",
+)
+def desktop_embedder_remote_settings_collections(value, desktop_embedder):
+    if not value:
+        return ()
+    if not desktop_embedder:
+        die(
+            "--with-desktop-embedder-remote-settings-collections requires "
+            "--enable-desktop-embedder"
+        )
+
+    entries = tuple(value[0].split(","))
+    allowed_characters = "abcdefghijklmnopqrstuvwxyz0123456789-_"
+    for entry in entries:
+        segments = entry.split("/")
+        if (
+            len(segments) != 2
+            or not all(segments)
+            or any(
+                character not in allowed_characters
+                for segment in segments
+                for character in segment
+            )
+        ):
+            die(
+                "Invalid Desktop Embedder Remote Settings collection "
+                f"identifier: {entry!r}"
+            )
+    if entries != tuple(sorted(set(entries))):
+        die(
+            "Desktop Embedder Remote Settings collections must be sorted "
+            "and unique"
+        )
+    return entries
+
+
+set_config(
+    "MOZ_DESKTOP_EMBEDDER_REMOTE_SETTINGS_COLLECTIONS",
+    desktop_embedder_remote_settings_collections,
+)
+
 
 option(
     "--enable-observability-runtime",
