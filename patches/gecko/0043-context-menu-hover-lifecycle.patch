+#ifdef MOZ_DESKTOP_EMBEDDER
+uint64_t BrowserParent::sContextMenuMouseEventId = 0;
+
+static bool HasContextMenuForBrowser(BrowserParent& aBrowser) {
+  Element* owner = aBrowser.GetBrowsingContext()->Top()->GetEmbedderElement();
+  nsXULPopupManager* manager = nsXULPopupManager::GetInstance();
+  nsIFrame* popup = manager ? manager->GetTopPopup(PopupType::Menu) : nullptr;
+  return owner && popup &&
+         static_cast<nsMenuPopupFrame*>(popup)->IsContextMenu() &&
+         popup->GetContent()->OwnerDoc() == owner->OwnerDoc();
+}
+
+/* static */
+void BrowserParent::FlushContextMenuMouseExits(Document& aChromeDocument) {
+  if (!sLayerToBrowserParentTable) {
+    return;
+  }
+  AutoTArray<RefPtr<BrowserParent>, 4> pending;
+  RefPtr<BrowserParent> latest;
+  for (auto iter = sLayerToBrowserParentTable->Iter(); !iter.Done(); iter.Next()) {
+    RefPtr<BrowserParent> browser = do_QueryReferent(iter.Data());
+    if (!browser || (!browser->mContextMenuMouseExit &&
+                     !browser->mContextMenuMouseMove)) {
+      continue;
+    }
+    Element* owner = browser->GetBrowsingContext()->Top()->GetEmbedderElement();
+    if (owner && owner->OwnerDoc() == &aChromeDocument &&
+        !HasContextMenuForBrowser(*browser)) {
+      pending.AppendElement(browser);
+      if (!latest || browser->mContextMenuMouseEventId >
+                         latest->mContextMenuMouseEventId) {
+        latest = browser;
+      }
+    }
+  }
+  // Clear every frozen frame before resuming the last real pointer target.
+  // A root PresShell synthetic hit test alone cannot recover a precise APZ
+  // target inside an out-of-process iframe. Keep only the latest real event,
+  // not a history of moves through other frames under the open menu.
+  auto move = latest ? std::move(latest->mContextMenuMouseMove) : nullptr;
+  for (const auto& browser : pending) {
+    browser->mContextMenuMouseMove = nullptr;
+    browser->mContextMenuMouseEventId = 0;
+    if (auto event = std::move(browser->mContextMenuMouseExit)) {
+      browser->SendRealMouseEvent(*event);
+    }
+  }
+  if (move) {
+    if (move->mMessage == eMouseMove) {
+      latest->MouseEnterIntoWidget();
+    }
+    latest->SendRealMouseEvent(*move);
+  }
+}
+#endif
+
 void BrowserParent::SendRealMouseEvent(WidgetMouseEvent& aMouseOrPointerEvent) {
   if (mIsDestroyed) {
     return;
   }
 
+#ifdef MOZ_DESKTOP_EMBEDDER
+  // A context menu owns pointer navigation even outside its popup widget.
+  // Keep content hover frozen, while allowing the parent's remote-target
+  // routing to leave this actor (including moves into another chrome window).
+  if (HasContextMenuForBrowser(*this)) {
+    if (aMouseOrPointerEvent.mMessage == eMouseExitFromWidget) {
+      mContextMenuMouseExit =
+          MakeUnique<WidgetMouseEvent>(aMouseOrPointerEvent);
+      if (aMouseOrPointerEvent.mReason == WidgetMouseEvent::eReal) {
+        mContextMenuMouseMove = nullptr;
+        mContextMenuMouseEventId = ++sContextMenuMouseEventId;
+        UnsetLastMouseRemoteTarget(this);
+      }
+      return;
+    }
+    if (aMouseOrPointerEvent.mMessage == eMouseMove ||
+        aMouseOrPointerEvent.mMessage == eMouseEnterIntoWidget) {
+      if (aMouseOrPointerEvent.mReason == WidgetMouseEvent::eReal) {
+        mContextMenuMouseMove =
+            MakeUnique<WidgetMouseEvent>(aMouseOrPointerEvent);
+        mContextMenuMouseEventId = ++sContextMenuMouseEventId;
+      }
+      return;
+    }
+  } else {
+    mContextMenuMouseExit = nullptr;
+    mContextMenuMouseMove = nullptr;
+    mContextMenuMouseEventId = 0;
+  }
+#endif
+
   // XXXedgar, if the synthesized mouse events could deliver to the correct
   // process directly (see
   // https://bugzilla.mozilla.org/show_bug.cgi?id=1549355), we probably don't
