+void NavisAndroidWindowSupport::PrintToPdf(
+    jni::Object::Param aResult, int64_t aSourceWindow, int64_t aPrintWindow,
+    int32_t aWidth, int32_t aHeight, int32_t aLeft, int32_t aTop,
+    int32_t aRight, int32_t aBottom, bool aColor, jni::IntArray::Param aRanges) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!aResult) {
+    return;
+  }
+  auto result = java::GeckoResult::Ref::From(aResult);
+  auto fail = [&result](const char* aMessage) {
+    result->CompleteExceptionally(
+        java::sdk::IllegalStateException::New(aMessage).Cast<jni::Throwable>());
+  };
+  if (!mDOMWindow || !mDOMWindow->GetDoc() || !aRanges ||
+      aWidth < 256 || aHeight < 256 || aWidth > 200000 || aHeight > 200000 ||
+      aLeft < 0 || aTop < 0 || aRight < 0 || aBottom < 0 ||
+      aLeft >= aWidth || aRight >= aWidth || aTop >= aHeight ||
+      aBottom >= aHeight || aLeft + aRight >= aWidth ||
+      aTop + aBottom >= aHeight || aRanges->Length() > 2048) {
+    fail("Invalid or closed print document");
+    return;
+  }
+  nsCOMPtr<nsIDocShellTreeOwner> treeOwner = mDOMWindow->GetTreeOwner();
+  RefPtr<dom::BrowsingContext> primary;
+  if (!treeOwner || NS_FAILED(treeOwner->GetPrimaryContentBrowsingContext(
+                        getter_AddRefs(primary))) || !primary) {
+    fail("Print source is unavailable");
+    return;
+  }
+  RefPtr<dom::WindowGlobalParent> source =
+      dom::WindowGlobalParent::GetByInnerWindowId(aSourceWindow);
+  RefPtr<dom::WindowGlobalParent> document =
+      dom::WindowGlobalParent::GetByInnerWindowId(aPrintWindow);
+  if (!source || !document ||
+      primary->Canonical()->GetCurrentWindowGlobal() != source ||
+      document->GetBrowsingContext()->GetCurrentWindowGlobal() != document) {
+    fail("Print source changed");
+    return;
+  }
+  RefPtr<dom::CanonicalBrowsingContext> context = document->GetBrowsingContext();
+  if (context != primary) {
+    dom::Element* element = context->GetEmbedderElement();
+    nsAutoString id;
+    if (element) {
+      element->GetAttr(kNameSpaceID_None, nsGkAtoms::id, id);
+    }
+    if (!context->IsTop() || !element || element->OwnerDoc() != mDOMWindow->GetDoc() ||
+        !id.EqualsLiteral("navis-print-clone")) {
+      fail("Print document belongs to another window");
+      return;
+    }
+  }
+  nsTArray<int32_t> ranges = aRanges->GetElements();
+  if (ranges.Length() % 2) {
+    fail("Invalid print ranges");
+    return;
+  }
+  int32_t previous = 0;
+  for (size_t i = 0; i < ranges.Length(); i += 2) {
+    if (ranges[i] <= previous || ranges[i + 1] < ranges[i] ||
+        ranges[i + 1] > 1000000) {
+      fail("Invalid print ranges");
+      return;
+    }
+    previous = ranges[i + 1];
+  }
+  nsCOMPtr<nsIPrintSettingsService> service =
+      do_GetService("@mozilla.org/gfx/printsettings-service;1");
+  nsCOMPtr<nsIPrintSettings> settings;
+  if (!service || NS_FAILED(service->CreateNewPrintSettings(getter_AddRefs(settings)))) {
+    fail("Print settings are unavailable");
+    return;
+  }
+  auto stream = java::GeckoInputStream::New(nullptr);
+  auto output = MakeRefPtr<GeckoViewOutputStream>(stream);
+  settings->SetPrinterName(u"Mozilla Save to PDF"_ns);
+  settings->SetOutputDestination(nsIPrintSettings::kOutputDestinationStream);
+  settings->SetOutputFormat(nsIPrintSettings::kOutputFormatPDF);
+  settings->SetOutputStream(output);
+  settings->SetPrintSilent(true);
+  settings->SetPaperSizeUnit(nsIPrintSettings::kPaperSizeInches);
+  settings->SetPaperWidth(std::min(aWidth, aHeight) / 1000.0);
+  settings->SetPaperHeight(std::max(aWidth, aHeight) / 1000.0);
+  settings->SetOrientation(aWidth > aHeight ? nsIPrintSettings::kLandscapeOrientation
+                                         : nsIPrintSettings::kPortraitOrientation);
+  settings->SetMarginLeft(aLeft / 1000.0);
+  settings->SetMarginTop(aTop / 1000.0);
+  settings->SetMarginRight(aRight / 1000.0);
+  settings->SetMarginBottom(aBottom / 1000.0);
+  settings->SetPrintInColor(aColor);
+  settings->SetPageRanges(ranges);
+  settings->SetHeaderStrLeft(EmptyString());
+  settings->SetHeaderStrCenter(EmptyString());
+  settings->SetHeaderStrRight(EmptyString());
+  settings->SetFooterStrLeft(EmptyString());
+  settings->SetFooterStrCenter(EmptyString());
+  settings->SetFooterStrRight(EmptyString());
+  RefPtr<dom::CanonicalBrowsingContext::PrintPromise> printing = context->Print(settings);
+  result->Complete(stream);
+  printing->Then(GetCurrentSerialEventTarget(), __func__,
+      [stream](const dom::CanonicalBrowsingContext::PrintPromise::ResolveOrRejectValue& value) {
+        if (value.IsReject()) {
+          stream->WriteError();
+        }
+      });
+}
