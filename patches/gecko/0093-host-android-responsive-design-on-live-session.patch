diff --git a/mobile/shared/modules/navis/NavisAndroidResponsive.sys.mjs b/mobile/shared/modules/navis/NavisAndroidResponsive.sys.mjs
new file mode 100644
--- /dev/null
+++ b/mobile/shared/modules/navis/NavisAndroidResponsive.sys.mjs
@@ -0,0 +1,242 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+let browserLifecycleDetached = false;
+
+function manager() {
+  const { require } = ChromeUtils.importESModule(
+    "resource://devtools/shared/loader/Loader.sys.mjs");
+  const { gDevToolsBrowser } = require("devtools/client/framework/devtools-browser");
+  if (!browserLifecycleDetached) {
+    // As on desktop, use the shared stylesheet service, not Firefox's window
+    // startup/shutdown ownership. Navis closes its own toolbox and RDM clients.
+    for (const topic of ["browser-delayed-startup-finished", "quit-application", "devtools:loader:destroy"]) {
+      try { Services.obs.removeObserver(gDevToolsBrowser, topic); } catch {}
+    }
+    browserLifecycleDetached = true;
+  }
+  return require("devtools/client/responsive/manager");
+}
+
+/** Events identify the actual Navis tab, including its remoteness/close owner. */
+class TabEvents {
+  listeners = new Map();
+  addEventListener(type, listener, options = {}) {
+    if (!listener || options?.signal?.aborted) return;
+    if (!this.listeners.has(type)) this.listeners.set(type, new Map());
+    const entries = this.listeners.get(type);
+    if (entries.has(listener)) return;
+    const entry = { once: Boolean(options?.once), signal: options?.signal };
+    entry.abort = () => this.removeEventListener(type, listener);
+    entries.set(listener, entry);
+    entry.signal?.addEventListener("abort", entry.abort, { once: true });
+  }
+  removeEventListener(type, listener) {
+    const entry = this.listeners.get(type)?.get(listener);
+    entry?.signal?.removeEventListener("abort", entry.abort);
+    this.listeners.get(type)?.delete(listener);
+  }
+  emit(type, tab) {
+    const event = Object.freeze({ type, target: tab, currentTarget: tab });
+    for (const [listener, entry] of [...(this.listeners.get(type) || [])]) {
+      if (entry.once) this.removeEventListener(type, listener);
+      try {
+        if (typeof listener === "function") listener.call(tab, event);
+        else listener.handleEvent(event);
+      } catch (error) { Cu.reportError(error); }
+    }
+  }
+  clear() {
+    for (const [type, entries] of this.listeners) {
+      for (const listener of [...entries.keys()]) this.removeEventListener(type, listener);
+    }
+    this.listeners.clear();
+  }
+}
+
+/**
+ * Real target-side host contract. Construct before the browser's FIRST DOM
+ * insertion: moving a live remote browser would discard its page/session state.
+ * The container owns the existing browser, never a screenshot or second tab.
+ */
+export function createNavisAndroidResponsiveTarget(window, browser, tab) {
+  if (window.document.documentURI !== "chrome://navis-android/content/host.xhtml" ||
+      browser.documentGlobal !== window || tab.browser !== browser || tab.isPopup ||
+      browser.isConnected || window.gBrowser) {
+    throw new Error("Responsive target requires an uninserted owned Navis browser");
+  }
+  const document = window.document;
+  const container = document.createXULElement("vbox");
+  container.className = "navis-android-browser-container browserContainer";
+  const stack = document.createXULElement("stack");
+  stack.className = "navis-android-browser-stack browserStack";
+  browser.classList.add("navis-android-content-browser");
+  stack.append(browser);
+  container.append(stack);
+  const events = new TabEvents();
+  const selections = new TabEvents();
+  let closed = false;
+  let ready = false;
+  let notificationBox;
+  let responsiveManager;
+  let zoomBeforeResponsive;
+
+  Object.defineProperties(tab, {
+    tagName: { value: "tab" },
+    ownerDocument: { get: () => document },
+    documentGlobal: { get: () => window },
+    selected: { get: () => tab.getActive() },
+    addEventListener: { value: events.addEventListener.bind(events) },
+    removeEventListener: { value: events.removeEventListener.bind(events) },
+  });
+  const checkBrowser = candidate => {
+    if (closed || candidate !== browser || browser.documentGlobal !== window) {
+      throw new Error("The responsive target no longer belongs to this host");
+    }
+    return browser;
+  };
+  window.gBrowser = Object.freeze({
+    get selectedTab() { return closed ? null : tab; },
+    set selectedTab(candidate) {
+      if (candidate !== tab || closed) throw new Error("Cannot select another Session through this render host");
+      browser.focus();
+    },
+    get selectedBrowser() { return closed ? null : browser; },
+    get tabs() { return closed ? [] : [tab]; },
+    get browsers() { return closed ? [] : [browser]; },
+    tabContainer: selections,
+    getBrowserForTab(candidate) {
+      if (candidate !== tab) throw new Error("The tab belongs to another Session");
+      return checkBrowser(browser);
+    },
+    getTabForBrowser(candidate) { checkBrowser(candidate); return tab; },
+    getBrowserContainer(candidate) { checkBrowser(candidate); return container; },
+    getNotificationBox(candidate) {
+      checkBrowser(candidate);
+      // Use Gecko's actual visible notification widget, not a no-op facade.
+      if (!notificationBox) {
+        notificationBox = new window.MozElements.NotificationBox(element => container.prepend(element));
+      }
+      return notificationBox;
+    },
+  });
+  window.gFissionBrowser = true;
+  window.gBrowserInit = Object.freeze({
+    get delayedStartupFinished() { return ready && !closed; },
+    isAdoptingTab: () => false,
+  });
+  const media = window.matchMedia("(prefers-color-scheme: dark)");
+  const updateTheme = () => {
+    const pref = Services.prefs.getStringPref("devtools.theme", "auto");
+    document.documentElement.setAttribute("devtoolstheme",
+      pref === "dark" || (pref === "auto" && media.matches) ? "dark" : "light");
+  };
+  media.addEventListener("change", updateTheme);
+  Services.prefs.addObserver("devtools.theme", updateTheme);
+  updateTheme();
+  const remotenessChanged = () => events.emit("TabRemotenessChange", tab);
+  browser.addEventListener("XULFrameLoaderCreated", remotenessChanged);
+  const restoreResponsiveZoom = ({ tab: changedTab }) => {
+    if (changedTab !== tab || zoomBeforeResponsive === undefined) return;
+    if (!closed && browser.browsingContext) browser.fullZoom = zoomBeforeResponsive;
+    zoomBeforeResponsive = undefined;
+  };
+
+  async function closeResponsive() {
+    if (!responsiveManager?.isActiveForTab(tab)) return;
+    let finished;
+    const completion = new Promise(resolve => { finished = resolve; });
+    const onClosed = ({ tab: changedTab }) => { if (changedTab === tab) finished(); };
+    responsiveManager.on("off", onClosed);
+    try {
+      await responsiveManager.closeIfNeeded(window, tab, { trigger: "toolbox" });
+      // The upstream toolbar may already be destroying this UI. In that case
+      // closeIfNeeded returns early: only its actual "off" confirms cleanup.
+      if (responsiveManager.isActiveForTab(tab)) await completion;
+    } finally { responsiveManager.off("off", onClosed); }
+  }
+
+  async function rollbackFailedOpen() {
+    const ui = responsiveManager?.getResponsiveUIForTab(tab);
+    if (!ui) return;
+    // Upstream initialized is resolved only after success. Calling its normal
+    // destroy after initialize rejects would wait forever. Undo only resources
+    // this failed transaction actually acquired, including the real actor
+    // clients (which own UA/DPR/touch overrides); do not report a tab discard.
+    if (ui.networkFront) await ui.updateNetworkThrottling();
+    await ui.commands?.destroy();
+    events.removeEventListener("TabBrowserDiscarded", ui);
+    events.removeEventListener("TabClose", ui);
+    window.removeEventListener("unload", ui);
+    window.removeEventListener("FullZoomChange", ui);
+    for (const type of ["mousedown", "mousemove", "mouseup"]) browser.removeEventListener(type, ui);
+    ui.resizeToolbarObserver?.disconnect();
+    ui.rdmFrame?.contentWindow?.removeEventListener("message", ui);
+    ui.rdmFrame?.contentWindow?.destroy?.();
+    ui.rdmFrame?.remove();
+    ui.screenBox?.remove();
+    if (browser.browsingContext) {
+      browser.leaveResponsiveMode();
+      window.InspectorUtils.setVerticalClipping(browser.browsingContext, 0);
+      window.InspectorUtils.setDynamicToolbarMaxHeight(browser.browsingContext, 0);
+    }
+    container.classList.remove("responsive-mode");
+    for (const name of ["--rdm-width", "--rdm-height", "--rdm-zoom"]) stack.style.removeProperty(name);
+    for (const name of ["top", "visibility"]) browser.style.removeProperty(name);
+    responsiveManager.activeTabs.delete(tab);
+    responsiveManager.removeMenuCheckListenerFor(window);
+    responsiveManager.emit("off", { tab });
+  }
+
+  return Object.freeze({
+    container,
+    tab,
+    markReady() { ready = true; },
+    selectionChanged() { if (!closed) selections.emit("TabSelect", tab); },
+    async toggle() {
+      checkBrowser(browser);
+      if (!ready || browser.navisNativePresentation !== false || !browser.browsingContext) {
+        throw new Error("Responsive Design needs a live web document");
+      }
+      if (!responsiveManager) {
+        responsiveManager = manager();
+        responsiveManager.on("off", restoreResponsiveZoom);
+      }
+      if (responsiveManager.isActiveForTab(tab)) await closeResponsive();
+      else {
+        zoomBeforeResponsive = browser.fullZoom;
+        try { await responsiveManager.openIfNeeded(window, tab, { trigger: "toolbox" }); }
+        catch (error) { await rollbackFailedOpen(); throw error; }
+      }
+      return { responsive: responsiveManager.isActiveForTab(tab), zoom: browser.fullZoom };
+    },
+    zoom(command) {
+      checkBrowser(browser);
+      if (!ready || browser.navisNativePresentation !== false) throw new Error("The target has no web viewport");
+      const current = browser.fullZoom;
+      const next = command === "zoom-in" ? current + 0.1 : command === "zoom-out" ? current - 0.1 :
+        command === "reset-zoom" ? 1 : NaN;
+      if (!Number.isFinite(next)) throw new TypeError("Unknown viewport zoom command");
+      browser.fullZoom = Math.min(2, Math.max(0.25, Math.round(next * 100) / 100));
+      return { zoom: browser.fullZoom };
+    },
+    async restore() {
+      await closeResponsive();
+    },
+    destroy() {
+      if (closed) return;
+      events.emit("TabClose", tab);
+      responsiveManager?.off("off", restoreResponsiveZoom);
+      if (responsiveManager?.isActiveForTab(tab)) {
+        responsiveManager.closeIfNeeded(window, tab, { reason: "unload" }).catch(Cu.reportError);
+      }
+      closed = true;
+      events.clear();
+      selections.clear();
+      browser.removeEventListener("XULFrameLoaderCreated", remotenessChanged);
+      media.removeEventListener("change", updateTheme);
+      Services.prefs.removeObserver("devtools.theme", updateTheme);
+    },
+  });
+}
diff --git a/mobile/shared/chrome/navis/host.css b/mobile/shared/chrome/navis/host.css
new file mode 100644
--- /dev/null
+++ b/mobile/shared/chrome/navis/host.css
@@ -0,0 +1,39 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+.navis-android-browser-container {
+  display: flex;
+  flex: 1;
+  min-width: 0;
+  min-height: 0;
+  flex-direction: column;
+  position: relative;
+  --browser-stack-z-index-rdm-toolbar: 3;
+}
+
+.navis-android-browser-stack {
+  display: grid;
+  flex: 1;
+  min-width: 0;
+  min-height: 0;
+}
+
+.navis-android-content-browser {
+  grid-area: 1 / 1;
+  width: 100%;
+  min-width: 0;
+  min-height: 0;
+}
+
+/* Same host constraint as Navis Desktop. Gecko's original RDM stylesheet
+ * controls grid/scale and handles; normal browser flex must not override it. */
+.browserContainer.responsive-mode > .browserStack > :is(browser, .rdm-screen-box) {
+  width: var(--rdm-width) !important;
+  height: var(--rdm-height) !important;
+  min-width: 0 !important;
+  min-height: 0 !important;
+  max-width: none !important;
+  max-height: none !important;
+  flex: none !important;
+}
