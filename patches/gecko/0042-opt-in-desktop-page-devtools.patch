diff --git a/devtools/shared/performance-new/recording-utils.sys.mjs b/devtools/shared/performance-new/recording-utils.sys.mjs
index 8969dad70f8c..d0848395e2d7 100644
--- a/devtools/shared/performance-new/recording-utils.sys.mjs
+++ b/devtools/shared/performance-new/recording-utils.sys.mjs
@@ -14,11 +14,31 @@
  * @type {GetActiveBrowserID}
  */
 export function getActiveBrowserID() {
-  const win = Services.wm.getMostRecentBrowserWindow();
+  const browserWindow = Services.wm.getMostRecentBrowserWindow();
+  const candidates = [
+    browserWindow,
+    Services.focus.activeWindow,
+    Services.focus.activeWindow?.opener,
+  ];
+  for (const win of candidates) {
+    const browserId =
+      win?.gBrowser?.selectedBrowser?.browsingContext?.browserId;
+    if (browserId) {
+      return browserId;
+    }
+  }
 
-  const browserId = win?.gBrowser?.selectedBrowser?.browsingContext?.browserId;
-  if (browserId) {
-    return browserId;
+  // Product-neutral embedders may use a chrome window type other than
+  // navigator:browser, so getMostRecentBrowserWindow() legitimately returns
+  // null even though their local-tab facade exposes gBrowser. The focused
+  // window path above handles ordinary and separate toolboxes; this final
+  // fallback also covers a temporarily unfocused application window.
+  for (const win of Services.wm.getEnumerator(null)) {
+    const browserId =
+      win?.gBrowser?.selectedBrowser?.browsingContext?.browserId;
+    if (browserId) {
+      return browserId;
+    }
   }
 
   console.error(
