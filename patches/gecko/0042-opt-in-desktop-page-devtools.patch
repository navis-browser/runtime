From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: willvar <0@willvar.tw>
Date: Fri, 4 Sep 2026 01:08:00 +0800
Subject: [PATCH] Add opt-in desktop page developer tools

---
diff --git a/devtools/startup/DevToolsStartup.sys.mjs b/devtools/startup/DevToolsStartup.sys.mjs
index ab008a13b4a6..b2f8fc2ef966 100644
--- a/devtools/startup/DevToolsStartup.sys.mjs
+++ b/devtools/startup/DevToolsStartup.sys.mjs
@@ -357,6 +357,16 @@ export class DevToolsStartup {
   }
 
   handle(cmdLine) {
+    if (AppConstants.MOZ_DESKTOP_EMBEDDER_DEVTOOLS) {
+      if (cmdLine.state == Ci.nsICommandLine.STATE_INITIAL_LAUNCH) {
+        Services.obs.addObserver(
+          this.onWindowReady,
+          "browser-delayed-startup-finished"
+        );
+      }
+      return;
+    }
+
     const flags = this.readCommandLineFlags(cmdLine);
 
     // handle() can be called after browser startup (e.g. opening links from other apps).
@@ -566,6 +576,11 @@ export class DevToolsStartup {
    * @param {Window} window
    */
   onWindowReady(window) {
+    if (AppConstants.MOZ_DESKTOP_EMBEDDER_DEVTOOLS) {
+      JsonView.initialize();
+      return;
+    }
+
     if (
       this.isDisabledByPolicy() ||
       AppConstants.MOZ_APP_NAME == "thunderbird"
diff --git a/netwerk/protocol/about/nsAboutProtocolHandler.cpp b/netwerk/protocol/about/nsAboutProtocolHandler.cpp
index 8337daae876a..d314d63a7521 100644
--- a/netwerk/protocol/about/nsAboutProtocolHandler.cpp
+++ b/netwerk/protocol/about/nsAboutProtocolHandler.cpp
@@ -33,6 +33,11 @@ static bool IsDesktopEmbedderEngineAboutURI(nsIURI* aURI) {
   if (NS_FAILED(NS_GetAboutModuleName(aURI, name))) {
     return false;
   }
+#  ifdef MOZ_DESKTOP_EMBEDDER_DEVTOOLS
+  if (name.EqualsLiteral("devtools-toolbox")) {
+    return true;
+  }
+#  endif
   return name.EqualsLiteral("blank") || name.EqualsLiteral("srcdoc") ||
          name.EqualsLiteral("neterror") || name.EqualsLiteral("certerror") ||
          name.EqualsLiteral("httpsonlyerror") ||
diff --git a/toolkit/moz.configure b/toolkit/moz.configure
index 77c63476f013..124e8bd637d7 100644
--- a/toolkit/moz.configure
+++ b/toolkit/moz.configure
@@ -51,7 +51,38 @@ option(
 )
 set_config("MOZ_DESKTOP_EMBEDDER", True, when="--enable-desktop-embedder")
 set_define("MOZ_DESKTOP_EMBEDDER", True, when="--enable-desktop-embedder")
-imply_option("MOZ_DEVTOOLS", "none", when="--enable-desktop-embedder")
+
+option(
+    "--enable-desktop-embedder-devtools",
+    help="Build Gecko page developer tools for the desktop embedder",
+)
+
+
+@depends("--enable-desktop-embedder-devtools", "--enable-desktop-embedder")
+def desktop_embedder_devtools(value, desktop_embedder):
+    if value and not desktop_embedder:
+        die(
+            "--enable-desktop-embedder-devtools requires "
+            "--enable-desktop-embedder"
+        )
+    return bool(value)
+
+
+set_config("MOZ_DESKTOP_EMBEDDER_DEVTOOLS", desktop_embedder_devtools)
+set_define("MOZ_DESKTOP_EMBEDDER_DEVTOOLS", True, when=desktop_embedder_devtools)
+
+
+@depends(desktop_embedder_devtools)
+def desktop_embedder_devtools_mode(value):
+    return "all" if value else "none"
+
+
+imply_option(
+    "MOZ_DEVTOOLS",
+    desktop_embedder_devtools_mode,
+    reason="--enable-desktop-embedder",
+    when="--enable-desktop-embedder",
+)
 imply_option(
     "MOZ_DESKTOP_EMBEDDER_HISTORY", True, when="--enable-desktop-embedder"
 )
diff --git a/toolkit/components/moz.build b/toolkit/components/moz.build
--- a/toolkit/components/moz.build
+++ b/toolkit/components/moz.build
@@ -128,8 +128,9 @@ if CONFIG["MOZ_DESKTOP_EMBEDDER"]:
         "thumbnails",
         "timermanager",
         "translations",
-        "viewsource",
     ]
+    if not CONFIG["MOZ_DESKTOP_EMBEDDER_DEVTOOLS"]:
