--- /dev/null
+++ b/mobile/shared/modules/navis/NavisAndroidProduct.sys.mjs
@@ -0,0 +1,274 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import {
+  prepareDesktopCleanLinks,
+  projectDesktopCopiedLink,
+  setDesktopCleanLinksEnabled,
+} from "resource://gre/modules/navis/DesktopCleanLinks.sys.mjs";
+import { NavisProcessManager, getAdditionalSupportDiagnostics, getNavisLicenseText }
+  from "resource://gre/modules/navis/DesktopProductPages.sys.mjs";
+import { setAppearanceSetting }
+  from "resource://gre/modules/navis/NavisSettingsPolicy.sys.mjs";
+import { initializeAndroidSearch, queryAndroidSearch }
+  from "resource://gre/modules/NavisAndroidSearch.sys.mjs";
+
+const processManagers = new WeakMap();
+function processManager(window) {
+  if (!processManagers.has(window)) processManagers.set(window, new NavisProcessManager());
+  return processManagers.get(window);
+}
+
+// Match the desktop storage boundary. The upstream convenience flag also
+// invokes cleaners for product capabilities Navis deliberately excludes.
+const SITE_DATA_FLAGS = [
+  "CLEAR_COOKIES", "CLEAR_DOM_QUOTA", "CLEAR_REPORTS", "CLEAR_HSTS",
+  "CLEAR_AUTH_TOKENS", "CLEAR_AUTH_CACHE", "CLEAR_FINGERPRINTING_PROTECTION_STATE",
+  "CLEAR_BOUNCE_TRACKING_PROTECTION_STATE", "CLEAR_STORAGE_PERMISSIONS",
+  "CLEAR_MESSAGING_LAYER_SECURITY_STATE", "CLEAR_TLS_TOKEN_CACHE",
+].reduce((flags, key) => (flags | Ci.nsIClearDataService[key]) >>> 0, 0);
+
+const siteRequests = new WeakMap();
+
+function clearWebPermissions(principal = null, types = null) {
+  for (const permission of Services.perms.all) {
+    const owner = permission.principal;
+    if (owner.isContentPrincipal && !owner.addonId &&
+        (owner.schemeIs("http") || owner.schemeIs("https")) &&
+        (!principal || owner.equals(principal)) && (!types || types.includes(permission.type))) {
+      Services.perms.removePermission(permission);
+    }
+  }
+}
+
+function read(object, key, fallback = "") {
+  try { return object?.[key] ?? fallback; } catch { return fallback; }
+}
+
+function text(value) {
+  return typeof value === "string" ? value.slice(0, 4096) : "";
+}
+
+function webIdentity(browser) {
+  const uri = browser?.documentURI;
+  const principal = browser?.contentPrincipal;
+  try {
+    if (!uri || !principal || principal.isSystemPrincipal || principal.addonId ||
+        !principal.isContentPrincipal ||
+        (!uri.schemeIs("http") && !uri.schemeIs("https")) ||
+        principal.URI.prePath !== uri.prePath) {
+      return null;
+    }
+    return { principal, origin: principal.URI.prePath, host: principal.URI.asciiHost };
+  } catch { return null; }
+}
+
+function loopback(host) {
+  const value = host.toLowerCase().replace(/^\[|\]$/gu, "");
+  if (value === "localhost" || value.endsWith(".localhost") ||
+      value === "::1" || value === "0:0:0:0:0:0:0:1") return true;
+  const octets = value.split(".");
+  return octets.length === 4 && Number(octets[0]) === 127 &&
+    octets.every(part => /^\d{1,3}$/u.test(part) && Number(part) <= 255);
+}
+
+function certificate(cert) {
+  if (!cert) return null;
+  const fields = ["displayName", "commonName", "subjectName", "organization", "organizationalUnit",
+    "issuerCommonName", "issuerOrganization", "issuerName", "serialNumber", "sha256Fingerprint",
+    "sha256SubjectPublicKeyInfoDigest"];
+  const result = Object.fromEntries(fields.map(key => [key, text(read(cert, key))]));
+  const validity = read(cert, "validity", null);
+  for (const [key, source] of [["validFrom", "notBefore"], ["validTo", "notAfter"]]) {
+    const time = Number(read(validity, source, 0)) / 1000;
+    result[key] = Number.isFinite(time) && time > 0 ? time : null;
+  }
+  return result;
+}
+
+function siteInformation(browser, issueClearToken = true) {
+  const web = webIdentity(browser);
+  const uri = browser?.documentURI;
+  const info = read(browser?.securityUI, "secInfo", null);
+  const security = Number(read(browser?.securityUI, "state", 0));
+  const certificateProblem = Boolean(security & (
+    Ci.nsIWebProgressListener.STATE_IS_BROKEN |
+    Ci.nsIWebProgressListener.STATE_CERT_USER_OVERRIDDEN
+  )) || Number(read(info, "errorCode", 0)) !== 0;
+  let kind = "unknown";
+  let builtInExtension = false;
+  if (web) {
+    kind = certificateProblem ? "broken" : loopback(web.host) ? "local" :
+      (security & Ci.nsIWebProgressListener.STATE_IS_SECURE) ? "secure" : "insecure";
+  } else if (uri?.schemeIs("about") && /^(neterror|certerror|httpsonlyerror)(?:[?#]|$)/u.test(uri.pathQueryRef)) {
+    kind = "error";
+  } else if (uri?.schemeIs("moz-extension")) {
+    const principal = browser.contentPrincipal;
+    const policy = principal?.addonPolicy;
+    if (policy?.active && principal.addonId === policy.id &&
+        policy.mozExtensionHostname === uri.asciiHost) {
+      kind = "extension";
+      const pref = "extensions.applicationBuiltins.allowedIds";
+      builtInExtension = Services.prefs.prefIsLocked(pref) &&
+        Services.prefs.getStringPref(pref, "").split(",").map(id => id.trim()).includes(policy.id);
+    }
+  }
+  const navigationToken = issueClearToken ? Services.uuid.generateUUID().toString() : "";
+  if (issueClearToken) {
+    siteRequests.set(browser, {
+      token: navigationToken, principal: web?.principal,
+      windowGlobal: browser.browsingContext?.currentWindowGlobal,
+      document: uri?.spec,
+    });
+  }
+  const succeededChain = read(info, "succeededCertChain", []);
+  const chain = succeededChain?.length ? succeededChain : read(info, "handshakeCertificates", []);
+  return {
+    kind, builtInExtension, navigationToken, origin: web?.origin ?? "", host: web?.host ?? "",
+    canClearData: issueClearToken && Boolean(web),
+    certificate: certificate(read(info, "serverCert", null)),
+    certificateChain: [...chain].slice(0, 16).map(certificate).filter(Boolean),
+    protocol: ["SSL 3", "TLS 1.0", "TLS 1.1", "TLS 1.2", "TLS 1.3"][read(info, "protocolVersion", -1)] ?? "",
+    cipher: text(read(info, "cipherName")),
+    keyExchange: text(read(info, "keaGroupName")),
+    signature: text(read(info, "signatureSchemeName")),
+    error: text(read(info, "errorCodeString")),
+  };
+}
+
+async function clearData(browser, token) {
+  const request = siteRequests.get(browser);
+  const web = webIdentity(browser);
+  if (!web || !request || request.token !== token ||
+      request.windowGlobal !== browser.browsingContext?.currentWindowGlobal ||
+      request.document !== browser.documentURI?.spec ||
+      !web.principal.equals(request.principal)) {
+    throw new Error("The site-information request is no longer current");
+  }
+  siteRequests.delete(browser);
+  const failures = await new Promise(resolve => Services.clearData.deleteDataFromPrincipal(
+    web.principal, true, SITE_DATA_FLAGS, resolve,
+  ));
+  if (failures) throw new Error("Some site data could not be cleared");
+  clearWebPermissions(web.principal);
+  return { cleared: true, origin: web.principal.originNoSuffix,
+    privateMode: web.principal.privateBrowsingId !== 0 };
+}
+
+/** Only the native host can call this fixed operation table. No script evaluation or pref RPC. */
+export async function query(window, operation, data = {}) {
+  const browser = window.tab?.linkedBrowser;
+  if (!browser || window.closed || !data || typeof data !== "object" || Array.isArray(data)) {
+    throw new Error("Product request has no live host");
+  }
+  switch (operation) {
+    case "search:get": case "search:default": case "search:upsert": case "search:remove":
+    case "search:move": case "search:remote": case "search:resolve": case "search:local-rank":
+    case "search:suggest": case "search:cancel": return queryAndroidSearch(window, operation, data);
+    case "appearance:set": {
+      if (Object.keys(data).length !== 2 ||
+          !Object.hasOwn(data, "key") || !Object.hasOwn(data, "value") ||
+          !["theme", "accent"].includes(data.key) || typeof data.value !== "string") {
+        throw new TypeError("Expected a theme or accent appearance setting");
+      }
+      const appearance = setAppearanceSetting(Services.prefs, data.key, data.value);
+      return { theme: appearance.theme, accent: appearance.accent };
+    }
+    case "product:initialize": {
+      if (Services.prefs.getIntPref("navis.sitePermissions.policyVersion", 0) < 2) {
+        // The previous boolean projection persisted even prompt dismissal. Its
+        // old entries cannot be interpreted as explicit user intent; re-prompt.
