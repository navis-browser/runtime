+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.gecko.navis;
+
+import android.os.Handler;
+import android.os.Looper;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.Set;
+import java.util.concurrent.CompletionStage;
+import org.mozilla.gecko.EventDispatcher;
+import org.mozilla.gecko.util.BundleEventListener;
+import org.mozilla.gecko.util.EventCallback;
+import org.mozilla.gecko.util.GeckoBundle;
+import org.mozilla.gecko.util.ThreadUtils;
+
+/** Process-wide direct-runtime peer for product-owned browsing data. */
+public final class NavisAndroidBrowsingData implements AutoCloseable {
+  private static final String DISPATCHER_NAME = "navis-android-browsing-data";
+  private static final String COMMAND_CLEAR = "NavisAndroid:BrowsingData:ClearProduct";
+  private static final Set<String> PRODUCT_TYPES =
+      new HashSet<>(Arrays.asList("history", "passwords", "downloads"));
+  private static final int MAX_EXTENSION_ID = 256;
+  private static final long MAX_SAFE_INTEGER = 9_007_199_254_740_991L;
+
+  public static final class Request {
+    public final String extensionId;
+    public final String dataType;
+    public final long since;
+    public final boolean privateMode;
+
+    private Request(final GeckoBundle bundle) {
+      extensionId = bounded(bundle.getString("extensionId", ""));
+      dataType = bundle.getString("dataType", "");
+      since = bundle.getLong("since", 0L);
+      privateMode = bundle.getBoolean("privateMode", false);
+      if (extensionId.isEmpty()
+          || dataType.isEmpty()
+          || !PRODUCT_TYPES.contains(dataType)
+          || since < 0L
+          || since > MAX_SAFE_INTEGER) {
+        throw new IllegalArgumentException("Invalid Navis browsing-data request");
+      }
+    }
+
+    public static Request fromBundle(final GeckoBundle bundle) {
+      if (bundle == null) {
+        throw new IllegalArgumentException("Missing browsing-data request");
+      }
+      return new Request(bundle);
+    }
+
+    private static String bounded(final String value) {
+      if (value == null || value.length() > MAX_EXTENSION_ID) {
+        return "";
+      }
+      return value;
+    }
+  }
+
+  public interface Delegate {
+    /** Returns true only after the product store has durably completed the clear. */
+    CompletionStage<Boolean> clear(Request request);
+  }
+
+  private static NavisAndroidBrowsingData sInstance;
+
+  private final Delegate mDelegate;
+  private final EventDispatcher mDispatcher;
+  private final BundleEventListener mListener = this::handleMessage;
+  private final Handler mUiHandler = new Handler(Looper.getMainLooper());
+  private final Set<PendingCommand> mPending = new HashSet<>();
+  private boolean mClosed;
+
+  private NavisAndroidBrowsingData(final Delegate delegate) {
+    mDelegate = delegate;
+    mDispatcher = EventDispatcher.byName(DISPATCHER_NAME);
+    mDispatcher.registerUiThreadListener(mListener, COMMAND_CLEAR);
+  }
+
+  public static synchronized NavisAndroidBrowsingData install(final Delegate delegate) {
+    ThreadUtils.assertOnUiThread();
+    if (delegate == null) {
+      throw new NullPointerException("delegate");
+    }
+    if (sInstance != null) {
+      throw new IllegalStateException("Only one Navis browsing-data peer may be installed");
+    }
+    sInstance = new NavisAndroidBrowsingData(delegate);
+    return sInstance;
+  }
+
+  private void handleMessage(
+      final String event, final GeckoBundle message, final EventCallback callback) {
+    ThreadUtils.assertOnUiThread();
+    if (callback == null) {
+      return;
+    }
+    if (mClosed) {
+      callback.sendError("Navis browsing-data peer is closed");
+      return;
+    }
+    if (!COMMAND_CLEAR.equals(event)) {
+      callback.sendError("Unknown Navis browsing-data operation");
+      return;
+    }
+
+    final Request request;
+    final CompletionStage<Boolean> stage;
+    try {
+      request = Request.fromBundle(message);
+      stage = mDelegate.clear(request);
+      if (stage == null) {
+        throw new IllegalStateException("Product data delegate returned no result");
+      }
+    } catch (final Throwable error) {
+      callback.sendError(publicMessage(error));
+      return;
+    }
+
+    final PendingCommand pending = new PendingCommand(callback);
+    mPending.add(pending);
+    stage.whenComplete(
+        (cleared, error) ->
+            onUi(
+                () -> {
+                  if (error != null) {
+                    pending.fail(error);
+                  } else if (!Boolean.TRUE.equals(cleared)) {
+                    pending.fail(new IllegalStateException("Product data clear was rejected"));
+                  } else {
+                    pending.succeed();
+                  }
+                }));
+  }
+
+  @Override
+  public void close() {
+    ThreadUtils.assertOnUiThread();
+    synchronized (NavisAndroidBrowsingData.class) {
+      if (mClosed) {
+        return;
+      }
+      mClosed = true;
+      if (sInstance == this) {
+        sInstance = null;
+      }
+    }
+    mDispatcher.unregisterUiThreadListener(mListener, COMMAND_CLEAR);
+    for (final PendingCommand pending : new ArrayList<>(mPending)) {
+      pending.fail(new IllegalStateException("Navis browsing-data peer is closed"));
+    }
+    mPending.clear();
+    mDispatcher.shutdown();
+  }
+
+  private void onUi(final Runnable action) {
+    if (Looper.myLooper() == Looper.getMainLooper()) {
+      action.run();
+    } else {
+      mUiHandler.post(action);
+    }
+  }
+
+  private static String publicMessage(final Throwable error) {
+    Throwable current = error;
+    while (current instanceof java.util.concurrent.CompletionException
+        && current.getCause() != null) {
+      current = current.getCause();
+    }
+    final String message = current.getMessage();
+    return message == null || message.isEmpty()
+        ? "Navis product data clear failed"
+        : message;
+  }
+
+  private final class PendingCommand {
+    private final EventCallback mCallback;
+    private boolean mFinished;
+
+    PendingCommand(final EventCallback callback) {
+      mCallback = callback;
+    }
+
+    void succeed() {
+      if (finish()) {
+        mCallback.sendSuccess(true);
+      }
+    }
+
+    void fail(final Throwable error) {
+      onUi(
+          () -> {
+            if (finish()) {
+              mCallback.sendError(publicMessage(error));
+            }
+          });
+    }
+
+    private boolean finish() {
+      if (mFinished) {
+        return false;
+      }
+      mFinished = true;
+      mPending.remove(this);
+      return true;
+    }
+  }
+}
