+++ b/mobile/shared/modules/navis/NavisAndroidBrowsingData.sys.mjs
@@ -0,0 +1,54 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+const MAX_EXTENSION_ID = 256;
+const PRODUCT_TYPES = new Set(["history", "passwords", "downloads"]);
+
+const { ExtensionError } = ChromeUtils.importESModule(
+  "resource://gre/modules/ExtensionUtils.sys.mjs"
+);
+const { EventDispatcher } = ChromeUtils.importESModule(
+  "resource://gre/modules/Messaging.sys.mjs"
+);
+const dispatcher = EventDispatcher.byName("navis-android-browsing-data");
+
+/** JS side of the direct product-store clearing seam. */
+const NavisAndroidBrowsingData = Object.freeze({
+  clearProduct(dataType, options, extensionId) {
+    if (!PRODUCT_TYPES.has(dataType)) {
+      return Promise.reject(new ExtensionError("Unsupported product data type"));
+    }
+    if (typeof extensionId !== "string" || !extensionId ||
+        extensionId.length > MAX_EXTENSION_ID) {
+      return Promise.reject(new ExtensionError("Invalid extension identity"));
+    }
+    const since = options?.since == null ? 0 : Number(options.since);
+    if (!Number.isFinite(since) || since < 0 || since > Number.MAX_SAFE_INTEGER) {
+      return Promise.reject(new ExtensionError("Invalid browsingData since"));
+    }
+    return dispatcher.sendRequestForResult(
+      "NavisAndroid:BrowsingData:ClearProduct",
+      Object.freeze({
+        extensionId,
+        dataType,
+        since: Math.floor(since),
+        // Product stores never persist private records. The Java peer treats
+        // private requests as an isolated no-op, never as normal-store access.
+        privateMode: options?.cookieStoreId === "firefox-private",
+      })
+    ).then(result => {
+      if (result !== true) {
+        throw new ExtensionError("Navis product data clear was not accepted");
+      }
+      return result;
+    }).catch(error => {
+      if (error instanceof ExtensionError) throw error;
+      throw new ExtensionError(error?.message || "Navis product data clear failed");
+    });
+  },
+});
+
+export { NavisAndroidBrowsingData };
