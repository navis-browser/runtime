+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.gecko.navis;
+
+/** Only the authorized extension document's own navigation can complete its popup. */
+final class NavisAndroidPopupLoadState {
+  enum Completion { IGNORE, LOADED, FAILED }
+
+  private final String expectedUri;
+  private long generation;
+  private boolean settled;
+
+  NavisAndroidPopupLoadState(final String uri) {
+    expectedUri = withoutFragment(uri);
+  }
+
+  void started(final long nextGeneration, final String uri) {
+    if (!settled && nextGeneration > 0 && expectedUri.equals(withoutFragment(uri))) {
+      generation = nextGeneration;
+    }
+  }
+
+  Completion completed(final long completedGeneration, final int status,
+      final boolean statusKnown, final boolean cancelled, final boolean errorPage, final String uri) {
+    if (settled || generation == 0 || !expectedUri.equals(withoutFragment(uri))
+        || (completedGeneration != 0 && generation != completedGeneration)
+        || !statusKnown || cancelled) {
+      return Completion.IGNORE;
+    }
+    settled = true;
+    return !errorPage && (status & 0x80000000) == 0 ? Completion.LOADED : Completion.FAILED;
+  }
+
+  private static String withoutFragment(final String uri) {
+    if (uri == null) return "";
+    final int hash = uri.indexOf('#');
+    return hash < 0 ? uri : uri.substring(0, hash);
+  }
+}

