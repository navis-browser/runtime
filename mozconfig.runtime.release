# Navis 1.0 Linux x86_64 release graph. This profile deliberately avoids
# compiler caches and Cargo incremental state so the shipped graph can be
# reconstructed from an empty object directory.
export MOZ_REQUIRE_SIGNING=1

ac_add_options --enable-project=navis
ac_add_options --disable-tests
ac_add_options --enable-release
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --disable-local-ml
ac_add_options --disable-eme-api
ac_add_options --disable-web-push
ac_add_options --disable-safe-browsing
ac_add_options --enable-webdriver
ac_add_options --disable-printing
ac_add_options --disable-ctypes
ac_add_options --disable-backgroundtasks
ac_add_options --enable-desktop-embedder
ac_add_options --enable-webextensions-runtime
ac_add_options --disable-observability-runtime
ac_add_options --disable-webrtc
ac_add_options --disable-cargo-incremental
ac_add_options --host=x86_64-unknown-linux-gnu
ac_add_options --target=x86_64-unknown-linux-gnu

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-navis-runtime-release
mk_add_options AUTOCLOBBER=1
mk_add_options MOZ_MAKE_FLAGS="-j16"
